// Applet -> Oak, generated by Magnolia. Edit the named method functions below.
// Same-layout bytecode edits can become NEW class bytes via: magnolia build --entry EDITED.oak --output NEW.class
// restoreOak instead recovers the archived ORIGINAL; arbitrary Oak is not a Java compiler.
// @magnolia-applet-archive-v1:
// @magnolia-applet-runtime-sha256-v1:a8979f55b70664439c4c4f597a6cf1d49ccb19de89691ab0454d2b0754c12299
// applet-runtime — a bounded, headless interpreter for the verified subset
// emitted by applet-bytecode. No Java, network, filesystem or AWT host calls.
// Works under Magnolia and in its generated JavaScript bundles.

std := import('std')
str := import('str')
default := std.default
range := std.range
map := std.map
fmt := import('fmt')
format := fmt.format
// Portable Oak VM-library transition boundary for the bounded JVM image.
// All external host members pass through descriptor + invocation-opcode
// admission here, both at bytecode preflight and again at execution. Extend
// the VM by adding a checked contract here, an implementation in jvmInvoke /
// jvmString or applet-runtime's stateful host adapter, and parity tests for
// native Oak, bundled JS, standalone Oak and the optional Java-source emitter.
// This module deliberately does not claim a complete java.* / AWT library.

std := import('std')

fn _spec(operation, count) {op: operation, argc: count}
// Color's uppercase constants are aliases of their historical lowercase
// counterparts in the JDK, not equal-valued but independent objects.
fn jvmColorName(name) if name {
    'white', 'WHITE' -> 'white'
    'black', 'BLACK' -> 'black'
    'red', 'RED' -> 'red'
    'green', 'GREEN' -> 'green'
    'blue', 'BLUE' -> 'blue'
    'yellow', 'YELLOW' -> 'yellow'
    'cyan', 'CYAN' -> 'cyan'
    'magenta', 'MAGENTA' -> 'magenta'
    'gray', 'GRAY' -> 'gray'
    'lightGray', 'LIGHT_GRAY' -> 'lightGray'
    'darkGray', 'DARK_GRAY' -> 'darkGray'
    'orange', 'ORANGE' -> 'orange'
    'pink', 'PINK' -> 'pink'
    _ -> ?
}
fn _color?(name) jvmColorName(name) != ?

// These are the only host fields and external instantiable types. User
// classes are resolved by the class linker instead of being listed here.
fn jvmField(owner, name, desc, opcode) if owner {
    'java/lang/System' -> if opcode = 178 & name = 'out' &
        desc = 'Ljava/io/PrintStream;' {
        true -> _spec('system-out', 0), _ -> ?}
    'java/awt/Color' -> if opcode = 178 & desc = 'Ljava/awt/Color;' &
        _color?(name) {
        true -> _spec('awt-color', 0), _ -> ?}
    // Only the mutable coordinates of a real Point, not arbitrary AWT fields.
    'java/awt/Point' -> if (opcode = 180 | opcode = 181) &
        (name = 'x' | name = 'y') & desc = 'I' {
        true -> _spec('point-coordinate', if opcode = 181 {true -> 1, _ -> 0})
        _ -> ?
    }
    _ -> ?
}
fn jvmNew(owner) if owner {
    'java/lang/StringBuilder', 'java/lang/StringBuffer' -> 'text-builder'
    'java/awt/Color' -> 'awt-color'
    'java/awt/Point' -> 'awt-point'
    _ -> ?
}
// Reference types whose identity/subtyping the bounded VM can model without
// loading a JDK class. In particular, array instanceof/checkcast may use
// Object, Cloneable and Serializable; unknown JDK types fail at preflight.
fn jvmReference(owner) if owner {
    'java/lang/Object', 'java/lang/String',
    'java/lang/StringBuilder', 'java/lang/StringBuffer',
    'java/applet/Applet', 'java/awt/Color', 'java/awt/Graphics',
    'java/awt/Point', 'java/awt/geom/Point2D',
    'java/io/PrintStream', 'java/lang/Cloneable',
    'java/io/Serializable' -> true
    _ -> ?
}

// No name-only shortcuts: a call with the wrong descriptor or opcode never
// reaches the interpreter's host functions. argc is the number of JVM
// one-slot arguments, excluding the receiver for invokevirtual/special.
fn jvmMethod(owner, name, desc, opcode) if owner {
    // Static JVM arraycopy, not a name-based shortcut for other System calls.
    'java/lang/System' -> if opcode = 184 & name = 'arraycopy' &
        desc = '(Ljava/lang/Object;ILjava/lang/Object;II)V' {
        true -> _spec('arraycopy', 5), _ -> ?
    }
    'java/lang/Math' -> if opcode = 184 {
        true -> if name + desc {
            'abs(I)I' -> _spec('iabs', 1)
            'max(II)I' -> _spec('imax', 2)
            'min(II)I' -> _spec('imin', 2)
            _ -> ?
        }
        _ -> ?
    }
    'java/lang/Integer' -> if opcode = 184 {
        true -> if name + desc {
            'parseInt(Ljava/lang/String;)I' -> _spec('parse-int', 1)
            'toString(I)Ljava/lang/String;' -> _spec('int-string', 1)
            'compare(II)I' -> _spec('icompare', 2)
            'sum(II)I' -> _spec('isum', 2)
            'max(II)I' -> _spec('imax', 2)
            'min(II)I' -> _spec('imin', 2)
            _ -> ?
        }
        _ -> ?
    }
    'java/lang/String' -> if opcode = 182 {
        true -> if name + desc {
            'length()I' -> _spec('string-length', 0)
            'equals(Ljava/lang/Object;)Z' -> _spec('string-equals', 1)
            'equalsIgnoreCase(Ljava/lang/String;)Z' -> _spec('string-equals-ignore-case', 1)
            'indexOf(I)I' -> _spec('string-index-of', 1)
            'concat(Ljava/lang/String;)Ljava/lang/String;' -> _spec('string-concat', 1)
            _ -> ?
        }
        _ -> if opcode = 184 & name = 'valueOf' & desc = '(I)Ljava/lang/String;' {
            true -> _spec('int-string', 1), _ -> ?
        }
    }
    'java/lang/Object' -> if opcode = 183 & name = '<init>' & desc = '()V' {
        true -> _spec('object-init', 0), _ -> ?}
    'java/applet/Applet' -> if opcode = 183 & name = '<init>' & desc = '()V' {
        true -> _spec('applet-init', 0)
        _ -> if opcode = 182 & name = 'getParameter' &
            desc = '(Ljava/lang/String;)Ljava/lang/String;' {
            true -> _spec('applet-param', 1), _ -> ?}
    }
    'java/io/PrintStream' -> if opcode = 182 &
        (name = 'print' | name = 'println') &
        (desc = '()V' | desc = '(I)V' | desc = '(Z)V' |
        desc = '(Ljava/lang/String;)V' | desc = '(Ljava/lang/Object;)V') {
        true -> _spec(name, if desc = '()V' {true -> 0, _ -> 1})
        _ -> ?
    }
    'java/lang/StringBuilder', 'java/lang/StringBuffer' -> if opcode = 183 &
        name = '<init>' & (desc = '()V' | desc = '(Ljava/lang/String;)V') {
        true -> _spec('text-init', if desc = '()V' {true -> 0, _ -> 1})
        _ -> if opcode = 182 {
            true -> if {
                name = 'toString' & desc = '()Ljava/lang/String;' ->
                    _spec('text-string', 0)
                name = 'append' & (desc = '(I)L' + owner + ';' |
                    desc = '(Ljava/lang/String;)L' + owner + ';') ->
                    _spec('text-append', 1)
                _ -> ?
            }
            _ -> ?
        }
    }
    'java/awt/Color' -> if opcode = 183 & name = '<init>' & desc = '(III)V' {
        true -> _spec('color-init', 3), _ -> ?}
    'java/awt/Point' -> if opcode = 183 & name = '<init>' {
        true -> if desc {
            '()V' -> _spec('point-init', 0)
            '(II)V' -> _spec('point-init-xy', 2)
            '(Ljava/awt/Point;)V' -> _spec('point-init-copy', 1)
            _ -> ?
        }
        _ -> if opcode = 182 {true -> if name + desc {
            'move(II)V', 'setLocation(II)V' -> _spec('point-move', 2)
            'getLocation()Ljava/awt/Point;' -> _spec('point-copy', 0)
            'equals(Ljava/lang/Object;)Z' -> _spec('point-equals', 1)
            _ -> ?
        }, _ -> ?}
    }
    'java/awt/Graphics' -> if opcode = 182 {
        true -> if name + desc {
            'setColor(Ljava/awt/Color;)V' -> _spec('draw-color', 1)
            'fillRect(IIII)V' -> _spec('draw-rect', 4)
            'drawLine(IIII)V' -> _spec('draw-line', 4)
            'drawString(Ljava/lang/String;II)V' -> _spec('draw-text', 3)
            _ -> ?
        }
        _ -> ?
    }
    _ -> ?
}

fn _error(message) {type: :error, message: message}
fn _int32?(n) type(n) = :int & n >= -2147483648 & n <= 2147483647
fn _i32(n) {
    u := n & 4294967295
    if u >= 2147483648 {true -> u - 4294967296, _ -> u}
}
// Java NumberFormatException is represented as a bounded VM error; it is
// never silently treated as a successful result. Large zero-padded strings
// beyond 4096 characters are intentionally outside this subset.
fn _parseInt(text) {
    if type(text) != :string | len(text) = 0 | len(text) > 4096 {
        true -> _error('Integer.parseInt expects a bounded nonempty string')
        _ -> {
            first := text.(0)
            negative? := first = '-'
            start := if negative? | first = '+' {true -> 1, _ -> 0}
            limit := if negative? {true -> 2147483648, _ -> 2147483647}
            value := 0
            issue := ?
            if start >= len(text) -> issue <- 'invalid integer'
            std.range(start, len(text)) |> std.each(fn(i) if issue = ? {
                true -> {
                    digit := codepoint(text.(i)) - 48
                    if digit < 0 | digit > 9 {
                        true -> issue <- 'invalid integer'
                        _ -> if value > (limit - digit) / 10 {
                            true -> issue <- 'integer overflow'
                            _ -> value <- value * 10 + digit
                        }
                    }
                }
            })
            if issue != ? {
                true -> _error(issue)
                _ -> {type: :ok, value: if negative? {true -> 0 - value, _ -> value}}
            }
        }
    }
}
// Deterministic, host-independent integer service. MIN_VALUE abs stays
// negative, and Integer.sum wraps as a JVM signed 32-bit addition.
fn jvmInvoke(spec, args) {
    if spec = ? | type(args) != :list | len(args) != spec.argc {
        true -> _error('invalid portable JVM library invocation')
        _ -> if spec.op = 'parse-int' {
            true -> _parseInt(args.(0))
            _ -> {
                a := args.(0)
                b := if spec.argc = 2 {true -> args.(1), _ -> ?}
                if !_int32?(a) | (spec.argc = 2 & !_int32?(b)) {
                    true -> _error('JVM integer library expects int32 arguments')
                    _ -> if spec.op {
                        'int-string' -> {type: :ok, value: string(a)}
                        'iabs' -> {type: :ok, value: if a < 0 & a != -2147483648 {
                            true -> 0 - a, _ -> a}}
                        'imax' -> {type: :ok, value: if a > b {true -> a, _ -> b}}
                        'imin' -> {type: :ok, value: if a < b {true -> a, _ -> b}}
                        'isum' -> {type: :ok, value: _i32(a + b)}
                        'icompare' -> {type: :ok, value: if a < b {
                            true -> -1, _ -> if a > b {true -> 1, _ -> 0}}}
                        _ -> _error('unsupported JVM integer library intrinsic')
                    }
                }
            }
        }
    }
}
fn _ascii?(text) {
    ascii? := type(text) = :string & len(text) <= 4194304
    if ascii? -> std.range(len(text)) |> std.each(fn(i) if codepoint(text.(i)) >= 128 -> ascii? <- false)
    ascii?
}
// Java strings are UTF-16; class constants currently retain raw modified
// UTF-8 bytes. Refuse non-ASCII rather than returning incorrect Java lengths
// or comparing an encoded class literal with a decoded host string.
fn jvmString(spec, receiver, args) {
    if spec = ? | type(args) != :list | len(args) != spec.argc |
        !_ascii?(receiver) {
        true -> _error('JVM String library requires an ASCII string receiver')
        _ -> if spec.op {
            'string-length' -> {type: :ok, value: len(receiver)}
            'string-equals' -> {
                other := args.(0)
                if type(other) = :string & !_ascii?(other) {
                    true -> _error('JVM String.equals does not support non-ASCII strings')
                    _ -> {type: :ok, value: if receiver = other {true -> 1, _ -> 0}}
                }
            }
            'string-equals-ignore-case' -> {
                other := args.(0)
                if other != ? & !_ascii?(other) {
                    true -> _error('JVM String.equalsIgnoreCase supports ASCII only')
                    _ -> {
                        same? := type(other) = :string & len(receiver) = len(other)
                        fn lower(c) {
                            code := codepoint(c)
                            if code >= 65 & code <= 90 {true -> code - (0 - 32), _ -> code}
                        }
                        if same? -> std.range(len(receiver)) |> std.each(fn(i) if
                            lower(receiver.(i)) != lower(other.(i)) -> same? <- false)
                        {type: :ok, value: if same? {true -> 1, _ -> 0}}
                    }
                }
            }
            'string-index-of' -> if type(args.(0)) = :int &
                args.(0) >= 0 & args.(0) <= 127 {
                true -> {
                    index := -1
                    std.range(len(receiver)) |> std.each(fn(i) if index = -1 &
                        codepoint(receiver.(i)) = args.(0) -> index <- i)
                    {type: :ok, value: index}
                }
                _ -> _error('JVM String.indexOf supports ASCII code points only')
            }
            'string-concat' -> if _ascii?(args.(0)) {
                true -> if len(receiver) + len(args.(0)) > 4194304 {
                    true -> _error('JVM String result exceeds 4 MiB limit')
                    _ -> {type: :ok, value: receiver + args.(0)}
                }
                _ -> _error('JVM String.concat requires a nonnull ASCII string')
            }
            _ -> _error('unsupported JVM String library intrinsic')
        }
    }
}

vmLib := {jvmMethod: jvmMethod, jvmField: jvmField,
    jvmNew: jvmNew, jvmReference: jvmReference,
    jvmColorName: jvmColorName, jvmInvoke: jvmInvoke, jvmString: jvmString}

fn i32(n) {
	u := n & 4294967295
	if u >= 2147483648 {true -> u - 4294967296, _ -> u}
}
fn truncDiv(a, b) {
	q := a / b
	if q < 0 {true -> 0 - int(0 - q), _ -> int(q)}
}
fn fail(state, message) {
	if state.error = ? -> state.error <- message
	?
}
fn fieldKey(owner, name, desc) owner + '.' + name + ':' + desc
fn methodKey(name, desc) name + desc

// Every JVM reference gets a run-local identity, including String values.
// Oak/Builder JS compare text and objects differently, so neither Oak '='
// nor JS structural equality can implement JVM if_acmp*. Intern only class
// literals/ConstantValue strings; host results and supplied arguments are
// distinct objects even when their characters match.
fn _tagRef(state, value) if state.nextRefId > 1048576 {
    true -> fail(state, 'JVM reference limit exceeded (1048576)')
    _ -> {
        value.refId <- state.nextRefId
        state.nextRefId <- state.nextRefId + 1
        value
    }
}
fn _newString(state, text) if type(text) = :string {
    true -> _tagRef(state, {className: 'java/lang/String', text: text})
    _ -> fail(state, 'invalid JVM String value')
}
fn _internString(state, text) {
    // Prefix arbitrary class-file text so keys cannot collide with JS object
    // prototype properties in the standalone Builder output.
    key := 'literal:' + text
    ref := state.interned.(key)
    if ref = ? {
        true -> {
            ref <- _newString(state, text)
            if state.error = ? -> state.interned.(key) <- ref
        }
    }
    ref
}
fn _string?(value) type(value) = :object &
    value.className = 'java/lang/String' & type(value.text) = :string
fn _stringText(value) if _string?(value) {true -> value.text, _ -> ?}
fn _referenceId(value, state) if value = ? {
    true -> 0
    _ -> if type(value) = :object & type(value.className) = :string &
        type(value.refId) = :int & value.refId > 0 {
        true -> value.refId
        _ -> fail(state, 'reference comparison requires JVM references')
    }
}
// Native Oak has a literal 'super' key. Builder's bundled JS may instead
// mangle a parsed identifier to '__oak_js_super', while a virtual Oak object
// with a quoted key retains 'super'. Accept both internal representations.
fn classParent(cls) if cls = ? {
    true -> ?
    _ -> if cls.('super') != ? {true -> cls.('super'), _ -> cls.__oak_js_super}
}
fn isVoid?(desc) desc.(len(desc) - 1) = 'V'

fn _defaultField(desc) if desc.(0) {
	'Z', 'B', 'C', 'S', 'I' -> 0
	_ -> ?
}
fn _initFields(program, owner, fields, state) {
	cls := program.classes.(owner)
	if cls != ? {
		true -> {
			if classParent(cls) != ? -> _initFields(program, classParent(cls), fields, state)
			cls.fields |> keys() |> std.each(fn(k) fields.(k) <- cls.fields.(k))
		}
	}
}
fn awtColor(r, g, b, state) _tagRef(state,
    {className: 'java/awt/Color', fields: {}, red: r, green: g, blue: b})
// Point is a mutable, identity-bearing AWT geometry value. Its public int
// coordinates use the SAME field keys as ordinary JVM getfield/putfield.
fn _point?(value) type(value) = :object &
    value.className = 'java/awt/Point' & type(value.fields) = :object
fn _pointKey(name) fieldKey('java/awt/Point', name, 'I')
fn _int32?(value) type(value) = :int &
    value >= -2147483648 & value <= 2147483647
fn _newPoint(state, x, y) {
    fields := {}
    fields.(_pointKey('x')) <- x
    fields.(_pointKey('y')) <- y
    _tagRef(state, {className: 'java/awt/Point', fields: fields})
}
fn awtCSS(color) 'rgb(' + string(color.red) + ',' + string(color.green) + ',' + string(color.blue) + ')'
fn draw(state, command) if len(state.draw) >= 16384 {
    true -> fail(state, 'AWT drawing command limit exceeded (16384)')
    _ -> state.draw << command
}
fn namedColor(name, state) {
    canonical := vmLib.jvmColorName(name)
    if canonical = ? {
        true -> fail(state, 'unsupported AWT color constant ' + name)
        _ -> {
            saved := state.colors.('color:' + canonical)
            if saved != ? {
                true -> saved
                _ -> {
                    color := if canonical {
                        'white' -> awtColor(255, 255, 255, state)
                        'black' -> awtColor(0, 0, 0, state)
                        'red' -> awtColor(255, 0, 0, state)
                        'green' -> awtColor(0, 255, 0, state)
                        'blue' -> awtColor(0, 0, 255, state)
                        'yellow' -> awtColor(255, 255, 0, state)
                        'cyan' -> awtColor(0, 255, 255, state)
                        'magenta' -> awtColor(255, 0, 255, state)
                        'gray' -> awtColor(128, 128, 128, state)
                        'lightGray' -> awtColor(192, 192, 192, state)
                        'darkGray' -> awtColor(64, 64, 64, state)
                        'orange' -> awtColor(255, 200, 0, state)
                        'pink' -> awtColor(255, 175, 175, state)
                        _ -> fail(state, 'unsupported AWT color constant ' + name)
                    }
                    if state.error = ? -> state.colors.('color:' + canonical) <- color
                    color
                }
            }
        }
    }
}
// Class preparation's ConstantValue defaults are in state.statics already.
// Active use runs <clinit> once, after the superclass, within the same
// instruction/depth budgets as ordinary methods. Mark 'initializing' before
// calling code so recursive static references do not rerun the initializer.
fn initializeClass(program, owner, state) {
    cls := program.classes.(owner)
    if cls != ? & state.error = ? & state.initialized.(owner) = ? {
        true -> {
            state.initialized.(owner) <- 'initializing'
            if classParent(cls) != ? -> initializeClass(program, classParent(cls), state)
            if state.error = ? & cls.methods.('<clinit>()V') != ? ->
                execute(program, owner, '<clinit>', '()V', [], ?, state)
            state.initialized.(owner) <- if state.error = ? {true -> 'ready', _ -> 'failed'}
        }
    }
}
fn newObject(program, owner, state) if vmLib.jvmNew(owner) {
    'text-builder' -> _tagRef(state, {className: owner, fields: {}, text: ''})
    'awt-color' -> awtColor(0, 0, 0, state)
    'awt-point' -> _newPoint(state, 0, 0)
    _ -> if program.classes.(owner) {
        ? -> fail(state, 'missing class ' + owner)
        _ -> {
            initializeClass(program, owner, state)
            if state.error != ? {
                true -> ?
                _ -> {
                    fields := {}
                    _initFields(program, owner, fields, state)
                    _tagRef(state, {className: owner, fields: fields})
                }
            }
        }
    }
}

// JVM instanceof/checkcast and interface dispatch share the same bounded
// transitive type walk. For host values and arrays, model only admitted JVM
// identities, Object and the standard array interfaces. A missing reference
// type is rejected by the linker rather than reported as a false instanceof.
// classParent accepts both representations of the reserved parent key in
// Builder's bundled JS and in standalone/native Oak.
fn _arrayClass(op, tag) if op = 189 {
    true -> if str.startsWith?(tag, '[') {true -> '[' + tag, _ -> '[L' + tag + ';'}
    _ -> if tag {
        4 -> '[Z'
        5 -> '[C'
        8 -> '[B'
        9 -> '[S'
        10 -> '[I'
        _ -> ?
    }
}
fn _arrayComponent(name) if type(name) != :string | len(name) < 2 |
    name.(0) != '[' {
    true -> ?
    _ -> {
        tail := std.slice(name, 1)
        if tail.(0) = '[' {
            true -> tail
            _ -> if tail.(0) = 'L' & len(tail) > 2 &
                tail.(len(tail) - 1) = ';' {
                true -> std.slice(tail, 1, len(tail) - 1)
                _ -> ?
            }
        }
    }
}
fn _hostSubtype?(current, owner) if owner {
    'java/lang/Object' -> vmLib.jvmReference(current) != ?
    'java/io/Serializable' -> current = 'java/lang/String' |
        current = 'java/lang/StringBuilder' | current = 'java/lang/StringBuffer' |
        current = 'java/awt/Color' | current = 'java/awt/Point' |
        current = 'java/applet/Applet'
    'java/lang/Cloneable' -> current = 'java/awt/Point' |
        current = 'java/awt/geom/Point2D'
    'java/awt/geom/Point2D' -> current = 'java/awt/Point'
    _ -> false
}
fn _isSubtype(program, current, owner, depth) if depth >= 64 |
    type(current) != :string | type(owner) != :string {
    true -> false
    _ -> if current = owner {
        true -> true
        _ -> if str.startsWith?(current, '[') {
            true -> if owner = 'java/lang/Object' |
                owner = 'java/lang/Cloneable' | owner = 'java/io/Serializable' {
                true -> true
                _ -> if str.startsWith?(owner, '[') &
                    _arrayComponent(current) != ? & _arrayComponent(owner) != ? {
                    true -> _isSubtype(program, _arrayComponent(current),
                        _arrayComponent(owner), depth - (0 - 1))
                    _ -> false
                }
            }
            _ -> if _hostSubtype?(current, owner) {
                true -> true
                _ -> {
                    cls := program.classes.(current)
                    if cls = ? {
                        true -> false
                        _ -> _isSubtype(program, classParent(cls), owner, depth - (0 - 1)) |
                            (cls.interfaces |> std.default([]) |>
                                std.some(fn(parent) _isSubtype(program, parent,
                                    owner, depth - (0 - 1))))
                    }
                }
            }
        }
    }
}
fn _isInstance(program, value, owner) if value {
    ? -> false
    _ -> if type(value) {
        :string -> _isSubtype(program, 'java/lang/String', owner, 0)
        :object -> _isSubtype(program, value.className, owner, 0)
        _ -> false
    }
}

// System.arraycopy is a bounded VM-library operation on actual JVM arrays.
// Take a snapshot before writing for overlapping copies, but check each
// reference store in order so an incompatible element cannot be skipped.
// Host work consumes the same instruction budget as JVM instructions.
fn _arraycopyArray?(value) if type(value) != :object {
    true -> false
    _ -> if type(value.values) != :list | type(value.className) != :string {
        true -> false
        _ -> if type(value.tag) {
            :int -> _arrayClass(188, value.tag) = value.className
            :string -> _arrayClass(189, value.tag) = value.className
            _ -> false
        }
    }
}
fn _arraycopy(program, args, state) {
    from := args.(0)
    sourcePos := args.(1)
    into := args.(2)
    destPos := args.(3)
    count := args.(4)
    if from = ? | into = ? {
        true -> fail(state, 'null System.arraycopy array')
        _ -> if !_arraycopyArray?(from) | !_arraycopyArray?(into) {
            true -> fail(state, 'System.arraycopy requires JVM arrays')
            _ -> if (type(from.tag) = :int) != (type(into.tag) = :int) |
                (type(from.tag) = :int & from.tag != into.tag) {
                true -> fail(state, 'System.arraycopy primitive array type mismatch')
                _ -> if !_int32?(sourcePos) | !_int32?(destPos) |
                    !_int32?(count) | sourcePos < 0 | destPos < 0 |
                    count < 0 | count > state.maxArray |
                    sourcePos > len(from.values) - count |
                    destPos > len(into.values) - count {
                    true -> fail(state, 'System.arraycopy range out of bounds')
                    _ -> if state.steps + count > state.maxSteps {
                        true -> fail(state, 'System.arraycopy instruction budget exceeded')
                        _ -> {
                            state.steps <- state.steps + count
                            original := range(count) |> map(fn(i) from.values.(sourcePos + i))
                            range(count) |> std.each(fn(i) if state.error = ? {
                                true -> {
                                    value := original.(i)
                                    if type(into.tag) = :string & value != ? &
                                        !_isInstance(program, value, into.tag) {
                                        true -> fail(state, 'System.arraycopy array store type mismatch')
                                        _ -> into.values.(destPos + i) <- value
                                    }
                                }
                            })
                            ?
                        }
                    }
                }
            }
        }
    }
}

// The same VM-library member contract gates both preflight and dispatch.
// This guard also applies to hand-constructed or edited Oak IR. Stateful
// services (output, AWT, applet params) remain in the bounded runtime;
// pure int and ASCII String services execute in the shared VM library.
fn _hostCall(program, owner, name, desc, opcode, recv, args, state) {
    spec := vmLib.jvmMethod(owner, name, desc, opcode)
    if spec = ? | type(args) != :list | len(args) != spec.argc {
        true -> fail(state, 'unsupported JVM library call ' + owner + '.' + name + desc)
        _ -> _hostAdmitted(program, owner, name, desc, opcode, recv, args, state, spec)
    }
}
fn _hostAdmitted(program, owner, name, desc, opcode, recv, args, state, spec) if owner {
    'java/lang/System' -> if spec.op = 'arraycopy' & recv = ? {
        true -> _arraycopy(program, args, state)
        _ -> fail(state, 'unsupported JVM System call ' + name + desc)
    }
    'java/lang/Math', 'java/lang/Integer' -> {
        passed := if spec.op = 'parse-int' {
            true -> [_stringText(args.(0))], _ -> args}
        outcome := vmLib.jvmInvoke(spec, passed)
        if outcome.type = :error {
            true -> fail(state, outcome.message)
            _ -> if spec.op = 'int-string' {
                true -> _newString(state, outcome.value), _ -> outcome.value}
        }
    }
    'java/lang/String' -> {
        passed := if spec.op = 'string-equals' | spec.op = 'string-equals-ignore-case' |
            spec.op = 'string-concat' {
            true -> [_stringText(args.(0))], _ -> args}
        if opcode != 184 & !_string?(recv) ->
            fail(state, 'String method on non-String receiver')
        outcome := if state.error != ? {
            true -> ?
            _ -> if opcode = 184 {
                true -> vmLib.jvmInvoke(spec, passed)
                _ -> vmLib.jvmString(spec, recv.text, passed)
            }
        }
        if state.error != ? {true -> ?, _ -> if outcome.type = :error {
            true -> fail(state, outcome.message)
            _ -> if opcode = 184 {
                true -> _newString(state, outcome.value)
                _ -> if spec.op = 'string-concat' {
                    true -> if passed.(0) = '' {true -> recv,
                        _ -> _newString(state, outcome.value)}
                    _ -> outcome.value
                }
            }
        }}
    }
	'java/lang/Object', 'java/applet/Applet' -> if name = '<init>' & desc = '()V' {
		true -> ?
		_ -> fail(state, 'unsupported host method ' + owner + '.' + name + desc)
	}
	'java/io/PrintStream' -> if recv.className = owner & (name = 'print' | name = 'println') {
		true -> {
            // Java's Object overload can execute arbitrary user toString.
            // Never print an Oak/JS object representation as a Java result.
            value := if len(args) = 0 {true -> ?, _ -> args.(0)}
            text := if desc {
                '()V' -> ''
                '(I)V' -> if type(value) = :int {true -> string(value),
                    _ -> fail(state, 'PrintStream.print(int) requires an integer')}
                '(Z)V' -> if type(value) = :int {true -> if value = 0 {
                    true -> 'false', _ -> 'true'},
                    _ -> fail(state, 'PrintStream.print(boolean) requires an integer')}
                '(Ljava/lang/String;)V' -> if value = ? {true -> 'null',
                    _ -> if _string?(value) {true -> value.text,
                        _ -> fail(state, 'PrintStream.print(String) requires a String')}}
                '(Ljava/lang/Object;)V' -> if value = ? {true -> 'null',
                    _ -> if _string?(value) {true -> value.text,
                        _ -> if type(value) = :object &
                            (value.className = 'java/lang/StringBuilder' |
                                value.className = 'java/lang/StringBuffer') {
                            true -> value.text
                            _ -> fail(state, 'PrintStream.print(Object) cannot model this toString')
                        }
                    }
                }
                _ -> fail(state, 'unsupported PrintStream descriptor')
            }
            if state.error = ? {
                true -> {
                    suffix := if name = 'println' {true -> '\n', _ -> ''}
                    if len(state.output) + len(text) + len(suffix) > 4194304 {
                        true -> fail(state, 'JVM output exceeds 4 MiB limit')
                        _ -> state.output <- state.output + text + suffix
                    }
                }
            }
			?
		}
		_ -> fail(state, 'invalid PrintStream call')
	}
	'java/lang/StringBuilder', 'java/lang/StringBuffer' -> if recv.className = owner {
		true -> if name {
            '<init>' -> if len(args) = 1 {
                true -> if !_string?(args.(0)) {
                    true -> fail(state, owner + ' constructor requires a String')
                    _ -> if len(args.(0).text) > 4194304 {
                        true -> fail(state, 'JVM text builder exceeds 4 MiB limit')
                        _ -> recv.text <- args.(0).text
                    }
                }
            }
			'append' -> {
                part := if args.(0) = ? {true -> 'null',
                    _ -> if type(args.(0)) = :int {true -> string(args.(0)),
                        _ -> if _string?(args.(0)) {true -> args.(0).text,
                            _ -> fail(state, 'StringBuilder.append requires an int or String')}}}
                if state.error = ? -> if len(recv.text) + len(part) > 4194304 {
                    true -> fail(state, 'JVM text builder exceeds 4 MiB limit')
                    _ -> {
				    recv.text <- recv.text + part
				    recv
                    }
                }
			}
			'toString' -> _newString(state, recv.text)
			_ -> fail(state, 'unsupported StringBuilder method')
		}
		_ -> fail(state, 'StringBuilder method on non-builder')
	}
    'java/awt/Color' -> if recv.className = owner & name = '<init>' & desc = '(III)V' {
        true -> {
            if args |> std.some(fn(n) n < 0 | n > 255) {
                true -> fail(state, 'AWT Color component outside 0..255')
                _ -> {
                    recv.red <- args.(0)
                    recv.green <- args.(1)
                    recv.blue <- args.(2)
                    ?
                }
            }
        }
        _ -> fail(state, 'invalid AWT Color call')
    }
    'java/awt/Point' -> if !_point?(recv) {
        true -> fail(state, 'AWT Point method on non-Point receiver')
        _ -> if spec.op {
            'point-init' -> ? // new already prepared both int fields as zero
            'point-init-xy', 'point-move' -> if !_int32?(args.(0)) |
                !_int32?(args.(1)) {
                true -> fail(state, 'AWT Point requires int32 coordinates')
                _ -> {
                    recv.fields.(_pointKey('x')) <- args.(0)
                    recv.fields.(_pointKey('y')) <- args.(1)
                    ?
                }
            }
            'point-init-copy' -> if !_point?(args.(0)) {
                true -> fail(state, 'AWT Point copy requires a Point')
                _ -> {
                    recv.fields.(_pointKey('x')) <- args.(0).fields.(_pointKey('x'))
                    recv.fields.(_pointKey('y')) <- args.(0).fields.(_pointKey('y'))
                    ?
                }
            }
            'point-copy' -> _newPoint(state, recv.fields.(_pointKey('x')),
                recv.fields.(_pointKey('y')))
            'point-equals' -> if _point?(args.(0)) &
                recv.fields.(_pointKey('x')) = args.(0).fields.(_pointKey('x')) &
                recv.fields.(_pointKey('y')) = args.(0).fields.(_pointKey('y')) {
                true -> 1, _ -> 0
            }
            _ -> fail(state, 'unsupported AWT Point method ' + name + desc)
        }
    }
    'java/awt/Graphics' -> if recv.className = owner {
        true -> if name {
            'setColor' -> if args.(0) = ? | args.(0).className != 'java/awt/Color' {
                true -> fail(state, 'invalid AWT setColor argument')
                _ -> recv.color <- args.(0)
            }
            'fillRect' -> if args.(2) > 0 & args.(3) > 0 {
                true -> draw(state, {type: :rect, x: args.(0), y: args.(1), width: args.(2), height: args.(3), color: awtCSS(recv.color)})
            }
            'drawLine' -> draw(state, {type: :line, x1: args.(0), y1: args.(1), x2: args.(2), y2: args.(3), color: awtCSS(recv.color)})
            'drawString' -> if !_string?(args.(0)) {
                true -> fail(state, 'AWT Graphics.drawString requires a String')
                _ -> draw(state, {type: :text, text: args.(0).text,
                    x: args.(1), y: args.(2), color: awtCSS(recv.color)})
            }
            _ -> fail(state, 'unsupported AWT Graphics call ' + name)
        }
        _ -> fail(state, 'AWT Graphics method on non-Graphics')
    }
	_ -> fail(state, 'unsupported host method ' + owner + '.' + name + desc)
}

fn _findMethod(program, owner, name, desc) {
	cls := program.classes.(owner)
	if cls = ? {
		true -> ?
		_ -> if found := cls.methods.(methodKey(name, desc)) {
			? -> if classParent(cls) = ? {true -> ?, _ -> _findMethod(program, classParent(cls), name, desc)}
			_ -> {owner: owner, method: found}
		}
	}
}

fn execute(program, owner, name, desc, args, recv, state) if {
	state.error != ? -> ?
	state.depth >= state.maxDepth -> fail(state, 'maximum Java call depth exceeded')
	_ -> _execute(program, owner, name, desc, args, recv, state)
}
fn _execute(program, owner, name, desc, args, recv, state) {
	state.depth <- state.depth - (0 - 1)
	found := _findMethod(program, owner, name, desc)
	if found = ? {
		true -> {
			state.depth <- state.depth - 1
			fail(state, 'method not compiled: ' + owner + '.' + name + desc)
		}
		_ -> {
			method := found.method
			locals := range(method.locals) |> map(fn(_) ?)
			isStatic? := method.static?
			base := if isStatic? {true -> 0, _ -> 1}
			if !isStatic? -> locals.(0) <- recv
			args |> std.each(fn(arg, i) locals.(base + i) <- arg)
			stack := []
			sp := 0
			result := ?
			done? := false

			fn push(value) if sp >= method.stack + 2 {
				true -> fail(state, 'operand stack overflow')
				_ -> {
					stack.(sp) <- value
					sp <- sp + 1
				}
			}
			fn pop() if sp <= 0 {
				true -> fail(state, 'operand stack underflow')
				_ -> {
					sp <- sp - 1
					stack.(sp)
				}
			}
			fn local(index) if index < 0 | index >= len(locals) {
				true -> fail(state, 'invalid local variable index')
				_ -> locals.(index)
			}
			fn setLocal(index, value) if index < 0 | index >= len(locals) {
				true -> fail(state, 'invalid local variable index')
				_ -> locals.(index) <- value
			}
			fn arrayValues(array) if array = ? {
				true -> fail(state, 'null array reference')
                _ -> if type(array) != :object | type(array.values) != :list |
                    type(array.className) != :string {
                    true -> fail(state, 'invalid array reference')
                    _ -> if !str.startsWith?(array.className, '[') {
                        true -> fail(state, 'invalid array reference')
                        _ -> array.values
                    }
                }
			}
            fn arrayKind?(array, op) if op {
                46, 79 -> array.tag = 10                  // int[]
                50, 83 -> type(array.tag) = :string     // reference[]
                51, 84 -> array.tag = 4 | array.tag = 8 // boolean[]/byte[]
                52, 85 -> array.tag = 5                  // char[]
                53, 86 -> array.tag = 9                  // short[]
                _ -> false
            }
			fn arrayGet(array, index) {
				vals := arrayValues(array)
				if vals = ? {true -> ?, _ -> if index < 0 | index >= len(vals) {
					true -> fail(state, 'array index out of bounds')
					_ -> vals.(index)
				}}
			}
			fn arraySet(array, index, value) {
				vals := arrayValues(array)
				if vals != ? -> if index < 0 | index >= len(vals) {
					true -> fail(state, 'array index out of bounds')
					_ -> vals.(index) <- value
				}
			}
			fn call(op, argc, ref) {
				argv := range(argc) |> map(fn(_) ?)
				fn gather(i) if i >= 0 {
					true -> {
						argv.(i) <- pop()
						gather(i - 1)
					}
				}
				gather(argc - 1)
				object := if op = 184 {true -> ?, _ -> pop()}
				if op != 184 & object = ? -> fail(state, 'null method receiver')
				if state.error = ? {
					true -> {
						owner := ref.(0)
						mname := ref.(1)
						mdesc := ref.(2)
                        if op = 185 & !_isInstance(program, object, owner) ->
                            fail(state, 'invalid invokeinterface receiver for ' + owner)
                        if op = 184 -> initializeClass(program, owner, state)
						value := if state.error != ? {true -> ?, _ -> if mname = 'getParameter' & mdesc = '(Ljava/lang/String;)Ljava/lang/String;' &
                            _isInstance(program, object, 'java/applet/Applet') &
							_findMethod(program, owner, mname, mdesc) = ? {
							true -> if _string?(argv.(0)) {
                                true -> state.params.(argv.(0).text)
                                _ -> fail(state, 'getParameter requires a String key')
                            }
							_ -> if program.classes.(owner) = ? {
								true -> _hostCall(program, owner, mname, mdesc, op, object, argv, state)
                                _ -> {
                                    dynamicOwner := owner
                                    if (op = 182 | op = 185) & type(object) = :object {
                                        true -> if program.classes.(object.className) != ? ->
                                            dynamicOwner <- object.className
                                    }
                                    execute(program, dynamicOwner, mname, mdesc, argv, object, state)
                                }
							}
						}
                        }
						if !isVoid?(mdesc) & state.error = ? -> push(value)
					}
				}
			}
			fn tick(pc) if done? | state.error != ? {
				true -> result
				_ -> if pc < 0 | pc >= len(method.code) {
					true -> fail(state, 'program counter out of bounds in ' + owner + '.' + name)
					_ -> if state.steps >= state.maxSteps {
						true -> fail(state, 'applet instruction budget exceeded')
						_ -> {
							state.steps <- state.steps + 1
							inst := method.code.(pc)
							op := inst.(0)
							arg := inst.(1)
							ref := inst.(2)
							next := pc + 1
							if op {
								0 -> ? // nop
								1 -> push(?) // aconst_null
								2, 3, 4, 5, 6, 7, 8 -> push(op - 3)
								16, 17 -> push(arg)
                                18, 19 -> if type(arg) = :string {
                                    true -> push(_internString(state, arg))
                                    _ -> push(arg)
                                }
								21, 25, 54, 58 -> if op = 21 | op = 25 {true -> push(local(arg)), _ -> setLocal(arg, pop())}
								26, 27, 28, 29 -> push(local(op - 26))
								42, 43, 44, 45 -> push(local(op - 42))
								59, 60, 61, 62 -> setLocal(op - 59, pop())
								75, 76, 77, 78 -> setLocal(op - 75, pop())
								87 -> pop()
								89 -> {
									top := pop()
									push(top)
									push(top)
								}
                                // All admitted descriptors and constants are
                                // category-one values; two-slot primitives
                                // remain rejected by the decoder.
                                90 -> {
                                    first := pop()
                                    second := pop()
                                    if state.error = ? {
                                        true -> {
                                            push(first)
                                            push(second)
                                            push(first)
                                        }
                                    }
                                }
                                91 -> {
                                    first := pop()
                                    second := pop()
                                    third := pop()
                                    if state.error = ? {
                                        true -> {
                                            push(first)
                                            push(third)
                                            push(second)
                                            push(first)
                                        }
                                    }
                                }
                                92 -> {
                                    first := pop()
                                    second := pop()
                                    if state.error = ? {
                                        true -> {
                                            push(second)
                                            push(first)
                                            push(second)
                                            push(first)
                                        }
                                    }
                                }
								96, 100, 104, 108, 112, 126, 128, 130, 120, 122, 124 -> {
									b := pop()
									a := pop()
									if state.error = ? -> if op {
										96 -> push(i32(a + b))
										100 -> push(i32(a - b))
										104 -> push(i32(a * b))
										108, 112 -> if b = 0 {
											true -> fail(state, 'division by zero')
											_ -> if op = 108 {
												true -> push(i32(truncDiv(a, b)))
												_ -> push(i32(a - truncDiv(a, b) * b))
											}
										}
										126 -> push(i32(a & b))
										128 -> push(i32(a | b))
										130 -> push(i32(a ^ b))
										120 -> push(i32(a << (b & 31)))
										122 -> push(i32(a >> (b & 31)))
										124 -> push(i32((a & 4294967295) >> (b & 31)))
									}
								}
								116 -> push(i32(0 - pop()))
								132 -> setLocal(arg, i32(local(arg) + ref))
                                196 -> if type(ref) = :list & len(ref) = 2 &
                                    type(arg) = :int & type(ref.(0)) = :int {
                                    true -> if ref.(0) {
                                        21, 25 -> push(local(arg))
                                        54, 58 -> setLocal(arg, pop())
                                        132 -> {
                                            value := local(arg)
                                            if state.error = ? {
                                                true -> if type(value) != :int |
                                                    type(ref.(1)) != :int {
                                                    true -> fail(state,
                                                        'wide iinc requires an integer local')
                                                    _ -> setLocal(arg, i32(value + ref.(1)))
                                                }
                                            }
                                        }
                                        _ -> fail(state, 'invalid wide local operation')
                                    }
                                    _ -> fail(state, 'invalid wide local operation')
                                }
                                145, 146, 147 -> {
                                    original := pop()
                                    if state.error = ? {
                                        true -> if type(original) != :int {
                                            true -> fail(state, 'integer narrowing requires an int')
                                            _ -> {
                                                bits := original & if op = 145 {true -> 255,
                                                    _ -> 65535}
                                                if op = 145 & bits >= 128 -> bits <- bits - 256
                                                if op = 147 & bits >= 32768 -> bits <- bits - 65536
                                                push(bits)
                                            }
                                        }
                                    }
                                }
								153, 154, 155, 156, 157, 158 -> {
									v := pop()
									matches? := if op {
										153 -> v = 0
										154 -> v != 0
										155 -> v < 0
										156 -> v >= 0
										157 -> v > 0
										158 -> v <= 0
									}
									if matches? -> next <- arg
								}
								159, 160, 161, 162, 163, 164 -> {
									b := pop()
									a := pop()
									matches? := if op {
										159 -> a = b
										160 -> a != b
										161 -> a < b
										162 -> a >= b
										163 -> a > b
										164 -> a <= b
									}
									if matches? -> next <- arg
								}
                                165, 166 -> {
                                    right := pop()
                                    left := pop()
                                    if state.error = ? {
                                        true -> {
                                            rid := _referenceId(right, state)
                                            lid := _referenceId(left, state)
                                            if state.error = ? & ((op = 165 & lid = rid) |
                                                (op = 166 & lid != rid)) -> next <- arg
                                        }
                                    }
                                }
								167 -> next <- arg
                                170, 171 -> {
                                    value := pop()
                                    if state.error = ? {
                                        true -> if type(value) != :int | type(ref) != :list |
                                            (op = 170 & len(ref) < 1) |
                                            (op = 171 & len(ref) % 2 != 0) {
                                            true -> fail(state, 'invalid integer switch')
                                            _ -> if op = 170 {
                                                true -> {
                                                    slot := value - ref.(0) + 1
                                                    next <- if slot >= 1 & slot < len(ref) {
                                                        true -> ref.(slot), _ -> arg}
                                                }
                                                _ -> {
                                                    // Strictly increasing keys were checked by
                                                    // the bytecode decoder. Binary search avoids
                                                    // unmetered scans of large lookup tables.
                                                    fn lookup(lo, hi) if lo >= hi {
                                                        true -> arg
                                                        _ -> {
                                                            mid := int((lo + hi) / 2)
                                                            key := ref.(2 * mid)
                                                            if value = key {
                                                                true -> ref.(2 * mid + 1)
                                                                _ -> if value < key {
                                                                    true -> lookup(lo, mid)
                                                                    _ -> lookup(mid + 1, hi)
                                                                }
                                                            }
                                                        }
                                                    }
                                                    next <- lookup(0, int(len(ref) / 2))
                                                }
                                            }
                                        }
                                    }
                                }
								198 -> if pop() = ? -> next <- arg
								199 -> if pop() != ? -> next <- arg
								172, 176 -> {
									result <- pop()
									done? <- true
								}
								177 -> done? <- true
								178 -> if ref.(0) {
                    'java/lang/System' -> if vmLib.jvmField(ref.(0), ref.(1), ref.(2), 178) = ? {
                        true -> fail(state, 'unsupported JVM library field ' + ref.(0) + '.' + ref.(1))
                        _ -> {
                            if state.systemOut = ? -> state.systemOut <-
                                _tagRef(state, {className: 'java/io/PrintStream', fields: {}})
                            if state.error = ? -> push(state.systemOut)
                        }
                    }
                    'java/awt/Color' -> if vmLib.jvmField(ref.(0), ref.(1), ref.(2), 178) = ? {
                        true -> fail(state, 'unsupported JVM library field ' + ref.(0) + '.' + ref.(1))
                        _ -> push(namedColor(ref.(1), state))
                    }
                    _ -> if program.classes.(ref.(0)) = ? {
                        true -> fail(state, 'unsupported JVM library field ' + ref.(0) + '.' + ref.(1))
                        _ -> {
                            initializeClass(program, ref.(0), state)
                            if state.error = ? -> push(state.statics.(ref.(0)).(fieldKey(ref.(0), ref.(1), ref.(2))))
                        }
                    }
                }
									179 -> if program.classes.(ref.(0)) = ? {
                        true -> fail(state, 'unsupported JVM library field ' + ref.(0) + '.' + ref.(1))
                        _ -> {
                            initializeClass(program, ref.(0), state)
                            if state.error = ? -> state.statics.(ref.(0)).(fieldKey(ref.(0), ref.(1), ref.(2))) <- pop()
                        }
                    }
								180 -> {
									obj := pop()
                                    if obj = ? {
                                        true -> fail(state, 'null field receiver')
                                        _ -> if ref.(0) = 'java/awt/Point' {
                                            true -> if vmLib.jvmField(ref.(0), ref.(1), ref.(2), 180) = ? |
                                                !_point?(obj) {
                                                true -> fail(state, 'invalid AWT Point field read')
                                                _ -> {
                                                    value := obj.fields.(_pointKey(ref.(1)))
                                                    if _int32?(value) {true -> push(value),
                                                        _ -> fail(state, 'invalid AWT Point coordinate')}
                                                }
                                            }
