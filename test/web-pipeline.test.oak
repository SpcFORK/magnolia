wp := import('web-pipeline')

fn run(t) {
	// Module exports — verify all expected functions exist
	'web-pipeline exports WebPipeline function' |> t.eq(
		type(wp.WebPipeline)
		:function
	)

	'web-pipeline exports createContext function' |> t.eq(
		type(wp.createContext)
		:function
	)

	'web-pipeline exports loadResource function' |> t.eq(
		type(wp.loadResource)
		:function
	)

	'web-pipeline exports fetchText function' |> t.eq(
		type(wp.fetchText)
		:function
	)

	'web-pipeline exports fetchJson function' |> t.eq(
		type(wp.fetchJson)
		:function
	)

	'web-pipeline exports loadShader function' |> t.eq(
		type(wp.loadShader)
		:function
	)

	'web-pipeline exports loadProgram function' |> t.eq(
		type(wp.loadProgram)
		:function
	)

	'web-pipeline exports destroyContext function' |> t.eq(
		type(wp.destroyContext)
		:function
	)

	'web-pipeline exports pipelineResources function' |> t.eq(
		type(wp.pipelineResources)
		:function
	)

	'web-pipeline exports Opcode object' |> t.eq(
		type(wp.Opcode)
		:object
	)

	'web-pipeline exports CloseCode object' |> t.eq(
		type(wp.CloseCode)
		:object
	)

	'web-pipeline exports DefaultContextAttrs object' |> t.eq(
		type(wp.DefaultContextAttrs)
		:object
	)

	// Platform detection — on native Oak all should be false/detectable
	'isWeb? returns false on native Oak' |> t.eq(
		wp.isWeb?()
		false
	)

	'isNode? returns false on native Oak' |> t.eq(
		wp.isNode?()
		false
	)

	'isBrowser? returns false on native Oak' |> t.eq(
		wp.isBrowser?()
		false
	)

	// DefaultContextAttrs values
	'DefaultContextAttrs.alpha is true' |> t.eq(
		wp.DefaultContextAttrs.alpha
		true
	)

	'DefaultContextAttrs.depth is true' |> t.eq(
		wp.DefaultContextAttrs.depth
		true
	)

	'DefaultContextAttrs.stencil is false' |> t.eq(
		wp.DefaultContextAttrs.stencil
		false
	)

	'DefaultContextAttrs.preserveDrawingBuffer is false' |> t.eq(
		wp.DefaultContextAttrs.preserveDrawingBuffer
		false
	)

	// WebSocket constants
	'Opcode.text equals 1' |> t.eq(
		wp.Opcode.text
		1
	)

	'Opcode.binary equals 2' |> t.eq(
		wp.Opcode.binary
		2
	)

	'CloseCode.normal equals 1000' |> t.eq(
		wp.CloseCode.normal
		1000
	)

	'CloseCode.goingAway equals 1001' |> t.eq(
		wp.CloseCode.goingAway
		1001
	)

	// createContext on non-web backend returns error
	'createContext returns error on non-web backend' |> t.eq(
		wp.createContext({ type: :ok, backend: :native }, {}).type
		:error
	)

	// WebPipeline on non-web backend returns error context
	'WebPipeline stores error context on non-web backend' |> t.eq(
		wp.WebPipeline({ type: :ok, backend: :native }, {}).context.type
		:error
	)

	'WebPipeline isReady? returns false on non-web backend' |> t.eq(
		wp.WebPipeline({ type: :ok, backend: :native }, {}).isReady?()
		false
	)

	// loadResource on failed HTTP request returns Thenable with error value
	'loadResource returns error on connection refused' |> t.eq(
		wp.loadResource('http://127.0.0.1:1/nonexistent').value.type
		:error
	)

	// fetchText on failed HTTP request returns error Thenable
	'fetchText returns error on connection refused' |> t.eq(
		wp.fetchText('http://127.0.0.1:1/nonexistent').value.type
		:error
	)

	// destroyContext on error context is a no-op (returns ctx as-is or ?)
	'destroyContext on error context does not panic' |> t.eq(
		{
			errCtx := wp.createContext({ type: :ok, backend: :native }, {})
			result := wp.destroyContext(errCtx)
			result.type
		}
		:error
	)

	// WebPipeline has all expected methods
	'WebPipeline has load method' |> t.eq(
		type(wp.WebPipeline({ type: :ok, backend: :native }, {}).load)
		:function
	)

	'WebPipeline has fetchText method' |> t.eq(
		type(wp.WebPipeline({ type: :ok, backend: :native }, {}).fetchText)
		:function
	)

	'WebPipeline has fetchJson method' |> t.eq(
		type(wp.WebPipeline({ type: :ok, backend: :native }, {}).fetchJson)
		:function
	)

	'WebPipeline has beginFrame method' |> t.eq(
		type(wp.WebPipeline({ type: :ok, backend: :native }, {}).beginFrame)
		:function
	)

	'WebPipeline has endFrame method' |> t.eq(
		type(wp.WebPipeline({ type: :ok, backend: :native }, {}).endFrame)
		:function
	)

	'WebPipeline has runFrameLoop method' |> t.eq(
		type(wp.WebPipeline({ type: :ok, backend: :native }, {}).runFrameLoop)
		:function
	)

	'WebPipeline has stopFrameLoop method' |> t.eq(
		type(wp.WebPipeline({ type: :ok, backend: :native }, {}).stopFrameLoop)
		:function
	)

	'WebPipeline has destroy method' |> t.eq(
		type(wp.WebPipeline({ type: :ok, backend: :native }, {}).destroy)
		:function
	)

	'WebPipeline has connectWebSocket method' |> t.eq(
		type(wp.WebPipeline({ type: :ok, backend: :native }, {}).connectWebSocket)
		:function
	)
}
