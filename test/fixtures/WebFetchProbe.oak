// Uses an injected fake fetch host; never makes a network request.
std := import('std')
json := import('json')
req({method: 'POST', url: 'https://example.invalid/café/🦉',
    body: '\x00\x7f\x80\xff'}, fn(evt) {
    std.println(json.serialize([string(evt.type), evt.resp.status, bits(evt.resp.body)]))
})
