// Test-only template: oracle substitutes one quoted loopback URL and mode.
// The server is a private local test fixture, never an external network host.
std := import('std')
json := import('json')
url := '__ORACLE_URL__'
mode := '__ORACLE_MODE__'
fn observe(evt) if evt.type {
    :resp -> std.println(json.serialize(['resp', evt.resp.status, bits(evt.resp.body)]))
    _ -> std.println(json.serialize(['error']))
}
data := {method: 'POST', url: url, headers: {'X-Probe': 'binary-check'},
    body: '\x00\x7f\x80\xff'}
if mode {
    'async' -> req(data, observe)
    'sync' -> observe(req(data))
}
