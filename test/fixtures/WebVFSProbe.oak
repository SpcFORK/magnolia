// Built with --includeVFS; the browser reads no host filesystem.
std := import('std')
fs := import('fs')
json := import('json')
path := 'café-🦉.bin'
data := fs.readFile(path)
info := fs.statFile(path)
items := fs.listFiles('.')
subitems := fs.listFiles('内')
inner := fs.readFile('内/other.bin')
if data = ? | info = ? | type(items) != :list | len(items) != 2 |
    type(subitems) != :list | len(subitems) != 1 | inner = ? -> {
    std.println('VFS REFUSED')
    exit(1)
}
foundFile := items |> std.some(fn(x) x.name = path & !x.dir)
foundDir := items |> std.some(fn(x) x.name = '内' & x.dir)
std.println(json.serialize([bits(data), info.len, foundFile, foundDir,
    bits(subitems.(0).name), subitems.(0).dir, bits(inner)]))
