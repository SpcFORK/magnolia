// Owned PCM probe used by tools/audio-pcm-ogg-oracle.py; no external media.
fs := import('fs')
cli := import('cli').parse()
audio := import('audio')
fs.writeFile(cli.opts.wav, audio.wav([-1.0, 0.0, 1.0], 8000, 1, 8))
fs.writeFile(cli.opts.ogg, audio.ogg([0.5, -0.5], 44100, 1, 16))
fs.writeFile(cli.opts.aiff, audio.aiff([0.5, -0.5], 44100, 1, 16))
