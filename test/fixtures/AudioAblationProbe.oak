// Owned tiny PCM/WAV boundary probe. No device playback.
// The Python runner supplies a new output path and inspects it with wave.
std := import('std')
fs := import('fs')
audio := import('audio')
opts := import('cli').parse().opts
if opts.out = ? | fs.readFile(opts.out) != ? {
    true -> {
        std.println('REFUSED audio output path')
        exit(2)
    }
}
raw := audio.wav([-1.0, 0.0, 1.0], 8000, 1, 8)
if type(raw) != :string {
    true -> {
        std.println('REFUSED WAV encoder unavailable')
        exit(2)
    }
}
if fs.writeFile(opts.out, raw) = ? {
    true -> {
        std.println('REFUSED WAV output failed')
        exit(2)
    }
}
std.println('PASS WAV 8-bit 3 samples')
