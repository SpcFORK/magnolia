// Run only in an isolated empty working directory; deletes its own test folder.
std := import('std')
fs := import('fs')
json := import('json')
dir := 'tèst-猫'
file := 'café-🦉.bin'
path := dir + '/' + file
made := mkdir(dir).type = :end
written := fs.writeFile(path, '\x00\x7f\x80\xff') = true
content := fs.readFile(path)
info := fs.statFile(path)
listing := fs.listFiles(dir)
first := if type(listing) = :list & len(listing) = 1 {true -> listing.(0).name, _ -> '?'}
arg := args().(2)
value := env().MAGNOLIA_WEB_TEXT
echo := exec('/usr/bin/printf', ['%s', 'é猫'], '')
cat := exec('/bin/cat', [], '\x00\x7f\x80\xff')
out := [made, written, bits(content), info.len, bits(info.name), bits(first),
    bits(arg), bits(value), echo.status, bits(echo.stdout), cat.status, bits(cat.stdout)]
removed := rm(dir).type = :end
out << removed
std.println(json.serialize(out))
