// Quick test
obj := import('obj')

// Test parse vertex only
model := obj.parse('v 1.0 2.0 3.0')
print('vertices count: ' + string(len(model.vertices)))

// Test encode
encoded := obj.encode(model)
print('encoded length: ' + string(len(encoded)))

// Test roundtrip
model2 := obj.parse(encoded)
print('roundtrip vertices: ' + string(len(model2.vertices)))

print('SUCCESS')