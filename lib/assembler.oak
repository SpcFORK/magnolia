// assembler -- Multi-architecture assembler for Magnolia
//
// Assembles textual assembly source (x86-64 and ARM64) into machine code
// bytes.  The x86-64 assembler parses a dst-first (Intel operand order)
// dialect: registers written with a '%' prefix (rax, r8), immediates with
// '$' or bare digits, memory operands as disp(base) like -8(%rbp).
// Supported mnemonics: mov (reg/imm/mem forms), add/or/and/sub/xor/cmp,
// not/neg, test, idiv, imul, cqo, leave, movzx, movsxd, shl/shr/sar,
// setcc, cmovcc, push/pop, call/jmp/jcc family, ret, nop, syscall, int3,
// hlt.  Labels end with ':'; branch targets resolve through rel32
// relocations after emission.
//
// Implementation notes:
//   - All state (code bytes, labels, relocations) is threaded as explicit
//     parameters through the emission routines — captured mutation is
//     unreliable at fn-in-fn-in-fn depth in this dialect.
//   - Match arms evaluate pattern expressions and compare them to the
//     matched value, so boolean helper calls cannot be arm patterns;
//     classification uses sequential arrow-ifs instead.
//
// This module is used by the native codegen target and can also be
// called directly from Oak programs for inline assembly or JIT scenarios.

{
	default: default
	map: map
	each: each
	slice: slice
	filter: filter
	reduce: reduce
	clone: clone
	append: append
	len: len
	range: range
	indexOf: indexOf
} := import('std')
{
	replace: replace
	contains?: strContains?
	join: join
	split: split
	trim: trim
	startsWith?: startsWith?
	endsWith?: endsWith?
	lower: lower
} := import('str')
{
	format: format
	printf: printf
} := import('fmt')

// ---------------------------------------------------------------------------
// Architecture constants
// ---------------------------------------------------------------------------

ARCH_X86_64 := :x86_64
ARCH_ARM64 := :arm64

// ---------------------------------------------------------------------------
// x86-64 register tables
// ---------------------------------------------------------------------------

x86_64Regs := {
	rax: 0, rcx: 1, rdx: 2, rbx: 3, rsp: 4, rbp: 5, rsi: 6, rdi: 7
	r8: 8, r9: 9, r10: 10, r11: 11, r12: 12, r13: 13, r14: 14, r15: 15
	eax: 0, ecx: 1, edx: 2, ebx: 3, esp: 4, ebp: 5, esi: 6, edi: 7
	al: 0, cl: 1, dl: 2, bl: 3, spl: 4, bpl: 5, sil: 6, dil: 7
	r8d: 8, r9d: 9, r10d: 10, r11d: 11, r12d: 12, r13d: 13, r14d: 14, r15d: 15
	r8b: 8, r9b: 9, r10b: 10, r11b: 11, r12b: 12, r13b: 13, r14b: 14, r15b: 15
}

// ---------------------------------------------------------------------------
// ARM64 register tables
// ---------------------------------------------------------------------------

arm64Regs := {}
// x0-x30, sp(31), xzr(31)
fn _initARM64Regs() {
	range(31) |> each(fn(i) {
		arm64Regs.('x' + string(i)) <- i
		arm64Regs.('w' + string(i)) <- i
	})
	arm64Regs.sp <- 31
	arm64Regs.xzr <- 31
	arm64Regs.wzr <- 31
}
_initARM64Regs()

// ---------------------------------------------------------------------------
// Token types for assembly lexer
// ---------------------------------------------------------------------------

TOK_LABEL    := :label       // "name:"
TOK_MNEMONIC := :mnemonic    // "mov", "add", etc.
TOK_REG      := :register    // "%rax" or "rax"
TOK_IMM      := :immediate   // "$42" or "#42" or "42"
TOK_MEM      := :memory      // "(%rax)" or "[x0, #8]"
TOK_SYMBOL   := :symbol      // reference to a label/symbol
TOK_COMMA    := :comma       // ","
TOK_NEWLINE  := :newline
TOK_COMMENT  := :comment     // ";" or "//" or "#"
TOK_DIRECTIVE := :directive  // ".text", ".data", ".global"

// ---------------------------------------------------------------------------
// Assembly lexer
// ---------------------------------------------------------------------------

fn tokenizeAsm(source) {
	tokens := []
	lines := source |> split('\n')

	lines |> each(fn(line) {
		line <- line |> trim()

		// Skip empty lines and comments
		if line = '' -> ()
		if startsWith?(line, ';') | startsWith?(line, '//') | startsWith?(line, '#') {
			true -> tokens << { type: TOK_COMMENT, val: line }
			_ -> {
				// Split by whitespace and commas
				parts := line |> split(' ')
				parts |> each(fn(part, idx) {
					part <- part |> trim() |> replace('\t', '')
					if part = '' -> ()
					// classify part into a kind for dispatch.
					// NOTE: match arms evaluate pattern expressions and compare
					// them to the matched value, so boolean helper calls cannot
					// be arm patterns — sequential arrow-ifs instead.
					kind := 'other'
					if part = ',' -> kind <- 'comma'
					if endsWith?(part, ':') -> kind <- 'label'
					if startsWith?(part, '.') -> kind <- 'directive'
					if startsWith?(part, '$') | startsWith?(part, '#') -> kind <- 'imm'
					if startsWith?(part, '%') -> kind <- 'reg'
					if startsWith?(part, '-') | startsWith?(part, '0') | startsWith?(part, '1') | startsWith?(part, '2') | startsWith?(part, '3') | startsWith?(part, '4') | startsWith?(part, '5') | startsWith?(part, '6') | startsWith?(part, '7') | startsWith?(part, '8') | startsWith?(part, '9') -> kind <- 'imm'
					// memory operands last: -8(%rbp) also matches the '-' check
					if strContains?(part, '(') -> kind <- 'mem'
					if kind {
						'comma' -> tokens << { type: TOK_COMMA, val: ',' }
						'label' -> tokens << { type: TOK_LABEL, val: slice(part, 0, len(part) - 1) }
						'directive' -> tokens << { type: TOK_DIRECTIVE, val: part }
						'mem' -> tokens << { type: TOK_MEM, val: part }
						'imm' -> tokens << { type: TOK_IMM, val: part }
						'reg' -> tokens << { type: TOK_REG, val: part |> replace('%', '') |> replace(',', '') }
						_ -> {
							if idx = 0 {
								true -> tokens << { type: TOK_MNEMONIC, val: part |> lower() }
								_ -> {
									// Could be register, immediate, or symbol
									cleanPart := part |> replace(',', '')
									if x86_64Regs.(cleanPart) != ? | arm64Regs.(cleanPart) != ? {
										true -> tokens << { type: TOK_REG, val: cleanPart }
										_ -> {
											// Try parsing as number
											tokens << { type: TOK_SYMBOL, val: cleanPart }
										}
									}
								}
							}
						}
					}
				})
			}
		}
		tokens << { type: TOK_NEWLINE, val: '\n' }
	})

	tokens
}

// ---------------------------------------------------------------------------
// x86-64 assembler
// ---------------------------------------------------------------------------

fn assembleX86_64(source) {
	tokens := tokenizeAsm(source)
	code := []
	labels := {}
	relocs := []

	// Helper to emit bytes (list passed explicitly — captured mutation is
	// unreliable at fn-in-fn-in-fn depth, so all state is threaded as params)
	fn emitByte(lst, b) lst << (b & 255)
	fn emitDword(lst, d) {
		emitByte(lst, d & 255)
		emitByte(lst, (d >> 8) & 255)
		emitByte(lst, (d >> 16) & 255)
		emitByte(lst, (d >> 24) & 255)
	}
	fn emitQword(lst, q) {
		emitDword(lst, q & 4294967295)
		emitDword(lst, (q >> 32) & 4294967295)
	}

	fn regNum(name) {
		clean := name |> replace('%', '') |> replace(',', '') |> lower()
		x86_64Regs.(clean) |> default(0)
	}
	fn rexW(r, b) 0x48 | (if r > 7 { true -> 4, _ -> 0 }) | (if b > 7 { true -> 1, _ -> 0 })
	fn modRM(mod, reg, rm) ((mod & 3) << 6) | ((reg & 7) << 3) | (rm & 7)
	fn parseImm(val) {
		clean := val |> replace('$', '') |> replace('#', '') |> replace(',', '')
		int(clean)
	}

	// operand kinds: 0 = register, 1 = immediate, 2 = memory, 3 = symbol
	fn parseMem(tok) {
		parts := tok.val |> split('(')
		dispPart := parts.(0) |> trim()
		disp := 0
		if dispPart != '' {
			true -> disp <- parseImm(dispPart)
		}
		inner := '?'
		if len(parts) > 1 {
			true -> inner <- parts.(1) |> split(')') |> slice(0, 1) |> join('') |> trim() |> replace('%', '') |> lower()
		}
		{
			disp: disp
			base: x86_64Regs.(inner) |> default(-1)
			sib?: inner = 'rsp' | inner = 'esp'
		}
	}
	fn classifyOp(tok) if tok.type {
		TOK_REG -> { kind: 0, reg: regNum(tok.val) }
		TOK_IMM -> { kind: 1, val: parseImm(tok.val) }
		TOK_MEM -> { kind: 2, mem: parseMem(tok) }
		_ -> { kind: 3, val: tok.val }
	}
	fn oneOp(tokens, i) if tokens.(i).type = TOK_COMMA {
		true -> { op: classifyOp(tokens.(i + 1)), next: i + 2 }
		_ -> { op: classifyOp(tokens.(i)), next: i + 1 }
	}
	fn twoOps(tokens, i) {
		a := oneOp(tokens, i)
		b := oneOp(tokens, a.next)
		{ a: a.op, b: b.op, next: b.next }
	}
	// mod bits for a displacement: 0 when none needed, 1 for disp8, 2 for disp32
	fn memMod(disp, base, sib) if disp = 0 & base != 5 & !sib {
		true -> 0
		_ -> if -128 <= disp & disp <= 127 {
			true -> 1
			_ -> 2
		}
	}
	// emit modrm + sib + displacement for a memory operand with the given
	// reg field (register-to-memory direction handled by the opcode)
	fn emitMemOperand(lst, regField, mem) {
		mBase := mem.base
		disp := mem.disp
		if mBase = -1 {
			true -> {
				emitByte(lst, modRM(0, regField, 5))
				emitDword(lst, disp)
			}
			_ -> {
				mod := memMod(disp, mBase, mem.sib?)
				rm := if mem.sib? {
					true -> 4
					_ -> mBase
				}
				emitByte(lst, modRM(mod, regField, rm))
				if mem.sib? {
					true -> emitByte(lst, 0x24) // SIB: no index, base rsp
				}
				if mod = 1 {
					true -> emitByte(lst, disp & 255)
				}
				if mod = 2 {
					true -> emitDword(lst, disp)
				}
			}
		}
	}
	// emit a rel32 branch placeholder + relocation record
	fn emitRelBranch(lst, relocLst, opcodes, symbol) {
		opcodes |> each(fn(b) emitByte(lst, b))
		relocLst << { offset: len(lst), symbol: symbol, type: :rel32 }
		emitDword(lst, 0)
	}

	// Assemble one instruction: consumes operand tokens from i, appends
	// machine bytes to codeLst, relocation records to relocLst.
	// Returns { next: tokenIndexAfterInstruction }.
	fn assembleInstruction(mnemonic, tokens, i, codeLst, relocLst) if mnemonic {
		'nop' -> {
			emitByte(codeLst, 0x90)
			{ next: i }
		}
		'ret' -> {
			emitByte(codeLst, 0xC3)
			{ next: i }
		}
		'syscall' -> {
			emitByte(codeLst, 0x0F)
			emitByte(codeLst, 0x05)
			{ next: i }
		}
		'int3' -> {
			emitByte(codeLst, 0xCC)
			{ next: i }
		}
		'hlt' -> {
			emitByte(codeLst, 0xF4)
			{ next: i }
		}
		'push' -> {
			op := oneOp(tokens, i)
			if op.op.kind = 0 {
				true -> {
					r := op.op.reg
					if r > 7 -> emitByte(codeLst, 0x41)
					emitByte(codeLst, 0x50 + (r & 7))
				}
			}
			{ next: op.next }
		}
		'pop' -> {
			op := oneOp(tokens, i)
			if op.op.kind = 0 {
				true -> {
					r := op.op.reg
					if r > 7 -> emitByte(codeLst, 0x41)
					emitByte(codeLst, 0x58 + (r & 7))
				}
			}
			{ next: op.next }
		}
		// --- mov: dst,src with reg/imm/mem operands (Intel order) ---
		'mov' -> {
			ops := twoOps(tokens, i)
			if ops.a.kind = 0 & ops.b.kind = 0 {
				true -> {
					emitByte(codeLst, rexW(ops.b.reg, ops.a.reg))
					emitByte(codeLst, 0x89)
					emitByte(codeLst, modRM(3, ops.b.reg, ops.a.reg))
				}
			}
			if ops.a.kind = 0 & ops.b.kind = 1 {
				true -> {
					emitByte(codeLst, rexW(0, ops.a.reg))
					emitByte(codeLst, 0xB8 + (ops.a.reg & 7))
					emitQword(codeLst, ops.b.val)
				}
			}
			if ops.a.kind = 0 & ops.b.kind = 2 {
				true -> {
					emitByte(codeLst, rexW(ops.a.reg, ops.b.mem.base))
					emitByte(codeLst, 0x8B)
					emitMemOperand(codeLst, ops.a.reg, ops.b.mem)
				}
			}
			if ops.a.kind = 2 & ops.b.kind = 0 {
				true -> {
					emitByte(codeLst, rexW(ops.b.reg, ops.a.mem.base))
					emitByte(codeLst, 0x89)
					emitMemOperand(codeLst, ops.b.reg, ops.a.mem)
				}
			}
			if ops.a.kind = 2 & ops.b.kind = 1 {
				true -> {
					emitByte(codeLst, rexW(0, ops.a.mem.base))
					emitByte(codeLst, 0xC7)
					emitMemOperand(codeLst, 0, ops.a.mem)
					emitDword(codeLst, ops.b.val)
				}
			}
			{ next: ops.next }
		}
		// --- ALU family (Intel order: dst, src) ---
		'add', 'or', 'and', 'sub', 'xor', 'cmp' -> {
			ops := twoOps(tokens, i)
			base := if mnemonic {
				'add' -> 0x00
				'or' -> 0x08
				'and' -> 0x20
				'sub' -> 0x28
				'xor' -> 0x30
				_ -> 0x38
			}
			ext := if mnemonic {
				'add' -> 0
				'or' -> 1
				'and' -> 4
				'sub' -> 5
				'xor' -> 6
				_ -> 7
			}
			if ops.a.kind = 0 & ops.b.kind = 0 {
				true -> {
					emitByte(codeLst, rexW(ops.b.reg, ops.a.reg))
					emitByte(codeLst, base + 1)
					emitByte(codeLst, modRM(3, ops.b.reg, ops.a.reg))
				}
			}
			if ops.a.kind = 0 & ops.b.kind = 1 {
				true -> {
					emitByte(codeLst, rexW(0, ops.a.reg))
					emitByte(codeLst, 0x81)
					emitByte(codeLst, modRM(3, ext, ops.a.reg))
					emitDword(codeLst, ops.b.val)
				}
			}
			if ops.a.kind = 2 & ops.b.kind = 0 {
				true -> {
					emitByte(codeLst, rexW(ops.b.reg, ops.a.mem.base))
					emitByte(codeLst, base + 1)
					emitMemOperand(codeLst, ops.b.reg, ops.a.mem)
				}
			}
			if ops.a.kind = 0 & ops.b.kind = 2 {
				true -> {
					emitByte(codeLst, rexW(ops.a.reg, ops.b.mem.base))
					emitByte(codeLst, base + 3)
					emitMemOperand(codeLst, ops.a.reg, ops.b.mem)
				}
			}
			if ops.a.kind = 2 & ops.b.kind = 1 {
				true -> {
					emitByte(codeLst, rexW(0, ops.a.mem.base))
					emitByte(codeLst, 0x81)
					emitMemOperand(codeLst, ext, ops.a.mem)
					emitDword(codeLst, ops.b.val)
				}
			}
			{ next: ops.next }
		}
		// --- unary rm64 ops: not /2, neg /3 ---
		'not', 'neg' -> {
			op := oneOp(tokens, i)
			ext := if mnemonic {
				'not' -> 2
				_ -> 3
			}
			if op.op.kind = 0 {
				true -> {
					emitByte(codeLst, rexW(0, op.op.reg))
					emitByte(codeLst, 0xF7)
					emitByte(codeLst, modRM(3, ext, op.op.reg))
				}
			}
			if op.op.kind = 2 {
				true -> {
					emitByte(codeLst, rexW(0, op.op.mem.base))
					emitByte(codeLst, 0xF7)
					emitMemOperand(codeLst, ext, op.op.mem)
				}
			}
			{ next: op.next }
		}
		// --- test r/m64: reg,reg or reg,imm ---
		'test' -> {
			ops := twoOps(tokens, i)
			if ops.a.kind = 0 & ops.b.kind = 0 {
				true -> {
					emitByte(codeLst, rexW(ops.b.reg, ops.a.reg))
					emitByte(codeLst, 0x85)
					emitByte(codeLst, modRM(3, ops.b.reg, ops.a.reg))
				}
			}
			if ops.a.kind = 0 & ops.b.kind = 1 {
				true -> {
					emitByte(codeLst, rexW(0, ops.a.reg))
					emitByte(codeLst, 0xF7)
					emitByte(codeLst, modRM(3, 0, ops.a.reg))
					emitDword(codeLst, ops.b.val)
				}
			}
			{ next: ops.next }
		}
		// --- idiv r/m64 (signed; F7 /7 — /6 is the unsigned div) ---
		'idiv' -> {
			op := oneOp(tokens, i)
			if op.op.kind = 0 {
				true -> {
					emitByte(codeLst, rexW(0, op.op.reg))
					emitByte(codeLst, 0xF7)
					emitByte(codeLst, modRM(3, 7, op.op.reg))
				}
			}
			if op.op.kind = 2 {
				true -> {
					emitByte(codeLst, rexW(0, op.op.mem.base))
					emitByte(codeLst, 0xF7)
					emitMemOperand(codeLst, 7, op.op.mem)
				}
			}
			{ next: op.next }
		}
		// --- imul r64, r/m64 (two-operand form) ---
		'imul' -> {
			ops := twoOps(tokens, i)
			if ops.a.kind = 0 & ops.b.kind = 0 {
				true -> {
					emitByte(codeLst, rexW(ops.a.reg, ops.b.reg))
					emitByte(codeLst, 0x0F)
					emitByte(codeLst, 0xAF)
					emitByte(codeLst, modRM(3, ops.a.reg, ops.b.reg))
				}
			}
			{ next: ops.next }
		}
		'cqo', 'cqto' -> {
			emitByte(codeLst, 0x48)
			emitByte(codeLst, 0x99)
			{ next: i }
		}
		'leave' -> {
			emitByte(codeLst, 0xC9)
			{ next: i }
		}
		// --- movzx r64, r/m8 ---
		'movzx', 'movzbq' -> {
			ops := twoOps(tokens, i)
			if ops.a.kind = 0 & ops.b.kind = 0 {
				true -> {
					emitByte(codeLst, rexW(ops.a.reg, ops.b.reg))
					emitByte(codeLst, 0x0F)
					emitByte(codeLst, 0xB6)
					emitByte(codeLst, modRM(3, ops.a.reg, ops.b.reg))
				}
			}
			if ops.a.kind = 0 & ops.b.kind = 2 {
				true -> {
					emitByte(codeLst, rexW(ops.a.reg, ops.b.mem.base))
					emitByte(codeLst, 0x0F)
					emitByte(codeLst, 0xB6)
					emitMemOperand(codeLst, ops.a.reg, ops.b.mem)
				}
			}
			{ next: ops.next }
		}
		// --- movsxd r64, r/m32 ---
		'movsxd' -> {
			ops := twoOps(tokens, i)
			if ops.a.kind = 0 & ops.b.kind = 0 {
				true -> {
					emitByte(codeLst, rexW(ops.a.reg, ops.b.reg))
					emitByte(codeLst, 0x63)
					emitByte(codeLst, modRM(3, ops.a.reg, ops.b.reg))
				}
			}
			if ops.a.kind = 0 & ops.b.kind = 2 {
				true -> {
					emitByte(codeLst, rexW(ops.a.reg, ops.b.mem.base))
					emitByte(codeLst, 0x63)
					emitMemOperand(codeLst, ops.a.reg, ops.b.mem)
				}
			}
			{ next: ops.next }
		}
		// --- shift family: r/m64 by imm8 or cl ---
		'shl', 'shr', 'sar' -> {
			ops := twoOps(tokens, i)
			ext := if mnemonic {
				'shl' -> 6
				'shr' -> 5
				_ -> 7
			}
			if ops.a.kind = 0 & ops.b.kind = 1 {
				true -> {
					emitByte(codeLst, rexW(0, ops.a.reg))
					emitByte(codeLst, 0xC1)
					emitByte(codeLst, modRM(3, ext, ops.a.reg))
					emitByte(codeLst, ops.b.val & 63)
				}
			}
			if ops.a.kind = 0 & ops.b.kind = 0 {
				true -> {
					emitByte(codeLst, rexW(0, ops.a.reg))
					emitByte(codeLst, 0xD3)
					emitByte(codeLst, modRM(3, ext, ops.a.reg))
				}
			}
			if ops.a.kind = 2 & ops.b.kind = 1 {
				true -> {
					emitByte(codeLst, rexW(0, ops.a.mem.base))
					emitByte(codeLst, 0xC1)
					emitMemOperand(codeLst, ext, ops.a.mem)
					emitByte(codeLst, ops.b.val & 63)
				}
			}
			if ops.a.kind = 2 & ops.b.kind = 0 {
				true -> {
					emitByte(codeLst, rexW(0, ops.a.mem.base))
					emitByte(codeLst, 0xD3)
					emitMemOperand(codeLst, ext, ops.a.mem)
				}
			}
			{ next: ops.next }
		}
		// --- branches (rel32, resolved by relocations) ---
		'call' -> {
			op := oneOp(tokens, i)
			emitRelBranch(codeLst, relocLst, [0xE8], op.op.val)
			{ next: op.next }
		}
		'jmp' -> {
			op := oneOp(tokens, i)
			emitRelBranch(codeLst, relocLst, [0xE9], op.op.val)
			{ next: op.next }
		}
		'je', 'jz' -> {
			op := oneOp(tokens, i)
			emitRelBranch(codeLst, relocLst, [0x0F, 0x84], op.op.val)
			{ next: op.next }
		}
		'jne', 'jnz' -> {
			op := oneOp(tokens, i)
			emitRelBranch(codeLst, relocLst, [0x0F, 0x85], op.op.val)
			{ next: op.next }
		}
		'jl' -> {
			op := oneOp(tokens, i)
			emitRelBranch(codeLst, relocLst, [0x0F, 0x8C], op.op.val)
			{ next: op.next }
		}
		'jg' -> {
			op := oneOp(tokens, i)
			emitRelBranch(codeLst, relocLst, [0x0F, 0x8F], op.op.val)
			{ next: op.next }
		}
		'jle' -> {
			op := oneOp(tokens, i)
			emitRelBranch(codeLst, relocLst, [0x0F, 0x8E], op.op.val)
			{ next: op.next }
		}
		'jge' -> {
			op := oneOp(tokens, i)
			emitRelBranch(codeLst, relocLst, [0x0F, 0x8D], op.op.val)
			{ next: op.next }
		}
		'js' -> {
			op := oneOp(tokens, i)
			emitRelBranch(codeLst, relocLst, [0x0F, 0x88], op.op.val)
			{ next: op.next }
		}
		'jns' -> {
			op := oneOp(tokens, i)
			emitRelBranch(codeLst, relocLst, [0x0F, 0x89], op.op.val)
			{ next: op.next }
		}
		// --- setcc r/m8 ---
		'sete', 'setne', 'setl', 'setg', 'setle', 'setge', 'sets', 'setns' -> {
			op := oneOp(tokens, i)
			cc := if mnemonic {
				'sete' -> 0x94
				'setne' -> 0x95
				'setl' -> 0x9C
				'setg' -> 0x9F
				'setle' -> 0x9E
				'setge' -> 0x9D
				'sets' -> 0x98
				_ -> 0x99
			}
			if op.op.kind = 0 {
				true -> {
					emitByte(codeLst, 0x40 | (if op.op.reg > 7 { true -> 1, _ -> 0 }))
					emitByte(codeLst, 0x0F)
					emitByte(codeLst, cc)
					emitByte(codeLst, modRM(3, 0, op.op.reg))
				}
			}
			if op.op.kind = 2 {
				true -> {
					emitByte(codeLst, 0x40 | (if op.op.mem.base > 7 { true -> 1, _ -> 0 }))
					emitByte(codeLst, 0x0F)
					emitByte(codeLst, cc)
					emitMemOperand(codeLst, 0, op.op.mem)
				}
			}
			{ next: op.next }
		}
		// --- cmovcc r64, r/m64 ---
		'cmove', 'cmovne', 'cmovl', 'cmovg', 'cmovle', 'cmovge' -> {
			ops := twoOps(tokens, i)
			cc := if mnemonic {
				'cmove' -> 0x44
				'cmovne' -> 0x45
				'cmovl' -> 0x4C
				'cmovg' -> 0x4F
				'cmovle' -> 0x4E
				_ -> 0x4D
			}
			if ops.a.kind = 0 & ops.b.kind = 0 {
				true -> {
					emitByte(codeLst, rexW(ops.a.reg, ops.b.reg))
					emitByte(codeLst, 0x0F)
					emitByte(codeLst, cc)
					emitByte(codeLst, modRM(3, ops.a.reg, ops.b.reg))
				}
			}
			if ops.a.kind = 0 & ops.b.kind = 2 {
				true -> {
					emitByte(codeLst, rexW(ops.a.reg, ops.b.mem.base))
					emitByte(codeLst, 0x0F)
					emitByte(codeLst, cc)
					emitMemOperand(codeLst, ops.a.reg, ops.b.mem)
				}
			}
			{ next: ops.next }
		}
		_ -> { next: i }
	}

	// Main assembly loop (state threaded via params; label/directive handling
	// at the loop level keeps captured mutation out of deep recursion)
	fn assembleLoop(tokens, i, codeLst, labelTbl, relocLst) if i < len(tokens) {
		true -> {
			tok := tokens.(i)
			if tok.type {
				:label -> {
					labelTbl.(tok.val) <- len(codeLst)
					assembleLoop(tokens, i + 1, codeLst, labelTbl, relocLst)
				}
				:directive -> {
					if tok.val = '.global' | tok.val = '.globl' {
						true -> assembleLoop(tokens, i + 2, codeLst, labelTbl, relocLst)
						_ -> assembleLoop(tokens, i + 1, codeLst, labelTbl, relocLst)
					}
				}
				:mnemonic -> {
					res := assembleInstruction(tok.val, tokens, i + 1, codeLst, relocLst)
					assembleLoop(tokens, res.next, codeLst, labelTbl, relocLst)
				}
				_ -> assembleLoop(tokens, i + 1, codeLst, labelTbl, relocLst)
			}
		}
		_ -> ?
	}

	assembleLoop(tokens, 0, code, labels, relocs)

	// Resolve relocations
	relocs |> each(fn(rel) {
		if labels.(rel.symbol) != ? {
			true -> {
				target := labels.(rel.symbol)
				source := rel.offset + 4  // after the 4-byte placeholder
				offset := target - source
				code.(rel.offset) <- offset & 255
				code.(rel.offset + 1) <- (offset >> 8) & 255
				code.(rel.offset + 2) <- (offset >> 16) & 255
				code.(rel.offset + 3) <- (offset >> 24) & 255
			}
		}
	})

	{
		code: code
		labels: labels
		relocations: relocs
	}
}

// ---------------------------------------------------------------------------
// ARM64 assembler
// ---------------------------------------------------------------------------

fn assembleARM64(source) {
	tokens := tokenizeAsm(source)
	code := []
	labels := {}
	relocations := []

	fn emit32(inst) {
		code << (inst & 255)
		code << ((inst >> 8) & 255)
		code << ((inst >> 16) & 255)
		code << ((inst >> 24) & 255)
	}

	fn regNum(name) {
		clean := name |> replace(',', '') |> lower()
		arm64Regs.(clean) |> default(0)
	}

	fn parseImm(val) {
		clean := val |> replace('#', '') |> replace('$', '') |> replace(',', '')
		int(clean)
	}

	idx := [0]
	fn peek() if idx.0 < len(tokens) { true -> tokens.(idx.0), _ -> ? }
	fn advance() {
		t := tokens.(idx.0)
		idx.0 <- idx.0 + 1
		t
	}
	fn skipCommas() {
		fn loop() if peek() {
			? -> ?
			_ -> if peek().type = TOK_COMMA {
				true -> {
					advance()
					loop()
				}
			}
		}
		loop()
	}

	fn assembleInstruction(mnemonic) if mnemonic |> lower() {
		'nop' -> emit32(0xD503201F)
		'ret' -> emit32(0xD65F03C0)
		'mov' -> {
			skipCommas()
			dst := advance()
			skipCommas()
			src := advance()
			if src.type = TOK_IMM {
				true -> {
					rd := regNum(dst.val)
					imm := parseImm(src.val)
					// MOVZ Xd, #imm16
					emit32(0xD2800000 | ((imm & 0xFFFF) << 5) | (rd & 31))
				}
				_ -> if src.type = TOK_REG {
					true -> {
						rd := regNum(dst.val)
						rm := regNum(src.val)
						// MOV Xd, Xm (encoded as ORR Xd, XZR, Xm)
						emit32(0xAA0003E0 | ((rm & 31) << 16) | (rd & 31))
					}
				}
			}
		}
		'add' -> {
			skipCommas()
			rd := advance()
			skipCommas()
			rn := advance()
			skipCommas()
			rm := advance()
			if rm.type = TOK_REG {
				true -> {
					// ADD Xd, Xn, Xm
					emit32(0x8B000000 | ((regNum(rm.val) & 31) << 16) | ((regNum(rn.val) & 31) << 5) | (regNum(rd.val) & 31))
				}
				_ -> if rm.type = TOK_IMM {
					true -> {
						// ADD Xd, Xn, #imm12
						imm := parseImm(rm.val)
						emit32(0x91000000 | ((imm & 0xFFF) << 10) | ((regNum(rn.val) & 31) << 5) | (regNum(rd.val) & 31))
					}
				}
			}
		}
		'sub' -> {
			skipCommas()
			rd := advance()
			skipCommas()
			rn := advance()
			skipCommas()
			rm := advance()
			if rm.type = TOK_REG {
				true -> emit32(0xCB000000 | ((regNum(rm.val) & 31) << 16) | ((regNum(rn.val) & 31) << 5) | (regNum(rd.val) & 31))
				_ -> if rm.type = TOK_IMM {
					true -> {
						imm := parseImm(rm.val)
						emit32(0xD1000000 | ((imm & 0xFFF) << 10) | ((regNum(rn.val) & 31) << 5) | (regNum(rd.val) & 31))
					}
				}
			}
		}
		'svc' -> {
			skipCommas()
			imm := advance()
			emit32(0xD4000001 | ((parseImm(imm.val) & 0xFFFF) << 5))
		}
		'b' -> {
			skipCommas()
			target := advance()
			relocations << { offset: len(code), symbol: target.val, type: :rel26 }
			emit32(0x14000000)
		}
		'bl' -> {
			skipCommas()
			target := advance()
			relocations << { offset: len(code), symbol: target.val, type: :rel26 }
			emit32(0x94000000)
		}
		'cbz' -> {
			skipCommas()
			rt := advance()
			skipCommas()
			target := advance()
			relocations << { offset: len(code), symbol: target.val, type: :rel19 }
			emit32(0xB4000000 | (regNum(rt.val) & 31))
		}
		'cbnz' -> {
			skipCommas()
			rt := advance()
			skipCommas()
			target := advance()
			relocations << { offset: len(code), symbol: target.val, type: :rel19 }
			emit32(0xB5000000 | (regNum(rt.val) & 31))
		}
	}

	fn assembleLoop() if idx.0 < len(tokens) {
		true -> {
			tok := advance()
			if tok.type {
				:label -> labels.(tok.val) <- len(code)
				:mnemonic -> assembleInstruction(tok.val)
				:directive -> ?
				:newline -> ?
				:comment -> ?
			}
			assembleLoop()
		}
	}

	assembleLoop()

	// Resolve ARM64 relocations
	relocations |> each(fn(rel) {
		if labels.(rel.symbol) != ? {
			true -> {
				target := labels.(rel.symbol)
				offset := (target - rel.offset) / 4  // ARM64 uses instruction-sized offsets
				existing := code.(rel.offset) | (code.(rel.offset + 1) << 8) | (code.(rel.offset + 2) << 16) | (code.(rel.offset + 3) << 24)
				patched := if rel.type {
					:rel26 -> existing | (offset & 0x3FFFFFF)
					:rel19 -> existing | ((offset & 0x7FFFF) << 5)
					_ -> existing
				}
				code.(rel.offset) <- patched & 255
				code.(rel.offset + 1) <- (patched >> 8) & 255
				code.(rel.offset + 2) <- (patched >> 16) & 255
				code.(rel.offset + 3) <- (patched >> 24) & 255
			}
		}
	})

	{
		code: code
		labels: labels
		relocations: relocations
	}
}

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

fn assemble(source, arch) if arch {
	:arm64, :aarch64 -> assembleARM64(source)
	_ -> assembleX86_64(source)
}
