// jvm-fp — compatibility alias for the shared IEEE-754 primitives.
// The implementation now lives in lib/ieee754.oak (import('ieee754')); this
// module keeps the historical import path working and re-exports the exact
// same surface. New code should import 'ieee754' directly.

ieee754 := import('ieee754')

{f32: ieee754.f32, f64: ieee754.f64, float?: ieee754.float?,
    double?: ieee754.double?, wide?: ieee754.wide?,
    sign: ieee754.sign, kind: ieee754.kind, numeric: ieee754.numeric,
    fromNumber: ieee754.fromNumber, fromLong: ieee754.fromLong,
    negative: ieee754.negative, zero: ieee754.zero,
    infinity: ieee754.infinity, nan: ieee754.nan, binary: ieee754.binary,
    compare: ieee754.compare, toInt: ieee754.toInt, text: ieee754.text}
