// b64-hex — hex-string helpers for base64url encoding.
//
// Split from the main `b64` module so callers that already have integer
// byte lists (e.g. from crypto primitives) don't need to pull in hex
// decoding logic. The hex primitives now live in the shared `hex` module;
// this module re-exports the subset the base64url path uses.

hex := import('hex')

hexToBytes := hex.hexToBytes
bytesToHex := hex.bytesToHex

{
	hexToBytes: hexToBytes
	bytesToHex: bytesToHex
}
