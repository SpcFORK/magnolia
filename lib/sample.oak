// libsample — exact float-to-fixed-point sample-conversion primitives shared
// by the audio codecs (WAV/OGG/AIFF/AU/RAW) and the audio facade.
//
// Normalised float samples live in the range [-1, 1]. These primitives convert
// between that range and the fixed-width integer representations used by PCM
// audio containers (8/16/32-bit signed, 8-bit unsigned). They are defined in
// one place so the codecs cannot drift on the exact scaling constants.
//
// No dependencies: every body is pure arithmetic on a single sample value.

fn _clipF32(s) if {
	s > 1 -> 1
	s < -1 -> -1
	_ -> s
}

fn _f32ToI8(s) {
	v := int(s * 127)
	if v < -128 { true -> -128, _ -> if v > 127 { true -> 127, _ -> v } }
}

fn _i8ToF32(s) s / 128

fn _f32ToI16(s) int(s * 32767)

fn _i16ToF32(s) s / 32768

fn _f32ToI32(s) int(s * 2147483647)

fn _i32ToF32(s) s / 2147483648

fn _f32ToU8(s) int((s + 1) / 2 * 255)

fn _u8ToF32(s) s / 127.5 - 1
