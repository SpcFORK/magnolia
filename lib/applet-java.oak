                        int key = num(pop(stack)), result = num(ins.arg);
                        int[] pairs = (int[]) ins.extra;
                        int low = 0, high = pairs.length / 2;
                        while (low < high) {
                            int mid = (low + high) / 2, cmp = pairs[mid * 2];
                            if (key == cmp) { result = pairs[mid * 2 + 1]; break; }
                            if (key < cmp) high = mid;
                            else low = mid + 1;
                        }
                        pc = result;
                        break;
                    }
                    case 198: if (pop(stack) == null) pc = num(ins.arg); break;
                    case 199: if (pop(stack) != null) pc = num(ins.arg); break;
                    case 172: case 176: return pop(stack);
                    case 173: return wide(pop(stack));
                    case 174: return floating(pop(stack));
                    case 175: return doubling(pop(stack));
                    case 177: return null;
                    case 178: {
                        String[] r = (String[]) ins.extra;
                        if (r[0].equals("java/lang/System")) {
                            if (!r[1].equals("out") || !r[2].equals("Ljava/io/PrintStream;"))
                                throw fail("unsupported JVM library field");
                            push(stack, SYSTEM_OUT, m.maxStack);
                        } else if (r[0].equals("java/awt/Color")) {
                            if (!r[2].equals("Ljava/awt/Color;"))
                                throw fail("unsupported JVM library field");
                            push(stack, namedColor(r[1]), m.maxStack);
                        } else {
                            if (!CLASSES.containsKey(r[0])) throw fail("unsupported JVM library field");
                            initialize(r[0]);
                            push(stack, CLASSES.get(r[0]).statics.get(fieldKey(r[0], r[1], r[2])), m.maxStack);
                        }
                        break;
                    }
                    case 179: {
                        String[] r = (String[]) ins.extra;
                        if (!CLASSES.containsKey(r[0])) throw fail("unsupported JVM library field");
                        initialize(r[0]);
                        CLASSES.get(r[0]).statics.put(fieldKey(r[0], r[1], r[2]), pop(stack)); break;
                    }
                    case 180: {
                        String[] r = (String[]) ins.extra;
                        v = pop(stack);
                        if (v == null) throw raised("java/lang/NullPointerException", "null field receiver");
                        if (!(v instanceof Obj)) throw fail("invalid field receiver");
                        if (r[0].equals("java/awt/Point")) {
                            if (!r[2].equals("I") || !(r[1].equals("x") || r[1].equals("y")))
                                throw fail("invalid AWT Point field read");
                            push(stack, pointCoordinate(point(v), r[1]), m.maxStack);
                        } else {
                            if (!CLASSES.containsKey(r[0])) throw fail("unsupported JVM library field");
                            push(stack, ((Obj) v).fields.get(fieldKey(r[0], r[1], r[2])), m.maxStack);
                        }
                        break;
                    }
                    case 181: {
                        String[] r = (String[]) ins.extra;
                        v = pop(stack); a = pop(stack);
                        if (a == null) throw raised("java/lang/NullPointerException", "null field receiver");
                        if (!(a instanceof Obj)) throw fail("invalid field receiver");
                        if (r[0].equals("java/awt/Point")) {
                            if (!r[2].equals("I") || !(r[1].equals("x") || r[1].equals("y")) ||
                                    !(v instanceof Integer)) throw fail("invalid AWT Point field write");
                            point(a).fields.put(fieldKey(r[0], r[1], r[2]), v);
                        } else {
                            if (!CLASSES.containsKey(r[0])) throw fail("unsupported JVM library field");
                            ((Obj) a).fields.put(fieldKey(r[0], r[1], r[2]), v);
                        }
                        break;
                    }
                    case 182: case 183: case 184: case 185: {
                        String[] r = (String[]) ins.extra;
                        Object[] argv = new Object[num(ins.arg)];
                        for (int i = argv.length - 1; i >= 0; i--) argv[i] = pop(stack);
                        Object obj = op == 184 ? null : pop(stack);
                        if (op != 184 && obj == null)
                            throw raised("java/lang/NullPointerException", "null method receiver");
                        if (op == 185 && !instance(obj, r[0]))
                            throw fail("invalid invokeinterface receiver for " + r[0]);
                        if (op == 184) initialize(r[0]);
                        Object ret;
                        if (r[1].equals("getParameter") && r[2].equals("(Ljava/lang/String;)Ljava/lang/String;") && find(r[0], r[1] + r[2]) == null)
                            ret = PARAMS.get(String.valueOf(argv[0]));
                        else if (CLASSES.containsKey(r[0])) {
                            String dispatchOwner = (op == 182 || op == 185) && obj instanceof Obj &&
                                CLASSES.containsKey(((Obj) obj).name) ? ((Obj) obj).name : r[0];
                            ret = execute(dispatchOwner, r[1], r[2], argv, obj);
                        } else ret = host(r[0], r[1], r[2], obj, argv);
                        if (!isVoid(r[2])) push(stack, ret, m.maxStack);
                        break;
                    }
                    case 187: push(stack, make((String) ins.arg), m.maxStack); break;
                    case 197: {
                        if (!(ins.arg instanceof String) || !(ins.extra instanceof Integer))
                            throw fail("invalid multianewarray operands");
                        int count = num(ins.extra);
                        if (count < 1 || count > 16)
                            throw fail("invalid multianewarray dimension count");
                        int[] dimensions = new int[count];
                        for (int i = count - 1; i >= 0; i--) {
                            Object size = pop(stack);
                            if (!(size instanceof Integer))
                                throw fail("invalid multianewarray dimension");
                            dimensions[i] = num(size);
                        }
                        push(stack, multi((String) ins.arg, dimensions), m.maxStack); break;
                    }
                    case 188: case 189:
                        n = num(pop(stack));
                        if (n < 0) throw raised("java/lang/NegativeArraySizeException",
                            "invalid array size: negative size");
                        if (n > MAX_ARRAY) throw fail("invalid array size");
                        push(stack, new Arr(ins.arg, n, op == 188 ?
                            (num(ins.arg) == 11 ? (Object) WideLong.of(0L) :
                             num(ins.arg) == 6 ? (Object) new WideFloat(0L) :
                             num(ins.arg) == 7 ? (Object) new WideDouble(0L, 0L) :
                             Integer.valueOf(0)) : null), m.maxStack); break;
                    case 190: push(stack, array(pop(stack)).values.size(), m.maxStack); break;
                    case 191:
                        v = pop(stack);
                        if (v == null) throw raised("java/lang/NullPointerException", "null athrow operand");
                        if (!(v instanceof Obj) || !instance(v, "java/lang/Throwable"))
                            throw fail("athrow operand is not a JVM Throwable");
                        throw new VmThrown((Obj) v);
                    case 46: case 47: case 48: case 49: case 50: case 51: case 52: case 53: {
                        n = num(pop(stack)); Arr arr = array(pop(stack));
                        requireArrayKind(arr, op);
                        v = get(arr, n);
                        if (op == 47 && !(v instanceof WideLong))
                            throw fail("invalid JVM long array element");
                        if (op == 48) floating(v);
                        if (op == 49) doubling(v);
                        if (op == 51 && num(arr.tag) == 8 && num(v) >= 128)
                            v = num(v) - 256;
                        if (op == 53 && num(v) >= 32768) v = num(v) - 65536;
                        push(stack, v, m.maxStack); break;
                    }
                    case 79: case 80: case 81: case 82: case 83: case 84: case 85: case 86: {
                        v = pop(stack); n = num(pop(stack)); Arr arr = array(pop(stack));
                        requireArrayKind(arr, op);
                        if (op == 80 && !(v instanceof WideLong))
                            throw fail("long array store requires a JVM long");
                        if (op == 81) floating(v);
                        if (op == 82) doubling(v);
                        if (op == 83 && v != null && !instance(v, (String) arr.tag))
                            throw raised("java/lang/ArrayStoreException", "array store type mismatch");
                        if (op == 84) v = num(v) & (num(arr.tag) == 4 ? 1 : 255);
                        if (op == 85 || op == 86) v = num(v) & 65535;
                        set(arr, n, v); break;
                    }
                    case 192:
                        v = pop(stack);
                        if (v != null && !instance(v, (String) ins.arg))
                            throw raised("java/lang/ClassCastException", "invalid checkcast");
                        push(stack, v, m.maxStack); break;
                    case 193: push(stack, instance(pop(stack), (String) ins.arg) ? 1 : 0, m.maxStack); break;
                    default: throw fail("unverified opcode reached: " + op);
                }
                } catch (VmThrown thrown) {
                    boolean handled = false;
                    for (Handler handler : m.handlers) {
                        if (throwSite >= handler.start && throwSite < handler.end &&
                                (handler.catchType == null ||
                                 instance(thrown.value, handler.catchType))) {
                            stack.clear(); stack.slots = 0;
                            push(stack, thrown.value, m.maxStack);
                            pc = handler.target;
                            handled = true;
                            break;
                        }
                    }
                    if (!handled) throw thrown;
                }
            }
        } finally { depth--; }
    }
    public static void main(String[] args) {
        try {
            if (APPLICATION) {
                initialize(ENTRY);
                Arr argv = new Arr("java/lang/String", ARGUMENTS.length, null);
                for (int i = 0; i < ARGUMENTS.length; i++) {
                    if (!(ARGUMENTS[i] instanceof String)) throw fail("main arguments must be strings");
                    argv.values.set(i, ARGUMENTS[i]);
                }
                execute(ENTRY, "main", "([Ljava/lang/String;)V", new Object[]{argv}, null);
                System.out.print(OUTPUT.toString());
                return;
            }
            Obj obj = make(ENTRY);
            if (find(ENTRY, "<init>()V") != null) execute(ENTRY, "<init>", "()V", new Object[0], obj);
            Object value = null;
            if (METHOD != null) {
                value = execute(ENTRY, METHOD, DESC, ARGUMENTS, obj);
            } else {
                if (find(ENTRY, "init()V") != null) execute(ENTRY, "init", "()V", new Object[0], obj);
                if (find(ENTRY, "start()V") != null) execute(ENTRY, "start", "()V", new Object[0], obj);
                if (PAINT) {
                    if (find(ENTRY, "paint(Ljava/awt/Graphics;)V") == null) throw fail("paint(Graphics) is not compiled");
                    BufferedImage image = new BufferedImage(WIDTH, HEIGHT, BufferedImage.TYPE_INT_ARGB);
                    Graphics2D g = image.createGraphics();
                    try {
                        g.setColor(Color.BLACK);
                        Obj graphics = new Obj("java/awt/Graphics"); graphics.graphics = g;
                        execute(ENTRY, "paint", "(Ljava/awt/Graphics;)V", new Object[]{graphics}, obj);
                    } finally { g.dispose(); }
                    try {
                        if (!ImageIO.write(image, "PNG", new File(IMAGE_FILE))) throw fail("PNG writer not available");
                    } catch (IOException e) { throw fail("cannot write " + IMAGE_FILE + ": " + e.getMessage()); }
                    System.out.println("Painted " + IMAGE_FILE);
                }
            }
            System.out.print(OUTPUT.toString());
            if (value instanceof WideFloat) System.out.println(floatingText(value, false));
            else if (value instanceof WideDouble) System.out.println(floatingText(value, true));
            else if (value != null) System.out.println(value);
        } catch (RuntimeException e) {
            // Native Oak and bundled JS retain output printed before a VM
            // error; flush that prefix before reporting the diagnostic.
            System.out.print(OUTPUT.toString());
            System.out.flush();
            System.err.println("[applet] " + e.getMessage());
            System.exit(1);
        }
    }
}
'

fn _error(message) std.error(message)
fn _keys(value) sort.sort!(keys(value))

// Class-file names and literals arrive as raw modified-UTF-8 bytes. Oak also
// stores ordinary caller strings as UTF-8 bytes. Decode both before writing
// Java source: encoding each byte as \u00XX would turn a JVM method named ŷ
// (C5 B7) into two *different* Java characters (Å·). Java's Unicode escapes
// are processed before lexing, so ASCII quotes, backslashes and newlines must
// be escaped separately and must NEVER be emitted as \u0022/\u005c/\u000a.
fn _validJavaText?(value) if type(value) {
    :string -> _utf8Units(value).type = :ok
    :list -> std.every(value, _validJavaText?)
    :object -> std.every(keys(value), fn(k) _validJavaText?(k) & _validJavaText?(value.(k)))
    _ -> true
}
fn _quote(text) {
    decoded := _utf8Units(text)
    if decoded.type = :error {
        true -> ?
        _ -> {
            fn escape(n) if n {
                92 -> '\\\\'
                10 -> '\\n'
                13 -> '\\r'
                9 -> '\\t'
                34 -> '\\' + char(34)
                _ -> if n < 32 {
                    true -> {
                        digits := '01234567'
                        '\\' + digits.(n >> 6) + digits.((n >> 3) & 7) + digits.(n & 7)
                    }
                    _ -> if n >= 127 {
                        true -> '\\u' + _HEXN((n >> 12) & 15) + _HEXN((n >> 8) & 15) +
                            _HEXN((n >> 4) & 15) + _HEXN(n & 15)
                        _ -> char(n)
                    }
                }
            }
            char(34) + (decoded.value |> std.map(escape) |> str.join('')) + char(34)
        }
    }
}
fn _literal(v) if type(v) {
    :null, :empty -> 'null'
    :int, :float, :bool -> string(v)
    :string -> _quote(v)
    :object -> if v.jvmLong = true & type(v.hi) = :int & type(v.lo) = :int {
        true -> 'new WideLong(' + string(v.hi) + ', ' + string(v.lo) + 'L)'
        _ -> if v.jvmFloat = true & type(v.bits) = :int {
            true -> 'new WideFloat(' + string(v.bits) + 'L)'
            _ -> if v.jvmDouble = true & type(v.hi) = :int &
                type(v.lo) = :int {
                true -> 'new WideDouble(' + string(v.hi) + 'L, ' +
                    string(v.lo) + 'L)'
                _ -> 'null'
            }
        }
    }
    _ -> 'null'
}
// Invocation arguments are external objects, not JVM-interned class literals.
fn _argument(v) if type(v) {
    :string -> 'new String(' + _quote(v) + ')'
    _ -> _literal(v)
}
fn _extra(v, op) if type(v) {
    :list -> if op = 170 | op = 171 | op = 196 {
        true -> 'new int[]{' + (v |> std.map(_literal) |> str.join(', ')) + '}'
        _ -> 'new String[]{' + (v |> std.map(_literal) |> str.join(', ')) + '}'
    }
    _ -> _literal(v)
}

// className must exactly match the .java file's basename (e.g. AppletBundle).
fn _validClassName?(name) {
    if type(name) != :string | len(name) = 0 {
        true -> false
        _ -> {
            first := name.(0)
            fn letter?(c) {
                v := codepoint(c)
                (v >= 65 & v <= 90) | (v >= 97 & v <= 122) | c = '_' | c = '$'
            }
            fn scan(i) if i >= len(name) {
                true -> true
                _ -> if letter?(name.(i)) | (codepoint(name.(i)) >= 48 & codepoint(name.(i)) <= 57) {
                    true -> scan(i + 1)
                    _ -> false
                }
            }
            letter?(first) & scan(1)
        }
    }
}

fn _render(program, params, options, className, template) {
    declarations := ''
    error := ?
    _keys(program.classes) |> std.each(fn(owner) {
        cls := program.classes.(owner)
        declarations <- declarations + '        { Klass c = new Klass(' + _literal(cls.super) + ');\n'
        (cls.interfaces |> std.default([])) |> std.each(fn(iface) {
            declarations <- declarations + '          c.interfaces.add(' + _quote(iface) + ');\n'
        })
        _keys(cls.fields) |> std.each(fn(key) {
            val := cls.fields.(key)
            declarations <- declarations + '          c.fields.put(' + _quote(key) + ', ' + _literal(val) + ');\n'
        })
        _keys(cls.static) |> std.each(fn(key) {
            val := cls.static.(key)
            declarations <- declarations + '          c.statics.put(' + _quote(key) + ', ' + _literal(val) + ');\n'
        })
        _keys(cls.methods) |> std.each(fn(signature) {
            method := cls.methods.(signature)
            widths := method.argWidths |> std.default([])
            declarations <- declarations + '          c.methods.put(' + _quote(signature) + ', new Method(' +
                string(method.locals) + ', ' + string(method.stack) + ', ' +
                string(method.static?) + ', new int[]{' +
                (widths |> std.map(string) |> str.join(', ')) + '}, new Ins[]{\n'
            method.code |> std.each(fn(inst) {
                declarations <- declarations + '            new Ins(' + string(inst.(0)) + ', ' +
                    _literal(inst.(1)) + ', ' + _extra(inst.(2), inst.(0)) + '),\n'
            })
            declarations <- declarations + '          }, new Handler[]{\n'
            (method.handlers |> std.default([])) |> std.each(fn(h) {
                declarations <- declarations + '            new Handler(' +
                    string(h.start) + ', ' + string(h.end) + ', ' +
                    string(h.target) + ', ' + _literal(h.catch) + '),\n'
            })
            declarations <- declarations + '          }));\n'
        })
        declarations <- declarations + '          CLASSES.put(' + _quote(owner) + ', c); }\n'
    })
    bindings := ''
    _keys(params) |> std.each(fn(key) {
        val := params.(key)
        bindings <- bindings + '        PARAMS.put(' + _quote(key) + ', ' + if val = ? {
            true -> 'null', _ -> 'new String(' + _quote(string(val)) + ')'} + ');\n'
    })
    args := options.args |> std.default([])
    if type(args) != :list -> error <- 'args must be a list'
    args |> std.each(fn(arg) {
        ieee? := type(arg) = :object &
            (_ieee754.float?(arg) |
                _ieee754.double?(arg))
        long? := type(arg) = :object & arg.jvmLong = true &
            type(arg.hi) = :int & type(arg.lo) = :int &
            arg.hi >= -2147483648 & arg.hi <= 2147483647 &
            arg.lo >= 0 & arg.lo <= 4294967295
        if !(type(arg) = :int | type(arg) = :string | type(arg) = :bool |
            type(arg) = :null | ieee? | long?) ->
            error <- 'Java target supports int/string/bool/null and tagged JVM numeric arguments'
        if program.kind = 'application' & type(arg) != :string ->
            error <- 'application main arguments must be strings'
    })
    method := options.method |> std.default(?)
    width := options.width |> std.default(320)
    height := options.height |> std.default(200)
    if type(width) != :int | type(height) != :int | width < 1 | height < 1 | width > 4096 | height > 4096 ->
        error <- 'Java AWT image dimensions must be 1..4096'
    if error != ? {
        true -> _error(error)
        _ -> {
            output := template
            output <- str.replace(output, '/*%CLASS%*/', className)
            output <- str.replace(output, '/*%ENTRY%*/', _quote(program.entry))
            output <- str.replace(output, '/*%METHOD%*/', _literal(method))
            output <- str.replace(output, '/*%DESC%*/', _quote(options.desc |> std.default('()V')))
            output <- str.replace(output, '/*%ARGS%*/', 'new Object[]{' + (args |> std.map(_argument) |> str.join(', ')) + '}')
            output <- str.replace(output, '/*%STEPS%*/', string(options.maxSteps |> std.default(100000)))
            output <- str.replace(output, '/*%APPLICATION%*/', string(program.kind = 'application'))
            output <- str.replace(output, '/*%PAINT%*/', string(options.paint? = true))
            output <- str.replace(output, '/*%WIDTH%*/', string(width))
            output <- str.replace(output, '/*%HEIGHT%*/', string(height))
            output <- str.replace(output, '/*%IMAGE%*/', _quote(className + '.png'))
            output <- str.replace(output, '/*%DATA%*/', declarations)
            output <- str.replace(output, '/*%PARAMS%*/', bindings)
            {type: :ok, value: output}
        }
    }
}

fn source(program, params, options, className) if !_validClassName?(className) {
    true -> _error('Java output filename must be a valid Java class name')
    _ -> if !_validJavaText?([program, params, options]) {
        true -> _error('Java output requires well-formed UTF-8/modified UTF-8 text')
        _ -> _render(program, params |> std.default({}), options |> std.default({}), className, JAVA_PREAMBLE)
    }
}
