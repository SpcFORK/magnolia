// ---- shared positional readers --------------------------------------------
// These primitives read integers at a given offset from a binary string.
// Abstracted from the JVM/ZIP, AVM1/SWF, MIDP and recompile parsers, which
// each carried local copies of _at/_u16/_u2/_u4. The bounds-checked
// variants return ? on overrun; the unchecked variants assume valid input.

fn at(raw, pos) codepoint(raw.(pos)) & 255

fn atChecked(raw, pos) if pos >= 0 & pos < len(raw) {
	true -> codepoint(raw.(pos)) & 255
	_ -> ?
}

fn u16(raw, pos) at(raw, pos) + (at(raw, pos + 1) << 8)

fn u16Checked(raw, pos) if pos >= 0 & pos + 2 <= len(raw) {
	true -> u16(raw, pos)
	_ -> ?
}

fn u32(raw, pos) u16(raw, pos) + (u16(raw, pos + 2) << 16)

fn u32Checked(raw, pos) if pos >= 0 & pos + 4 <= len(raw) {
	true -> u32(raw, pos)
	_ -> ?
}

// ---- shared little-endian writers ----------------------------------------
// Abstracted from the JAR writer's local _le2/_le4. Return a 2- or 4-byte
// string (for ZIP local file headers and similar binary containers).

fn le2(n) char(n & 255) + char((n >> 8) & 255)

fn le4(n) le2(n & 65535) + le2((n >> 16) & 65535)
