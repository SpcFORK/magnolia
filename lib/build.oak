// oak build -- compiler and bundler

std := import('std')
slice := std.slice
default := std.default
clone := std.clone
map := std.map
filter := std.filter
each := std.each
reduce := std.reduce
append := std.append
contains? := std.contains?
merge := std.merge
once := std.once
keys := std.keys

str := import('str')
join := str.join
replace := str.replace
split := str.split
startsWith? := str.startsWith?

sort := import('sort')
sort! := sort.sort!

fs := import('fs')
readFile := fs.readFile
writeFile := fs.writeFile
statFile := fs.statFile

fmt := import('fmt')
printf := fmt.printf
format := fmt.format

path := import('path')
dir := path.dir
resolve := path.resolve

json := import('json')
encodeJSON := json.serialize

syntax := import('syntax')
bundleUtils := import('bundle-utils')
transform := import('ast-transform')
transpile := import('transpile')
packModule := import('pack')
buildIncludes := import('build-includes')
buildIdent := import('build-ident')
buildAst := import('build-ast')
buildAnalyze := import('build-analyze')
buildRender := import('build-render')
buildConfig := import('build-config')
buildImports := import('build-imports')

threadLib := import('thread')
pmap := threadLib.pmap

runtimeCodegen := import('runtime-codegen')
OakNativeRuntime := runtimeCodegen.OakNativeRuntime
OakJSRuntime := runtimeCodegen.OakJSRuntime

Log := printf
Abort := fn(msg) {
	Log(msg)
	exit(1)
}

Entry := ?
Web? := false
Wasm? := false
Ast? := false
Bin? := false
Doc? := false
Ts? := false
Lua? := false
Java? := false
Graph? := false
C? := false
CC? := false
Target := 'oak'
Output := ?
Includes := []
IncludeVFS := ?
VFSFiles := {}
AbsoluteEntry := ?

fn requireOpt(flag, value) {
	buildConfig.requireOpt(flag, value, Abort, format)
}
parseInclude := buildIncludes.parseInclude
parseIncludes := buildIncludes.parseIncludes

fn applyConfig(config) {
	state := {
		Log: Log
		Abort: Abort
		Entry: Entry
		Web?: Web?
		Wasm?: Wasm?
		Ast?: Ast?
		Bin?: Bin?
		Doc?: Doc?
		Ts?: Ts?
		Lua?: Lua?
		Java?: Java?
		Graph?: Graph?
		C?: C?
		CC?: CC?
		Target: Target
		Output: Output
		Includes: Includes
		IncludeVFS: IncludeVFS
		VFSFiles: VFSFiles
		AbsoluteEntry: AbsoluteEntry
	}
	buildConfig.configure(
		config
		state
		parseIncludes
		statFile
		resolve
		packModule.collectVFSFiles
		transpile
		each
		printf
		format
	)
	Log <- state.Log
	Abort <- state.Abort
	Entry <- state.Entry
	Web? <- state.Web?
	Wasm? <- state.Wasm?
	Ast? <- state.Ast?
	Bin? <- state.Bin?
	Doc? <- state.Doc?
	Ts? <- state.Ts?
	Lua? <- state.Lua?
	Java? <- state.Java?
	Graph? <- state.Graph?
	C? <- state.C?
	CC? <- state.CC?
	Target <- state.Target
	Output <- state.Output
	Includes <- state.Includes
	IncludeVFS <- state.IncludeVFS
	VFSFiles <- state.VFSFiles
	AbsoluteEntry <- state.AbsoluteEntry
}

Configured := ?

fn configure(config) {
	Configured <- config
}

fn compile() if Configured {
	? -> Abort('[oak build] No config set. Call configure() first.')
	_ -> run(Configured)
}

// a { string: [Node] } that maps absolute paths of imported modules to their
// fully parsed AST. We cache it here because we need to potentially astgen
// modules multiple times in the compilation process. This also serves as the
// source of truth for which modules the bundle must include.
ModuleNodes := {}

// ImportCallNode is a template node of the form `import(<string literal>)`,
// which is a static import that the bundler must handle specially and
// transform on output.
ImportCallNode := {
	type: :fnCall
	function: { type: :identifier, val: 'import', tok: _ }
	args: [{ type: :string, val: _, tok: _ }]
	restArg: ?
	tok: _
}

// ImportAssignmentNode is a template node of the form `_ := import(<string
// literal>)`, which is a top-level static import that the bundler must handle
// specially and transform on output.
ImportAssignmentNode := {
	type: :assignment
	tok: _
	local?: true
	left: _
	right: ImportCallNode
}

// cachedParse is a wrapper around syntax.parse that lazily caches the computed
// AST, so we can minimize redundant work.
// The path must be absolute, but the text is optional if the path is
// guaranteed to be cached.
fn cachedParse(path, text) if cached := ModuleNodes.(path) {
	? -> buildImports.cachedParse(path, text, ModuleNodes, Log, Abort, syntax, format)
	_ -> cached
}

// addImportsFromFile reads and parses a file at a given path, and potentially
// dispatches further addImportsFromFile calls to modules imported by the given
// module. Calling this on an entrypoint module will eventually reach all of
// the modules it imports recursively.
fn addImportsFromFile(path) {
	buildImports.addImportsFromFile(path, readFile, printf, addImportsFromSource)
}
// addImportsFromSource takes an Oak source file and recursively imports
// modules included from that entrypoint. It is dual to addImportsFromFile, but
// takes a source file rather than a path to a file on disk.
fn addImportsFromSource(path, file) {
	buildImports.addImportsFromSource(
		path
		file
		ModuleNodes
		ImportAssignmentNode
		Web?
		___runtime_lib?
		___runtime_lib
		resolve
		dir
		addImportsFromFile
		cachedParse
	)
}

// When translating between incompatible identifier names or symbols, Oak
// names will be appended to "__oak_js_" to produce a valid JS name, e.g.
// Oak identifier "const" (a JS reserve word) becomes "__oak_js_const".
//
// Notably, the identifier "import" is always translated to the bundler builtin
// "__oak_module_import", which in every runtime runs custom logic to search
// bundled modules before falling back to native import().
fn formatIdent(name, key) buildIdent.formatIdent(Web? | Ts?, name, key)

fn wrapModule(block) buildAst.wrapModule(block)

fn bundleCommonPrefix(paths) buildAst.bundleCommonPrefix(paths)

fn wrapBundle(modules, entryModuleName) {
	buildAst.wrapBundle(modules, entryModuleName, Includes, ImportCallNode)
}

fn analyzeNode(node) buildAnalyze.analyzeNode(node, Web? | Ts?)

// renderOakNodes renders Oak AST nodes to Oak program text
fn renderOakBundle(bundleNode) {
	buildRender.renderOakBundle(bundleNode, VFSFiles, encodeJSON, OakNativeRuntime, formatIdent, Abort)
}

// renderJSNodes renders Oak AST nodes to JavaScript program text.
// renderJSNodes is also responsible for adding the JavaScript Oak runtime,
// which provides language compatibility features.
fn renderJSBundle(bundleNode) {
	buildRender.renderJSBundle(bundleNode, VFSFiles, encodeJSON, OakJSRuntime, formatIdent, clone)
}

fn renderWasmBundle(bundleNode) {
	runtimeCodegen.renderWasmBundle(
		bundleNode
		fn(node) buildRender.renderOakBundle(node, VFSFiles, encodeJSON, OakNativeRuntime, formatIdent, Abort)
	)
}

// renderAstBundle serializes the bundled AST as JSON
fn renderAstBundle(bundleNode) {
	encodeJSON(bundleNode)
}

// renderBinBundle serializes the bundled AST to a compact bytecode binary.
// The preamble (from runtime-native.oak) is compiled into the bytecode so
// the .mgb file is self-contained.
fn renderBinBundle(bundleNode) {
	vm := import('wasm-vm')

	// Parse the runtime preamble and create a combined block
	preambleAST := syntax.parse(OakNativeRuntime)
	combinedExprs := []
	preambleAST |> each(fn(node) combinedExprs << node)
	if bundleNode.type {
		:block -> bundleNode.exprs |> each(fn(node) combinedExprs << node)
		_ -> combinedExprs << bundleNode
	}
	combinedNode := {
		type: :block
		tok: bundleNode.tok
		exprs: combinedExprs
		decls: []
	}

	compiler := vm.compileProgram(combinedNode)

	bcStr := vm.serializeBytecodeToString(compiler)
	cpStr := vm.serializeConstantPool(compiler)
	ftStr := vm.serializeFunctionTable(compiler)
	tlStr := vm.serializeTopLevelNames(compiler)

	// Binary format: MGbc <version:u16> <sections>
	// Each section: <len:u32> <data>
	fn u16le(n) char(n & 0xFF) << char((n >> 8) & 0xFF)
	fn u32le(n) char(n & 0xFF) << char((n >> 8) & 0xFF) << char((n >> 16) & 0xFF) << char((n >> 24) & 0xFF)

	header := 'MGbc' << u16le(2)
	bcSection := u32le(len(bcStr)) << bcStr
	cpSection := u32le(len(cpStr)) << cpStr
	ftSection := u32le(len(ftStr)) << ftStr
	tlSection := u32le(len(tlStr)) << tlStr

	header << bcSection << cpSection << ftSection << tlSection
}

// renderDocBundle generates Markdown documentation from the bundled AST
fn renderDocBundle(bundleNode) {
	output := '# API Documentation\n\n'
	output <- output << '_Auto-generated from Magnolia source._\n\n'
	output <- output << '---\n\n'

	// lastExpr extracts the tail expression (return value) from a body node
	fn lastExpr(node) if node {
		? -> ?
		_ -> if node.type {
			:block -> if node.exprs != ? & len(node.exprs) > 0 {
				true -> node.exprs.(len(node.exprs) - 1)
				_ -> ?
			}
			_ -> node
		}
	}

	// inferType returns a short type descriptor string for a node
	fn inferType(node) if node {
		? -> ?
		_ -> if node.type {
			:string -> ':string'
			:int -> ':int'
			:float -> ':float'
			:bool -> ':bool'
			:atom -> ':atom'
			:null -> '?'
			:list -> ':list'
			:object -> ':object'
			:function -> ':function'
			:class -> ':function'
			:identifier -> ?
			:assignment -> inferType(node.right)
			:block -> inferType(lastExpr(node))
			:binary -> if node.op {
				// comparison operators
				:equal, :notEqual, :greater, :less, :greaterEqual, :lessEqual, :and, :or -> ':bool'
				:plus, :minus, :times, :divide, :modulus -> {
					lt := inferType(node.left)
					rt := inferType(node.right)
					if lt = rt {
						true -> lt
						_ -> if lt != ? -> lt
					}
				}
				:pushArrow -> inferType(node.left)
				_ -> ?
			}
			:unary -> if node.op {
				:exclam -> ':bool'
				:minus -> inferType(node.right)
				_ -> ?
			}
			:fnCall -> ?
			:ifExpr -> {
				// try inferring from the first branch body
				if len(node.branches) {
					0 -> ?
					_ -> {
						firstBranch := node.branches.(0)
						inferType(firstBranch.body)
					}
				}
			}
			:propertyAccess -> ?
			_ -> ?
		}
	}

	// inferReturnType gets return type of a function/class body
	fn inferReturnType(bodyNode) if bodyNode {
		? -> ?
		_ -> {
			tail := lastExpr(bodyNode)
			inferType(tail)
		}
	}

	// isThunk returns true if the body's tail expression is a function or class
	fn isThunk(bodyNode) {
		tail := lastExpr(bodyNode)
		if tail {
			? -> false
			_ -> if tail.type {
				:function -> true
				:class -> true
				_ -> false
			}
		}
	}

	// renderConstVal produces a short display string for a constant's value
	fn renderConstVal(node) if node.type {
		:string -> {
			s := node.val
			if s = ? {
				true -> ?
				_ -> if len(s) > 60 {
					true -> '\'' << slice(s, 0, 57) << '...\''
					_ -> '\'' << s << '\''
				}
			}
		}
		:int -> string(node.val)
		:float -> string(node.val)
		:bool -> string(node.val)
		:atom -> ':' << string(node.val)
		:null -> '?'
		:list -> if node.elems != ? {
			true -> if len(node.elems) {
				0 -> '[]'
				_ -> '[' << string(len(node.elems)) << ' items]'
			}
			_ -> '[]'
		}
		:object -> if node.entries != ? {
			true -> if len(node.entries) {
				0 -> '{}'
				_ -> '{' << string(len(node.entries)) << ' entries}'
			}
			_ -> '{}'
		}
		:function -> 'fn(...)'
		:class -> 'cs(...)'
		:fnCall -> if node.function != ? {
			true -> if node.function.type = :identifier {
				true -> node.function.val << '(...)'
				_ -> ?
			}
		}
		_ -> ?
	}

	// formatAnnotation builds the annotation line for a function signature
	fn formatAnnotation(bodyNode) {
		parts := []
		retType := inferReturnType(bodyNode)
		thunk? := isThunk(bodyNode)
		if thunk? {
			true -> parts <- parts << '**thunk** '
		}
		if retType != ? {
			true -> parts <- parts << 'returns `' << retType << '`'
		}
		if len(parts) {
			0 -> ''
			_ -> {
				joined := parts |> join('')
				'> ' << joined << '\n\n'
			}
		}
	}

	fn docNode(node, depth) if node.type {
		:block -> {
			node.exprs |> each(fn(expr) docNode(expr, depth))
		}
		:assignment -> if node.local? {
			true -> if node.left.val != ? {
				true -> if node.right.type {
					:function -> {
						name := node.left.val
						args := node.right.args |> map(fn(a) a) |> join(', ')
						restArg := node.right.restArg
						sig := if restArg {
							?, '' -> name << '(' << args << ')'
							_ -> name << '(' << args << (if len(node.right.args) { 0 -> '', _ -> ', ' }) << restArg << '...)'
						}
						output <- output << string(depth) << '### `' << sig << '`\n\n'
						ann := formatAnnotation(node.right.body)
						if ann != '' -> output <- output << ann
					}
					:class -> {
						name := node.left.val
						args := node.right.args |> map(fn(a) a) |> join(', ')
						restArg := node.right.restArg
						sig := if restArg {
							?, '' -> name << '(' << args << ')'
							_ -> name << '(' << args << (if len(node.right.args) { 0 -> '', _ -> ', ' }) << restArg << '...)'
						}
						output <- output << string(depth) << '### `cs ' << sig << '`\n\n'
						ann := formatAnnotation(node.right.body)
						if ann != '' -> output <- output << ann
					}
					_ -> {
						name := node.left.val
						valStr := renderConstVal(node.right)
						if valStr != ? {
							true -> output <- output << string(depth) << '- `' << name << '` · `' << valStr << '`\n'
							_ -> output <- output << string(depth) << '- `' << name << '` — constant\n'
						}
					}
				}
			}
		}
		:function -> if node.name != '' {
			true -> {
				args := node.args |> map(fn(a) a) |> join(', ')
				restArg := node.restArg
				sig := if restArg {
					?, '' -> node.name << '(' << args << ')'
					_ -> node.name << '(' << args << (if len(node.args) { 0 -> '', _ -> ', ' }) << restArg << '...)'
				}
				output <- output << '### `' << sig << '`\n\n'
				ann := formatAnnotation(node.body)
				if ann != '' -> output <- output << ann
			}
		}
		:class -> if node.name != '' {
			true -> {
				args := node.args |> map(fn(a) a) |> join(', ')
				restArg := node.restArg
				sig := if restArg {
					?, '' -> node.name << '(' << args << ')'
					_ -> node.name << '(' << args << (if len(node.args) { 0 -> '', _ -> ', ' }) << restArg << '...)'
				}
				output <- output << '### `cs ' << sig << '`\n\n'
				ann := formatAnnotation(node.body)
				if ann != '' -> output <- output << ann
			}
		}
		:fnCall -> if node.function.type = :identifier & node.function.val = '__oak_modularize' {
			true -> {
				arg0 := node.args.(0)
				arg1 := node.args.(1)
				moduleName := arg0.val
				output <- output << '## Module: `' << moduleName << '`\n\n'
				// The second arg is a function whose body contains module declarations
				if arg1.type = :function {
					true -> docNode(arg1.body, '')
				}
			}
		}
	}

	docNode(bundleNode, '')
	output
}

// renderTsBundle produces TypeScript output (JS with type annotations)
fn renderTsBundle(bundleNode) {
	// TypeScript target uses the JS renderer as base, then wraps with TS header
	jsOutput := buildRender.renderJSBundle(bundleNode, VFSFiles, encodeJSON, OakJSRuntime, fn(name, key) buildIdent.formatIdent(true, name, key), clone)

	tsHeader := '// @ts-nocheck — Oak-generated TypeScript bundle\n'
	tsHeader << '// Type stubs for Oak runtime\n'
	tsHeader << 'declare type OakVal = any;\n'
	tsHeader << 'declare type OakFn = (...args: OakVal[]) => OakVal;\n'
	tsHeader << 'declare type OakList = OakVal[];\n'
	tsHeader << 'declare type OakObject = Record<string, OakVal>;\n\n'
	tsHeader << jsOutput
}

// renderLuaBundle transpiles bundled Oak AST to Lua 5.4
fn renderLuaBundle(bundleNode) {
	luaReserved := ['and', 'break', 'do', 'else', 'elseif', 'end', 'false'
		'for', 'function', 'goto', 'if', 'in', 'local', 'nil', 'not', 'or'
		'repeat', 'return', 'then', 'true', 'until', 'while']

	fn luaIdent(name) {
		clean := if type(name) != :string { true -> '__oak_nonstring_ident', _ -> name |> clone() }
		clean <- clean |> replace('?', '_qm') |> replace('!', '_exclam')
		luaReserved |> each(fn(kw) if clean = kw {
			true -> clean <- '__oak_lua_' << clean
		})
		if clean = 'import' -> clean <- '__oak_module_import'
		clean
	}

	output := '-- oak build --lua\n'
	output <- output << '-- Magnolia/Oak to Lua transpiled bundle\n\n'

	// Lua runtime preamble. The Oak builtin set is intentionally limited:
	// this is a bounded execution layer, not a full Lua/std port.
	output <- output << 'local __Oak_Modules = {}\n'
	output <- output << 'local args = {...}\n\n'
	// Raw captures, before the Oak builtin shadowing below.
	output <- output << 'local _oakType = type\n'
	output <- output << 'local _oakTostring = tostring\n'
	output <- output << 'local _oakTonumber = tonumber\n'
	output <- output << 'local _oakFloor = math.floor\n'
	output <- output << 'local _oakCeil = math.ceil\n'
	output <- output << 'local _oakStringsub = string.sub\n'
	output <- output << 'local _oakStringchar = string.char\n'
	output <- output << 'local _oakStringbyte = string.byte\n\n'
	// Oak lists are Lua array tables (1..n); Oak indices are 0-based and
	// Oak objects use raw keys. __oak_listp distinguishes the two so numeric
	// indexing works for both. Results are cached with weak table keys.
	output <- output << 'local __oakListCache = setmetatable({}, { __mode = "k" })\n'
	output <- output << 'local function __oak_listp(t)\n'
	output <- output << '  local cached = __oakListCache[t]\n'
	output <- output << '  if cached ~= nil then return cached end\n'
	output <- output << '  local n = #t\n'
	output <- output << '  local count = 0\n'
	output <- output << '  for k in pairs(t) do\n'
	output <- output << '    if _oakType(k) ~= "number" or k < 1 or k > n or k % 1 ~= 0 then\n'
	output <- output << '      __oakListCache[t] = false\n'
	output <- output << '      return false\n'
	output <- output << '    end\n'
	output <- output << '    count = count + 1\n'
	output <- output << '  end\n'
	output <- output << '  local r = count == n\n'
	output <- output << '  __oakListCache[t] = r\n'
	output <- output << '  return r\n'
	output <- output << 'end\n\n'
	output <- output << 'local function __oak_modularize(name, factory)\n'
	output <- output << '  __Oak_Modules[name] = factory\n'
	output <- output << 'end\n\n'
	output <- output << 'local function __oak_module_import(name)\n'
	output <- output << '  local m = __Oak_Modules[name]\n'
	output <- output << '  if m == nil and __Oak_Import_Aliases and __Oak_Import_Aliases[name] then\n'
	output <- output << '    m = __Oak_Modules[__Oak_Import_Aliases[name]]\n'
	output <- output << '  end\n'
	output <- output << '  if m == nil then return nil end\n'
	output <- output << '  if _oakType(m) == "function" then\n'
	output <- output << '    local result = m()\n'
	output <- output << '    __Oak_Modules[name] = result\n'
	output <- output << '    return result\n'
	output <- output << '  end\n'
	output <- output << '  return m\n'
	output <- output << 'end\n\n'
	output <- output << 'local __Oak_Import_Aliases = nil\n\n'
	output <- output << 'local function __oak_eq(a, b)\n'
	output <- output << '  if _oakType(a) ~= _oakType(b) then return false end\n'
	output <- output << '  if _oakType(a) == "table" then\n'
	output <- output << '    for k, v in pairs(a) do\n'
	output <- output << '      if not __oak_eq(v, b[k]) then return false end\n'
	output <- output << '    end\n'
	output <- output << '    for k, v in pairs(b) do\n'
	output <- output << '      if a[k] == nil then return false end\n'
	output <- output << '    end\n'
	output <- output << '    return true\n'
	output <- output << '  end\n'
	output <- output << '  return a == b\n'
	output <- output << 'end\n\n'
	output <- output << 'local function __oak_push(tbl, val)\n'
	output <- output << '  tbl[#tbl + 1] = val\n'
	output <- output << '  return tbl\n'
	output <- output << 'end\n\n'
	output <- output << 'local function __oak_acc(obj, key)\n'
	output <- output << '  if obj == nil then return nil end\n'
	output <- output << '  local t = _oakType(obj)\n'
	output <- output << '  if t == "string" then\n'
	output <- output << '    if _oakType(key) ~= "number" or key % 1 ~= 0 or key < 0 then return nil end\n'
	output <- output << '    return _oakStringsub(obj, math.floor(key) + 1, math.floor(key) + 1)\n'
	output <- output << '  elseif t == "table" then\n'
	output <- output << '    if _oakType(key) == "number" and key % 1 == 0 and key >= 0 and __oak_listp(obj) then\n'
	output <- output << '      return obj[math.floor(key) + 1]\n'
	output <- output << '    end\n'
	output <- output << '    return obj[key]\n'
	output <- output << '  end\n'
	output <- output << '  return nil\n'
	output <- output << 'end\n\n'
	output <- output << 'local function __oak_set(obj, key, value)\n'
	output <- output << '  if obj == nil or _oakType(obj) ~= "table" then return value end\n'
	output <- output << '  if _oakType(key) == "number" and key % 1 == 0 and key >= 0 and __oak_listp(obj) then\n'
	output <- output << '    obj[math.floor(key) + 1] = value\n'
	output <- output << '    return value\n'
	output <- output << '  end\n'
	output <- output << '  obj[key] = value\n'
	output <- output << '  return value\n'
	output <- output << 'end\n\n'
	output <- output << 'local function __as_oak_string(v)\n'
	output <- output << '  if v == nil then return "" end\n'
	output <- output << '  return _oakTostring(v)\n'
	output <- output << 'end\n\n'
	output <- output << 'local function __oak_add(a, b)\n'
	output <- output << '  if _oakType(a) == "number" and _oakType(b) == "number" then return a + b end\n'
	output <- output << '  return __as_oak_string(a) .. __as_oak_string(b)\n'
	output <- output << 'end\n\n'
	output <- output << 'local function __oak_and(a, b)\n'
	output <- output << '  if a == false then return false end\n'
	output <- output << '  return b\n'
	output <- output << 'end\n\n'
	output <- output << 'local function __oak_or(a, b)\n'
	output <- output << '  if a == true then return true end\n'
	output <- output << '  return b\n'
	output <- output << 'end\n\n'
	output <- output << 'local function __oak_xor(a, b)\n'
	output <- output << '  if _oakType(a) == "boolean" and _oakType(b) == "boolean" then\n'
	output <- output << '    return a ~= b\n'
	output <- output << '  end\n'
	output <- output << '  return a ~ b\n'
	output <- output << 'end\n\n'
	// ---- Oak builtins (bounded host surface) ----
	output <- output << 'local function type(v)\n'
	output <- output << '  local t = _oakType(v)\n'
	output <- output << '  if t == "table" then\n'
	output <- output << '    if __oak_listp(v) then return "list" end\n'
	output <- output << '    return "object"\n'
	output <- output << '  elseif t == "number" then\n'
	output <- output << '    if v % 1 == 0 then return "int" end\n'
	output <- output << '    return "float"\n'
	output <- output << '  elseif t == "boolean" then return "bool" end\n'
	output <- output << '  return t\n'
	output <- output << 'end\n\n'
	output <- output << 'local function len(x)\n'
	output <- output << '  if x == nil then return 0 end\n'
	output <- output << '  return #x\n'
	output <- output << 'end\n\n'
	output <- output << 'local function string(v)\n'
	output <- output << '  if v == nil then return "" end\n'
	output <- output << '  if _oakType(v) == "number" and v % 1 == 0 then return _oakTostring(_oakFloor(v)) end\n'
	output <- output << '  return _oakTostring(v)\n'
	output <- output << 'end\n\n'
	output <- output << 'local function int(v)\n'
	output <- output << '  local n = _oakTonumber(v)\n'
	output <- output << '  if n == nil then return 0 end\n'
	output <- output << '  if n >= 0 then return _oakFloor(n) else return _oakCeil(n) end\n'
	output <- output << 'end\n\n'
	output <- output << 'local function float(v)\n'
	output <- output << '  return _oakTonumber(v) or 0\n'
	output <- output << 'end\n\n'
	output <- output << 'local function char(n) return _oakStringchar(int(n) % 256) end\n\n'
	output <- output << 'local function codepoint(s)\n'
	output <- output << '  if s == nil or s == "" then return 0 end\n'
	output <- output << '  return _oakStringbyte(s, 1)\n'
	output <- output << 'end\n\n'
	output <- output << 'local function atom(n) return _oakTostring(n) end\n\n'
	output <- output << 'local function keys(t)\n'
	output <- output << '  local r = {}\n'
	output <- output << '  if t == nil then return r end\n'
	output <- output << '  if _oakType(t) == "table" and __oak_listp(t) then\n'
	output <- output << '    for i = 1, #t do r[#r + 1] = i - 1 end\n'
	output <- output << '    return r\n'
	output <- output << '  end\n'
	output <- output << '  for k in pairs(t) do r[#r + 1] = k end\n'
	output <- output << '  return r\n'
	output <- output << 'end\n\n'
	output <- output << 'local function acos(x) return math.acos(x) end\n'
	output <- output << 'local function asin(x) return math.asin(x) end\n'
	output <- output << 'local function atan(x, y) if y then return math.atan(x, y) end return math.atan(x) end\n'
	output <- output << 'local function cos(x) return math.cos(x) end\n'
	output <- output << 'local function sin(x) return math.sin(x) end\n'
	output <- output << 'local function tan(x) return math.tan(x) end\n'
	output <- output << 'local function pow(x, y) return x ^ y end\n\n'
	output <- output << 'local function print(s)\n'
	output <- output << '  if s == nil then s = "" end\n'
	output <- output << '  io.write(s)\n'
	output <- output << 'end\n\n'
	output <- output << 'local function time() return os.clock() end\n'
	output <- output << 'local function nanotime() return math.floor(os.clock() * 1000000000) end\n'
	output <- output << 'local function rand(n)\n'
	output <- output << '  if n == nil then return math.random() end\n'
	output <- output << '  if int(n) <= 1 then return 0 end\n'
	output <- output << '  return math.random(0, int(n) - 1)\n'
	output <- output << 'end\n'
	output <- output << 'local function srand(n) math.randomseed(int(n)) end\n\n'
	output <- output << 'local function env()\n'
	output <- output << '  return setmetatable({}, { __index = function(_, k) return os.getenv(k) end })\n'
	output <- output << 'end\n\n'
	output <- output << 'local function exit(code) os.exit(int(code or 0)) end\n\n'
	// Render the AST to Lua
	fn renderReturnLua(node) ?
	fn renderNode(node) { renderNodeMode(node, false) }
	fn renderChild(node) { renderNodeMode(node, false) }
	fn renderNodeMode(node, stmtMode) if node.type {
		:null -> 'nil'
		:empty -> 'nil'
		:string -> '\'' + (node.val |> map(fn(c) if c {
			'\\' -> '\\\\'
			'\'' -> '\\\''
			'\n' -> '\\n'
			'\r' -> '\\r'
			'\t' -> '\\t'
			_ -> c
		})) + '\''
		:int, :float, :bool -> string(node.val)
		:identifier -> luaIdent(node.val)
		:atom -> '\'' + node.val + '\''
		:list -> '{' + (node.elems |> map(renderNode) |> join(', ')) + '}'
		:object -> '{' + (node.entries |> map(fn(entry) {
			{ key: k, val: v } := entry
			if k.type {
				:identifier -> '["' + k.val + '"]=' + renderChild(v)
				:string -> '["' + k.val + '"]=' + renderChild(v)
				:int -> '[' + string(k.val) + ']=' + renderChild(v)
				_ -> '[' + renderChild(k) + ']=' + renderChild(v)
			}
		}) |> join(', ')) + '}'
		:unary -> if node.op {
			:minus -> '(-' + renderChild(node.right) + ')'
			:exclam -> '(not ' + renderChild(node.right) + ')'
		}
		:binary -> if node.op {
			:plus -> '__oak_add(' + renderChild(node.left) + ', ' + renderChild(node.right) + ')'
			:minus -> '(' + renderChild(node.left) + ' - ' + renderChild(node.right) + ')'
			:times -> '(' + renderChild(node.left) + ' * ' + renderChild(node.right) + ')'
			:divide -> '(' + renderChild(node.left) + ' / ' + renderChild(node.right) + ')'
			:modulus -> '(' + renderChild(node.left) + ' % ' + renderChild(node.right) + ')'
			:rshift -> '(' + renderChild(node.left) + ' >> ' + renderChild(node.right) + ')'
			:and -> '__oak_and(' + renderChild(node.left) + ', ' + renderChild(node.right) + ')'
			:xor -> '__oak_xor(' + renderChild(node.left) + ', ' + renderChild(node.right) + ')'
			:or -> '__oak_or(' + renderChild(node.left) + ', ' + renderChild(node.right) + ')'
			:eq -> '__oak_eq(' + renderChild(node.left) + ', ' + renderChild(node.right) + ')'
			:neq -> '(not __oak_eq(' + renderChild(node.left) + ', ' + renderChild(node.right) + '))'
			:greater -> '(' + renderChild(node.left) + ' > ' + renderChild(node.right) + ')'
			:less -> '(' + renderChild(node.left) + ' < ' + renderChild(node.right) + ')'
			:geq -> '(' + renderChild(node.left) + ' >= ' + renderChild(node.right) + ')'
			:leq -> '(' + renderChild(node.left) + ' <= ' + renderChild(node.right) + ')'
			:pushArrow -> '__oak_push(' + renderChild(node.left) + ', ' + renderChild(node.right) + ')'
		}
		:assignment -> if node.left.type {
			:propertyAccess -> {
				container := renderChild(node.left.left)
				key := if node.left.right.type {
					:identifier -> '"' + node.left.right.val + '"'
					:block -> if len(node.left.right.exprs) = 1 {
						true -> renderChild(node.left.right.exprs.0)
						_ -> renderChild(node.left.right)
					}
					_ -> renderChild(node.left.right)
				}
				'__oak_set(' + container + ', ' + key + ', ' + renderChild(node.right) + ')'
			}
			:object -> (if node.local? & stmtMode { true -> _oakAssignmentPrefix(node), _ -> '' }) +
				'(function()\nlocal __oak_assgn = ' + renderChild(node.right) + '\n' + {
				result := ''
				node.left.entries |> each(fn(entry) {
					{ key: k, val: v } := entry
					name := if v.type {
						:identifier -> v.val
						_ -> k.val
					}
					result <- result + luaIdent(name) + ' = __oak_assgn["' + k.val + '"]\n'
				})
				result
			} + 'return __oak_assgn\nend)()'
			:list -> (if node.local? & stmtMode { true -> _oakAssignmentPrefix(node), _ -> '' }) +
				'(function()\nlocal __oak_assgn = ' + renderChild(node.right) + '\n' + {
				result := ''
				node.left.elems |> each(fn(elem, i) if elem.type {
					:identifier -> result <- result + luaIdent(elem.val) + ' = __oak_assgn[' + string(i + 1) + ']\n'
					:empty -> ?
				})
				result
			} + 'return __oak_assgn\nend)()'
			_ -> if node.local? & stmtMode {
				true -> 'local ' + luaIdent(node.left.val) + ' = ' + renderChild(node.right)
				_ -> '(function() ' + luaIdent(node.left.val) + ' = ' + renderChild(node.right) + '; return ' + luaIdent(node.left.val) + ' end)()'
			}
		}
		:propertyAccess -> if node.right.type {
			:identifier -> renderChild(node.left) + '["' + node.right.val + '"]'
			_ -> '__oak_acc(' + renderChild(node.left) + ', ' + renderChild(node.right) + ')'
		}
		:ifExpr -> '(function()\n' + {
				result := ''
				node.branches |> each(fn(br, i) {
					prefix := if i { 0 -> 'if ', _ -> 'elseif ' }
					if br.target.type = :empty {
						true -> result <- result + 'else ' + renderReturnLua(br.body) + '\n'
						_ -> result <- result + prefix + '__oak_eq(__oak_cond, ' + renderChild(br.target) + ') then ' + renderReturnLua(br.body) + '\n'
					}
				})
				'local __oak_cond = ' + renderChild(node.cond) + '\n' + result + 'end\nend)()'
			}
		:block -> '(function()\n' + _oakOperandPreamble(node.exprs) + {
			result := ''
			lastIdx := len(node.exprs) - 1
			node.exprs |> each(fn(expr, i) {
				if i = lastIdx {
					true -> result <- result + renderReturnLua(expr) + '\n'
					_ -> result <- result + renderNodeMode(expr, true) + ';\n'
				}
			})
			result
		} + 'end)()'
		:function -> {
			args := if type(node.args) {
				:list -> node.args |> map(luaIdent) |> join(', ')
				_ -> ''
			}
			hasRest := type(node.restArg) = :string & node.restArg != ''
			restSuffix := if hasRest {
				true -> if args = '' { true -> '...', _ -> ', ...' }
				_ -> ''
			}
			restCapture := if hasRest {
				true -> 'local ' + luaIdent(node.restArg) + ' = {...};\n'
				_ -> ''
			}
			bodyPreamble := if node.body.type = :block {
				true -> _oakOperandPreamble(node.body.exprs)
				_ -> ''
			}
			fnBody := 'function(' + args + restSuffix + ')\n' + restCapture + bodyPreamble + {
				if node.body.type = :block {
					true -> {
						result := ''
						lastIdx := len(node.body.exprs) - 1
						node.body.exprs |> each(fn(expr, i) {
							if i = lastIdx {
								true -> result <- result + renderReturnLua(expr) + '\n'
								_ -> result <- result + renderNodeMode(expr, true) + ';\n'
							}
						})
						result
					}
					_ -> renderReturnLua(node.body) + '\n'
				}
			} + 'end'
			if node.name {
				'' -> fnBody
				? -> fnBody
				_ -> if stmtMode {
					true -> 'local ' + luaIdent(node.name) + ';\n' + luaIdent(node.name) + ' = ' + fnBody
					_ -> '(function() ' + luaIdent(node.name) + ' = ' + fnBody + '; return ' + luaIdent(node.name) + ' end)()'
				}
			}
		}
		:fnCall -> renderChild(node.function) + '(' + (node.args |> map(renderNode) |> join(', ')) + ')'
	}

	// Oak allows `x := e` anywhere an expression is legal; Lua does not.
	// Statement-position `x := e` renders as a Lua `local x = e` (RHS reads
	// the outer binding, exactly like Oak). Operand-position `x := e` renders
	// as a value-producing IIFE `(function() x = e; return x end)()` that
	// assigns a pre-declared upvalue. Every body pre-declares all locals that
	// bind in operand position (not crossing nested block/function/class
	// boundaries) at the top — mirroring the Go backend's collectBlockLocals.
	fn _oakIsBoundary?(node) type(node) = :object & (node.type = :function | node.type = :class | node.type = :block)

	fn _oakAddName?(acc, name) {
		if name != ? & type(name) = :string & !contains?(acc.names, name) {
			true -> acc.names <- acc.names << name
		}
		acc
	}

	// Collect the bound names of one local?-assignment node (plain or
	// destructured) without crossing boundaries.
	fn _oakCollectAssignment(node, acc) {
		if node.left.type {
			:identifier -> _oakAddName?(acc, node.left.val)
			:object -> {
				node.left.entries |> each(fn(entry) {
					{ key: k, val: v } := entry
					name := if v.type {
						:identifier -> v.val
						_ -> if k.type = :identifier | k.type = :string {
							true -> k.val
							_ -> ?
						}
					}
					_oakAddName?(acc, name)
				})
			}
			:list -> {
				node.left.elems |> each(fn(elem) if elem.type {
					:identifier -> _oakAddName?(acc, elem.val)
				})
			}
		}
		acc
	}

	// Walk a subtree without crossing block/function/class boundaries and
	// collect every bound local (destructured or plain) plus named fns.
	fn _oakCollectLocalsIn(node, acc) {
		if type(node) {
			:list -> {
				node |> each(fn(elem) _oakCollectLocalsIn(elem, acc))
				acc
			}
			:object -> if _oakIsBoundary?(node) {
				true -> acc
				_ -> {
					if node.type = :assignment & node.local? -> _oakCollectAssignment(node, acc)
					if node.type = :function & type(node.name) = :string & node.name != '' -> _oakAddName?(acc, node.name)
					keys(node) |> each(fn(k) {
						skip := node.type = :assignment & k = 'left'
						if !skip -> _oakCollectLocalsIn(node.(k), acc)
					})
					acc
				}
			}
			_ -> acc
		}
	}

	fn _oakPreambleLine(names) if len(names) > 0 {
		true -> 'local ' + (names |> map(luaIdent) |> join(', ')) + ';\n'
		_ -> ''
	}

	// Preamble for a body: every local that binds in OPERAND position anywhere
	// in the body (excluding the direct children's own statement bindings,
	// which emit their own statement locals). Ends with `;`.
	fn _oakOperandPreamble(exprs) {
		acc := { names: [] }
		exprs |> each(fn(e) {
			if _oakIsBoundary?(e) {
				true -> ?
				_ -> if type(e) = :object & e.type = :assignment & e.local? {
					true -> if e.right != ? {
						true -> _oakCollectLocalsIn(e.right, acc)
						_ -> acc
					}
					_ -> if type(e) = :object & e.type = :function {
						true -> acc
						_ -> _oakCollectLocalsIn(e, acc)
					}
				}
			}
		})
		_oakPreambleLine(acc.names)
	}

	// Bound names of a single local?-assignment node as a Lua statement-local
	// prefix (statement position only; operand position uses the preamble).
	fn _oakAssignmentPrefix(node) { 'local ' + (_oakCollectAssignment(node, { names: [] }).names |> map(luaIdent) |> join(', ')) + ';\n' }

	renderReturnLua <- fn(node) if {
		node.type = :function & type(node.name) = :string & node.name != '' -> renderNodeMode(node, true) + '\nreturn ' + luaIdent(node.name)
		node.type = :assignment -> if node.left.type {
			:propertyAccess -> renderChild(node) + '\nreturn ' + renderChild(node.left)
			:object, :list -> renderNodeMode(node, true) + '\nreturn __oak_assgn'
			_ -> renderNodeMode(node, true) + '\nreturn ' + luaIdent(node.left.val)
		}
		_ -> 'return ' + renderChild(node)
	}

	output <- output + renderNode(bundleNode) + '\n'
	output
}

// renderJavaBundle transpiles bundled Oak AST to Java 17+
fn renderJavaBundle(bundleNode) {
	javaReserved := ['abstract', 'assert', 'boolean', 'break', 'byte', 'case', 'catch'
		'char', 'class', 'const', 'continue', 'default', 'do', 'double', 'else'
		'enum', 'extends', 'final', 'finally', 'float', 'for', 'goto', 'if'
		'implements', 'import', 'instanceof', 'int', 'interface', 'long', 'native'
		'new', 'package', 'private', 'protected', 'public', 'return', 'short'
		'static', 'strictfp', 'super', 'switch', 'synchronized', 'this', 'throw'
		'throws', 'transient', 'try', 'void', 'volatile', 'while', 'var', 'yield'
		'record', 'sealed', 'permits', 'non-sealed']

	fn javaIdent(name) {
		clean := name |> clone()
		clean <- clean |> replace('?', '_qm') |> replace('!', '_exclam')
		javaReserved |> each(fn(kw) if clean = kw {
			true -> clean <- '__oak_java_' << clean
		})
		if clean = 'import' -> clean <- '__oak_module_import'
		clean
	}

	fn javaStr(s) {
		'"' << s |> map(fn(c) if c {
			'\\' -> '\\\\'
			'"' -> '\\"'
			'\n' -> '\\n'
			'\r' -> '\\r'
			'\t' -> '\\t'
			_ -> c
		}) << '"'
	}

	output := '// oak build --java\n'
	output <- output << '// Magnolia/Oak to Java transpiled bundle\n'
	output <- output << 'import java.util.*;\n'
	output <- output << 'import java.util.function.*;\n\n'

	output <- output << '@SuppressWarnings("unchecked")\n'
	output <- output << 'public class OakBundle {\n\n'

	// Oak runtime helpers as static methods
	output <- output << '  static final Map<String, Object> __Oak_Modules = new HashMap<>();\n'
	output <- output << '  static Map<String, String> __Oak_Import_Aliases = null;\n\n'

	output <- output << '  static Object __oak_eq(Object a, Object b) {\n'
	output <- output << '    if (a == null && b == null) return true;\n'
	output <- output << '    if (a == null || b == null) return false;\n'
	output <- output << '    if (a instanceof Map && b instanceof Map) {\n'
	output <- output << '      Map<?,?> ma = (Map<?,?>) a, mb = (Map<?,?>) b;\n'
	output <- output << '      if (ma.size() != mb.size()) return false;\n'
	output <- output << '      for (var e : ma.entrySet())\n'
	output <- output << '        if (!Boolean.TRUE.equals(__oak_eq(e.getValue(), mb.get(e.getKey())))) return false;\n'
	output <- output << '      return true;\n'
	output <- output << '    }\n'
	output <- output << '    return a.equals(b);\n'
	output <- output << '  }\n\n'

	output <- output << '  static List<Object> __oak_push(List<Object> list, Object val) {\n'
	output <- output << '    list.add(val); return list;\n'
	output <- output << '  }\n\n'

	output <- output << '  static Object __oak_acc(Object obj, Object key) {\n'
	output <- output << '    if (obj == null) return null;\n'
	output <- output << '    if (obj instanceof Map) return ((Map<?,?>) obj).get(key);\n'
	output <- output << '    if (obj instanceof List && key instanceof Number)\n'
	output <- output << '      return ((List<?>) obj).get(((Number) key).intValue());\n'
	output <- output << '    return null;\n'
	output <- output << '  }\n\n'

	output <- output << '  static String __as_oak_string(Object v) {\n'
	output <- output << '    if (v == null) return "";\n'
	output <- output << '    return String.valueOf(v);\n'
	output <- output << '  }\n\n'

	output <- output << '  static void __oak_modularize(String name, Function<Void, Object> factory) {\n'
	output <- output << '    __Oak_Modules.put(name, factory);\n'
	output <- output << '  }\n\n'

	output <- output << '  @SuppressWarnings("unchecked")\n'
	output <- output << '  static Object __oak_module_import(String name) {\n'
	output <- output << '    Object m = __Oak_Modules.get(name);\n'
	output <- output << '    if (m == null && __Oak_Import_Aliases != null)\n'
	output <- output << '      m = __Oak_Modules.get(__Oak_Import_Aliases.get(name));\n'
	output <- output << '    if (m == null) return null;\n'
	output <- output << '    if (m instanceof Function) {\n'
	output <- output << '      Object result = ((Function<Void, Object>) m).apply(null);\n'
	output <- output << '      __Oak_Modules.put(name, result);\n'
	output <- output << '      return result;\n'
	output <- output << '    }\n'
	output <- output << '    return m;\n'
	output <- output << '  }\n\n'

	// Render the AST to Java
	fn renderNode(node) if node.type {
		:null -> 'null'
		:empty -> 'null'
		:string -> javaStr(node.val)
		:int -> string(node.val)
		:float -> string(node.val)
		:bool -> string(node.val)
		:identifier -> javaIdent(node.val)
		:atom -> '"' << node.val << '"'
		:list -> 'new ArrayList<>(Arrays.asList(' << node.elems |> map(renderNode) |> join(', ') << '))'
		:object -> 'new HashMap<>(Map.of(' << node.entries |> map(fn(entry) {
			{ key: k, val: v } := entry
			if k.type {
				:identifier, :string -> '"' << k.val << '", ' << renderNode(v)
				:int -> 'String.valueOf(' << string(k.val) << '), ' << renderNode(v)
				_ -> renderNode(k) << ', ' << renderNode(v)
			}
		}) |> join(', ') << '))'
		:unary -> if node.op {
			:minus -> '(-((Number) ' << renderNode(node.right) << ').doubleValue())'
			:exclam -> '(!Boolean.TRUE.equals(' << renderNode(node.right) << '))'
		}
		:binary -> if node.op {
			:plus -> '(__as_oak_string(' << renderNode(node.left) << ') + __as_oak_string(' << renderNode(node.right) << '))'
			:minus -> '(((Number) ' << renderNode(node.left) << ').doubleValue() - ((Number) ' << renderNode(node.right) << ').doubleValue())'
			:times -> '(((Number) ' << renderNode(node.left) << ').doubleValue() * ((Number) ' << renderNode(node.right) << ').doubleValue())'
			:divide -> '(((Number) ' << renderNode(node.left) << ').doubleValue() / ((Number) ' << renderNode(node.right) << ').doubleValue())'
			:modulus -> '(((Number) ' << renderNode(node.left) << ').doubleValue() % ((Number) ' << renderNode(node.right) << ').doubleValue())'
			:and -> '(Boolean.TRUE.equals(' << renderNode(node.left) << ') ? ' << renderNode(node.right) << ' : false)'
			:or -> '(Boolean.TRUE.equals(' << renderNode(node.left) << ') ? true : ' << renderNode(node.right) << ')'
			:eq -> '__oak_eq(' << renderNode(node.left) << ', ' << renderNode(node.right) << ')'
			:neq -> '(!Boolean.TRUE.equals(__oak_eq(' << renderNode(node.left) << ', ' << renderNode(node.right) << ')))'
			:greater -> '(((Comparable) ' << renderNode(node.left) << ').compareTo(' << renderNode(node.right) << ') > 0)'
			:less -> '(((Comparable) ' << renderNode(node.left) << ').compareTo(' << renderNode(node.right) << ') < 0)'
			:geq -> '(((Comparable) ' << renderNode(node.left) << ').compareTo(' << renderNode(node.right) << ') >= 0)'
			:leq -> '(((Comparable) ' << renderNode(node.left) << ').compareTo(' << renderNode(node.right) << ') <= 0)'
			:pushArrow -> '__oak_push((List<Object>) ' << renderNode(node.left) << ', ' << renderNode(node.right) << ')'
		}
		:assignment -> if node.left.type {
			:propertyAccess -> {
				container := renderNode(node.left.left)
				key := if node.left.right.type {
					:identifier -> '"' << node.left.right.val << '"'
					_ -> 'String.valueOf(' << renderNode(node.left.right) << ')'
				}
				'((HashMap<String, Object>) ' << container << ').put(' << key << ', ' << renderNode(node.right) << ')'
			}
			:object -> '((Function<Void, Object>) (__oak_v) -> {\n' << {
				result := 'Object __oak_assgn = ' << renderNode(node.right) << ';\n'
				node.left.entries |> each(fn(entry) {
					{ key: k, val: v } := entry
					name := if v.type {
						:identifier -> v.val
						_ -> k.val
					}
					result <- result << javaIdent(name) << ' = __oak_acc(__oak_assgn, "' << k.val << '");\n'
				})
				result
			} << 'return __oak_assgn;\n}).apply(null)'
			:list -> '((Function<Void, Object>) (__oak_v) -> {\n' << {
				result := 'Object __oak_assgn = ' << renderNode(node.right) << ';\n'
				node.left.elems |> each(fn(elem, i) if elem.type {
					:identifier -> result <- result << javaIdent(elem.val) << ' = ((List<Object>) __oak_assgn).get(' << string(i) << ');\n'
					:empty -> ?
				})
				result
			} << 'return __oak_assgn;\n}).apply(null)'
			_ -> javaIdent(node.left.val) << ' = ' << renderNode(node.right)
		}
		:propertyAccess -> if node.right.type {
			:identifier -> '__oak_acc(' << renderNode(node.left) << ', "' << node.right.val << '")'
			_ -> '__oak_acc(' << renderNode(node.left) << ', ' << renderNode(node.right) << ')'
		}
		:ifExpr -> '((Function<Void, Object>) (__oak_v) -> {\n' << {
			result := ''
			node.branches |> each(fn(br, i) {
				prefix := if i { 0 -> 'if ', _ -> 'else if ' }
				if br.target.type = :empty {
					true -> result <- result << 'else { return ' << renderNode(br.body) << '; }\n'
					_ -> result <- result << prefix << '(Boolean.TRUE.equals(__oak_eq(__oak_cond, ' << renderNode(br.target) << '))) { return ' << renderNode(br.body) << '; }\n'
				}
			})
			'Object __oak_cond = ' << renderNode(node.cond) << ';\n' << result << 'return null;\n'
		} << '}).apply(null)'
		:block -> '((Function<Void, Object>) (__oak_v) -> {\n' << {
			result := ''
			lastIdx := len(node.exprs) - 1
			node.exprs |> each(fn(expr, i) {
				if i = lastIdx {
					true -> result <- result << 'return (Object) (' << renderNode(expr) << ');\n'
					_ -> result <- result << renderNode(expr) << ';\n'
				}
			})
			result
		} << '}).apply(null)'
		:function -> {
			args := node.args
			// Java lambdas with multiple statements need Function interface
			fnBody := '(Function<Object[], Object>) (__oak_args) -> {\n' + {
				// Destructure args
				argBindings := args |> map(fn(a, i) 'Object ' + javaIdent(a) + ' = __oak_args.length > ' + string(i) + ' ? __oak_args[' + string(i) + '] : null;\n') |> join('')
				argBindings + if node.body.type = :block {
					true -> {
						result := ''
						lastIdx := len(node.body.exprs) - 1
						node.body.exprs |> each(fn(expr, i) {
							if i = lastIdx {
								true -> result <- result + 'return (Object) (' + renderNode(expr) + ');\n'
								_ -> result <- result + renderNode(expr) + ';\n'
							}
						})
						result
					}
					_ -> 'return (Object) (' + renderNode(node.body) + ');\n'
				}
			} + '}'
			if node.name {
				'' -> fnBody
				_ -> javaIdent(node.name) + ' = ' + fnBody
			}
		}
		:fnCall -> '((Function<Object[], Object>) ' << renderNode(node.function) << ').apply(new Object[]{' << node.args |> map(renderNode) |> join(', ') << '})'
	}

	output <- output << '  public static void main(String[] args) {\n'
	output <- output << '    ' << renderNode(bundleNode) << ';\n'
	output <- output << '  }\n'
	output <- output << '}\n'
	output
}

// renderGoBundle transpiles the Oak AST bundle to Go source code.
fn renderGoBundle(bundleNode) {
	codegenGo := import('codegen-go')
	codegenGo.renderGoBundle(bundleNode)
}

// renderCBundle transpiles the Oak AST bundle to self-contained C11
// ("Goose+ Mode", TODO-14). --cc additionally invokes the system compiler
// to produce a native binary next to the emitted source.
fn renderCBundle(bundleNode) {
	codegenC := import('codegen-c')
	codegenC.renderCBundle(bundleNode)
}

// renderNativeBundle compiles the Oak AST bundle to native machine code
// and links it into an executable binary.
fn renderNativeBundle(bundleNode) {
	nativeCodegen := import('codegen-native')
	linker := import('linker')

	irCompiler := nativeCodegen.createIRCompiler()
	irProgram := irCompiler.compile(bundleNode)

	// Detect host OS/arch
	sysInfo := ___runtime_sys_info()
	arch := if sysInfo.arch {
		'arm64', 'aarch64' -> :arm64
		_ -> :x86_64
	}
	format := if sysInfo.os {
		'windows' -> :pe
		'darwin' -> :macho
		_ -> :elf
	}

	generator := if arch {
		:arm64 -> nativeCodegen.createARM64Generator()
		_ -> nativeCodegen.createX86_64Generator()
	}

	compiled := generator.compile(irProgram)

	result := linker.link({
		format: format
		arch: arch
		textCode: compiled.code
		dataBytes: []
	})

	// Return raw binary bytes as string
	result.binary |> map(fn(b) char(b)) |> join('')
}

// renderGraphBundle generates a Mermaid dependency graph from the build's
// ModuleNodes map and recursively resolves stdlib imports so the full
// transitive dependency tree is shown.  Project modules are grouped in one
// subgraph, stdlib modules in another; every edge in the transitive closure
// is rendered so the complete tree is visible.
fn renderGraphBundle(bundleNode) {
	mermaid := import('mermaid')

	// Sanitize a module name/path into a Mermaid-safe node id
	fn sanitizeId(s) {
		s |> replace('/', '_') |> replace('\\', '_') |> replace('.', '_') |> replace('-', '_') |> replace(' ', '_') |> replace(':', '_')
	}

	// Short display name from a path (last segment)
	fn shortName(p) {
		parts := p |> split('/')
		bparts := p |> split('\\')
		use := if len(bparts) > len(parts) {
			true -> bparts
			_ -> parts
		}
		if len(use) > 0 {
			true -> use.(len(use) - 1)
			_ -> p
		}
	}

	// Extract all static import('name') calls from an AST node list
	fn extractImports(nodes) {
		imports := []
		fn walk(node) if type(node) = :object {
			true -> if node.type {
				:block -> if type(node.exprs) = :list {
					true -> node.exprs |> each(walk)
				}
				:assignment -> if {
					node.local? = true &
					type(node.right) = :object &
					node.right.type = :fnCall &
					type(node.right.function) = :object &
					node.right.function.type = :identifier &
					node.right.function.val = 'import' &
					len(node.right.args) = 1 &
					type(node.right.args.(0)) = :object &
					node.right.args.(0).type = :string -> {
						imports <- imports << node.right.args.(0).val
					}
				}
				_ -> ?
			}
		}
		if type(nodes) = :list {
			true -> nodes |> each(walk)
			_ -> walk(nodes)
		}
		imports
	}

	// Resolve the import list for any module name.  For modules in ModuleNodes
	// we already have the AST; for stdlib modules we fetch the source via
	// ___runtime_lib and parse it on the fly.
	resolvedCache := {}
	fn resolveImports(name) if cached := resolvedCache.(name) {
		? -> {
			imports := if ast := ModuleNodes.(name) {
				? -> if ___runtime_lib?(name) {
					true -> {
						src := ___runtime_lib(name)
						if nodes := syntax.parse(src) {
							{ type: :error } -> []
							_ -> extractImports(nodes)
						}
					}
					_ -> []
				}
				_ -> extractImports(ast)
			}
			resolvedCache.(name) <- imports
			imports
		}
		_ -> cached
	}

	// Walk the full dependency tree starting from a set of root names.
	// Returns { name: [importName, ...], ... } for every reachable module.
	fn walkTree(roots) {
		visited := {}
		fn visit(name) if visited.(name) {
			? -> {
				visited.(name) <- true
				imports := resolveImports(name)
				imports |> each(visit)
			}
			_ -> ?
		}
		roots |> each(visit)
		// Build result map for every visited module
		result := {}
		visited |> keys() |> each(fn(name) {
			result.(name) <- resolveImports(name)
		})
		result
	}

	// Collect module paths from the build and walk the full tree
	moduleKeys := ModuleNodes |> keys()
	fullTree := walkTree(moduleKeys)
	allNames := fullTree |> keys()

	// Classify each module
	fn isProjectModule?(name) ModuleNodes.(name) != ?

	// --- Build the graph ---
	g := mermaid.graph(:lr)
	g |> mermaid.setTitle('Module Dependency Graph')

	// Partition names into project modules and stdlib modules
	projectNames := []
	stdlibNames := []
	allNames |> each(fn(name) if isProjectModule?(name) {
		true -> projectNames <- projectNames << name
		_ -> stdlibNames <- stdlibNames << name
	})

	// Helper to pick node shape
	fn shapeFor(name) if name = AbsoluteEntry {
		true -> mermaid.ShapeStadium
		_ -> if isProjectModule?(name) {
			true -> mermaid.ShapeRect
			_ -> mermaid.ShapeRound
		}
	}

	// Add project modules subgraph (if more than one project file)
	if len(projectNames) > 1 {
		true -> g |> mermaid.subgraph('project_modules', 'Project Modules', fn(sg) {
			projectNames |> each(fn(name) {
				id := sanitizeId(name)
				label := shortName(name)
				sg |> mermaid.node(id, label, shapeFor(name))
			})
		})
		_ -> projectNames |> each(fn(name) {
			id := sanitizeId(name)
			label := shortName(name)
			g |> mermaid.node(id, label, shapeFor(name))
		})
	}

	// Group stdlib modules into families based on common prefix (before first
	// hyphen), e.g. email-smtp, email-pop → "email" family.
	stdlibFamilies := {}
	stdlibNames |> each(fn(name) {
		parts := name |> split('-')
		family := if len(parts) > 1 {
			true -> parts.(0)
			_ -> name
		}
		if stdlibFamilies.(family) = ? -> stdlibFamilies.(family) <- []
		stdlibFamilies.(family) <- stdlibFamilies.(family) << name
	})

	// Render each stdlib family: families with >1 member get a subgraph,
	// singletons are placed in a catch-all "Stdlib" subgraph.
	singletons := []
	familyKeys := stdlibFamilies |> keys()
	familyKeys |> each(fn(fam) {
		members := stdlibFamilies.(fam)
		if len(members) > 1 {
			true -> g |> mermaid.subgraph('stdlib_' << sanitizeId(fam), fam, fn(sg) {
				members |> each(fn(name) {
					id := sanitizeId(name)
					sg |> mermaid.node(id, name, shapeFor(name))
				})
			})
			_ -> singletons <- singletons << members.(0)
		}
	})
	if len(singletons) > 0 -> g |> mermaid.subgraph('stdlib_core', 'Standard Library', fn(sg) {
		singletons |> each(fn(name) {
			id := sanitizeId(name)
			sg |> mermaid.node(id, name, shapeFor(name))
		})
	})

	// Add all edges across the full tree (deduplicated)
	seenEdges := {}
	allNames |> each(fn(name) {
		fromId := sanitizeId(name)
		deps := fullTree.(name)
		if deps != ? -> deps |> each(fn(dep) {
			toId := sanitizeId(dep)
			edgeKey := fromId + '->' + toId
			if seenEdges.(edgeKey) {
				? -> {
					seenEdges.(edgeKey) <- true
					g |> mermaid.edge(fromId, toId)
				}
				_ -> ?
			}
		})
	})

	// Output as HTML or Mermaid text depending on file extension
	graphText := mermaid.render(g)

	if Output != ? {
		true -> {
			outParts := Output |> split('.')
			ext := if len(outParts) > 1 {
				true -> outParts.(len(outParts) - 1)
				_ -> ''
			}
			if ext {
				'html', 'htm' -> mermaid.renderHTML(g)
				_ -> graphText
			}
		}
		_ -> graphText
	}
}

// renderBundle transforms a bundle's AST nodes to compiled program text
fn renderBundle(bundleNode) {
	buildRender.renderBundle(
		bundleNode
		Target
		renderOakBundle
		renderJSBundle
		renderWasmBundle
		renderAstBundle
		renderBinBundle
		renderDocBundle
		renderTsBundle
		renderLuaBundle
		renderJavaBundle
		renderGoBundle
		renderNativeBundle
		renderGraphBundle
		renderCBundle
	)
}

fn runOak(config) {
	applyConfig(config)

	// clear state for repeated invocations from non-CLI callers
	ModuleNodes <- {}
	transpile.clearTranspilers()

	// Start from entrypoint and explicit includes, collect all static imports
	Log(format('[oak build] Bundling with entrypoint {{0}}', Entry))
	Log(format('[oak build] AbsoluteEntry = {{0}}', AbsoluteEntry))
	Includes |> with each() fn(spec) if ___runtime_lib?(spec.name) {
		true -> if Web? | Ts? -> addImportsFromSource(spec.name, ___runtime_lib(spec.name))
		_ -> if ModuleNodes.(spec.path) = ? -> addImportsFromFile(spec.path)
	}
	Log('[oak build] About to import entry file...')
	if config.source != ? {
		true -> addImportsFromSource(AbsoluteEntry, config.source)
		_ -> addImportsFromFile(AbsoluteEntry)
	}
	Log('[oak build] Import resolution complete.')

	Log(format('[oak build] Compiling {{0}} modules...', len(ModuleNodes |> keys())))

	// compile the import map into a bundle with an entrypoint and render to
	// bundle program text
	moduleKeys := ModuleNodes |> keys() |> sort!()
	compiledModules := pmap(moduleKeys, fn(name) [name, name |> cachedParse() |> transform.wrapBlock() |> transpile.transpileNode() |> analyzeNode() |> wrapModule()])
	BundleFile := compiledModules |>
		wrapBundle(AbsoluteEntry) |>
		renderBundle()

	Log('[oak build] Rendering complete.')

	if config.inMemory? = true {
		true -> {type: :ok, value: BundleFile, target: Target}
		_ -> if writeFile(Output, BundleFile) {
			? -> {type: :error, message: format('[oak build] Could not write bundle to {{0}}', Output)}
			_ -> {
				Log(format('[oak build] Bundle written to {{0}}', Output))
				if CC? {
					// --cc: compile the emitted C with the system compiler
					true -> {
						ccOut := if str.endsWith?(Output, '.c') {
							true -> str.slice(Output, 0, len(Output) - 2)
							_ -> Output + '.out'
						}
						ccRes := exec('gcc', ['-O3', '-march=native', '-o', ccOut, Output, '-lm'], '')
						if ccRes.status = 0 {
							true -> Log(format('[oak build] Native binary written to {{0}}', ccOut))
							_ -> std.println('[oak build] gcc failed:\n' + ccRes.stderr)
						}
					}
					_ -> ?
				}
				{type: :ok, value: BundleFile, target: Target}
			}
		}
	}
}
// Dispatch JVM inputs through the verified applet adapter, then use the
// ordinary Builder engine for Oak -> JS. Native Oak uses the applet emitter
// until the generic Oak renderer can compile this generated runtime correctly.
fn jvmInput?(entry) {
    name := if type(entry) = :string {true -> str.lower(entry), _ -> ''}
    str.endsWith?(name, '.class') | str.endsWith?(name, '.jar') |
    str.endsWith?(name, '.zip') | str.endsWith?(name, '.java') |
    str.endsWith?(name, '.applet.json') |
    str.endsWith?(name, '.applet') | str.endsWith?(name, '.html') |
    str.endsWith?(name, '.htm') | str.endsWith?(name, '.jnlp')
}
// Reverse Builder route: verified, edited standalone Oak -> new .class or
// unsigned .jar. No supplied Oak code is executed during bytecode assembly.
fn editedOakBinary?(config) type(config.entry) = :string & type(config.output) = :string &
    str.endsWith?(str.lower(config.entry), '.oak') &
    (str.endsWith?(str.lower(config.output), '.class') |
     str.endsWith?(str.lower(config.output), '.jar'))
fn findAppletAdapter(directory, depth) if depth >= 32 {
    true -> ?
    _ -> {
        candidate := resolve('lib/build-applet.oak', directory)
        if statFile(candidate) != ? {
            true -> candidate
            _ -> if dir(directory) = directory {
                true -> ?
                _ -> findAppletAdapter(dir(directory), depth + 1)
            }
        }
    }
}
fn recompileOakBinary(config) {
    problem := ?
    if config.web? = true | config.wasm? = true | config.java? = true |
        config.ts? = true | config.lua? = true | config.go? = true |
        config.native? = true | config.ast? = true | config.bin? = true |
        config.doc? = true | config.graph? = true ->
        problem <- 'Oak-to-class/JAR cannot use another Builder target flag'
    source := config.source |> default(if problem = ? {true -> readFile(config.entry), _ -> ?})
    if source = ? & problem = ? -> problem <- 'cannot read edited Oak source: ' + config.entry
    opts := config.applet |> default({})
    adapterPath := opts.adapterPath |>
        default(env().MAGNOLIA_APPLET_ADAPTER) |>
        default(if statFile(resolve('lib/build-applet.oak')) != ? {
            true -> resolve('lib/build-applet.oak')
            _ -> findAppletAdapter(dir(resolve(config.entry)), 0)
        })
    if problem = ? & adapterPath = ? ->
        problem <- 'Magnolia applet adapter not found; supply applet.adapterPath'
    compiled := if problem = ? {
        true -> import(resolve('applet-recompile.oak', dir(adapterPath))).fromOak(source)
        _ -> ?
    }
    if problem = ? & compiled.type = :error -> problem <- compiled.message
    jar? := str.endsWith?(str.lower(config.output), '.jar')
    if problem = ? & !jar? & len(compiled.value) != 1 ->
        problem <- 'Oak archive contains multiple classes; output a .jar with an original JAR, or use api.recompileOak / build recompile --output DIRECTORY'
    if problem = ? & jar? & compiled.originalJar = ? ->
        problem <- 'Oak archive has no original JAR; use a class output'
    if problem = ? & config.inMemory? != true & statFile(config.output) != ? ->
        problem <- 'refusing to overwrite ' + config.output
    packed := if problem = ? & jar? & compiled.changedInstructions > 0 {
        true -> import(resolve('jvm-jar-write.oak', dir(adapterPath))).repack(
            compiled.originalJar, compiled.value)
        _ -> ?
    }
    if problem = ? & packed != ? & packed.type = :error -> problem <- packed.message
    if problem != ? {
        true -> {type: :error, message: problem}
        _ -> {
            bytes := if jar? {
                true -> if packed = ? {true -> compiled.originalJar, _ -> packed.value}
                _ -> compiled.value.(0)
            }
            target := if jar? {true -> 'jar', _ -> 'class'}
            if config.inMemory? = true {
                true -> {type: :ok, target: target, value: bytes,
                    changedInstructions: compiled.changedInstructions, entry: compiled.entry}
                _ -> if writeFile(config.output, bytes) = ? {
                    true -> {type: :error, message: 'could not write ' + target + ' ' + config.output}
                    _ -> {type: :ok, target: target, value: bytes,
                        changedInstructions: compiled.changedInstructions, entry: compiled.entry}
                }
            }
        }
    }
}
fn run(config) if editedOakBinary?(config) {
    true -> recompileOakBinary(config)
    _ -> if jvmInput?(config.entry) {
    true -> {
        // Lazy loading keeps ordinary Oak builds independent of applet files.
        // An alternate location may be provided programmatically for callers
        // outside the Magnolia checkout.
        config.applet <- config.applet |> default({})
        adapterPath := config.applet.adapterPath |>
            default(env().MAGNOLIA_APPLET_ADAPTER) |>
            default(if statFile(resolve('lib/build-applet.oak')) != ? {
                true -> resolve('lib/build-applet.oak')
                _ -> findAppletAdapter(dir(resolve(config.entry)), 0)
            })
        if adapterPath = ? {
            true -> {type: :error, message: 'Magnolia applet adapter not found; supply applet.adapterPath'}
            _ -> {
                config.applet.adapterPath <- adapterPath
                buildApplet := import(adapterPath)
                buildApplet.run(config, runOak)
            }
        }
    }
    _ -> runOak(config)
    }
}
