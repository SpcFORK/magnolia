            true -> ?
            _ -> if !_int32?(offset) | !_int32?(stride) |
                stride < width | offset < 0 |
                offset + (height - 1) * stride + width > len(source) {
                true -> fail(state, if indexed? {
                    true -> 'MemoryImageSource byte window outside bounded array'
                    _ -> 'MemoryImageSource int window outside bounded array'
                })
                _ -> {
                    image := _rasterNew(width, height, state)
                    if state.error = ? &
                        _rasterCharge(state, 0, count) -> {
                        range(height) |> std.each(fn(y) range(width) |>
                            std.each(fn(x) {
                                pixel := source.(offset + y * stride + x)
                                image.raster.(y * width + x) <- if indexed? {
                                    true -> producer.model.palette.(pixel & 255)
                                    _ -> i32(pixel)
                                }
                            }))
                    }
                    image
                }
            }
        }
    }
}
fn _rasterARGB(color) i32(4278190080 | (color.red << 16) |
    (color.green << 8) | color.blue)
fn _rasterBlit(program, graphics, source, x, y, observer, state) if
    !_rasterClip?(graphics) | !_rasterImage?(source) |
    !_int32?(x) | !_int32?(y) | x < -16384 | x > 16384 |
    y < -16384 | y > 16384 |
    (observer != ? & !_isInstance(program, observer, 'java/awt/image/ImageObserver')) {
    true -> fail(state, 'drawImage requires bounded rasters, coordinates and ImageObserver')
    _ -> if graphics.image.refId = source.refId {
        true -> fail(state, 'overlapping self-image blit is outside bounded AWT subset')
        _ -> {
            target := graphics.image
            x0 := if x > graphics.clipX0 {true -> x, _ -> graphics.clipX0}
            y0 := if y > graphics.clipY0 {true -> y, _ -> graphics.clipY0}
            x1 := if x + source.width < graphics.clipX1 {
                true -> x + source.width, _ -> graphics.clipX1}
            y1 := if y + source.height < graphics.clipY1 {
                true -> y + source.height, _ -> graphics.clipY1}
            width := if x1 > x0 {true -> x1 - x0, _ -> 0}
            height := if y1 > y0 {true -> y1 - y0, _ -> 0}
            if _rasterCharge(state, 0, width * height) {
                true -> {
                    range(y0, y1) |> std.each(fn(row) range(x0, x1) |>
                        std.each(fn(col) {
                            pixel := source.raster.((row - y) * source.width + col - x)
                            // IndexedColorModel(8,256,RGB) is opaque; a blank
                            // image is transparent. Refuse unmodeled partial alpha.
                            alpha := (pixel >> 24) & 255
                            if alpha = 255 {
                                true -> target.raster.(row * target.width + col) <- pixel
                                _ -> if alpha != 0 -> fail(state,
                                    'partial AWT image alpha outside bounded subset')
                            }
                        }))
                    1
                }
                _ -> ?
            }
        }
    }
}
fn _rasterFill(graphics, x, y, width, height, outline?, state) {
    image := graphics.image
    if !_rasterClip?(graphics) | !_int32?(x) | !_int32?(y) |
        !_int32?(width) | !_int32?(height) | width < -1 |
        height < -1 | width > 4096 | height > 4096 {
        true -> fail(state, 'draw rectangle outside bounded image subset')
        _ -> {
            endX := x + width + if outline? {true -> 1, _ -> 0}
            endY := y + height + if outline? {true -> 1, _ -> 0}
            x0 := if x > graphics.clipX0 {true -> x, _ -> graphics.clipX0}
            y0 := if y > graphics.clipY0 {true -> y, _ -> graphics.clipY0}
            x1 := if endX < graphics.clipX1 {true -> endX, _ -> graphics.clipX1}
            y1 := if endY < graphics.clipY1 {true -> endY, _ -> graphics.clipY1}
            cols := if x1 > x0 {true -> x1 - x0, _ -> 0}
            rows := if y1 > y0 {true -> y1 - y0, _ -> 0}
            if _rasterCharge(state, 0, cols * rows) {
                true -> {
                    pixel := _rasterARGB(graphics.color)
                    range(y0, y1) |> std.each(fn(row) range(x0, x1) |>
                        std.each(fn(col) if !outline? | row = y |
                            row = y + height | col = x | col = x + width ->
                            image.raster.(row * image.width + col) <- pixel))
                    ?
                }
                _ -> ?
            }
        }
    }
}

// An optional trusted headless capture sink snapshots one original Fliplay
// first frame and then up to sixty scheduled display frames. It is NOT a
// substitute for the original VM calls; caller-provided export work is
// charged before invocation and capped independently from image allocations.
fn _captureFrame(state, image, number) if state.frameSink != ? &
    state.error = ? & state.thrown = ? &
    number != state.lastCapturedFrame {
    true -> if !_rasterImage?(image) | !_int32?(number) |
        number < 0 | number > 60 | state.captureCount >= 61 |
        image.width != 320 | image.height != 240 |
        state.captureCells > 5000000 - 76800 {
        true -> fail(state, 'headless frame capture outside 61-frame/5M-cell bound')
        _ -> if _rasterCharge(state, 0, 76800 * 3) {
            true -> {
                state.captureCells <- state.captureCells + 76800
                state.captureCount <- state.captureCount + 1
                state.lastCapturedFrame <- number
                state.frameSink(image, number)
                ?
            }
            _ -> ?
        }
    }
}

// Repaint requests coalesce until the next bounded Thread.sleep yield. The
// deterministic scheduler then invokes the ORIGINAL update(Graphics) bytecode
// against one metered off-screen canvas. No OS/AWT worker thread or display is
// created, and no event is silently drawn merely because repaint was called.
fn _drainRepaint(program, state) {
    count := 0
    fn drain() if state.pendingRepaint != ? & state.error = ? &
        state.thrown = ? {
        true -> {
            target := state.pendingRepaint
            state.pendingRepaint <- ?
            count <- count + 1
            if count > 128 | !_isInstance(program, target, 'java/applet/Applet') {
                true -> fail(state, 'bounded repaint event cannot be delivered')
                _ -> {
                    if state.screen = ? -> state.screen <-
                        _rasterNew(state.viewportWidth, state.viewportHeight, state)
                    if state.error = ? {
                        true -> {
                            graphics := _rasterGraphics(state.screen, state)
                            if state.error = ? -> execute(program, target.className,
                                'update', '(Ljava/awt/Graphics;)V', [graphics],
                                target, state)
                            if state.error = ? & state.thrown = ? &
                                state.frameSink != ? &
                                target.fields.('fliplay.loaded:Z') = 1 ->
                                _captureFrame(state, state.screen,
                                    target.fields.('fliplay.frame_number:I'))
                        }
                    }
                    drain()
                }
            }
        }
    }
    drain()
}

// An independently JDK-checked, narrow Graphics.fillPolygon subset: a
// centered, isosceles left/right arrow with a vertical base (the original
// Fliplay init icon). Java2D's general polygon edge rasterization is NOT
// modeled; reject other shapes instead of producing plausible wrong pixels.
// Integer quarter-pixel tests avoid JS floating-point differences. Clipping,
// source arrays, and the worst-case scan are checked/charged before drawing.
fn _arrowPixel(x, y, xs, ys) {
    sampleX := 4 * x + 1
    sampleY := 4 * y + 1
    inside := false
    range(3) |> std.each(fn(i) {
        j := (i + 1) % 3
        y0 := ys.(i)
        y1 := ys.(j)
        if (sampleY < 4 * y0) != (sampleY < 4 * y1) {
            true -> {
                cross := (sampleX - 4 * xs.(i)) * (y1 - y0) -
                    (sampleY - 4 * y0) * (xs.(j) - xs.(i))
                if (y1 > y0 & cross < 0) | (y1 < y0 & cross > 0) ->
                    inside <- !inside
            }
        }
    })
    inside
}
fn _rasterArrow(graphics, xPoints, yPoints, nPoints, state) {
    image := graphics.image
    if !_rasterClip?(graphics) | !_arraycopyArray?(xPoints) |
        !_arraycopyArray?(yPoints) | xPoints.className != '[I' |
        yPoints.className != '[I' | xPoints.tag != 10 |
        yPoints.tag != 10 | !_int32?(nPoints) | nPoints != 3 |
        len(xPoints.values) < 3 | len(yPoints.values) < 3 {
        true -> fail(state, 'fillPolygon requires two bounded int arrays and three arrow points')
        _ -> {
            xs := [xPoints.values.(0), xPoints.values.(1), xPoints.values.(2)]
            ys := [yPoints.values.(0), yPoints.values.(1), yPoints.values.(2)]
            base := xs.(0)
            apex := xs.(1)
            top := ys.(0)
            validCoordinates := (xs |> std.every(_int32?)) &
                (ys |> std.every(_int32?))
            height := if validCoordinates {true -> ys.(2) - top, _ -> 0}
            valid := validCoordinates & base = xs.(2) &
                top >= -16384 & ys.(2) <= 16384 &
                base >= -16384 & base <= 16384 &
                apex >= -16384 & apex <= 16384 &
                height >= 2 & height <= 64 & height % 2 = 0 &
                ys.(1) = top + int(height / 2) &
                (apex = base + height | apex = base - height)
            if !valid {
                true -> fail(state, 'fillPolygon outside bounded centered-arrow raster subset')
                _ -> {
                    left := if base < apex {true -> base, _ -> apex}
                    right := if base > apex {true -> base, _ -> apex}
                    x0 := if left > graphics.clipX0 {
                        true -> left, _ -> graphics.clipX0}
                    x1 := if right + 1 < graphics.clipX1 {
                        true -> right + 1, _ -> graphics.clipX1}
                    y0 := if top > graphics.clipY0 {
                        true -> top, _ -> graphics.clipY0}
                    y1 := if top + height + 1 < graphics.clipY1 {
                        true -> top + height + 1, _ -> graphics.clipY1}
                    cols := if x1 > x0 {true -> x1 - x0, _ -> 0}
                    rows := if y1 > y0 {true -> y1 - y0, _ -> 0}
                    if _rasterCharge(state, 0, cols * rows * 3 + 6) {
                        true -> {
                            pixel := _rasterARGB(graphics.color)
                            range(y0, y1) |> std.each(fn(y) range(x0, x1) |>
                                std.each(fn(x) if _arrowPixel(x, y, xs, ys) ->
                                    image.raster.(y * image.width + x) <- pixel))
                            ?
                        }
                        _ -> ?
                    }
                }
            }
        }
    }
}

// Java ME offscreen Image island. The source Java methods execute as owned
// bytecode; only their seven exact ImageBridge descriptors enter this native
// host. Resources were decoded/verified by midlet.run BEFORE construction.
// Runtime allocations/copies/fills are additionally charged to the VM and to
// a separate cumulative pixel/work budget. Default calls are offscreen; the
// trusted opt-in one-frame MIDP host also reuses this charged image as its
// modeled Canvas surface. This is NOT AWT or a real handset display. Never
// allow it from a Java SE applet/program profile.
_MIDP_IMAGE := 'javax/microedition/lcdui/Image'
_MIDP_GRAPHICS := 'javax/microedition/lcdui/Graphics'
fn _midpImage?(value) type(value) = :object &
    value.className = _MIDP_IMAGE & value.midpReady? = true &
    _int32?(value.width) & _int32?(value.height) &
    value.width >= 1 & value.height >= 1 &
    type(value.midpPixels) = :list &
    len(value.midpPixels) = value.width * value.height
fn _midpGraphics?(value) type(value) = :object &
    value.className = _MIDP_GRAPHICS & value.midpReady? = true &
    _midpImage?(value.midpImage) & value.midpImage.midpMutable? = true &
    _int32?(value.midpColor)
fn _midpCharge(state, cells, work) {
    used := state.midpImageCells |> default(0)
    cumulative := state.midpWorkCells |> default(0)
    steps := 1 + int((work + 63) / 64)
    if type(used) != :int | type(cumulative) != :int |
        cells < 0 | work < 0 |
        cells > 131072 - used | work > 262144 - cumulative |
        steps > state.maxSteps - state.steps {
        true -> fail(state, 'MIDP Image pixel/work/instruction budget exceeded')
        _ -> {
            state.midpImageCells <- used + cells
            state.midpWorkCells <- cumulative + work
            state.steps <- state.steps + steps
            true
        }
    }
}
fn _midpNew(program, width, height, pixels, mutable?, state) {
    if !_int32?(width) | !_int32?(height) |
        width < 1 | height < 1 {
        true -> _raiseJava(state, 'java/lang/IllegalArgumentException',
            'Image dimensions must be positive')
        _ -> if width > 512 | height > 256 | width * height > 65536 |
            (pixels != ? & (type(pixels) != :list |
             len(pixels) != width * height)) {
            true -> fail(state, 'MIDP Image geometry outside bounded indexed profile')
            _ -> {
                cells := width * height
                if _midpCharge(state, cells, cells) {
                    true -> {
                        image := newObject(program, _MIDP_IMAGE, state)
                        if state.error != ? | state.thrown != ? {
                            true -> ?
                            _ -> {
                                image.width <- width
                                image.height <- height
                                image.midpPixels <- if pixels = ? {
                                    true -> range(cells) |> map(fn(_) 4294967295)
                                    _ -> std.slice(pixels, 0, cells)
                                }
                                image.midpMutable? <- mutable?
                                image.midpReady? <- true
                                image.fields.(_MIDP_IMAGE + '.width:I') <- width
                                image.fields.(_MIDP_IMAGE + '.height:I') <- height
                                image.fields.(_MIDP_IMAGE + '.mutable:Z') <-
                                    if mutable? {true -> 1, _ -> 0}
                                image
                            }
                        }
                    }
                    _ -> ?
                }
            }
        }
    }
}
// The original Acotel uses Graphics.LEFT|TOP (20) on all six Image calls.
// Checked binary-alpha PNGs/opaque mutable images only: transparent source
// pixels retain the destination, opaque pixels replace it. Unsupported alpha,
// anchors or self-blits fail before changing ANY target pixel. This is an
// offscreen raster operation, not an LCDUI screen paint or image scaling.
fn _midpBlit(graphics, source, x, y, anchor, state) {
    if !_midpGraphics?(graphics) | !_midpImage?(source) |
        !_int32?(x) | !_int32?(y) | !_int32?(anchor) |
        x < -4096 | x > 4096 | y < -4096 | y > 4096 |
        anchor != 20 {
        true -> fail(state, 'MIDP drawImage outside top-left bounded raster profile')
        _ -> {
            target := graphics.midpImage
            if source.refId = target.refId {
                true -> fail(state, 'MIDP drawImage self-blit is unsupported')
                _ -> {
                    x0 := if x < 0 {true -> 0, _ -> x}
                    y0 := if y < 0 {true -> 0, _ -> y}
                    x1 := if x + source.width < target.width {
                        true -> x + source.width, _ -> target.width}
                    y1 := if y + source.height < target.height {
                        true -> y + source.height, _ -> target.height}
                    cols := if x1 > x0 {true -> x1 - x0, _ -> 0}
                    rows := if y1 > y0 {true -> y1 - y0, _ -> 0}
                    if _midpCharge(state, 0, cols * rows * 2) {
                        true -> {
                            supported? := true
                            std.range(rows) |> std.each(fn(ry) std.range(cols) |>
                                std.each(fn(rx) {
                                    pixel := source.midpPixels.((y0 + ry - y) *
                                        source.width + x0 + rx - x)
                                    alpha := int(_u32(pixel) / 16777216)
                                    if alpha != 0 & alpha != 255 -> supported? <- false
                                }))
                            if !supported? {
                                true -> fail(state, 'MIDP drawImage requires binary-alpha source')
                                _ -> {
                                    std.range(rows) |> std.each(fn(ry) {
                                        std.range(cols) |> std.each(fn(rx) {
                                            pixel := source.midpPixels.((y0 + ry - y) *
                                                source.width + x0 + rx - x)
                                            if int(_u32(pixel) / 16777216) = 255 ->
                                                target.midpPixels.((y0 + ry) * target.width +
                                                    x0 + rx) <- pixel
                                        })
                                    })
                                    ?
                                }
                            }
                        }
                        _ -> ?
                    }
                }
            }
        }
    }
}
fn _midpBridge(program, op, args, state) if program.midpProfile? != true {
    true -> fail(state, 'ImageBridge requires the selected MIDlet profile')
    _ -> if op {
        'midp-image-blank' -> _midpNew(program, args.(0), args.(1), ?, true, state)
        'midp-image-load' -> if !_string?(args.(0)) {
            true -> _raiseJava(state, 'java/lang/NullPointerException',
                'null Image resource path')
            _ -> {
                path := args.(0).text
                name := if len(path) > 1 & len(path) <= 65 &
                    path.(0) = '/' {
                    true -> std.slice(path, 1), _ -> ?
                }
                safe? := if name = ? {
                    true -> false
                    _ -> std.range(len(name)) |> std.every(fn(i) {
                        str.contains?('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-',
                            name.(i))
                    })
                }
                if !safe? {
                    true -> fail(state, 'MIDP Image resource path outside simple local-JAR profile')
                    _ -> {
                        source := state.midpImages.('asset:' + name)
                        if source = ? {
                            true -> _raiseJava(state, 'java/io/IOException',
                                'Image resource not selected: ' + name)
                            _ -> _midpNew(program, source.width, source.height,
                                source.pixels, false, state)
                        }
                    }
                }
            }
        }
        'midp-image-graphics' -> {
            image := args.(0)
            if !_midpImage?(image) | image.midpMutable? != true {
                true -> fail(state, 'getGraphics requires a mutable modeled MIDP Image')
                _ -> _tagRef(state, {className: _MIDP_GRAPHICS,
                    fields: {}, midpImage: image, midpColor: 0, midpReady?: true})
            }
        }
        'midp-graphics-blit' -> _midpBlit(args.(0), args.(1), args.(2),
            args.(3), args.(4), state)
        'midp-graphics-clip-width' -> if program.midpOnePaint? != true |
            !_midpGraphics?(args.(0)) {
            true -> fail(state, 'Canvas clip width requires an opt-in modeled Graphics')
            _ -> args.(0).midpImage.width
        }
        'midp-image-rgb' -> {
            image := args.(0)
            dst := args.(1)
            off := args.(2)
            stride := args.(3)
            x := args.(4)
            y := args.(5)
            width := args.(6)
            height := args.(7)
            if !_midpImage?(image) {
                true -> fail(state, 'getRGB requires a modeled MIDP Image')
                _ -> if dst = ? {
                    true -> _raiseJava(state, 'java/lang/NullPointerException',
                        'null getRGB destination')
                    _ -> if type(dst) != :object | dst.className != '[I' |
                        dst.tag != 10 | type(dst.values) != :list |
                        !_int32?(off) | !_int32?(stride) | !_int32?(x) |
                        !_int32?(y) | !_int32?(width) | !_int32?(height) {
                        true -> fail(state, 'getRGB requires an int[] and int32 rectangle')
                        _ -> if width < 1 | height < 1 | stride < width |
                            x < 0 | y < 0 | width > image.width - x |
                            height > image.height - y |
                            width * height > state.maxArray |
                            off < 0 | off + (height - 1) * stride + width > len(dst.values) {
                            true -> _raiseJava(state,
                                'java/lang/IndexOutOfBoundsException',
                                'getRGB region or destination bounds')
                            _ -> if _midpCharge(state, 0, width * height) {
                                true -> {
                                    range(height) |> std.each(fn(ry) {
                                        range(width) |> std.each(fn(rx) {
                                            dst.values.(off + ry * stride + rx) <-
                                                i32(image.midpPixels.((y + ry) * image.width + x + rx))
                                        })
                                    })
                                    ?
                                }
                                _ -> ?
                            }
                        }
                    }
                }
            }
        }
        'midp-graphics-color-set', 'midp-graphics-color-get',
        'midp-graphics-fill' -> {
            graphics := args.(0)
            if !_midpGraphics?(graphics) {
                true -> fail(state, 'Graphics method requires a mutable offscreen Image')
                _ -> if op = 'midp-graphics-color-get' {
                    true -> graphics.midpColor
                    _ -> if op = 'midp-graphics-color-set' {
                        true -> if !_int32?(args.(1)) {
                            true -> fail(state, 'Graphics color requires an int32 RGB value')
                            _ -> {
                                // The pinned MicroEmulator keeps all 32
                                // argument bits in Graphics.getColor().
                                graphics.midpColor <- args.(1)
                                ?
                            }
                        }
                        _ -> {
                            x := args.(1)
                            y := args.(2)
                            width := args.(3)
                            height := args.(4)
                            image := graphics.midpImage
                            if !_int32?(x) | !_int32?(y) |
                                !_int32?(width) | !_int32?(height) |
                                x < -4096 | x > 4096 | y < -4096 | y > 4096 |
                                width < -4096 | width > 4096 |
                                height < -4096 | height > 4096 {
                                true -> fail(state, 'Graphics fill rectangle outside bounded profile')
                                _ -> {
                                    x0 := if x < 0 {true -> 0, _ -> x}
                                    y0 := if y < 0 {true -> 0, _ -> y}
                                    x1 := if x + width > image.width {
                                        true -> image.width, _ -> x + width}
                                    y1 := if y + height > image.height {
                                        true -> image.height, _ -> y + height}
                                    cols := if width > 0 & x1 > x0 {
                                        true -> x1 - x0, _ -> 0}
                                    rows := if height > 0 & y1 > y0 {
                                        true -> y1 - y0, _ -> 0}
                                    if _midpCharge(state, 0, cols * rows) {
                                        true -> {
                                            pixel := 4278190080 | graphics.midpColor
                                            range(y0, y0 + rows) |> std.each(fn(row) {
                                                range(x0, x0 + cols) |> std.each(fn(col) {
                                                    image.midpPixels.(row * image.width + col) <- pixel
                                                })
                                            })
                                            ?
                                        }
                                        _ -> ?
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        _ -> fail(state, 'unsupported ImageBridge operation ' + op)
    }
}

// Deliberately synthetic, caller-supplied MIDP free-memory snapshot. It is
// constant during one finite session: allocations are capped elsewhere, but
// are NOT debited against this number. gc records a request; it cannot collect
// or claim a real MicroEmulator/JDK heap. With no explicit value, refuse.
fn _midpRuntimeCall(program, op, recv, state) if program.midpProfile? != true |
    state.midpVirtualFreeBytes = ? {
    true -> fail(state, 'Runtime requires an explicit finite MIDlet virtual free-memory snapshot')
    _ -> if op = 'midp-runtime-get' {
        true -> if recv != ? {
            true -> fail(state, 'Runtime.getRuntime requires a static invocation')
            _ -> {
                if state.midpRuntimeRef = ? ->
                    state.midpRuntimeRef <- _tagRef(state, {
                        className: 'java/lang/Runtime', fields: {}})
                state.midpRuntimeRef
            }
        }
        _ -> if type(recv) != :object | recv != state.midpRuntimeRef |
            recv.className != 'java/lang/Runtime' {
            true -> fail(state, 'Runtime method requires the session singleton')
            _ -> if op {
                'midp-runtime-free' -> _long(0, state.midpVirtualFreeBytes)
                'midp-runtime-gc' -> {
                    if state.midpRuntimeGcCalls >= 4 {
                        true -> fail(state, 'virtual Runtime.gc call budget exceeded')
                        _ -> {
                            state.midpRuntimeGcCalls <- state.midpRuntimeGcCalls + 1
                            ?
                        }
                    }
                }
                _ -> fail(state, 'unsupported MIDP Runtime operation')
            }
        }
    }
}

// The CLDC Random island uses the Java 48-bit LCG with two 24-bit limbs.
// All products/carries stay below 2^53 in standalone JS as well as native
// Oak. Do not convert a JVM long seed to a JS Number or ask the host clock
// for the default constructor. Unseeded objects may be allocated (the
// original Acotel does exactly that), but CANNOT be sampled until setSeed.
fn _midpRandomSeed(recv, seed) {
    recv.randomLo24 <- (seed.lo ^ 15525485) & 16777215
    recv.randomHi24 <- (((seed.hi & 65535) * 256 +
        int(seed.lo / 16777216)) ^ 1502) & 16777215
    recv.randomSeeded? <- true
    ?
}
fn _midpRandomDraw(recv, state) if !recv.randomSeeded? {
    true -> fail(state, 'MIDP Random() requires setSeed before sampling; device clock is not modeled')
    _ -> {
        draws := state.midpRandomDraws |> default(0)
        if type(draws) != :int | draws >= 4096 |
            state.steps >= state.maxSteps {
            true -> fail(state, 'MIDP Random draw/VM-step budget exceeded')
            _ -> {
                // (old * 0x5DEECE66D + 11) mod 2^48, exact limbs.
                low := recv.randomLo24 * 15525485 + 11
                hi := (recv.randomHi24 * 15525485 +
                    recv.randomLo24 * 1502 + int(low / 16777216)) & 16777215
                recv.randomLo24 <- low & 16777215
                recv.randomHi24 <- hi
                state.midpRandomDraws <- draws + 1
                state.steps <- state.steps + 1
                hi * 256 + int(recv.randomLo24 / 65536)
            }
        }
    }
}
fn _midpRandomBound(recv, bound, state) if !_int32?(bound) {
    true -> fail(state, 'MIDP Random bound requires int32')
    _ -> if bound <= 0 {
        true -> _raiseJava(state, 'java/lang/IllegalArgumentException',
            'Random.nextInt bound must be positive')
        _ -> if (bound & (bound - 1)) = 0 {
            true -> {
                sample := _midpRandomDraw(recv, state)
                if state.error != ? {true -> ?, _ -> int(int(sample / 2) /
                    int(2147483648 / bound))}
            }
            _ -> {
                // Java's signed-32 rejection test prevents modulo bias.
                fn attempt(remaining) if remaining = 0 {
                    true -> fail(state, 'MIDP Random bounded rejection budget exceeded')
                    _ -> {
                        sample := _midpRandomDraw(recv, state)
                        if state.error != ? {
                            true -> ?
                            _ -> {
                                bits := int(sample / 2)
                                value := bits % bound
                                if i32(bits - value + bound - 1) < 0 {
                                    true -> attempt(remaining - 1)
                                    _ -> value
                                }
                            }
                        }
                    }
                }
                attempt(32)
            }
        }
    }
}
fn _midpRandomCall(program, op, recv, args, state) if
    program.midpProfile? != true {
    true -> fail(state, 'Random requires a selected MIDlet profile')
    _ -> if type(recv) != :object |
        recv.className != 'java/util/Random' {
        true -> fail(state, 'Random requires a modeled receiver')
        _ -> if op {
            'midp-random-init-unseeded', 'midp-random-init-seeded' ->
                if recv.randomReady? {
                    true -> fail(state, 'Random constructor called twice')
                    _ -> if op = 'midp-random-init-seeded' & !_long?(args.(0)) {
                        true -> fail(state, 'Random constructor requires a JVM long seed')
                        _ -> {
                            recv.randomReady? <- true
                            if op = 'midp-random-init-seeded' ->
                                _midpRandomSeed(recv, args.(0))
                            ?
                        }
                    }
                }
            'midp-random-seed', 'midp-random-next', 'midp-random-bound' ->
                if !recv.randomReady? {
                    true -> fail(state, 'Random method before constructor')
                    _ -> if op = 'midp-random-seed' {
                        true -> if !_long?(args.(0)) {
                            true -> fail(state, 'Random.setSeed requires a JVM long')
                            _ -> _midpRandomSeed(recv, args.(0))
                        }
                        _ -> if op = 'midp-random-next' {
                            true -> {
                                sample := _midpRandomDraw(recv, state)
                                if state.error != ? {true -> ?, _ -> i32(sample)}
                            }
                            _ -> _midpRandomBound(recv, args.(0), state)
                        }
                    }
                }
            _ -> fail(state, 'unsupported MIDP Random operation')
        }
    }
}

// JDK Math.atan2 has strict signed-zero rules. Only axes and equal-magnitude
// diagonals with finite, nonzero magnitudes <=4096 are admitted. Return the
// JDK 11 raw binary64 constants, not a host libm approximation; all other
// angles, NaNs and infinities refuse BEFORE emitting a decimal approximation.
fn _boundedAtan2(y, x, state) if !fp.double?(y) | !fp.double?(x) {
    true -> fail(state, 'Math.atan2 requires JVM doubles')
    _ -> {
        yk := fp.kind(y)
        xk := fp.kind(x)
        if (yk != :zero & yk != :finite) |
            (xk != :zero & xk != :finite) {
            true -> fail(state, 'Math.atan2 outside finite axis/diagonal subset')
            _ -> {
                yn := fp.numeric(y)
                xn := fp.numeric(x)
                ya := if yn < 0 {true -> 0.0 - yn, _ -> yn}
                xa := if xn < 0 {true -> 0.0 - xn, _ -> xn}
                if ya > 4096 | xa > 4096 |
                    (yk = :finite & ya = 0) |
                    (xk = :finite & xa = 0) {
                    true -> fail(state, 'Math.atan2 outside finite axis/diagonal subset')
                    _ -> if yk = :zero {
                        true -> if (xk = :zero & fp.sign(x) = 1) |
                            (xk = :finite & xn < 0) {
                            true -> fp.f64(1074340347 +
                                if fp.sign(y) = 1 {true -> 2147483648, _ -> 0},
                                1413754136)
                            _ -> fp.zero(true, fp.sign(y) = 1)
                        }
                        _ -> if xk = :zero {
                            true -> fp.f64(1073291771 +
                                if fp.sign(y) = 1 {true -> 2147483648, _ -> 0},
                                1413754136)
                            _ -> if ya = xa {
                                true -> fp.f64(if xn < 0 {
                                    true -> 1073928572, _ -> 1072243195} +
                                    if fp.sign(y) = 1 {
                                        true -> 2147483648, _ -> 0},
                                    if xn < 0 {true -> 2134057426,
                                        _ -> 1413754136})
                                _ -> fail(state,
                                    'Math.atan2 outside finite axis/diagonal subset')
                            }
                        }
                    }
                }
            }
        }
    }
}
// The same VM-library member contract gates both preflight and dispatch.
// This guard also applies to hand-constructed or edited Oak IR. Stateful
// services (output, AWT, applet params) remain in the bounded runtime;
// pure int and ASCII String services execute in the shared VM library.
fn _hostCall(program, owner, name, desc, opcode, recv, args, state) {
    spec := vmLib.jvmMethod(owner, name, desc, opcode)
    if spec = ? | type(args) != :list | len(args) != spec.argc {
        true -> fail(state, 'unsupported JVM library call ' + owner + '.' + name + desc)
        // Preserve a compiled AppletContext override before the record-only
        // host fallback. The Component host overrides use the same principle.
        _ -> if owner = 'java/applet/Applet' & opcode = 182 &
            spec.op = 'applet-context' & type(recv) = :object &
            program.classes.(recv.className) != ? &
            _findMethod(program, recv.className, name, desc) != ? {
            true -> execute(program, recv.className, name, desc, args,
                recv, state)
            // invokevirtual on Component must honor a preflighted user
            // override before using any built-in detached host behavior.
            _ -> if owner = 'java/awt/Component' & opcode = 182 &
            (spec.op = 'component-background-set' |
             spec.op = 'component-background-get' |
             spec.op = 'component-background-is-set' |
             spec.op = 'component-foreground-set' |
             spec.op = 'component-foreground-get' |
             spec.op = 'component-foreground-is-set' |
             spec.op = 'component-headless-model' |
             spec.op = 'component-detached-graphics' |
             spec.op = 'component-detached-showing') &
            type(recv) = :object &
            program.classes.(recv.className) != ? &
            _findMethod(program, recv.className, name, desc) != ? {
            true -> execute(program, recv.className, name, desc, args,
                recv, state)
            _ -> if owner = 'java/awt/Component' &
            (spec.op = 'raster-image-new' |
             spec.op = 'raster-image-source' |
             spec.op = 'bounded-repaint' |
             spec.op = 'bounded-size' |
             spec.op = 'bounded-focus' |
             spec.op = 'bounded-legacy-event') &
            !_isInstance(program, recv, 'java/applet/Applet') {
            true -> fail(state, 'detached non-Applet Component cannot use unmodeled image/repaint/focus/event host')
            _ -> _hostAdmitted(program, owner, name, desc, opcode, recv, args, state, spec)
        }
        }
        }
    }
}
fn _hostAdmitted(program, owner, name, desc, opcode, recv, args, state, spec) if owner {
    'javax/microedition/lcdui/ImageBridge' ->
        _midpBridge(program, spec.op, args, state)
    'java/util/Random' -> _midpRandomCall(program, spec.op, recv, args, state)
    'java/lang/Runtime' -> _midpRuntimeCall(program, spec.op, recv, state)
    'java/lang/Thread' -> if program.midpProfile? = true &
        !std.contains?(['bounded-thread-init', 'bounded-thread-alive',
                        'bounded-thread-start', 'bounded-thread-sleep'], spec.op) {
        true -> fail(state, 'Thread member outside finite MIDP task profile')
        _ -> if spec.op {
        'bounded-current-thread' -> if recv = ? & state.currentThreadRef != ? {
            true -> state.currentThreadRef
            _ -> fail(state, 'Thread.currentThread outside bounded Runnable task')
        }
        'bounded-thread-sleep' -> if recv != ? | state.currentThreadRef = ? |
            !_long?(args.(0)) | args.(0).hi != 0 |
            args.(0).lo > 10000 |
            args.(0).lo > 60000 - state.virtualMillis {
            true -> fail(state, 'Thread.sleep outside bounded virtual-clock task')
            _ -> {
                state.virtualMillis <- state.virtualMillis + args.(0).lo
                _drainRepaint(program, state)
                ?
            }
        }
        'bounded-thread-yield' -> if recv != ? |
            state.startedTasks > 1 | state.pendingRepaint != ? |
            state.yieldCount >= 128 {
            true -> fail(state, 'Thread.yield outside the single-task no-pending-event profile')
            _ -> {
                // JDK yield is only a scheduling hint. There is no second
                // runnable task here, so never advance logical time, drain
                // an AWT queue or promise OS scheduling parity.
                state.yieldCount <- state.yieldCount + 1
                ?
            }
        }
        _ -> if recv = ? | recv.className != 'java/lang/Thread' {
            true -> fail(state, 'Thread method on non-Thread receiver')
            _ -> if spec.op {
                'bounded-thread-init' -> if recv.threadReady? |
                    args.(0) = ? |
                    !_isInstance(program, args.(0), 'java/lang/Runnable') |
                    program.classes.(args.(0).className) = ? {
                    true -> fail(state, 'Thread constructor requires a compiled Runnable')
                    _ -> {
                        recv.threadTarget <- args.(0)
                        recv.threadReady? <- true
                        ?
                    }
                }
                'bounded-thread-alive' -> if recv.threadReady? {
                    true -> if recv.threadAlive? {true -> 1, _ -> 0}
                    _ -> fail(state, 'Thread.isAlive on uninitialized task')
                }
                'bounded-thread-priority' -> if !recv.threadReady? |
                    !_int32?(args.(0)) {
                    true -> fail(state, 'Thread.setPriority requires an initialized task')
                    _ -> if args.(0) < 1 | args.(0) > 10 {
                        true -> _raiseJava(state, 'java/lang/IllegalArgumentException',
                            'Thread priority outside 1..10')
                        _ -> recv.priority <- args.(0)
                    }
                }
                'bounded-thread-stop' -> if recv.threadAlive? {
                    true -> fail(state, 'forced stop of live Runnable task is unsupported')
                    _ -> ?
                }
                'bounded-thread-start' -> if !recv.threadReady? |
                    recv.threadStarted? | recv.threadAlive? |
                    state.currentThreadRef != ? | state.startedTasks >= 4 {
                    true -> fail(state, 'Thread.start outside single-task bounded scheduler')
                    _ -> {
                        state.startedTasks <- state.startedTasks + 1
                        recv.threadStarted? <- true
                        recv.threadAlive? <- true
                        state.currentThreadRef <- recv
                        state.currentTaskId <- recv.refId
                        target := recv.threadTarget
                        execute(program, target.className, 'run', '()V', [],
                            target, state)
                        recv.threadAlive? <- false
                        state.currentThreadRef <- ?
                        state.currentTaskId <- 0
                        ?
                    }
                }
                _ -> fail(state, 'unsupported bounded Thread operation')
            }
        }
        }
    }
    'java/lang/System' -> if recv = ? & spec.op = 'arraycopy' {
        true -> _arraycopy(program, args, state)
        _ -> if recv = ? & spec.op = 'system-gc-request' {
            true -> ? // Java System.gc is advisory, not observable GC.
            _ -> if recv = ? & spec.op = 'virtual-current-millis' {
                true -> if state.virtualClockEpochMillis = ? |
                    !_int32?(state.virtualMillis) |
                    state.virtualMillis < 0 | state.virtualMillis > 60000 {
                    true -> fail(state,
                        'System.currentTimeMillis requires an explicit finite virtual-clock epoch')
                    _ -> {
                        // This is a caller-selected logical clock, NEVER the
                        // OS clock. The single-task scheduler advances it only
                        // at bounded Thread.sleep yields (before repaint).
                        millis := state.virtualClockEpochMillis + state.virtualMillis
                        _long(int(millis / 4294967296), millis % 4294967296)
                    }
                }
                _ -> if recv = ? & spec.op = 'virtual-java-version' {
                    true -> if !_string?(args.(0)) |
                        args.(0).text != 'java.version' |
                        !vmLib.jvmVersion?(state.virtualJavaVersion) {
                        true -> fail(state,
                            'System.getProperty requires explicit virtual java.version key and value')
                        _ -> if state.virtualJavaVersionRef != ? {
                            true -> state.virtualJavaVersionRef
                            _ -> {
                                state.virtualJavaVersionRef <- _newString(state,
                                    state.virtualJavaVersion)
                                state.virtualJavaVersionRef
                            }
                        }
                    }
                    _ -> fail(state, 'unsupported JVM System call ' + name + desc)
                }
            }
        }
    }
    'java/lang/Double' -> if recv = ? & len(args) = 1 {
        true -> if spec.op {
            'double-raw-bits', 'double-bits' -> if fp.double?(args.(0)) {
                true -> if spec.op = 'double-bits' &
                    fp.kind(args.(0)) = :nan {
                    true -> _long(2146959360, 0)
                    _ -> _long(args.(0).hi, args.(0).lo)
                }
                _ -> fail(state, 'Double.doubleToLongBits requires a JVM double')
            }
            'double-from-bits' -> if _long?(args.(0)) {
                true -> fp.f64(_u32(args.(0).hi), args.(0).lo)
                _ -> fail(state, 'Double.longBitsToDouble requires a JVM long')
            }
            _ -> fail(state, 'unsupported JVM Double intrinsic')
        }
        _ -> fail(state, 'invalid JVM Double receiver or arity')
    }
    'java/lang/Float' -> if recv = ? & len(args) = 1 {
        true -> if spec.op {
            'float-raw-bits', 'float-bits' -> if fp.float?(args.(0)) {
                true -> if spec.op = 'float-bits' &
                    fp.kind(args.(0)) = :nan {
                    true -> 2143289344
                    _ -> _s32(args.(0).bits)
                }
                _ -> fail(state, 'Float.floatToIntBits requires a JVM float')
            }
            'float-from-bits' -> if _int32?(args.(0)) {
                true -> fp.f32(_u32(args.(0)))
                _ -> fail(state, 'Float.intBitsToFloat requires an int32')
            }
            _ -> fail(state, 'unsupported JVM Float intrinsic')
        }
        _ -> fail(state, 'invalid JVM Float receiver or arity')
    }
    'java/lang/Math', 'java/lang/Integer' -> if spec.op {
        'bounded-atan2' -> if owner != 'java/lang/Math' | recv != ? {
            true -> fail(state, 'Math.atan2 requires static invocation')
            _ -> _boundedAtan2(args.(0), args.(1), state)
        }
        'boxed-int-value' -> if recv = ? {
            true -> _raiseJava(state, 'java/lang/NullPointerException',
                'null Integer.intValue receiver')
            _ -> if type(recv) != :object |
                recv.className != 'java/lang/Integer' |
                !_int32?(recv.boxedInt) {
                true -> fail(state, 'Integer.intValue requires a boxed Integer')
                _ -> recv.boxedInt
            }
        }
        'boxed-int-string', 'boxed-int-radix' -> if
            (args.(0) != ? & !_string?(args.(0))) |
            (spec.op = 'boxed-int-radix' & !_int32?(args.(1))) {
            true -> fail(state, 'Integer.valueOf requires a String and optional int32 radix')
            _ -> {
                raw := _stringText(args.(0))
                outOfProfile := false
                if raw != ? {
                    true -> if len(raw) > 4096 {
                        true -> outOfProfile <- true
                        _ -> std.range(len(raw)) |> std.each(fn(i) {
                            if codepoint(raw.(i)) > 127 -> outOfProfile <- true
                        })
                    }
                }
                if outOfProfile {
                    true -> fail(state, 'Integer.valueOf requires at most 4096 ASCII characters')
                    _ -> {
                        inputs := if spec.op = 'boxed-int-radix' {
                            true -> [raw, args.(1)], _ -> [raw]}
                        outcome := vmLib.jvmInvoke(spec, inputs)
                        if outcome.type = :error {
                            true -> _raiseJava(state,
                                'java/lang/NumberFormatException', outcome.message)
                            _ -> _boxedInteger(state, outcome.value)
                        }
                    }
                }
            }
        }
        _ -> {
            passed := if spec.op = 'parse-int' {
                true -> [_stringText(args.(0))], _ -> args}
            outcome := vmLib.jvmInvoke(spec, passed)
            if outcome.type = :error {
                true -> if spec.op = 'parse-int' {
                    true -> _raiseJava(state, 'java/lang/NumberFormatException',
                        outcome.message)
                    _ -> fail(state, outcome.message)
                }
                _ -> if spec.op = 'int-string' {
                    true -> _newString(state, outcome.value), _ -> outcome.value}
            }
        }
    }
    'java/lang/String' -> if spec.op = 'bounded-ascii-index-of-string' {
        true -> if opcode != 182 | !_string?(recv) {
            true -> fail(state, 'String.indexOf(String) requires a String receiver')
            _ -> if args.(0) = ? {
                true -> _raiseJava(state, 'java/lang/NullPointerException',
                    'String.indexOf(null)')
                _ -> if !_string?(args.(0)) |
                    len(recv.text) > 4096 | len(args.(0).text) > 128 |
                    (std.range(len(recv.text)) |>
                        std.some(fn(i) codepoint(recv.text.(i)) > 127)) |
                    (std.range(len(args.(0).text)) |>
                        std.some(fn(i) codepoint(args.(0).text.(i)) > 127)) {
                    true -> fail(state,
                        'String.indexOf(String) requires bounded ASCII')
                    _ -> {
                        // Charge the worst-case character comparisons before
                        // entering Oak's literal substring search.
                        cost := 1 + len(recv.text) * len(args.(0).text)
                        if cost > state.maxSteps - state.steps {
                            true -> fail(state, 'String.indexOf(String) search budget exceeded')
                            _ -> {
                                state.steps <- state.steps + cost
                                needle := args.(0).text
                                limit := len(recv.text) - len(needle)
                                found := -1
                                if limit >= 0 -> std.range(limit + 1) |>
                                    std.each(fn(i) if found = -1 &
                                        (std.range(len(needle)) |>
                                            std.every(fn(j) recv.text.(i + j) = needle.(j))) ->
                                        found <- i)
                                found
                            }
                        }
                    }
                }
            }
        }
        _ -> if spec.op = 'string-object-value-of' {
        true -> if opcode != 184 | recv != ? {
            true -> fail(state, 'String.valueOf(Object) requires a static call')
            _ -> if args.(0) = ? {
                true -> _internString(state, 'null')
                _ -> if _string?(args.(0)) {
                    true -> args.(0) // String.toString() preserves identity.
                    _ -> fail(state, 'String.valueOf(Object) requires a verifier-known String or null')
                }
            }
        }
        _ -> if spec.op = 'string-init-copy' {
        true -> if !_string?(recv) | !_string?(args.(0)) {
            true -> fail(state, 'String copy constructor requires a String')
            _ -> {
                recv.text <- args.(0).text
                ?
            }
        }
        _ -> if spec.op = 'bounded-ascii-char-array-init' {
            true -> if !_string?(recv) {
                true -> fail(state, 'String(char[]) requires a new String receiver')
                _ -> if args.(0) = ? {
                    true -> _raiseJava(state, 'java/lang/NullPointerException',
                        'String(char[]) source is null')
