// applet-runtime — a bounded, headless interpreter for the verified subset
// emitted by applet-bytecode. No Java, network, filesystem or AWT host calls.
// Works under Magnolia and in its generated JavaScript bundles.

std := import('std')
str := import('str')
default := std.default
range := std.range
map := std.map
fmt := import('fmt')
format := fmt.format
vmLib := import('./jvm-vm-libs.oak')
fp := import('./jvm-fp.oak')

fn _wide?(value) _long?(value) | fp.double?(value)
fn i32(n) {
	u := n & 4294967295
	if u >= 2147483648 {true -> u - 4294967296, _ -> u}
}
fn truncDiv(a, b) {
	q := a / b
	if q < 0 {true -> 0 - int(0 - q), _ -> int(q)}
}
// Exact signed 64-bit JVM longs are represented as two 32-bit limbs in a
// {jvmLong: true, hi, lo} record. All long arithmetic is abstracted onto the
// shared int64 module (lib/int64.oak) so this runtime stays free of inlined
// limb-level primitives.
int64 := import('./int64.oak')

fn _u32(n) int64.u32(n)
fn _s32(n) int64.s32(n)
fn _long?(v) int64.long?(v)
fn _long(hi, lo) int64.long(hi, lo)
fn _longAdd(a, b, state) if !int64.long?(a) | !int64.long?(b) {
    true -> fail(state, 'long arithmetic requires two JVM long values')
    _ -> int64.add(a, b)
}
fn _longSub(a, b, state) if !int64.long?(a) | !int64.long?(b) {
    true -> fail(state, 'long arithmetic requires two JVM long values')
    _ -> int64.sub(a, b)
}
fn _longMul(a, b, state) if !int64.long?(a) | !int64.long?(b) {
    true -> fail(state, 'long multiplication requires two JVM long values')
    _ -> int64.mul(a, b)
}
fn _longBitwise(a, b, op, state) if !int64.long?(a) | !int64.long?(b) {
    true -> fail(state, 'long bitwise operation requires two JVM long values')
    _ -> if op {
        127 -> int64.and(a, b)
        129 -> int64.or(a, b)
        131 -> int64.xor(a, b)
        _ -> fail(state, 'unsupported long bitwise operation')
    }
}
// JVM masks a long shift count to six bits; the right-hand operand is int.
fn _longShift(value, distance, op, state) if !int64.long?(value) |
    !_int32?(distance) {
    true -> fail(state, 'long shift requires a JVM long and int32 distance')
    _ -> if op {
        121 -> int64.shiftLeft(value, distance)
        123 -> int64.shiftRightSigned(value, distance)
        125 -> int64.shiftRightUnsigned(value, distance)
        _ -> fail(state, 'unsupported long shift operation')
    }
}
fn _negLongBits(value) int64.neg(value)
fn _unsignedLongCmp(a, b) int64.cmpUnsigned(a, b)
fn _longDivRem(a, b, op, state) if !int64.long?(a) | !int64.long?(b) {
    true -> fail(state, 'long division requires two JVM long values')
    _ -> if b.hi = 0 & b.lo = 0 {
        true -> _raiseJava(state, 'java/lang/ArithmeticException',
            '/ by zero')
        _ -> {
            result := int64.divRem(a, b)
            if result.type = :error -> fail(state, result.message)
            if op = 109 {
                true -> result.quotient
                _ -> result.remainder
            }
        }
    }
}
// f2l/d2l truncate toward zero and saturate at the signed long limits.
// Convert only finite magnitudes below 2^63, splitting at 2^32 so JS never
// needs an imprecise 64-bit integer or BigInt. The original pool bits survive
// unchanged through stores, calls and array operations.
fn _fpToLong(value, state) if !fp.float?(value) & !fp.double?(value) {
    true -> fail(state, 'floating conversion requires an IEEE value')
    _ -> if fp.kind(value) {
        :nan -> int64.long(0, 0)
        :infinity -> if fp.sign(value) = 1 {
            true -> int64.long(-2147483648, 0)
            _ -> int64.long(2147483647, 4294967295)
        }
        _ -> {
            number := fp.numeric(value)
            if number >= 9223372036854775808.0 {
                true -> int64.long(2147483647, 4294967295)
                _ -> if number <= -9223372036854775808.0 {
                    true -> int64.long(-2147483648, 0)
                    _ -> {
                        negative? := number < 0
                        magnitude := if negative? {true -> 0.0 - number, _ -> number}
                        hi := int(magnitude / 4294967296.0)
                        lo := int(magnitude - float(hi) * 4294967296.0)
                        bits := int64.long(hi, lo)
                        if negative? {true -> int64.neg(bits), _ -> bits}
                    }
                }
            }
        }
    }
}
fn _longCmp(a, b, state) if !int64.long?(a) | !int64.long?(b) {
    true -> fail(state, 'lcmp requires two JVM long values')
    _ -> int64.cmp(a, b)
}
fn _longText(value, state) if !int64.long?(value) {
    true -> fail(state, 'PrintStream.print(long) requires a JVM long')
    _ -> int64.toText(value)
}
fn fail(state, message) {
    // A pending JVM exception is not a host VM error. Keep its identity and
    // original throw site until the caller's ordered table has been searched.
    if state.error = ? & state.thrown = ? -> state.error <- message
    ?
}
fn fieldKey(owner, name, desc) owner + '.' + name + ':' + desc
fn methodKey(name, desc) name + desc

// Every JVM reference gets a run-local identity, including String values.
// Oak/Builder JS compare text and objects differently, so neither Oak '='
// nor JS structural equality can implement JVM if_acmp*. Intern only class
// literals/ConstantValue strings; host results and supplied arguments are
// distinct objects even when their characters match.
fn _tagRef(state, value) if state.nextRefId > 1048576 {
    true -> fail(state, 'JVM reference limit exceeded (1048576)')
    _ -> {
        value.refId <- state.nextRefId
        state.nextRefId <- state.nextRefId + 1
        value
    }
}
// ACC_SYNCHRONIZED methods and explicit monitorenter/monitorexit share an
// identity-based monitor. Only one deterministic task can run at once;
// foreign ownership refuses instead of waiting forever or inventing order.
// Explicit monitor scopes are bounded and must exit inside their own frame.
fn _monitorAcquire(declaringOwner, static?, recv, state) {
    key := if static? {
        true -> 'class:' + declaringOwner
        _ -> if type(recv) = :object & _int32?(recv.refId) &
            recv.refId > 0 {
            true -> 'object:' + string(recv.refId)
            _ -> ?
        }
    }
    if key = ? {
        true -> fail(state, 'synchronized method requires a JVM receiver')
        _ -> {
            held := state.monitors.(key)
            if held = ? {
                true -> state.monitors.(key) <- {owner: state.currentTaskId,
                    depth: 1}
                _ -> if held.owner != state.currentTaskId {
                    true -> fail(state, 'synchronized monitor contention outside bounded scheduler')
                    _ -> if held.depth >= 64 {
                        true -> fail(state, 'synchronized monitor reentrancy depth exceeded')
                        _ -> held.depth <- held.depth + 1
                    }
                }
            }
            if state.error = ? {true -> key, _ -> ?}
        }
    }
}
fn _monitorRelease(key, state) {
    held := state.monitors.(key)
    if held = ? | held.owner != state.currentTaskId |
        held.depth < 1 {
        true -> state.error <- 'synchronized monitor release invariant violated'
        _ -> if held.depth = 1 {
            true -> state.monitors.(key) <- ?
            _ -> held.depth <- held.depth - 1
        }
    }
}
// Throwable identity, superclass matching and handler dispatch are modeled
// inside this VM. Fatal verifier/budget failures continue to use state.error;
// they must never be caught by untrusted applet bytecode.
fn _raiseJava(state, owner, message) if state.error = ? & state.thrown = ? {
    true -> {
        state.thrown <- _tagRef(state, {className: owner, fields: {},
            message: message})
        ?
    }
}
fn _newString(state, text) if type(text) = :string {
    true -> _tagRef(state, {className: 'java/lang/String', text: text})
    _ -> fail(state, 'invalid JVM String value')
}
fn _internString(state, text) {
    // Prefix arbitrary class-file text so keys cannot collide with JS object
    // prototype properties in the standalone Builder output.
    key := 'literal:' + text
    ref := state.interned.(key)
    if ref = ? {
        true -> {
            ref <- _newString(state, text)
            if state.error = ? -> state.interned.(key) <- ref
        }
    }
    ref
}
fn _string?(value) type(value) = :object &
    value.className = 'java/lang/String' & type(value.text) = :string
fn _stringText(value) if _string?(value) {true -> value.text, _ -> ?}
fn _referenceId(value, state) if value = ? {
    true -> 0
    _ -> if type(value) = :object & type(value.className) = :string &
        type(value.refId) = :int & value.refId > 0 {
        true -> value.refId
        _ -> fail(state, 'reference comparison requires JVM references')
    }
}
// Native Oak has a literal 'super' key. Builder's bundled JS may instead
// mangle a parsed identifier to '__oak_js_super', while a virtual Oak object
// with a quoted key retains 'super'. Accept both internal representations.
fn classParent(cls) if cls = ? {
    true -> ?
    _ -> if cls.('super') != ? {true -> cls.('super'), _ -> cls.__oak_js_super}
}
fn isVoid?(desc) desc.(len(desc) - 1) = 'V'

fn _defaultField(desc) if desc.(0) {
	'Z', 'B', 'C', 'S', 'I' -> 0
    'J' -> {jvmLong: true, hi: 0, lo: 0}
    'F' -> {jvmFloat: true, bits: 0}
    'D' -> {jvmDouble: true, hi: 0, lo: 0}
	_ -> ?
}
fn _initFields(program, owner, fields, state) {
	cls := program.classes.(owner)
	if cls != ? {
		true -> {
			if classParent(cls) != ? -> _initFields(program, classParent(cls), fields, state)
			cls.fields |> keys() |> std.each(fn(k) fields.(k) <- cls.fields.(k))
		}
	}
}
fn awtColor(r, g, b, state) _tagRef(state,
    {className: 'java/awt/Color', fields: {}, red: r, green: g, blue: b})
// Point is a mutable, identity-bearing AWT geometry value. Its public int
// coordinates use the SAME field keys as ordinary JVM getfield/putfield.
fn _point?(value) type(value) = :object &
    value.className = 'java/awt/Point' & type(value.fields) = :object
fn _pointKey(name) fieldKey('java/awt/Point', name, 'I')
fn _int32?(value) type(value) = :int &
    value >= -2147483648 & value <= 2147483647
// Integer.valueOf(String) returns an identity-bearing reference, not a
// primitive. Java guarantees cached references for -128..127. Keep the
// bounded cache per VM run; outside that range allocate distinct objects.
fn _boxedInteger(state, value) if !_int32?(value) {
    true -> fail(state, 'Integer.valueOf requires an int32 result')
    _ -> if value >= -128 & value <= 127 {
        true -> {
            key := 'boxed:' + string(value)
            cached := state.boxedIntegers.(key)
            if cached = ? {
                true -> {
                    cached <- _tagRef(state, {className: 'java/lang/Integer',
                        fields: {}, boxedInt: value})
                    if state.error = ? -> state.boxedIntegers.(key) <- cached
                }
            }
            cached
        }
        _ -> _tagRef(state, {className: 'java/lang/Integer', fields: {},
            boxedInt: value})
    }
}
fn _newPoint(state, x, y) {
    fields := {}
    fields.(_pointKey('x')) <- x
    fields.(_pointKey('y')) <- y
    _tagRef(state, {className: 'java/awt/Point', fields: fields})
}
fn awtCSS(color) 'rgb(' + string(color.red) + ',' + string(color.green) + ',' + string(color.blue) + ')'
// Only safe, short ASCII logical names can enter the SVG/Canvas font path.
// This models a Font's requested name/style/size, not physical font mapping,
// glyph metrics, antialiasing or JDK pixel equality.
fn _fontNameAllowed?(name) type(name) = :string & len(name) >= 1 &
    len(name) <= 64 & (std.range(len(name)) |> std.every(fn(i) {
        c := codepoint(name.(i))
        (c >= 48 & c <= 57) | (c >= 65 & c <= 90) |
            (c >= 97 & c <= 122) | c = 32 | c = 45 | c = 95
    }))
fn draw(state, command) if len(state.draw) >= 16384 {
    true -> fail(state, 'AWT drawing command limit exceeded (16384)')
    _ -> state.draw << command
}
fn namedColor(name, state) {
    canonical := vmLib.jvmColorName(name)
    if canonical = ? {
        true -> fail(state, 'unsupported AWT color constant ' + name)
        _ -> {
            saved := state.colors.('color:' + canonical)
            if saved != ? {
                true -> saved
                _ -> {
                    color := if canonical {
                        'white' -> awtColor(255, 255, 255, state)
                        'black' -> awtColor(0, 0, 0, state)
                        'red' -> awtColor(255, 0, 0, state)
                        'green' -> awtColor(0, 255, 0, state)
                        'blue' -> awtColor(0, 0, 255, state)
                        'yellow' -> awtColor(255, 255, 0, state)
                        'cyan' -> awtColor(0, 255, 255, state)
                        'magenta' -> awtColor(255, 0, 255, state)
                        'gray' -> awtColor(128, 128, 128, state)
                        'lightGray' -> awtColor(192, 192, 192, state)
                        'darkGray' -> awtColor(64, 64, 64, state)
                        'orange' -> awtColor(255, 200, 0, state)
                        'pink' -> awtColor(255, 175, 175, state)
                        _ -> fail(state, 'unsupported AWT color constant ' + name)
                    }
                    if state.error = ? -> state.colors.('color:' + canonical) <- color
                    color
                }
            }
        }
    }
}
// Class preparation's ConstantValue defaults are in state.statics already.
// Active use runs <clinit> once, after the superclass, within the same
// instruction/depth budgets as ordinary methods. Mark 'initializing' before
// calling code so recursive static references do not rerun the initializer.
fn initializeClass(program, owner, state) {
    cls := program.classes.(owner)
    if cls != ? & state.error = ? & state.thrown = ? {
        true -> if state.initialized.(owner) {
            'failed' -> _raiseJava(state, 'java/lang/NoClassDefFoundError',
                'Could not initialize class ' + str.replace(owner, '/', '.'))
            ? -> {
                state.initialized.(owner) <- 'initializing'
                if classParent(cls) != ? ->
                    initializeClass(program, classParent(cls), state)
                ownInitializer? := state.error = ? & state.thrown = ? &
                    cls.methods.('<clinit>()V') != ?
                if ownInitializer? ->
                    execute(program, owner, '<clinit>', '()V', [], ?, state)
                // A non-Error escaping <clinit> is wrapped exactly once;
                // other active users of this erroneous class see NCDFE.
                if ownInitializer? & state.thrown != ? & state.error = ? &
                    !_isInstance(program, state.thrown, 'java/lang/Error') {
                    true -> {
                        cause := state.thrown
                        state.thrown <- _tagRef(state, {
                            className: 'java/lang/ExceptionInInitializerError',
                            fields: {}, message: ?, cause: cause})
                    }
                }
                state.initialized.(owner) <- if state.error = ? &
                    state.thrown = ? {true -> 'ready', _ -> 'failed'}
            }
            _ -> ? // already initializing (recursive active use) or ready
        }
    }
}
fn newObject(program, owner, state) if vmLib.jvmNew(owner) {
    'object' -> _tagRef(state, {className: owner, fields: {}})
    'string-object' -> _tagRef(state, {className: owner, fields: {}, text: ''})
    'throwable' -> _tagRef(state, {className: owner, fields: {}, message: ?})
    'text-builder' -> _tagRef(state, {className: owner, fields: {}, text: ''})
    'byte-array-stream' -> _tagRef(state, {className: owner, fields: {},
        streamBytes: ?, streamPos: 0, streamCount: 0,
        byteStreamReady?: false, streamReady?: false})
    'data-input-stream' -> _tagRef(state, {className: owner, fields: {},
        streamSource: ?, streamReady?: false})
    'byte-array-output' -> _tagRef(state, {className: owner, fields: {},
        outputBytes: ?, outputReady?: false})
    'data-output-stream' -> _tagRef(state, {className: owner, fields: {},
        outputTarget: ?, outputReady?: false})
    'bounded-resource-url' -> _tagRef(state, {className: owner, fields: {},
        urlKind: 'uninitialized', resourceName: ?})
    'bounded-zip-stream' -> _tagRef(state, {className: owner, fields: {},
        zipRaw: ?, entryRead?: false, streamReady?: false,
        streamClosed?: false, streamRaw: ?, streamPos: 0})
    'bounded-thread' -> _tagRef(state, {className: owner, fields: {},
        threadTarget: ?, threadReady?: false, threadAlive?: false,
        threadStarted?: false, priority: 5})
    'bounded-midp-random' -> if program.midpProfile? = true {
        true -> _tagRef(state, {className: owner, fields: {},
            randomReady?: false, randomSeeded?: false,
            randomHi24: 0, randomLo24: 0})
        _ -> fail(state, 'Random requires a selected MIDlet profile')
    }
    'awt-color' -> awtColor(0, 0, 0, state)
    'awt-font' -> _tagRef(state, {className: owner, fields: {},
        fontName: ?, fontStyle: ?, fontSize: ?, fontReady?: false})
    'awt-point' -> _newPoint(state, 0, 0)
    'awt-rectangle' -> _tagRef(state, {className: owner, fields: {
        'java/awt/Rectangle.x:I': 0,
        'java/awt/Rectangle.y:I': 0,
        'java/awt/Rectangle.width:I': 0,
        'java/awt/Rectangle.height:I': 0
    }, rectReady?: false})
    'awt-border-layout' -> _tagRef(state, {className: owner, fields: {},
        layoutReady?: false, slots: {}})
    'awt-canvas', 'awt-panel', 'awt-text-field', 'awt-button' ->
        _tagRef(state, {className: owner, fields: {}, awtReady?: false})
    'index-color-model' -> _tagRef(state, {className: owner,
        ready?: false, palette: ?})
    'memory-image-source' -> _tagRef(state, {className: owner,
        ready?: false, model: ?, bytes: ?})
    _ -> if program.classes.(owner) {
        ? -> fail(state, 'missing class ' + owner)
        _ -> {
            initializeClass(program, owner, state)
            if state.error != ? | state.thrown != ? {
                true -> ?
                _ -> {
                    fields := {}
                    _initFields(program, owner, fields, state)
                    _tagRef(state, {className: owner, fields: fields})
                }
            }
        }
    }
}

// JVM instanceof/checkcast and interface dispatch share the same bounded
// transitive type walk. For host values and arrays, model only admitted JVM
// identities, Object and the standard array interfaces. A missing reference
// type is rejected by the linker rather than reported as a false instanceof.
// classParent accepts both representations of the reserved parent key in
// Builder's bundled JS and in standalone/native Oak.
fn _arrayClass(op, tag) if op = 189 {
    true -> if str.startsWith?(tag, '[') {true -> '[' + tag, _ -> '[L' + tag + ';'}
    _ -> if tag {
        4 -> '[Z'
        5 -> '[C'
        8 -> '[B'
        9 -> '[S'
        10 -> '[I'
        11 -> '[J'
        6 -> '[F'
        7 -> '[D'
        _ -> ?
    }
}
// Decode each multianewarray level without conflating primitive and
// reference elements. A partially sized array ends with null references;
// only the fully allocated primitive leaf receives zero values.
fn _multiTag(desc) if type(desc) != :string | len(desc) < 2 |
    desc.(0) != '[' {
    true -> ?
    _ -> {
        component := std.slice(desc, 1)
        if len(component) = 1 {
            true -> if component {
                'Z' -> {op: 188, tag: 4}
                'C' -> {op: 188, tag: 5}
                'B' -> {op: 188, tag: 8}
                'S' -> {op: 188, tag: 9}
                'I' -> {op: 188, tag: 10}
                'J' -> {op: 188, tag: 11}
                'F' -> {op: 188, tag: 6}
                'D' -> {op: 188, tag: 7}
                _ -> ?
            }
            _ -> if component.(0) = '[' {
                true -> {op: 189, tag: component}
                _ -> if component.(0) = 'L' &
                    component.(len(component) - 1) = ';' {
                    true -> {op: 189, tag: std.slice(component, 1,
                        len(component) - 1)}
                    _ -> ?
                }
            }
        }
    }
}
// Bound cumulative array storage as well as each individual allocation. A
// loop allocating many max-size arrays must not bypass the per-array cap.
// Charge before materializing the backing list; budget failures are fatal,
// not Java exceptions that untrusted bytecode can catch and ignore.
fn _chargeArrayCells(state, count) if count < 0 |
    count > 1048576 - state.arrayCells {
    true -> fail(state, 'JVM total array-cell budget exceeded (1048576)')
    _ -> {
        state.arrayCells <- state.arrayCells + count
        true
    }
}
fn _multiArray(desc, sizes, state) {
    if type(sizes) != :list | len(sizes) = 0 | len(sizes) > 16 {
        true -> fail(state, 'invalid multianewarray dimensions')
        _ -> {
            current := desc
            cost := 0
            parents := 1
            arrays := 0
            std.range(len(sizes)) |> std.each(fn(i) if state.error = ? &
                state.thrown = ? {
                true -> {
                    shape := _multiTag(current)
                    count := sizes.(i)
                    if shape = ? {
                        true -> fail(state, 'invalid multianewarray descriptor or dimension')
                        _ -> if _int32?(count) & count < 0 {
                            true -> _raiseJava(state,
                                'java/lang/NegativeArraySizeException',
                                'invalid multianewarray descriptor or dimension: negative size')
                            _ -> if _arrayClass(shape.op, shape.tag) != current |
                                !_int32?(count) | count > state.maxArray {
                                true -> fail(state, 'invalid multianewarray descriptor or dimension')
                            _ -> {
                                cells := parents * count
                                if cells > state.maxArray |
                                    cost + parents + cells > state.maxArray {
                                    true -> fail(state, 'multianewarray allocation budget exceeded')
                                    _ -> {
                                        cost <- cost + parents + cells
                                        arrays <- arrays + parents
                                        parents <- cells
                                        current <- std.slice(current, 1)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            })
            if state.error = ? & state.thrown = ? &
                (state.steps + cost > state.maxSteps |
                    state.nextRefId + arrays - 1 > 1048576) ->
                fail(state, 'multianewarray instruction/reference budget exceeded')
            if state.error != ? | state.thrown != ? {
                true -> ?
                _ -> {
                    _chargeArrayCells(state, cost)
                    if state.error = ? -> state.steps <- state.steps + cost
                    fn allocate(name, level) {
                        shape := _multiTag(name)
                        size := sizes.(level)
                        initial := if shape.op = 188 {
                            true -> if shape.tag {
                                11 -> _long(0, 0)
                                6 -> fp.f32(0)
                                7 -> fp.f64(0, 0)
                                _ -> 0
                            }
                            _ -> ?
                        }
                        array := _tagRef(state, {className: name, tag: shape.tag,
                            values: range(size) |> map(fn(_) initial)})
                        if level + 1 < len(sizes) -> std.range(size) |>
                            std.each(fn(index) array.values.(index) <-
                                allocate(std.slice(name, 1), level + 1))
                        array
                    }
                    if state.error = ? {true -> allocate(desc, 0), _ -> ?}
                }
            }
        }
    }
}
fn _arrayComponent(name) if type(name) != :string | len(name) < 2 |
    name.(0) != '[' {
    true -> ?
    _ -> {
        tail := std.slice(name, 1)
        if tail.(0) = '[' {
            true -> tail
            _ -> if tail.(0) = 'L' & len(tail) > 2 &
                tail.(len(tail) - 1) = ';' {
                true -> std.slice(tail, 1, len(tail) - 1)
                _ -> ?
            }
        }
    }
}
fn _isSubtype(program, current, owner, depth) if depth >= 64 |
    type(current) != :string | type(owner) != :string {
    true -> false
    _ -> if current = owner {
        true -> true
        _ -> if str.startsWith?(current, '[') {
            true -> if owner = 'java/lang/Object' |
                owner = 'java/lang/Cloneable' | owner = 'java/io/Serializable' {
                true -> true
                _ -> if str.startsWith?(owner, '[') &
                    _arrayComponent(current) != ? & _arrayComponent(owner) != ? {
                    true -> _isSubtype(program, _arrayComponent(current),
                        _arrayComponent(owner), depth - (0 - 1))
                    _ -> false
                }
            }
            _ -> if vmLib.jvmReferenceSubtype?(current, owner) {
                true -> true
                _ -> {
                    cls := program.classes.(current)
                    if cls = ? {
                        true -> false
                        _ -> _isSubtype(program, classParent(cls), owner, depth - (0 - 1)) |
