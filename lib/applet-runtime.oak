                                            'java/lang/NullPointerException',
                                            'null athrow operand')
                                        _ -> if _isInstance(program, thrown,
                                            'java/lang/Throwable') {
                                            true -> state.thrown <- thrown
                                            _ -> fail(state,
                                                'athrow operand is not a JVM Throwable')
                                        }
                                    }
                                }
                                46, 47, 48, 49, 50, 51, 52, 53 -> {
									index := pop()
									array := pop()
                                    v := arrayGet(array, index)
                                    if state.error = ? & state.thrown = ? &
                                        !arrayKind?(array, op) ->
                                        fail(state, 'array opcode incompatible with component type')
                                    if state.error = ? & state.thrown = ? &
                                        op = 47 & !_long?(v) ->
                                        fail(state, 'invalid JVM long array element')
                                    if state.error = ? & state.thrown = ? &
                                        op = 48 & !fp.float?(v) ->
                                        fail(state, 'invalid JVM float array element')
                                    if state.error = ? & state.thrown = ? &
                                        op = 49 & !fp.double?(v) ->
                                        fail(state, 'invalid JVM double array element')
                                    if state.error = ? & state.thrown = ? {
                                        true -> if op = 51 & v >= 128 & array.tag = 8 {
                                            true -> push(v - 256)
                                            _ -> if op = 53 & v >= 32768 {
                                                true -> push(v - 65536)
                                                _ -> push(v)
                                            }
                                        }
                                    }
								}
								79, 80, 81, 82, 83, 84, 85, 86 -> {
									value := pop()
									index := pop()
									array := pop()
                                    values := arrayValues(array)
                                    if state.error = ? & state.thrown = ? &
                                        !arrayKind?(array, op) ->
                                        fail(state, 'array opcode incompatible with component type')
                                    if state.error = ? & state.thrown = ? &
                                        op = 80 & !_long?(value) ->
                                        fail(state, 'long array store requires a JVM long')
                                    if state.error = ? & state.thrown = ? &
                                        op = 81 & !fp.float?(value) ->
                                        fail(state, 'float array store requires a JVM float')
                                    if state.error = ? & state.thrown = ? &
                                        op = 82 & !fp.double?(value) ->
                                        fail(state, 'double array store requires a JVM double')
                                    if state.error = ? & state.thrown = ? &
                                        op != 83 & op != 80 & op != 81 &
                                        op != 82 & type(value) != :int ->
                                        fail(state, 'primitive array store requires an integer')
                                    if state.error = ? & state.thrown = ? &
                                        op = 83 & value != ? &
                                        !_isInstance(program, value, array.tag) ->
                                        _raiseJava(state, 'java/lang/ArrayStoreException',
                                            'array store type mismatch')
                                    if state.error = ? & state.thrown = ? {
                                        true -> {
                                            if op = 84 -> value <- value &
                                                if array.tag = 4 {true -> 1, _ -> 255}
                                            if op = 85 | op = 86 -> value <- value & 65535
                                            arraySet(array, index, value)
                                        }
                                    }
								}
								192 -> {
									obj := pop()
                                    if obj != ? & !_isInstance(program, obj, arg) ->
                                        _raiseJava(state, 'java/lang/ClassCastException',
                                            'invalid checkcast')
									push(obj)
								}
								193 -> {
									obj := pop()
									push(if _isInstance(program, obj, arg) {true -> 1, _ -> 0})
								}
                                194 -> monitorEnter(pop())
                                195 -> monitorExit(pop())
                                _ -> fail(state, 'unverified opcode reached')
                            }
                            if state.thrown != ? & state.error = ? {
                                true -> {
                                    caught := ?
                                    method.handlers |> std.default([]) |>
                                        std.each(fn(h) if caught = ? &
                                            pc >= h.start & pc < h.end &
                                            (h.catch = ? | _isInstance(program,
                                                state.thrown, h.catch)) ->
                                            caught <- h)
                                    if caught != ? {
                                        true -> {
                                            thrown := state.thrown
                                            state.thrown <- ?
                                            stack <- []
                                            sp <- 0
                                            usedSlots <- 0
                                            push(thrown)
                                            next <- caught.target
                                        }
                                    }
                                }
                            }
                            tick(next)
						}
					}
			}
			}
			output := tick(0)
            if explicitDepth > 0 {
                true -> {
                    // No silent lock leakage on a return, uncaught exception,
                    // or VM budget failure. Preserve the *first* refusal
                    // (e.g. notifyAll event cap), then release held locks;
                    // otherwise a cleanup diagnostic hides the real cause.
                    if state.error = ? & state.thrown = ? ->
                        state.error <- 'explicit JVM monitor left held on method exit'
                    keys(explicitHeld) |> std.each(fn(key) {
                        std.range(explicitHeld.(key)) |>
                            std.each(fn(_) _monitorRelease(key, state))
                    })
                }
            }
            if monitorKey != ? -> _monitorRelease(monitorKey, state)
			state.depth <- state.depth - 1
			output
		}
	}
}

// The API keeps raw tagged IEEE return values available to callers. A CLI or
// emitted entrypoint asks for their bounded Java decimal form separately;
// unsupported decimal cases must not print an Oak/JS object representation.
fn valueText(value) if _long?(value) {
    true -> {type: :ok, value: _longText(value,
        {error: ?, thrown: ?})}
    _ -> if fp.float?(value) | fp.double?(value) {
        true -> if fp.text(value) {
            ? -> {type: :error,
                message: 'JVM floating decimal formatting outside bounded subset'}
            _ -> {type: :ok, value: fp.text(value)}
        }
        _ -> {type: :ok, value: string(value)}
    }
}

// One canonical host-event boundary for both the finite run queue and a
// retained GUI session. Never accept arbitrary object references, unbounded
// coordinates, extra fields, or a browser-provided JVM Event object.
fn _checkedLegacyEvent(record) if type(record) != :object {
    true -> {type: :error, message: 'invalid legacy AWT event record'}
    _ -> {
        id := record.id
        key := record.key |> default(0)
        x := record.x |> default(0)
        y := record.y |> default(0)
        modifiers := record.modifiers |> default(0)
        unknown? := keys(record) |> std.some(fn(name) name != 'id' &
            name != 'key' & name != 'x' & name != 'y' &
            name != 'modifiers')
        if unknown? | !_int32?(id) | id < 0 | id > 2048 |
            !_int32?(key) | key < 0 | key > 65535 |
            !_int32?(x) | x < -16384 | x > 16384 |
            !_int32?(y) | y < -16384 | y > 16384 |
            !_int32?(modifiers) | modifiers < 0 | modifiers > 65535 {
            true -> {type: :error,
                message: 'invalid or out-of-bounds legacy AWT event'}
            _ -> {type: :ok, value: {id: id, key: key,
                x: x, y: y, modifiers: modifiers}}
        }
    }
}

fn _deliverLegacyEvent(program, obj, state, record) {
    event := _tagRef(state, {className: 'java/awt/Event', fields: {
        'java/awt/Event.id:I': record.id
        'java/awt/Event.key:I': record.key
        'java/awt/Event.x:I': record.x
        'java/awt/Event.y:I': record.y
        'java/awt/Event.modifiers:I': record.modifiers
    }})
    if state.error = ? {
        true -> {
            handled := execute(program, program.entry, 'handleEvent',
                '(Ljava/awt/Event;)Z', [event], obj, state)
            if state.error = ? & state.thrown = ? ->
                _drainRepaint(program, state)
            if state.error = ? & state.thrown = ? {
                true -> if handled != 0 & handled != 1 {
                    true -> fail(state, 'invalid legacy AWT boolean result')
                    _ -> state.eventResults << handled
                }
            }
        }
    }
}

// A trusted GUI host may retain this explicitly opt-in capability after the
// finite original lifecycle. The SAME metered state/object/virtual clock and
// selected preflight image continue; there is no fresh applet construction.
// One call delivers one validated Event, to a maximum of 16 over the session.
// Continue a preflighted selected-method image on the SAME object and
// metered VM state. Only a trusted caller can retain the returned session;
// there are no MIDP/AWT callbacks, class loading or new host API contracts
// in this generic path. Refuse malformed/uncompiled calls before execution.
fn dispatchMethod(session, name, desc, args) if type(session) != :object {
    true -> {type: :error, message: 'expected retained JVM method session'}
    _ -> if session.kind != 'bounded-method' |
        session.program.kind != 'method' |
        session.object = ? | session.state = ? {
        true -> {type: :error, message: 'unlinked JVM method session'}
        _ -> {
            state := session.state
            if type(name) != :string | type(desc) != :string |
                type(args) != :list | name = '<init>' | name = '<clinit>' {
                true -> {type: :error, message: 'invalid retained JVM callback'}
                _ -> if state.error != ? | state.thrown != ? |
                    state.depth != 0 | state.currentThreadRef != ? |
                    session.calls >= 4 | len(args) > 1 |
                    !(desc = '()V' | desc = '(I)V' | desc = '(Z)V') |
                    (desc = '()V' & len(args) != 0) |
                    (desc != '()V' & len(args) != 1) |
                    (args |> std.some(fn(arg) !_int32?(arg))) |
                    (desc = '(Z)V' & len(args) = 1 &
                        args.(0) != 0 & args.(0) != 1) |
                    _findMethod(session.program, session.program.entry,
                        name, desc) = ? {
                    true -> {type: :error,
                        message: 'JVM callback uncompiled, busy or exceeds four-call/int32-void bound'}
                    _ -> {
                        session.calls <- session.calls + 1
                        value := execute(session.program, session.program.entry,
                            name, desc, args, session.object, state)
                        if state.error != ? {
                            true -> {type: :error, message: state.error,
                                output: state.output, steps: state.steps}
                            _ -> if state.thrown != ? {
                                true -> {type: :error,
                                    message: 'uncaught Java exception ' +
                                        state.thrown.className,
                                    output: state.output, steps: state.steps}
                                _ -> {type: :ok, value: value,
                                    output: state.output, steps: state.steps,
                                    object: session.object,
                                    statics: state.statics, session: session}
                            }
                        }
                    }
                }
            }
        }
    }
}

// Exactly one trusted MIDP display callback after the selected startApp has
// returned. The callback bodies were included in the linked image before
// construction; do not expose a generic guest paint() call or an AWT event.
// A distinct service model may attach its resulting image for ONE later
// synchronous callback in a preflighted method; no concurrent queue/softkeys.
fn dispatchMidpPaint(session) if type(session) != :object {
    true -> {type: :error, message: 'expected retained one-frame MIDP session'}
    _ -> if session.kind != 'bounded-method' | session.program = ? |
        session.object = ? | session.state = ? {
        true -> {type: :error, message: 'unlinked one-frame MIDP session'}
        _ -> {
            program := session.program
            state := session.state
            if program.kind != 'method' | program.midpProfile? != true |
                program.midpOnePaint? != true | session.calls != 1 |
                state.error != ? | state.thrown != ? | state.depth != 0 |
                state.currentThreadRef != ? {
                true -> {type: :error,
                    message: 'MIDP paint requires one idle, preflighted startApp session'}
                _ -> {
                    statics := state.statics.('javax/microedition/lcdui/Display')
                    display := if statics = ? {true -> ?, _ -> statics.(
                        'javax/microedition/lcdui/Display.instance:Ljavax/microedition/lcdui/Display;')}
                    owner := if statics = ? {true -> ?, _ -> statics.(
                        'javax/microedition/lcdui/Display.owner:Ljavax/microedition/midlet/MIDlet;')}
                    selected := if type(display) != :object {true -> ?, _ -> display.fields.(
                        'javax/microedition/lcdui/Display.requested:Ljavax/microedition/lcdui/Displayable;')}
                    callback := if type(selected) != :object {true -> ?, _ ->
                        _findMethod(program, selected.className, 'paint',
                            '(Ljavax/microedition/lcdui/Graphics;)V')}
                    shown := if type(selected) != :object {true -> ?, _ ->
                        _findMethod(program, selected.className, 'showNotify', '()V')}
                    pending := if type(selected) != :object {true -> ?, _ -> selected.fields.(
                        'javax/microedition/lcdui/Canvas.repaintPending:Z')}
                    if type(display) != :object |
                        display.className != 'javax/microedition/lcdui/Display' |
                        type(owner) != :object |
                        owner.refId != session.object.refId |
                        !_isInstance(program, selected,
                            'javax/microedition/lcdui/Canvas') |
                        callback = ? | shown = ? |
                        (pending != 0 & pending != 1) {
                        true -> {type: :error,
                            message: 'MIDP paint requires one owned selected Canvas with linked callbacks'}
                        _ -> {
                            // 176x176 is the separately observed default
                            // MicroEmulator surface. The Image island charges
                            // allocation, copies and drawing against the same
                            // finite session, not a host/display GC.
                            image := _midpNew(program, 176, 176, ?, true, state)
                            graphics := if state.error = ? & state.thrown = ? {
                                true -> _midpBridge(program, 'midp-image-graphics',
                                    [image], state), _ -> ?}
                            if state.error = ? & state.thrown = ? {
                                true -> {
                                    session.calls <- 2
                                    selected.fields.(
                                        'javax/microedition/lcdui/Canvas.repaintPending:Z') <- 0
                                    execute(program, selected.className,
                                        'showNotify', '()V', [], selected, state)
                                    if state.error = ? & state.thrown = ? ->
                                        execute(program, selected.className, 'paint',
                                            '(Ljavax/microedition/lcdui/Graphics;)V',
                                            [graphics], selected, state)
                                    // The separate service model alone receives
                                    // this SAME image after its first paint.
                                    // Before then no guest service may paint.
                                    if state.error = ? & state.thrown = ? &
                                        program.midpOneService? = true ->
                                        selected.fields.(
                                            'javax/microedition/lcdui/Canvas.serviceFrame:Ljavax/microedition/lcdui/Image;') <- image
                                }
                            }
                            if state.error != ? {
                                true -> {type: :error, message: state.error,
                                    output: state.output, steps: state.steps}
                                _ -> if state.thrown != ? {
                                    true -> {type: :error, message: 'uncaught MIDP paint exception ' +
                                        state.thrown.className, output: state.output,
                                        steps: state.steps}
                                    _ -> {type: :ok, object: session.object,
                                        statics: state.statics, output: state.output,
                                        steps: state.steps, frame: image,
                                        paintedCanvas: selected,
                                        session: session}
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn dispatchEvent(session, record) if type(session) != :object {
    true -> {type: :error, message: 'expected retained JVM event session'}
    _ -> if session.kind != 'bounded-legacy-event' |
        session.program.eventEnabled? != true |
        session.program.kind != 'applet' |
        session.object = ? | session.state = ? {
        true -> {type: :error, message: 'unlinked JVM event session'}
        _ -> {
            state := session.state
            checked := _checkedLegacyEvent(record)
            if checked.type = :error {
                true -> checked
                _ -> if state.error != ? | state.thrown != ? |
                    state.depth != 0 | state.currentThreadRef != ? |
                    len(state.eventResults) >= 16 {
                    true -> {type: :error,
                        message: 'JVM event session failed, busy or exceeds 16-event bound'}
                    _ -> {
                        _deliverLegacyEvent(session.program, session.object,
                            state, checked.value)
                        if state.error != ? {
                            true -> {type: :error, message: state.error}
                            _ -> if state.thrown != ? {
                                true -> {type: :error,
                                    message: 'uncaught JVM event ' + state.thrown.className}
                                _ -> {type: :ok,
                                    handled: state.eventResults.(len(state.eventResults) - 1),
                                    events: len(state.eventResults), steps: state.steps,
                                    repaints: state.repaintCount,
                                    statuses: len(state.statusEvents),
                                    screen: state.screen, object: session.object}
                            }
                        }
                    }
                }
            }
        }
    }
}

// options: method? (e.g. 'twice(I)I'), args?: list, maxSteps?: int,
// maxDepth?: int, maxArray?: int. Default invokes constructor, init, start
// if present; paint/stop require a GUI host, so they are not called.
fn run(program, params, options) {
	options := default(options, {})
	// Clone static defaults so separate runs never mutate the compiled IR.
	statics := {}
	keys(program.classes) |> std.each(fn(owner) {
		values := {}
		keys(program.classes.(owner).static) |> std.each(fn(key) values.(key) <- program.classes.(owner).static.(key))
		statics.(owner) <- values
	})
    state := {
        error: ?
        thrown: ?
        steps: 0
		depth: 0
		maxSteps: options.maxSteps |> default(100000)
		maxDepth: options.maxDepth |> default(64)
		maxArray: options.maxArray |> default(65536)
        arrayCells: 0
        awtComponents: 0
        awtAttached: 0
        nextRefId: 1
        currentTaskId: 0
        currentThreadRef: ?
        startedTasks: 0
        virtualMillis: 0
        virtualClockEpochMillis: options.virtualClockEpochMillis
        virtualJavaVersion: options.virtualJavaVersion
        virtualJavaVersionRef: ?
        outputStreamCells: 0
        monitors: {}
        notifyAllCount: 0
        yieldCount: 0
        pendingRepaint: ?
        screen: ?
        frameSink: options.frameSink
        captureCount: 0
        captureCells: 0
        lastCapturedFrame: -1
        viewportWidth: options.width |> default(320)
        viewportHeight: options.height |> default(240)
        focusCount: 0
        interned: {}
        colors: {}
        boxedIntegers: {}
        rgbDefaultModel: ?
        systemOut: ?
		params: {}
        resources: {}
        resourceZip: options.resourceZip
        midpImages: options.midpImages |> default({})
        midpVirtualFreeBytes: options.midpVirtualFreeBytes
        midpRuntimeRef: ?
        midpRuntimeGcCalls: 0
        midpImageCells: 0
        midpWorkCells: 0
        statusEvents: []
        appletContextRef: ?
        navigationEvents: []
        repaintCount: 0
        eventResults: []
        traceRepaints?: options.traceRepaints? = true
		statics: statics
        initialized: {}
        draw: []
		output: ''
	}
    keys(statics) |> std.each(fn(owner) keys(statics.(owner)) |> std.each(fn(key) {
        value := statics.(owner).(key)
        if type(value) = :string & state.error = ? ->
            statics.(owner).(key) <- _internString(state, value)
    }))
    if state.resourceZip != ? & type(state.resourceZip) != :function ->
        fail(state, 'ZIP resource requires an explicit bounded host decoder')
    if state.frameSink != ? & type(state.frameSink) != :function ->
        fail(state, 'frame capture requires a trusted bounded host sink')
    // A virtual epoch must be an explicitly supplied exact JS-safe integer.
    // Even with this opt-in, unrelated instructions consume no wall time;
    // only bounded Thread.sleep moves the logical clock, at most 60 seconds.
    if state.virtualClockEpochMillis != ? &
        (type(state.virtualClockEpochMillis) != :int |
         state.virtualClockEpochMillis < 0 |
         state.virtualClockEpochMillis > 4102444800000) ->
        fail(state, 'virtual-clock epoch must be a finite integer in 0..4102444800000')
    if state.virtualJavaVersion != ? &
        !vmLib.jvmVersion?(state.virtualJavaVersion) ->
        fail(state, 'virtual java.version must be 3..32 ASCII digits/dots')
    if program.midpProfile? != true & options.midpImages != ? ->
        fail(state, 'Image resources require a selected MIDlet program')
    if state.midpVirtualFreeBytes != ? &
        (program.midpProfile? != true | type(state.midpVirtualFreeBytes) != :int |
         state.midpVirtualFreeBytes < 0 |
         state.midpVirtualFreeBytes > 268435456) ->
        fail(state, 'virtual free-memory snapshot requires a selected finite MIDlet program')
    if type(state.midpImages) != :object | len(keys(state.midpImages)) > 40 {
        true -> fail(state, 'MIDP image resource map outside 40-image profile')
        _ -> {
            preparedCells := 0
            keys(state.midpImages) |> std.each(fn(key) if state.error = ? {
                true -> {
                    source := state.midpImages.(key)
                    if !str.startsWith?(key, 'asset:') |
                        len(key) < 7 | len(key) > 70 |
                        type(source) != :object |
                        !_int32?(source.width) | !_int32?(source.height) |
                        source.width < 1 | source.width > 512 |
                        source.height < 1 | source.height > 256 |
                        source.width * source.height > 65536 |
                        type(source.pixels) != :list |
                        len(source.pixels) != source.width * source.height |
                        source.width * source.height > 100000 - preparedCells {
                        true -> fail(state, 'MIDP image resource geometry/cumulative budget differs')
                        _ -> preparedCells <- preparedCells +
                            source.width * source.height
                    }
                }
            })
        }
    }
    inputResources := options.resources |> default({})
    documentResources := options.documentResources |> default({})
    if type(inputResources) != :object | type(documentResources) != :object |
        len(keys(inputResources)) + len(keys(documentResources)) > 4 {
        true -> fail(state, 'resource maps must have at most four local files in total')
        _ -> {
            totalResourceBytes := 0
            fn admitResources(source, namespace) {
                keys(source) |> std.each(fn(name) if state.error = ? {
                    true -> {
                        raw := source.(name)
                        if !_localResourceName?(name) |
                            (type(raw) != :string & type(raw) != :list) {
                            true -> fail(state, 'unsafe or oversized local resource')
                            _ -> {
                                count := len(raw)
                                if count > 524288 |
                                    totalResourceBytes + count > 1048576 |
                                    (type(raw) = :list &
                                        !(raw |> std.every(fn(b) type(b) = :int &
                                            b >= 0 & b <= 255))) |
                                    (type(raw) = :string &
                                        !(std.range(count) |>
                                            std.every(fn(i) codepoint(raw.(i)) <= 255))) {
                                    true -> fail(state, 'unsafe or oversized local resource')
                                    _ -> {
                                        totalResourceBytes <- totalResourceBytes + count
                                        // Byte lists survive Builder JS source
                                        // emission even for 0x80..0xff, unlike
                                        // raw non-UTF-8 Oak string literals.
                                        state.resources.(namespace + name) <-
                                            if type(raw) = :list {
                                                true -> raw |> std.map(char) |> str.join('')
                                                _ -> raw
                                            }
                                    }
                                }
                            }
                        }
                    }
                })
            }
            admitResources(inputResources, 'resource:')
            if state.error = ? -> admitResources(documentResources, 'document:')
        }
    }
    inputParams := default(params, {})
    if type(inputParams) != :object {
        true -> fail(state, 'applet parameters must be a key/value map')
        _ -> keys(inputParams) |> std.each(fn(key) if state.error = ? {
            true -> {
                value := inputParams.(key)
                if value != ? -> if type(value) != :string {
                    true -> fail(state, 'applet parameter must be a string')
                    _ -> state.params.(key) <- _newString(state, value)
                }
            }
        })
    }
    // This is an explicit, finite host-input queue, not a browser event
    // listener. Validate every record BEFORE Applet construction or output;
    // only an event-enabled, selected-entry-linked Applet may receive it.
    eventRecords := []
    if options.persistentMethod? = true &
        (program.kind != 'method' | options.method = ? |
         (options.desc |> default('()V')) != '()V' |
         len(options.args |> default([])) != 0 |
         options.events != ? | options.paint? = true |
         options.persistent? = true) ->
        fail(state, 'retained methods require a no-arg void selected method without AWT events/paint')
    if options.persistent? = true &
        (program.eventEnabled? != true | program.kind != 'applet') ->
        fail(state, 'retained events require an event-linked Applet')
    if options.events != ? & state.error = ? {
        true -> if program.eventEnabled? != true | program.kind != 'applet' |
            type(options.events) != :list | len(options.events) > 16 {
            true -> fail(state, 'legacy AWT events require an event-linked Applet and at most 16 records')
            _ -> options.events |> std.each(fn(event) if state.error = ? {
                true -> {
                    checked := _checkedLegacyEvent(event)
                    if checked.type = :error {
                        true -> fail(state, checked.message)
                        _ -> eventRecords << checked.value
                    }
                }
            })
        }
    }
	entry := program.entry
    obj := if program.kind = 'application' | state.error != ? {
        true -> ?, _ -> newObject(program, entry, state)}
	value := ?
    if state.error = ? & state.thrown = ? & program.kind = 'application' {
        true -> {
            initializeClass(program, entry, state)
            argv := options.args |> default([])
            if type(argv) != :list | (argv |> std.some(fn(v) type(v) != :string)) {
                true -> fail(state, 'application main arguments must be JSON strings')
                _ -> {
                    values := argv |> map(fn(text) _newString(state, text))
                    if state.error = ? -> execute(program, entry, 'main', '([Ljava/lang/String;)V',
                        [_tagRef(state, {className: '[Ljava/lang/String;',
                            tag: 'java/lang/String', values: values})], ?, state)
                }
            }
        }
    }
    if state.error = ? & state.thrown = ? & program.kind != 'application' {
		true -> {
			if _findMethod(program, entry, '<init>', '()V') != ? -> execute(program, entry, '<init>', '()V', [], obj, state)
            if state.error = ? & state.thrown = ? -> if options.method != ? {
				true -> {
					desc := options.desc |> default('()V')
                    methodArgs := default(options.args, []) |> map(fn(arg) if type(arg) = :string {
                        true -> _newString(state, arg), _ -> arg})
                    if state.error = ? -> value <- execute(program, entry,
                        options.method, desc, methodArgs, obj, state)
				}
				_ -> {
					if _findMethod(program, entry, 'init', '()V') != ? -> execute(program, entry, 'init', '()V', [], obj, state)
                    if state.error = ? & state.thrown = ? &
                        _findMethod(program, entry, 'start', '()V') != ? ->
                        execute(program, entry, 'start', '()V', [], obj, state)
                    if state.error = ? & state.thrown = ? &
                        options.paint? = true {
                        true -> {
                            paint := _findMethod(program, entry, 'paint', '(Ljava/awt/Graphics;)V')
                            if paint = ? {
                                true -> fail(state, 'paint(Graphics) is not compiled')
                                _ -> {
                                    // The synthetic, detached paint adapter
                                    // starts from this Component's explicitly
                                    // set foreground (or black without one).
                                    graphics := _tagRef(state, {className: 'java/awt/Graphics',
                                        fields: {},
                                        color: if obj.foreground != ? {true -> obj.foreground,
                                            _ -> namedColor('black', state)},
                                        font: {name: 'Dialog', style: 0, size: 12}})
                                    if state.error = ? -> execute(program, entry,
                                        'paint', '(Ljava/awt/Graphics;)V', [graphics], obj, state)
                                }
                            }
                        }
                    }
				}
			}
		}
	}
    if state.error = ? & state.thrown = ? & program.kind = 'applet' ->
        eventRecords |> std.each(fn(record) if state.error = ? &
            state.thrown = ? {
            true -> _deliverLegacyEvent(program, obj, state, record)
        })
    // The 61-frame sink is a finite lifecycle oracle. A retained GUI uses its
    // own bounded post-event presentation, not additional headless captures:
    // otherwise stepping from paused frame 60 would exceed the oracle cap.
    if options.persistent? = true & state.error = ? & state.thrown = ? ->
        state.frameSink <- ?
    if state.error != ? {
        true -> {type: :error, message: state.error, output: state.output,
            steps: state.steps, draw: state.draw}
        _ -> if state.thrown != ? {
            true -> {type: :error, message: 'uncaught Java exception ' +
                state.thrown.className + if state.thrown.message = ? {
                    true -> '', _ -> ': ' + state.thrown.message},
                thrown: state.thrown, output: state.output,
                steps: state.steps, draw: state.draw}
            _ -> {type: :ok, value: if _string?(value) {
                true -> value.text, _ -> value}, output: state.output,
                steps: state.steps, object: obj, statics: statics,
                statusEvents: state.statusEvents,
                navigationEvents: state.navigationEvents,
                eventResults: state.eventResults,
                repaintCount: state.repaintCount, draw: state.draw,
                screen: state.screen, virtualMillis: state.virtualMillis,
                startedTasks: state.startedTasks, focusCount: state.focusCount,
                notifyAllCount: state.notifyAllCount,
                yieldCount: state.yieldCount,
                midpRuntimeGcCalls: state.midpRuntimeGcCalls,
                captureCount: state.captureCount, captureCells: state.captureCells,
                session: if options.persistentMethod? = true {
                    true -> {kind: 'bounded-method', calls: 1,
                        program: program, object: obj, state: state}
                    _ -> if options.persistent? = true {
                        true -> {kind: 'bounded-legacy-event',
                            program: program, object: obj, state: state}
                        _ -> ?
                    }}
                }
        }
    }
}
