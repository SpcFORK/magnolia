            'component-background-is-set' -> if recv.background != ? {
                true -> 1, _ -> 0}
            'component-foreground-is-set' -> if recv.foreground != ? {
                true -> 1, _ -> 0}
            'component-enable', 'component-disable' -> if recv.awtReady? != true {
                true -> fail(state, 'enable/disable requires constructed Component')
                _ -> {
                    recv.enabled? <- spec.op = 'component-enable'
                    ?
                }
            }
            'component-is-enabled' -> if recv.awtReady? = true {
                true -> if recv.enabled? {true -> 1, _ -> 0}
                _ -> fail(state, 'isEnabled requires constructed Component')
            }
            'component-parent' -> if recv.awtReady? = true {
                true -> recv.parent
                _ -> fail(state, 'getParent requires constructed Component')
            }
            'canvas-bounds-set', 'canvas-bounds-get' -> if
                !_isInstance(program, recv, 'java/awt/Canvas') |
                recv.awtReady? != true {
                true -> fail(state, 'Component bounds require a constructed Canvas')
                _ -> if recv.parent != ? {
                    true -> fail(state, 'AWT attached Canvas bounds require unmodeled layout geometry')
                    _ -> if spec.op = 'canvas-bounds-set' {
                        true -> if !_int32?(args.(0)) | !_int32?(args.(1)) |
                            !_int32?(args.(2)) | !_int32?(args.(3)) |
                            args.(0) < -4096 | args.(0) > 4096 |
                            args.(1) < -4096 | args.(1) > 4096 |
                            args.(2) < 0 | args.(2) > 4096 |
                            args.(3) < 0 | args.(3) > 4096 {
                            true -> fail(state, 'AWT Canvas bounds outside bounded detached geometry')
                            _ -> {
                                recv.boundsX <- args.(0)
                                recv.boundsY <- args.(1)
                                recv.boundsWidth <- args.(2)
                                recv.boundsHeight <- args.(3)
                                ?
                            }
                        }
                        _ -> _tagRef(state, {className: 'java/awt/Rectangle',
                            rectReady?: true, fields: {
                            'java/awt/Rectangle.x:I': recv.boundsX
                            'java/awt/Rectangle.y:I': recv.boundsY
                            'java/awt/Rectangle.width:I': recv.boundsWidth
                            'java/awt/Rectangle.height:I': recv.boundsHeight
                        }})
                    }
                }
            }
            'bounded-legacy-event' -> {
                event := args.(0)
                if event = ? {
                    true -> _raiseJava(state, 'java/lang/NullPointerException',
                        'null legacy AWT Event')
                    _ -> if type(event) != :object |
                        event.className != 'java/awt/Event' |
                        !_int32?(event.fields.('java/awt/Event.id:I')) |
                        !_int32?(event.fields.('java/awt/Event.key:I')) |
                        !_int32?(event.fields.('java/awt/Event.x:I')) |
                        !_int32?(event.fields.('java/awt/Event.y:I')) {
                        true -> fail(state, 'invalid bounded legacy AWT Event')
                        _ -> {
                            id := event.fields.('java/awt/Event.id:I')
                            key := event.fields.('java/awt/Event.key:I')
                            x := event.fields.('java/awt/Event.x:I')
                            y := event.fields.('java/awt/Event.y:I')
                            // JDK Component.handleEvent's legacy switch:
                            // callbacks are *virtual* even though this call
                            // to the superclass is invokespecial. Component's
                            // own unoverridden callbacks return false.
                            fn callback(name, desc, values) if
                                _findMethod(program, recv.className, name, desc) {
                                ? -> 0
                                _ -> execute(program, recv.className, name,
                                    desc, values, recv, state)
                            }
                            if id {
                                401, 403 -> callback('keyDown',
                                    '(Ljava/awt/Event;I)Z', [event, key])
                                402, 404 -> callback('keyUp',
                                    '(Ljava/awt/Event;I)Z', [event, key])
                                501 -> callback('mouseDown',
                                    '(Ljava/awt/Event;II)Z', [event, x, y])
                                502 -> callback('mouseUp',
                                    '(Ljava/awt/Event;II)Z', [event, x, y])
                                503 -> callback('mouseMove',
                                    '(Ljava/awt/Event;II)Z', [event, x, y])
                                504 -> callback('mouseEnter',
                                    '(Ljava/awt/Event;II)Z', [event, x, y])
                                505 -> callback('mouseExit',
                                    '(Ljava/awt/Event;II)Z', [event, x, y])
                                506 -> callback('mouseDrag',
                                    '(Ljava/awt/Event;II)Z', [event, x, y])
                                1001 -> callback('action',
                                    '(Ljava/awt/Event;Ljava/lang/Object;)Z', [event, ?])
                                1004 -> callback('gotFocus',
                                    '(Ljava/awt/Event;Ljava/lang/Object;)Z', [event, ?])
                                1005 -> callback('lostFocus',
                                    '(Ljava/awt/Event;Ljava/lang/Object;)Z', [event, ?])
                                _ -> 0
                            }
                        }
                    }
                }
            }
            'raster-image-new' -> _rasterNew(args.(0), args.(1), state)
            'raster-image-source' -> _rasterFromProducer(args.(0), state)
            'bounded-repaint' -> if state.repaintCount >= 128 |
                (state.pendingRepaint != ? &
                    state.pendingRepaint.refId != recv.refId) {
                true -> fail(state, 'headless repaint event limit or multi-window guard exceeded')
                _ -> {
                    state.repaintCount <- state.repaintCount + 1
                    // The original first-frame method has already painted
                    // bimage before it requests the first repaint.
                    if state.frameSink != ? & state.captureCount = 0 &
                        recv.fields.('fliplay.frame_number:I') = 0 &
                        recv.fields.('fliplay.display_frame:Z') = 1 ->
                        _captureFrame(state,
                            recv.fields.('fliplay.bimage:Ljava/awt/Image;'), 0)
                    // AWT coalesces queued repaints; deliver ONE update per
                    // target at the next virtual Thread.sleep yield.
                    if state.pendingRepaint = ? -> state.pendingRepaint <- recv
                    if state.traceRepaints? -> std.println(
                        '[headless-repaint] event=' + string(state.repaintCount) +
                        ' steps=' + string(state.steps) +
                        ' frame=' + string(recv.fields.('fliplay.frame_number:I')))
                    ?
                }
            }
            'bounded-size' -> if !_int32?(state.viewportWidth) |
                !_int32?(state.viewportHeight) |
                state.viewportWidth < 1 | state.viewportHeight < 1 |
                state.viewportWidth > 4096 | state.viewportHeight > 4096 {
                true -> fail(state, 'headless viewport dimensions outside bound')
                _ -> _tagRef(state, {className: 'java/awt/Dimension', fields: {
                    'java/awt/Dimension.width:I': state.viewportWidth
                    'java/awt/Dimension.height:I': state.viewportHeight
                }})
            }
            'bounded-focus' -> if state.focusCount >= 32 {
                true -> fail(state, 'headless focus request limit exceeded')
                _ -> {
                    state.focusCount <- state.focusCount + 1
                    ?
                }
            }
            _ -> fail(state, 'unsupported Component image/repaint/focus operation')
        }
    }
    'java/awt/Image' -> if !_rasterImage?(recv) {
        true -> fail(state, 'Image method on non-raster receiver')
        _ -> if spec.op {
            'raster-graphics' -> _rasterGraphics(recv, state)
            // BufferedImage.flush() releases accelerator state, not pixels.
            'raster-flush' -> ?
            _ -> fail(state, 'unsupported Image method ' + name + desc)
        }
    }
    'java/awt/Color' -> if recv = ? | recv.className != owner |
        name != '<init>' {
        true -> fail(state, 'invalid AWT Color call')
        _ -> if spec.op = 'opaque-packed-color-init' & _int32?(args.(0)) {
            true -> {
                // Color(int) is ALWAYS opaque: high input bits are ignored.
                recv.red <- (args.(0) >> 16) & 255
                recv.green <- (args.(0) >> 8) & 255
                recv.blue <- args.(0) & 255
                ?
            }
            _ -> if spec.op = 'color-init' &
                args |> std.every(fn(n) _int32?(n) & n >= 0 & n <= 255) {
                true -> {
                    recv.red <- args.(0)
                    recv.green <- args.(1)
                    recv.blue <- args.(2)
                    ?
                }
                _ -> fail(state, 'AWT Color components require 0..255 int32 values')
            }
        }
    }
    'java/awt/Font' -> if recv = ? | recv.className != owner {
        true -> fail(state, 'AWT Font method on non-Font receiver')
        _ -> if spec.op = 'font-init' {
            true -> {
                fontName := if args.(0) = ? {true -> 'Default',
                    _ -> _stringText(args.(0))}
                if !_fontNameAllowed?(fontName) | !_int32?(args.(1)) |
                    !_int32?(args.(2)) | args.(2) < 1 | args.(2) > 256 {
                    true -> fail(state, 'AWT Font requires a bounded ASCII name and size 1..256')
                    _ -> {
                        recv.fontName <- fontName
                        // Java's Font constructor normalizes an invalid
                        // BOLD/ITALIC bitmask to PLAIN.
                        recv.fontStyle <- if args.(1) >= 0 & args.(1) <= 3 {
                            true -> args.(1), _ -> 0}
                        recv.fontSize <- args.(2)
                        recv.fontReady? <- true
                        ?
                    }
                }
            }
            _ -> if recv.fontReady? != true {
                true -> fail(state, 'AWT Font used before initialization')
                _ -> if spec.op {
                    'font-name' -> _newString(state, recv.fontName)
                    'font-style' -> recv.fontStyle
                    'font-size' -> recv.fontSize
                    _ -> fail(state, 'unsupported AWT Font method ' + name + desc)
                }
            }
        }
    }
    'java/awt/Rectangle' -> if spec.op != 'bounded-rectangle-init' |
        recv = ? | recv.className != owner | recv.rectReady? = true |
        !(args |> std.every(_int32?)) {
        true -> fail(state, 'Rectangle(IIII) requires a fresh bounded int32 rectangle')
        _ -> {
            recv.fields.('java/awt/Rectangle.x:I') <- args.(0)
            recv.fields.('java/awt/Rectangle.y:I') <- args.(1)
            recv.fields.('java/awt/Rectangle.width:I') <- args.(2)
            recv.fields.('java/awt/Rectangle.height:I') <- args.(3)
            recv.rectReady? <- true
            ? // Even negative widths/heights are valid JDK Rectangle fields.
        }
    }
    'java/awt/Point' -> if !_point?(recv) {
        true -> fail(state, 'AWT Point method on non-Point receiver')
        _ -> if spec.op {
            'point-init' -> ? // new already prepared both int fields as zero
            'point-init-xy', 'point-move' -> if !_int32?(args.(0)) |
                !_int32?(args.(1)) {
                true -> fail(state, 'AWT Point requires int32 coordinates')
                _ -> {
                    recv.fields.(_pointKey('x')) <- args.(0)
                    recv.fields.(_pointKey('y')) <- args.(1)
                    ?
                }
            }
            'point-init-copy' -> if !_point?(args.(0)) {
                true -> fail(state, 'AWT Point copy requires a Point')
                _ -> {
                    recv.fields.(_pointKey('x')) <- args.(0).fields.(_pointKey('x'))
                    recv.fields.(_pointKey('y')) <- args.(0).fields.(_pointKey('y'))
                    ?
                }
            }
            'point-copy' -> _newPoint(state, recv.fields.(_pointKey('x')),
                recv.fields.(_pointKey('y')))
            'point-equals' -> if _point?(args.(0)) &
                recv.fields.(_pointKey('x')) = args.(0).fields.(_pointKey('x')) &
                recv.fields.(_pointKey('y')) = args.(0).fields.(_pointKey('y')) {
                true -> 1, _ -> 0
            }
            _ -> fail(state, 'unsupported AWT Point method ' + name + desc)
        }
    }
    'java/awt/Graphics' -> if recv.className = owner {
        true -> if spec.op {
            'draw-color' -> if args.(0) = ? | args.(0).className != 'java/awt/Color' {
                true -> fail(state, 'invalid AWT setColor argument')
                _ -> recv.color <- args.(0)
            }
            // Oracle Graphics.setFont(null) is a no-op. This records logical
            // font state only; no metrics or platform glyph parity is claimed.
            'draw-font' -> if args.(0) != ? {
                true -> if args.(0).className != 'java/awt/Font' |
                    args.(0).fontReady? != true |
                    !_fontNameAllowed?(args.(0).fontName) |
                    !_int32?(args.(0).fontStyle) |
                    !_int32?(args.(0).fontSize) |
                    args.(0).fontSize < 1 | args.(0).fontSize > 256 {
                    true -> fail(state, 'Graphics.setFont requires a bounded initialized Font or null')
                    _ -> recv.font <- {name: args.(0).fontName,
                        style: args.(0).fontStyle, size: args.(0).fontSize}
                }
            }
            'draw-rect' -> if recv.image != ? {
                true -> _rasterFill(recv, args.(0), args.(1), args.(2), args.(3), false, state)
                _ -> if args.(2) > 0 & args.(3) > 0 {
                    true -> draw(state, {type: :rect, x: args.(0), y: args.(1), width: args.(2), height: args.(3), color: awtCSS(recv.color)})
                }
            }
            'raster-outline' -> _rasterFill(recv, args.(0), args.(1), args.(2), args.(3), true, state)
            'raster-intersect-clip' -> _rasterClipRect(recv, args.(0),
                args.(1), args.(2), args.(3), state)
            'raster-arrow' -> _rasterArrow(recv, args.(0), args.(1), args.(2), state)
            'raster-blit' -> _rasterBlit(program, recv, args.(0),
                args.(1), args.(2), args.(3), state)
            'draw-line' -> if recv.image != ? {
                true -> fail(state, 'raster Graphics.drawLine is outside pixel subset')
                _ -> draw(state, {type: :line, x1: args.(0), y1: args.(1),
                    x2: args.(2), y2: args.(3), color: awtCSS(recv.color)})
            }
            'draw-arc', 'fill-arc' -> if recv.image != ? {
                true -> fail(state, 'raster Graphics arc rendering is not implemented')
                _ -> if args |> std.some(fn(arg) !_int32?(arg)) {
                true -> fail(state, 'Graphics arc arguments require six int32 values')
                _ -> draw(state, {type: if spec.op = 'draw-arc' {
                    true -> :drawArc, _ -> :fillArc},
                    x: args.(0), y: args.(1), width: args.(2),
                    height: args.(3), startAngle: args.(4),
                    arcAngle: args.(5), color: awtCSS(recv.color)})
                }
            }
            'draw-text' -> if recv.image != ? {
                true -> fail(state, 'raster Graphics.drawString is outside pixel subset')
                _ -> if args.(0) = ? {
                    true -> _raiseJava(state, 'java/lang/NullPointerException',
                        'Graphics.drawString(null)')
                    _ -> if !_string?(args.(0)) | len(args.(0).text) > 65536 {
                        true -> fail(state, 'Graphics.drawString requires a bounded String')
                        _ -> draw(state, {type: :text, text: args.(0).text,
                            x: args.(1), y: args.(2), color: awtCSS(recv.color),
                            font: recv.font})
                    }
                }
            }
            _ -> fail(state, 'unsupported AWT Graphics call ' + name)
        }
        _ -> fail(state, 'AWT Graphics method on non-Graphics')
    }
	_ -> fail(state, 'unsupported host method ' + owner + '.' + name + desc)
}

fn _findMethod(program, owner, name, desc) {
	cls := program.classes.(owner)
	if cls = ? {
		true -> ?
		_ -> if found := cls.methods.(methodKey(name, desc)) {
			? -> if classParent(cls) = ? {true -> ?, _ -> _findMethod(program, classParent(cls), name, desc)}
			_ -> {owner: owner, method: found}
		}
	}
}

fn execute(program, owner, name, desc, args, recv, state) if {
    state.error != ? | state.thrown != ? -> ?
	state.depth >= state.maxDepth -> fail(state, 'maximum Java call depth exceeded')
	_ -> _execute(program, owner, name, desc, args, recv, state)
}
fn _execute(program, owner, name, desc, args, recv, state) {
	state.depth <- state.depth - (0 - 1)
	found := _findMethod(program, owner, name, desc)
	if found = ? {
		true -> {
			state.depth <- state.depth - 1
			fail(state, 'method not compiled: ' + owner + '.' + name + desc)
		}
		_ -> {
			method := found.method
            monitorKey := if method.synchronized? = true {
                true -> _monitorAcquire(found.owner, method.static?, recv, state)
                _ -> ?
            }
            // Per-invocation ledger prevents a monitorexit from stealing an
            // implicit synchronized-method lock or another call frame's lock.
            explicitHeld := {}
            explicitDepth := 0
            fn monitorEnter(obj) if obj = ? {
                true -> _raiseJava(state, 'java/lang/NullPointerException',
                    'monitorenter on null')
                _ -> {
                    key := _monitorAcquire('', false, obj, state)
                    if key != ? {
                        true -> if explicitDepth >= 64 {
                            true -> {
                                _monitorRelease(key, state)
                                fail(state, 'explicit JVM monitor depth exceeds 64')
                            }
                            _ -> {
                                previous := explicitHeld.(key) |> default(0)
                                explicitHeld.(key) <- previous + 1
                                explicitDepth <- explicitDepth + 1
                            }
                        }
                    }
                }
            }
            fn monitorExit(obj) if obj = ? {
                true -> _raiseJava(state, 'java/lang/NullPointerException',
                    'monitorexit on null')
                _ -> if type(obj) != :object | !_int32?(obj.refId) |
                    obj.refId < 1 {
                    true -> fail(state, 'monitorexit requires a JVM reference')
                    _ -> {
                        key := 'object:' + string(obj.refId)
                        held := explicitHeld.(key) |> default(0)
                        if held <= 0 {
                            true -> _raiseJava(state,
                                'java/lang/IllegalMonitorStateException',
                                'monitorexit without matching monitorenter')
                            _ -> {
                                _monitorRelease(key, state)
                                if state.error = ? {
                                    true -> {
                                        explicitHeld.(key) <- held - 1
                                        explicitDepth <- explicitDepth - 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
			locals := range(method.locals) |> map(fn(_) ?)
			isStatic? := method.static?
			base := if isStatic? {true -> 0, _ -> 1}
			if !isStatic? -> locals.(0) <- recv
            widths := method.argWidths |> default(range(len(args)) |> map(fn(_) 1))
            if len(args) != len(widths) -> fail(state, 'invalid method arity')
            slot := base
            args |> std.each(fn(arg, i) if state.error = ? {
                true -> {
                    width := widths.(i)
                    if (width != 1 & width != 2) | slot + width > len(locals) |
                        (width = 2 & !_wide?(arg)) {
                        true -> fail(state, 'invalid JVM argument width')
                        _ -> {
                            locals.(slot) <- arg
                            if width = 2 -> locals.(slot + 1) <- 'wide-tail'
                            slot <- slot + width
                        }
                    }
                }
            })
			stack := []
			sp := 0
            usedSlots := 0
			result := ?
		done? := false

            fn valueWidth(value) if _wide?(value) {true -> 2, _ -> 1}
            fn push(value) if state.thrown != ? {
                true -> ?
                _ -> if usedSlots + valueWidth(value) > method.stack {
                    true -> fail(state, 'operand stack overflow')
                    _ -> {
                        stack.(sp) <- value
                        sp <- sp + 1
                        usedSlots <- usedSlots + valueWidth(value)
                    }
                }
            }
			fn pop() if sp <= 0 {
				true -> fail(state, 'operand stack underflow')
				_ -> {
					sp <- sp - 1
                    value := stack.(sp)
                    usedSlots <- usedSlots - valueWidth(value)
					value
				}
			}
			fn local(index) if index < 0 | index >= len(locals) {
				true -> fail(state, 'invalid local variable index')
				_ -> locals.(index)
			}
			fn setLocal(index, value) if index < 0 | index >= len(locals) {
				true -> fail(state, 'invalid local variable index')
				_ -> {
                if index > 0 & locals.(index) = 'wide-tail' ->
                    locals.(index - 1) <- ?
                if _wide?(locals.(index)) & index + 1 < len(locals) ->
                    locals.(index + 1) <- ?
                locals.(index) <- value
            }
			}
            fn longLocal(index) if index < 0 | index + 1 >= len(locals) |
                !_long?(locals.(index)) | locals.(index + 1) != 'wide-tail' {
                true -> fail(state, 'invalid or uninitialized long local')
                _ -> locals.(index)
            }
            fn setLongLocal(index, value) if !_long?(value) |
                index < 0 | index + 1 >= len(locals) {
                true -> fail(state, 'invalid JVM long local store')
                _ -> {
                    if index > 0 & locals.(index) = 'wide-tail' ->
                        locals.(index - 1) <- ?
                    if _wide?(locals.(index + 1)) & index + 2 < len(locals) ->
                        locals.(index + 2) <- ?
                    locals.(index) <- value
                    locals.(index + 1) <- 'wide-tail'
                }
            }
            fn doubleLocal(index) if index < 0 | index + 1 >= len(locals) |
                !fp.double?(locals.(index)) | locals.(index + 1) != 'wide-tail' {
                true -> fail(state, 'invalid or uninitialized double local')
                _ -> locals.(index)
            }
            fn setDoubleLocal(index, value) if !fp.double?(value) |
                index < 0 | index + 1 >= len(locals) {
                true -> fail(state, 'invalid JVM double local store')
                _ -> {
                    if index > 0 & locals.(index) = 'wide-tail' ->
                        locals.(index - 1) <- ?
                    if _wide?(locals.(index + 1)) & index + 2 < len(locals) ->
                        locals.(index + 2) <- ?
                    locals.(index) <- value
                    locals.(index + 1) <- 'wide-tail'
                }
            }
            fn arrayValues(array) if array = ? {
                true -> _raiseJava(state, 'java/lang/NullPointerException',
                    'null array reference')
                _ -> if type(array) != :object | type(array.values) != :list |
                    type(array.className) != :string {
                    true -> fail(state, 'invalid array reference')
                    _ -> if !str.startsWith?(array.className, '[') {
                        true -> fail(state, 'invalid array reference')
                        _ -> array.values
                    }
                }
			}
            fn arrayKind?(array, op) if op {
                46, 79 -> array.tag = 10                  // int[]
                47, 80 -> array.tag = 11                  // long[]
                48, 81 -> array.tag = 6                   // float[]
                49, 82 -> array.tag = 7                   // double[]
                50, 83 -> type(array.tag) = :string     // reference[]
                51, 84 -> array.tag = 4 | array.tag = 8 // boolean[]/byte[]
                52, 85 -> array.tag = 5                  // char[]
                53, 86 -> array.tag = 9                  // short[]
                _ -> false
            }
			fn arrayGet(array, index) {
				vals := arrayValues(array)
				if vals = ? {true -> ?, _ -> if index < 0 | index >= len(vals) {
                    true -> _raiseJava(state,
                        'java/lang/ArrayIndexOutOfBoundsException',
                        'array index out of bounds')
                    _ -> vals.(index)
				}}
			}
			fn arraySet(array, index, value) {
				vals := arrayValues(array)
				if vals != ? -> if index < 0 | index >= len(vals) {
                    true -> _raiseJava(state,
                        'java/lang/ArrayIndexOutOfBoundsException',
                        'array index out of bounds')
                    _ -> vals.(index) <- value
				}
			}
			fn call(op, argc, ref) {
				argv := range(argc) |> map(fn(_) ?)
				fn gather(i) if i >= 0 {
					true -> {
						argv.(i) <- pop()
						gather(i - 1)
					}
				}
				gather(argc - 1)
				object := if op = 184 {true -> ?, _ -> pop()}
                if op != 184 & object = ? ->
                    _raiseJava(state, 'java/lang/NullPointerException',
                        'null method receiver')
                if state.error = ? & state.thrown = ? {
					true -> {
						owner := ref.(0)
						mname := ref.(1)
						mdesc := ref.(2)
                        if op = 185 & !_isInstance(program, object, owner) ->
                            _raiseJava(state, 'java/lang/IncompatibleClassChangeError',
                                'receiver does not implement ' + owner)
                        if op = 184 -> initializeClass(program, owner, state)
                        value := if state.error != ? | state.thrown != ? {
                            true -> ?, _ -> if mname = 'getParameter' & mdesc = '(Ljava/lang/String;)Ljava/lang/String;' &
                            _isInstance(program, object, 'java/applet/Applet') &
							_findMethod(program, owner, mname, mdesc) = ? {
							true -> if _string?(argv.(0)) {
                                true -> state.params.(argv.(0).text)
                                _ -> fail(state, 'getParameter requires a String key')
                            }
							_ -> if program.classes.(owner) = ? {
								true -> _hostCall(program, owner, mname, mdesc, op, object, argv, state)
                                _ -> {
                                    dynamicOwner := owner
                                    if (op = 182 | op = 185) & type(object) = :object {
                                        true -> if program.classes.(object.className) != ? ->
                                            dynamicOwner <- object.className
                                    }
