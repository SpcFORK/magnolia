                    _ -> codepoint(recv.text.(args.(0)))
                }
            }
        _ -> if spec.op = 'bounded-ascii-substring' {
            true -> if !_string?(recv) | !_int32?(args.(0)) |
                !_int32?(args.(1)) | len(recv.text) > 4096 |
                (std.range(len(recv.text)) |> std.some(fn(i) {
                    codepoint(recv.text.(i)) > 127
                })) {
                true -> fail(state, 'String.substring requires bounded ASCII and int32 indices')
                _ -> if args.(0) < 0 | args.(1) < args.(0) |
                    args.(1) > len(recv.text) {
                    true -> _raiseJava(state, 'java/lang/StringIndexOutOfBoundsException',
                        'String substring index out of bounds')
                    _ -> if args.(0) = 0 & args.(1) = len(recv.text) {
                        true -> recv
                        _ -> _newString(state,
                            std.slice(recv.text, args.(0), args.(1)))
                    }
                }
            }
        _ -> if spec.op = 'bounded-double-string' {
        true -> if !fp.double?(args.(0)) {
            true -> fail(state, 'String.valueOf(double) requires a JVM double')
            _ -> if rendered := fp.text(args.(0)) {
                ? -> fail(state, 'String.valueOf(double) outside bounded exact-decimal subset')
                _ -> _newString(state, rendered)
            }
        }
        _ -> {
            passed := if spec.op = 'string-equals' | spec.op = 'string-equals-ignore-case' |
                spec.op = 'string-concat' {
                true -> [_stringText(args.(0))], _ -> args}
            if opcode != 184 & !_string?(recv) ->
                fail(state, 'String method on non-String receiver')
            outcome := if state.error != ? {
                true -> ?
                _ -> if opcode = 184 {
                    true -> vmLib.jvmInvoke(spec, passed)
                    _ -> vmLib.jvmString(spec, recv.text, passed)
                }
            }
            if state.error != ? {true -> ?, _ -> if outcome.type = :error {
                true -> fail(state, outcome.message)
                _ -> if opcode = 184 {
                    true -> _newString(state, outcome.value)
                    _ -> if spec.op = 'string-concat' |
                            spec.op = 'bounded-ascii-char-replace' {
                        true -> if outcome.value = recv.text {true -> recv,
                            _ -> _newString(state, outcome.value)}
                        _ -> outcome.value
                    }
                }
            }}
        }
        }
        }
        }
        }
        }
        }
    }
    'java/lang/Throwable', 'java/lang/Exception', 'java/lang/RuntimeException',
    'java/lang/Error', 'java/io/IOException',
    'java/lang/ClassNotFoundException', 'java/lang/InterruptedException',
    'java/lang/ArithmeticException', 'java/lang/NullPointerException',
    'java/lang/NegativeArraySizeException', 'java/lang/ClassCastException',
    'java/lang/ArrayStoreException', 'java/lang/IllegalArgumentException',
    'java/lang/IllegalStateException', 'java/lang/IndexOutOfBoundsException',
    'java/lang/ArrayIndexOutOfBoundsException',
    'java/lang/StringIndexOutOfBoundsException',
    'java/lang/NumberFormatException', 'java/lang/LinkageError',
    'java/lang/ExceptionInInitializerError',
    'java/lang/NoClassDefFoundError' -> if recv = ? |
        !_isInstance(program, recv, owner) {
        true -> fail(state, 'Throwable method on non-Throwable receiver')
        _ -> if spec.op {
            'throwable-init' -> recv.message <- ?
            'throwable-init-message' -> if _string?(args.(0)) {
                true -> recv.message <- args.(0).text
                _ -> if args.(0) = ? {true -> recv.message <- ?, _ ->
                    fail(state, 'Throwable constructor requires a String')}
