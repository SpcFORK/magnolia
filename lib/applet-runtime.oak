                        chars := args.(0)
                        if !_arraycopyArray?(chars) | chars.className != '[C' |
                            chars.tag != 5 | len(chars.values) > 4096 |
                            !(chars.values |> std.every(fn(unit) _int32?(unit) &
                                unit >= 0 & unit <= 127)) {
                            true -> fail(state, 'String(char[]) requires at most 4096 ASCII char units')
                            _ -> if len(chars.values) > state.maxSteps - state.steps {
                                true -> fail(state, 'String(char[]) copy instruction budget exceeded')
                                _ -> {
                                    // Charge the whole copy before mutating the String.
                                    state.steps <- state.steps + len(chars.values)
                                    recv.text <- chars.values |> std.map(char) |> str.join('')
                                    ?
                                }
                            }
                        }
                    }
                }
            }
        _ -> if spec.op = 'bounded-ascii-char-at' {            true -> if !_string?(recv) | !_int32?(args.(0)) |
                len(recv.text) > 4096 |
                (std.range(len(recv.text)) |> std.some(fn(i) {
                    codepoint(recv.text.(i)) > 127
                })) {
                true -> fail(state, 'String.charAt requires bounded ASCII and int32 index')
                _ -> if args.(0) < 0 | args.(0) >= len(recv.text) {
                    true -> _raiseJava(state, 'java/lang/StringIndexOutOfBoundsException',
