// codegen-native -- Native machine code generation from Oak AST
//
// Generates x86-64 and ARM64 machine code from Oak AST nodes.
// This module does NOT produce an executable directly — it emits
// raw instruction bytes that must be linked (see linker.oak) into
// a platform-specific binary (ELF, PE, Mach-O).
//
// Architecture:
//   1. AST → IR (intermediate representation with virtual registers)
//   2. IR → register-allocated machine instructions
//   3. Machine instructions → assembled bytes
//
// The IR is a simple 3-address code with virtual registers, designed
// for straightforward lowering to x86-64 or ARM64.

{
	default: default
	map: map
	each: each
	slice: slice
	filter: filter
	reduce: reduce
	clone: clone
	append: append
	len: len
	range: range
	indexOf: indexOf
} := import('std')
{
	replace: replace
	join: join
	split: split
} := import('str')
{
	format: format
	printf: printf
} := import('fmt')

// ---------------------------------------------------------------------------
// Target architectures
// ---------------------------------------------------------------------------

ARCH_X86_64 := :x86_64
ARCH_ARM64 := :arm64

// ---------------------------------------------------------------------------
// IR opcodes — 3-address intermediate representation
// ---------------------------------------------------------------------------

IR_CONST     := :ir_const        // %dst = const value
IR_LOAD      := :ir_load         // %dst = load(%src)
IR_STORE     := :ir_store        // store(%dst, %src)
IR_ADD       := :ir_add          // %dst = %a + %b
IR_SUB       := :ir_sub          // %dst = %a - %b
IR_MUL       := :ir_mul          // %dst = %a * %b
IR_DIV       := :ir_div          // %dst = %a / %b
IR_MOD       := :ir_mod          // %dst = %a % %b
IR_NEG       := :ir_neg          // %dst = -%src
IR_NOT       := :ir_not          // %dst = !%src
IR_AND       := :ir_and          // %dst = %a & %b
IR_OR        := :ir_or           // %dst = %a | %b
IR_XOR       := :ir_xor          // %dst = %a ^ %b
IR_SHL       := :ir_shl          // %dst = %a << %b
IR_SHR       := :ir_shr          // %dst = %a >> %b
IR_EQ        := :ir_eq           // %dst = %a == %b
IR_NEQ       := :ir_neq          // %dst = %a != %b
IR_LT        := :ir_lt           // %dst = %a < %b
IR_GT        := :ir_gt           // %dst = %a > %b
IR_LEQ       := :ir_leq          // %dst = %a <= %b
IR_GEQ       := :ir_geq          // %dst = %a >= %b
IR_CALL      := :ir_call         // %dst = call(%fn, args...)
IR_RET       := :ir_ret          // return %src
IR_JMP       := :ir_jmp          // goto label
IR_JZ        := :ir_jz           // if %cond == 0 goto label
IR_JNZ       := :ir_jnz          // if %cond != 0 goto label
IR_LABEL     := :ir_label        // label:
IR_ARG       := :ir_arg          // %dst = SysV arg register #a
IR_STKARG    := :ir_stkarg       // stack-passed arg: %dst = [rbp + 16 + 8*(a-6)]
IR_FRAME     := :ir_frame        // function prologue: push rbp; mov rbp,rsp; sub rsp,#a
IR_RETQ      := :ir_retq         // plain ret (no frame teardown), %a = result
IR_CMOV      := :ir_cmov         // %dst = %cond ? %a : %b
IR_ALLOC     := :ir_alloc        // %dst = alloc(size)  — heap allocation
IR_PUSH      := :ir_push         // push(%src) to list
IR_INDEX     := :ir_index        // %dst = %obj[%key]
IR_SETINDEX  := :ir_setindex     // %obj[%key] = %val
IR_CLOSURE   := :ir_closure      // %dst = closure(%fn, captures...)
IR_PHI       := :ir_phi          // %dst = phi(%a, %b) — SSA merge
IR_NOP       := :ir_nop          // no-op

// ---------------------------------------------------------------------------
// IR instruction constructors
// ---------------------------------------------------------------------------

fn irInst(op, dst, a, b, extra) {
	op: op
	dst: dst
	a: a
	b: b
	extra: extra
}

fn irConst(dst, value) irInst(IR_CONST, dst, value, ?, ?)
fn irLoad(dst, src) irInst(IR_LOAD, dst, src, ?, ?)
fn irStore(dst, src) irInst(IR_STORE, dst, src, ?, ?)
fn irAdd(dst, a, b) irInst(IR_ADD, dst, a, b, ?)
fn irSub(dst, a, b) irInst(IR_SUB, dst, a, b, ?)
fn irMul(dst, a, b) irInst(IR_MUL, dst, a, b, ?)
fn irDiv(dst, a, b) irInst(IR_DIV, dst, a, b, ?)
fn irMod(dst, a, b) irInst(IR_MOD, dst, a, b, ?)
fn irNeg(dst, src) irInst(IR_NEG, dst, src, ?, ?)
fn irNot(dst, src) irInst(IR_NOT, dst, src, ?, ?)
fn irAnd(dst, a, b) irInst(IR_AND, dst, a, b, ?)
fn irOr(dst, a, b) irInst(IR_OR, dst, a, b, ?)
fn irXor(dst, a, b) irInst(IR_XOR, dst, a, b, ?)
fn irShl(dst, a, b) irInst(IR_SHL, dst, a, b, ?)
fn irShr(dst, a, b) irInst(IR_SHR, dst, a, b, ?)
fn irEq(dst, a, b) irInst(IR_EQ, dst, a, b, ?)
fn irNeq(dst, a, b) irInst(IR_NEQ, dst, a, b, ?)
fn irLt(dst, a, b) irInst(IR_LT, dst, a, b, ?)
fn irGt(dst, a, b) irInst(IR_GT, dst, a, b, ?)
fn irLeq(dst, a, b) irInst(IR_LEQ, dst, a, b, ?)
fn irGeq(dst, a, b) irInst(IR_GEQ, dst, a, b, ?)
fn irCall(dst, fnReg, args) irInst(IR_CALL, dst, fnReg, ?, { args: args })
fn irArg(dst, idx) irInst(IR_ARG, dst, idx, ?, ?)
fn irFrame(size) irInst(IR_FRAME, ?, size, ?, ?)
fn irStkArg(dst, idx) irInst(IR_STKARG, dst, idx, ?, ?)
fn irRetQ(src) irInst(IR_RETQ, ?, src, ?, ?)
fn irCmov(dst, cond, a, b) irInst(IR_CMOV, dst, cond, ?, { a: a, b: b })
fn irRet(src) irInst(IR_RET, ?, src, ?, ?)
fn irJmp(label) irInst(IR_JMP, ?, ?, ?, { label: label })
fn irJz(cond, label) irInst(IR_JZ, ?, cond, ?, { label: label })
fn irJnz(cond, label) irInst(IR_JNZ, ?, cond, ?, { label: label })
fn irLabel(name) irInst(IR_LABEL, ?, ?, ?, { label: name })
fn irAlloc(dst, size) irInst(IR_ALLOC, dst, size, ?, ?)
fn irPush(list, val) irInst(IR_PUSH, ?, list, val, ?)
fn irIndex(dst, obj, key) irInst(IR_INDEX, dst, obj, key, ?)
fn irSetIndex(obj, key, val) irInst(IR_SETINDEX, ?, obj, key, { val: val })
fn irClosure(dst, fnRef, captures) irInst(IR_CLOSURE, dst, fnRef, ?, { captures: captures })
fn irNop() irInst(IR_NOP, ?, ?, ?, ?)

// ---------------------------------------------------------------------------
// IR compiler — Oak AST → IR instructions
// ---------------------------------------------------------------------------

fn createIRCompiler() {
	nextReg := [0]
	nextLabel := [0]
	instructions := []
	stringPool := []
	functionPool := []
	// st.0 = current name->vreg env; st.1 = [name, label] fn pairs.
	// Captured-list index ops are reliable at closure depth where captured
	// object member writes and beyond-first param bindings are not.
	st := [{}, []]

	fn freshReg() {
		r := nextReg.0
		nextReg.0 <- r + 1
		r
	}

	fn regCount() nextReg.0

	fn freshLabel(prefix) {
		l := nextLabel.0
		nextLabel.0 <- l + 1
		prefix + '_' + string(l)
	}

	fn emit(inst) {
		instructions << inst
	}

	fn internString(s) {
		idx := indexOf(stringPool, s)
		if idx {
			-1 -> {
				stringPool << s
				len(stringPool) - 1
			}
			_ -> idx
		}
	}

	// find a function label by name in the pair list
	fn findFn(pairs, name, i) if i < len(pairs) {
		true -> {
			if pairs.(i).0 = name {
				true -> pairs.(i).1
				_ -> findFn(pairs, name, i + 1)
			}
		}
		_ -> ?
	}

	// bind registers for list elements into dst (alloc + push)
	fn walkListElems(elems, i, dst) if i < len(elems) {
		true -> {
			elemReg := compileNode(elems.(i))
			emit(irPush(dst, elemReg))
			walkListElems(elems, i + 1, dst)
		}
		_ -> ?
	}

	// bind object entries into dst (alloc + setIndex)
	fn walkObjEntries(entries, i, dst) if i < len(entries) {
		true -> {
			keyReg := compileNode(entries.(i).key)
			valReg := compileNode(entries.(i).val)
			emit(irSetIndex(dst, keyReg, valReg))
			walkObjEntries(entries, i + 1, dst)
		}
		_ -> ?
	}

	// walk block statements, returning the last expression's register
	fn walkBlockExprs(exprs, i, acc) if i < len(exprs) {
		true -> walkBlockExprs(exprs, i + 1, compileNode(exprs.(i)), acc)
		_ -> acc
	}

	// walk ifExpr branches: equality-match arms against cond, default arm
	// binds unconditionally; result lands in resultReg
	fn walkBranches(branches, i, condReg, resultReg, endLabel) if i < len(branches) {
		true -> {
			if branches.(i).target.type {
				:empty -> {
					bodyReg := compileNode(branches.(i).body)
					emit(irStore(resultReg, bodyReg))
				}
				_ -> {
					targetReg := compileNode(branches.(i).target)
					matchReg := freshReg()
					emit(irEq(matchReg, condReg, targetReg))
					nextLabel := freshLabel('if_next')
					emit(irJz(matchReg, nextLabel))
					bodyReg := compileNode(branches.(i).body)
					emit(irStore(resultReg, bodyReg))
					emit(irJmp(endLabel))
					emit(irLabel(nextLabel))
				}
			}
			walkBranches(branches, i + 1, condReg, resultReg, endLabel)
		}
		_ -> ?
	}

	// bind fn call args (compiling each), returning the vreg list
	fn walkArgs(args, i, acc) if i < len(args) {
		true -> {
			acc << compileNode(args.(i))
			walkArgs(args, i + 1, acc)
		}
		_ -> acc
	}

	// compile a named function body: SysV param regs -> homes, body, ret
	fn compileFnBody(fnNode, fnLabel) {
		skipLabel := freshLabel('fn_skip')
		emit(irJmp(skipLabel))
		emit(irLabel(fnLabel))
		emit(irFrame(regCount())) // own frame: recursion-safe homes
		paramEnv := {}
		fn bindParams(i, penv) if i < len(fnNode.args) {
			true -> {
				if penv.(fnNode.args.(i)) {
					? -> penv.(fnNode.args.(i)) <- freshReg()
					_ -> ?
				}
				if i < 6 {
					true -> emit(irArg(penv.(fnNode.args.(i)), i))
					_ -> emit(irStkArg(penv.(fnNode.args.(i)), i))
				}
				bindParams(i + 1, penv)
			}
			_ -> ?
		}
		if fnNode.args {
			? -> ?
			_ -> bindParams(0, paramEnv)
		}
		st.0 <- paramEnv
		bodyReg := compileNode(fnNode.body)
		emit(irRet(bodyReg))
		emit(irLabel(skipLabel))
	}

	// Compile an AST node, returning the register holding the result
	fn compileNode(node) {
		env := st.0
		ftab := st.1
		if node {
			? -> {
				dst := freshReg()
				emit(irConst(dst, ?))
				dst
			}
			_ -> if node.type {
				:null -> {
					dst := freshReg()
					emit(irConst(dst, ?))
					dst
				}

				:empty -> {
					dst := freshReg()
					emit(irConst(dst, ?))
					dst
				}

				:int -> {
					dst := freshReg()
					emit(irConst(dst, node.val))
					dst
				}

				:float -> {
					dst := freshReg()
					emit(irConst(dst, node.val))
					dst
				}

				:bool -> {
					dst := freshReg()
					emit(irConst(dst, node.val))
					dst
				}

				:string -> {
					dst := freshReg()
					idx := internString(node.val)
					emit(irConst(dst, { stringIdx: idx }))
					dst
				}

				:atom -> {
					dst := freshReg()
					idx := internString(node.val)
					emit(irConst(dst, { atomIdx: idx }))
					dst
				}

				:identifier -> {
					dst := freshReg()
					if env.(node.val) {
						? -> emit(irConst(dst, 0)) // unknown symbol: stand-in nil
						_ -> emit(irLoad(dst, env.(node.val)))
					}
					dst
				}

				:list -> {
					dst := freshReg()
					emit(irAlloc(dst, len(node.elems)))
					walkListElems(node.elems, 0, dst)
					dst
				}

				:object -> {
					dst := freshReg()
					emit(irAlloc(dst, len(node.entries)))
					walkObjEntries(node.entries, 0, dst)
					dst
				}

				:unary -> if node.op {
					:minus -> {
						src := compileNode(node.right)
						dst := freshReg()
						emit(irNeg(dst, src))
						dst
					}
					:exclam -> {
						src := compileNode(node.right)
						dst := freshReg()
						emit(irNot(dst, src))
						dst
					}
				}

				:binary -> {
					aReg := compileNode(node.left)
					bReg := compileNode(node.right)
					dst := freshReg()
					if node.op {
						:plus -> emit(irAdd(dst, aReg, bReg))
						:minus -> emit(irSub(dst, aReg, bReg))
						:times -> emit(irMul(dst, aReg, bReg))
						:divide -> emit(irDiv(dst, aReg, bReg))
						:modulus -> emit(irMod(dst, aReg, bReg))
						:and -> emit(irAnd(dst, aReg, bReg))
						:or -> emit(irOr(dst, aReg, bReg))
						:xor -> emit(irXor(dst, aReg, bReg))
						// '<<' is dual-purpose in Magnolia (list append / int shl);
						// native v1 compiles it as integer shift-left
						:pushArrow -> emit(irShl(dst, aReg, bReg))
						:rshift -> emit(irShr(dst, aReg, bReg))
						:eq -> emit(irEq(dst, aReg, bReg))
						:neq -> emit(irNeq(dst, aReg, bReg))
						:greater -> emit(irGt(dst, aReg, bReg))
						:less -> emit(irLt(dst, aReg, bReg))
						:geq -> emit(irGeq(dst, aReg, bReg))
						:leq -> emit(irLeq(dst, aReg, bReg))
					}
					dst
				}

				:assignment -> {
					srcReg := compileNode(node.right)
					if node.left.type {
						:identifier -> {
							name := node.left.val
							if env.(name) {
								? -> env.(name) <- freshReg()
								_ -> ?
							}
							emit(irStore(env.(name), srcReg))
						}
						:propertyAccess -> {
							objReg := compileNode(node.left.left)
							keyReg := compileNode(node.left.right)
							emit(irSetIndex(objReg, keyReg, srcReg))
						}
					}
					srcReg
				}

				:propertyAccess -> {
					objReg := compileNode(node.left)
					keyReg := compileNode(node.right)
					dst := freshReg()
					emit(irIndex(dst, objReg, keyReg))
					dst
				}

				:ifExpr -> {
					condReg := compileNode(node.cond)
					endLabel := freshLabel('if_end')
					resultReg := freshReg()
					emit(irConst(resultReg, 0)) // default when no branch matches
					walkBranches(node.branches, 0, condReg, resultReg, endLabel)
					emit(irLabel(endLabel))
					resultReg
				}

				:block -> if len(node.exprs) {
					0 -> {
						lastReg := freshReg()
						emit(irConst(lastReg, ?))
						lastReg
					}
					_ -> walkBlockExprs(node.exprs, 0, 0)
				}

				:function -> if node.name {
					?, '' -> {
						// anonymous closure: no calling convention yet, stand-in nil
						dst := freshReg()
						emit(irConst(dst, 0))
						dst
					}
					_ -> {
						fnLabel := freshLabel('fn')
						functionPool << {
							label: fnLabel
							args: node.args
							restArg: node.restArg
							body: node.body
						}
						ftab << [node.name, fnLabel]
						compileFnBody(node, fnLabel)
						freshReg()
					}
				}

				:fnCall -> if node.function.type = :identifier {
					true -> {
						fnLabel := findFn(ftab, node.function.val, 0)
						if fnLabel {
							? -> {
								// not a known function (builtin/extern): nil
								walkArgs(node.args, 0, [])
								dst := freshReg()
								emit(irConst(dst, 0))
								dst
							}
							_ -> {
								argRegs := walkArgs(node.args, 0, [])
								dst := freshReg()
								emit(irCall(dst, fnLabel, argRegs))
								dst
							}
						}
					}
					_ -> {
						walkArgs(node.args, 0, [])
						dst := freshReg()
						emit(irConst(dst, 0))
						dst
					}
				}

				_ -> {
					dst := freshReg()
					emit(irConst(dst, ?))
					dst
				}
			}
		}
	}

	{
		compile: fn(ast) {
			st.0 <- {}
			emit(irLabel('main_top'))
			topReg := compileNode(ast)
			emit(irRetQ(topReg)) // plain ret: main_top runs in _start's frame
			{
				instructions: instructions
				stringPool: stringPool
				functionPool: functionPool
				fnTable: st.1
				regCount: nextReg.0
			}
		}
		compileNode: compileNode
		getInstructions: fn() instructions
		getStringPool: fn() stringPool
		getFunctionPool: fn() functionPool
	}
}

// ---------------------------------------------------------------------------
// x86-64 code generator — IR → machine bytes
// ---------------------------------------------------------------------------

fn createX86_64Generator() {
	code := []
	relocations := []
	fixups := []
	labelPairs := [] // [label, codeOffset] recorded during emission
	frameSize := [0] // set by compile(); used by :ir_frame

	fn emitByte(b) code << (b & 255)
	fn emitDword(d) {
		emitByte(d & 255)
		emitByte((d >> 8) & 255)
		emitByte((d >> 16) & 255)
		emitByte((d >> 24) & 255)
	}
	fn emitQword(q) {
		emitDword(q & 4294967295)
		emitDword((q >> 32) & 4294967295)
	}

	// REX prefix: r/b are physical register numbers (flags derived)
	fn rexW(r, b) {
		0x48 | (if r > 7 {
			true -> 4
			_ -> 0
		}) | (if b > 7 {
			true -> 1
			_ -> 0
		})
	}
	fn modRM(mod, reg, rm) ((mod & 3) << 6) | ((reg & 7) << 3) | (rm & 7)

	// Every virtual register gets a stack home at [rbp - 8*(vreg+1)].
	// Scratch registers (rax/rcx/rdx + SysV arg regs) are never live across
	// IR instructions, so no clobbering is possible regardless of regCount.
	fn vregDisp(vreg) {
		d := 8 * (vreg + 1)
		4294967296 - d // encode as int32 displacement
	}
	fn loadHome(phys, vreg) {
		emitByte(rexW(phys, 5))
		emitByte(0x8B)
		emitByte(modRM(2, phys, 5))
		emitDword(vregDisp(vreg))
	}
	fn storeHome(vreg, phys) {
		emitByte(rexW(phys, 5))
		emitByte(0x89)
		emitByte(modRM(2, phys, 5))
		emitDword(vregDisp(vreg))
	}
	fn emitMovRR(dPhys, sPhys) {
		emitByte(rexW(sPhys, dPhys))
		emitByte(0x89)
		emitByte(modRM(3, sPhys, dPhys))
	}
	fn emitAddRR(dPhys, sPhys) {
		emitByte(rexW(sPhys, dPhys))
		emitByte(0x01)
		emitByte(modRM(3, sPhys, dPhys))
	}
	fn emitSubRR(dPhys, sPhys) {
		emitByte(rexW(sPhys, dPhys))
		emitByte(0x29)
		emitByte(modRM(3, sPhys, dPhys))
	}
	fn emitCmpRR(aPhys, bPhys) {
		emitByte(rexW(bPhys, aPhys))
		emitByte(0x39)
		emitByte(modRM(3, bPhys, aPhys))
	}
	// setcc al + movzx rax, al (comparison result materialization)
	fn emitSetCC(cc) {
		emitByte(0x0F)
		emitByte(cc)
		emitByte(0xC0)
		emitByte(0x48)
		emitByte(0x0F)
		emitByte(0xB6)
		emitByte(0xC0)
	}
	// jump/call with rel32 placeholder registered for later patching
	fn emitBranch(opBytes, label) {
		opBytes |> each(fn(b) emitByte(b))
		fixups << { pos: len(code), label: label }
		emitDword(0)
	}

	// print result to stdout (decimal int64) then exit(0).
	// Machine-verified template (assembled+tested with gcc).
	// Input: rdi = value. Never returns.
	fn emitPrintExit() {
		[
			85, 72, 137, 229, 72, 131, 236, 64, 72, 137, 248, 69, 49, 210, 72,
			133, 192, 117, 16, 198, 69, 255, 48, 65, 186, 1, 0, 0, 0, 72, 141,
			117, 254, 235, 61, 69, 49, 219, 72, 133, 192, 121, 9, 65, 187, 1,
			0, 0, 0, 72, 247, 216, 72, 141, 117, 255, 185, 10, 0, 0, 0, 72,
			153, 72, 247, 249, 128, 194, 48, 136, 22, 72, 255, 206, 65, 255,
			194, 72, 133, 192, 117, 235, 69, 133, 219, 116, 9, 198, 6, 45, 72,
			255, 206, 65, 255, 194, 72, 255, 198, 184, 1, 0, 0, 0, 191, 1, 0,
			0, 0, 68, 137, 210, 15, 5, 184, 60, 0, 0, 0, 49, 255, 15, 5
		] |> each(fn(b) emitByte(b))
	}

	// SysV AMD64 integer arg registers
	argPhys := [7, 6, 2, 1, 8, 9] // rdi rsi rdx rcx r8 r9

	fn compileIR(inst, frame) if inst.op {
		:ir_const -> {
			imm := if type(inst.a) {
				:int -> inst.a
				:bool -> if inst.a {
					true -> 1
					_ -> 0
				}
				_ -> 0
			}
			emitByte(0x48)
			emitByte(0xB8)
			emitQword(imm)
			storeHome(inst.dst, 0)
		}
		:ir_arg -> {
			phys := if inst.a < len(argPhys) {
				true -> argPhys.(inst.a)
				_ -> 0
			}
			emitMovRR(0, phys)
			storeHome(inst.dst, 0)
		}
		:ir_load -> {
			loadHome(0, inst.a)
			storeHome(inst.dst, 0)
		}
		:ir_store -> {
			loadHome(0, inst.a)
			storeHome(inst.dst, 0)
		}
		:ir_add -> {
			loadHome(0, inst.a)
			loadHome(1, inst.b)
			emitAddRR(0, 1)
			storeHome(inst.dst, 0)
		}
		:ir_sub -> {
			loadHome(0, inst.a)
			loadHome(1, inst.b)
			emitSubRR(0, 1)
			storeHome(inst.dst, 0)
		}
		:ir_mul -> {
			loadHome(0, inst.a)
			loadHome(1, inst.b)
			emitByte(0x48)
			emitByte(0x0F)
			emitByte(0xAF)
			emitByte(0xC1) // imul rax, rcx
			storeHome(inst.dst, 0)
		}
		:ir_div -> {
			loadHome(0, inst.a)
			loadHome(1, inst.b)
			emitByte(0x48)
			emitByte(0x99) // cqo
			emitByte(0x48)
			emitByte(0xF7)
			emitByte(0xF9) // idiv rcx -> quotient rax
			storeHome(inst.dst, 0)
		}
		:ir_mod -> {
			loadHome(0, inst.a)
			loadHome(1, inst.b)
			emitByte(0x48)
			emitByte(0x99) // cqo
			emitByte(0x48)
			emitByte(0xF7)
			emitByte(0xF9) // idiv rcx -> remainder rdx
			emitMovRR(0, 2)
			storeHome(inst.dst, 0)
		}
		:ir_neg -> {
			loadHome(0, inst.a)
			emitByte(0x48)
			emitByte(0xF7)
			emitByte(0xD8) // neg rax
			storeHome(inst.dst, 0)
		}
		:ir_not -> {
			loadHome(0, inst.a)
			emitByte(0x48)
			emitByte(0x85)
			emitByte(modRM(3, 0, 0)) // test rax,rax (cmp self always sets ZF!)
			emitSetCC(0x94) // sete
			storeHome(inst.dst, 0)
		}
		:ir_and -> {
			loadHome(0, inst.a)
			loadHome(1, inst.b)
			emitByte(rexW(0, 1))
			emitByte(0x21)
			emitByte(0xC8)
			storeHome(inst.dst, 0)
		}
		:ir_or -> {
			loadHome(0, inst.a)
			loadHome(1, inst.b)
			emitByte(rexW(0, 1))
			emitByte(0x09)
			emitByte(0xC8)
			storeHome(inst.dst, 0)
		}
		:ir_xor -> {
			loadHome(0, inst.a)
			loadHome(1, inst.b)
			emitByte(rexW(0, 1))
			emitByte(0x31)
			emitByte(0xC8)
			storeHome(inst.dst, 0)
		}
		:ir_shl -> {
			loadHome(0, inst.a)
			loadHome(1, inst.b)
			emitByte(0x48)
			emitByte(0xD3)
			emitByte(0xE0) // shl rax, cl
			storeHome(inst.dst, 0)
		}
		:ir_shr -> {
			loadHome(0, inst.a)
			loadHome(1, inst.b)
			emitByte(0x48)
			emitByte(0xD3)
			emitByte(0xF8) // sar rax, cl (arithmetic, matches host '>>')
			storeHome(inst.dst, 0)
		}
		:ir_eq, :ir_neq, :ir_lt, :ir_gt, :ir_leq, :ir_geq -> {
			loadHome(0, inst.a)
			loadHome(1, inst.b)
			emitCmpRR(0, 1)
			cc := if inst.op {
				:ir_eq -> 0x94
				:ir_neq -> 0x95
				:ir_lt -> 0x9C
				:ir_gt -> 0x9F
				:ir_leq -> 0x9E
				_ -> 0x9D
			}
			emitSetCC(cc)
			storeHome(inst.dst, 0)
		}
		:ir_cmov -> {
			loadHome(2, inst.a) // cond -> rdx
			emitByte(rexW(2, 2))
			emitByte(0x85)
			emitByte(0xD2) // test rdx, rdx
			loadHome(0, inst.extra.a)
			loadHome(1, inst.extra.b)
			emitByte(0x48)
			emitByte(0x0F)
			emitByte(0x44)
			emitByte(0xC1) // cmove rax, rcx
			storeHome(inst.dst, 0)
		}
		:ir_jz -> {
			loadHome(0, inst.a)
			emitByte(0x48)
			emitByte(0x85)
			emitByte(modRM(3, 0, 0)) // test rax,rax
			emitBranch([0x0F, 0x84], inst.extra.label)
		}
		:ir_jnz -> {
			loadHome(0, inst.a)
			emitByte(0x48)
			emitByte(0x85)
			emitByte(modRM(3, 0, 0)) // test rax,rax
			emitBranch([0x0F, 0x85], inst.extra.label)
		}
		:ir_jmp -> emitBranch([0xE9], inst.extra.label)
		:ir_label -> ? // resolved by the size pre-pass
		:ir_call -> {
			args := inst.extra.args
			stackCount := if len(args) > 6 {
				true -> len(args) - 6
				_ -> 0
			}
			// reserve shadow space for args 7+, store right-to-left
			if stackCount > 0 {
				true -> {
					emitByte(0x48)
					emitByte(0x81)
					emitByte(0xEC)
					emitDword(8 * stackCount) // sub rsp, 8*n
				}
				_ -> ?
			}
			fn setArgs(i) if i < len(args) {
				true -> {
					if i < 6 {
						true -> {
							phys := argPhys.(i)
							emitByte(rexW(phys, 5))
							emitByte(0x8B)
							emitByte(modRM(2, phys, 5))
							emitDword(vregDisp(args.(i)))
						}
						_ -> {
							loadHome(0, args.(i))
							disp := 8 * (i - 6)
							emitByte(0x48)
							emitByte(0x89)
							if disp < 128 {
								true -> {
									emitByte(0x44)
									emitByte(0x24)
									emitByte(disp) // mov [rsp+disp8], rax
								}
								_ -> {
									emitByte(0x84)
									emitByte(0x24)
									emitDword(disp) // mov [rsp+disp32], rax
								}
							}
						}
					}
					setArgs(i + 1)
				}
				_ -> ?
			}
			setArgs(0)
			emitBranch([0xE8], inst.a) // irCall carries the fn label in a
			if stackCount > 0 {
				true -> {
					emitByte(0x48)
					emitByte(0x81)
					emitByte(0xC4)
					emitDword(8 * stackCount) // add rsp, 8*n
				}
				_ -> ?
			}
			storeHome(inst.dst, 0)
		}
		:ir_stkarg -> {
			emitByte(0x48)
			emitByte(0x8B)
			emitByte(0x85)
			emitDword(16 + 8 * (inst.a - 6)) // mov rax, [rbp + 16 + 8*(i-6)]
			storeHome(inst.dst, 0)
		}
		:ir_frame -> {
			emitByte(0x55) // push rbp
			emitByte(0x48)
			emitByte(0x89)
			emitByte(0xE5) // mov rbp, rsp
			emitByte(0x48)
			emitByte(0x81)
			emitByte(0xEC) // sub rsp, frame (imm32)
			emitDword(frame)
		}
		:ir_ret -> {
			if inst.a != ? {
				true -> loadHome(0, inst.a)
				_ -> ?
			}
			emitByte(0xC9) // leave
			emitByte(0xC3) // ret
		}
		:ir_retq -> {
			if inst.a != ? {
				true -> loadHome(0, inst.a)
				_ -> ?
			}
			emitByte(0xC3) // plain ret (no frame of its own)
		}
		:ir_nop -> emitByte(0x90)
		_ -> {
			// unsupported op (alloc/push/index/closure/...): stand-in 0
			if inst.dst != ? {
				true -> {
					emitByte(0x48)
					emitByte(0xB8)
					emitQword(0)
					storeHome(inst.dst, 0)
				}
				_ -> emitByte(0x90)
			}
		}
	}

	fn emitInsts(insts, i, frame) if i < len(insts) {
		true -> {
			inst := insts.(i)
			if inst.op = :ir_label {
				true -> {
					labelPairs << [inst.extra.label, len(code)]
					emitInsts(insts, i + 1, frame)
				}
				_ -> {
					compileIR(inst, frame)
					emitInsts(insts, i + 1, frame)
				}
			}
		}
		_ -> ?
	}
	fn findOffset(pairs, label, i) if i < len(pairs) {
		true -> {
			if pairs.(i).0 = label {
				true -> pairs.(i).1
				_ -> findOffset(pairs, label, i + 1)
			}
		}
		_ -> -1
	}
	fn patch(fx, i, out) if i < len(fx) {
		true -> {
			f := fx.(i)
			target := findOffset(labelPairs, f.label, 0)
			rel := target - (f.pos + 4)
			out.(f.pos) <- rel & 255
			out.(f.pos + 1) <- (rel >> 8) & 255
			out.(f.pos + 2) <- (rel >> 16) & 255
			out.(f.pos + 3) <- (rel >> 24) & 255
			patch(fx, i + 1, out)
		}
		_ -> ?
	}

	{
		compile: fn(irProgram) {
			frame := 8 * (irProgram.regCount + 8)
			frame <- frame + (16 - frame % 16) % 16
			// _start: frame setup, call top-level, print+exit
			emitByte(0x55) // push rbp
			emitByte(0x48)
			emitByte(0x89)
			emitByte(0xE5) // mov rbp, rsp
			emitByte(0x48)
			emitByte(0x81)
			emitByte(0xEC) // sub rsp, frame (imm32)
			emitDword(frame)
			emitBranch([0xE8], 'main_top')
			emitMovRR(7, 0) // mov rdi, rax
			emitBranch([0xE8], 'print_exit') // call print helper (prints rdi, exits 0)
			labelPairs << ['print_exit', len(code)]
			emitPrintExit()
			emitByte(0xC3)
			// pass 2: emit machine bytes (labels recorded at actual offsets)
			emitInsts(irProgram.instructions, 0, frame)
			// pass 3: patch branch/call rel32s
			patch(fixups, 0, code)
			{
				code: code
				relocations: relocations
				labelOffsets: labelPairs
				stringPool: irProgram.stringPool
			}
		}
		getCode: fn() code
		getRelocations: fn() relocations
	}
}

// ---------------------------------------------------------------------------
// ARM64 code generator (stub — generates basic instructions)
// ---------------------------------------------------------------------------

fn createARM64Generator() {
	code := []
	relocations := []
	labelOffsets := {}

	fn emit32(inst) {
		code << (inst & 255)
		code << ((inst >> 8) & 255)
		code << ((inst >> 16) & 255)
		code << ((inst >> 24) & 255)
	}

	// MOV Xd, #imm16
	fn emitMovImm(rd, imm) {
		// MOVZ Xd, #imm16
		inst := 0xD2800000 | ((imm & 0xFFFF) << 5) | (rd & 31)
		emit32(inst)
	}

	// ADD Xd, Xn, Xm
	fn emitAdd(rd, rn, rm) {
		inst := 0x8B000000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)
		emit32(inst)
	}

	// SUB Xd, Xn, Xm
	fn emitSub(rd, rn, rm) {
		inst := 0xCB000000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)
		emit32(inst)
	}

	// RET
	fn emitRet() emit32(0xD65F03C0)

	// NOP
	fn emitNop() emit32(0xD503201F)

	fn compileIR(inst) if inst.op {
		:ir_const -> if type(inst.a) {
			:int -> emitMovImm(inst.dst, inst.a)
			_ -> emitMovImm(inst.dst, 0)
		}
		:ir_add -> emitAdd(inst.dst, inst.a, inst.b)
		:ir_sub -> emitSub(inst.dst, inst.a, inst.b)
		:ir_ret -> {
			if inst.a != ? -> emitMovImm(0, 0)
			emitRet()
		}
		:ir_label -> labelOffsets.(inst.extra.label) <- len(code)
		:ir_nop -> emitNop()
		_ -> emitNop()
	}

	{
		compile: fn(irProgram) {
			irProgram.instructions |> each(compileIR)
			{
				code: code
				relocations: relocations
				labelOffsets: labelOffsets
				stringPool: irProgram.stringPool
			}
		}
		getCode: fn() code
	}
}

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

fn compileToNative(ast, arch) {
	irCompiler := createIRCompiler()
	irProgram := irCompiler.compile(ast)

	generator := if arch {
		:arm64 -> createARM64Generator()
		_ -> createX86_64Generator()
	}

	generator.compile(irProgram)
}
