}

// _defaultField returns the zero-value representation for a JVM field type
// descriptor. Abstracted from applet-recompile, applet-runtime and applet,
// which each carried an identical local copy.
fn _defaultField(desc) if desc.(0) {
	'Z', 'B', 'C', 'S', 'I' -> 0
	'J' -> {jvmLong: true, hi: 0, lo: 0}
	'F' -> {jvmFloat: true, bits: 0}
	'D' -> {jvmDouble: true, hi: 0, lo: 0}
	_ -> ?
}
