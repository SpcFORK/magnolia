// Portable Oak VM-library transition boundary for the bounded JVM image.
// All external host members pass through descriptor + invocation-opcode
// admission here, both at bytecode preflight and again at execution. Extend
// the VM by adding a checked contract here, an implementation in jvmInvoke /
// jvmString or applet-runtime's stateful host adapter, and parity tests for
// native Oak, bundled JS, standalone Oak and the optional Java-source emitter.
// This module deliberately does not claim a complete java.* / AWT library.

std := import('std')
str := import('str')

fn _spec(operation, count) {op: operation, argc: count}
// A caller-selected JVM property value, not the host process or a browser
// fingerprint. Bound it before embedding into a standalone bundle.
fn jvmVersion?(value) if type(value) != :string {
    true -> false
    _ -> if len(value) < 3 | len(value) > 32 {
        true -> false
        _ -> value.(0) != '.' & value.(len(value) - 1) != '.' &
            str.contains?(value, '.') & !str.contains?(value, '..') &
            (std.range(len(value)) |> std.every(fn(i) {
                c := codepoint(value.(i))
                (c >= 48 & c <= 57) | c = 46
            }))
    }
}
// Color's uppercase constants are aliases of their historical lowercase
// counterparts in the JDK, not equal-valued but independent objects.
fn jvmColorName(name) if name {
    'white', 'WHITE' -> 'white'
    'black', 'BLACK' -> 'black'
    'red', 'RED' -> 'red'
    'green', 'GREEN' -> 'green'
    'blue', 'BLUE' -> 'blue'
    'yellow', 'YELLOW' -> 'yellow'
    'cyan', 'CYAN' -> 'cyan'
    'magenta', 'MAGENTA' -> 'magenta'
    'gray', 'GRAY' -> 'gray'
    'lightGray', 'LIGHT_GRAY' -> 'lightGray'
    'darkGray', 'DARK_GRAY' -> 'darkGray'
    'orange', 'ORANGE' -> 'orange'
    'pink', 'PINK' -> 'pink'
    _ -> ?
}
fn _color?(name) jvmColorName(name) != ?

// These are the only host fields and external instantiable types. User
// classes are resolved by the class linker instead of being listed here.
fn jvmField(owner, name, desc, opcode) if owner {
    'java/lang/System' -> if opcode = 178 & name = 'out' &
        desc = 'Ljava/io/PrintStream;' {
        true -> _spec('system-out', 0), _ -> ?}
    'java/awt/Color' -> if opcode = 178 & desc = 'Ljava/awt/Color;' &
        _color?(name) {
        true -> _spec('awt-color', 0), _ -> ?}
    // Only the mutable coordinates of a real Point, not arbitrary AWT fields.
    'java/awt/Point' -> if (opcode = 180 | opcode = 181) &
        (name = 'x' | name = 'y') & desc = 'I' {
        true -> _spec('point-coordinate', if opcode = 181 {true -> 1, _ -> 0})
        _ -> ?
    }
    // The original SoundMixer subclasses ByteArrayInputStream and accesses
    // these three *protected* inherited fields. The lowerer additionally
    // requires an actual subclass; runtime validates the receiver and value.
    'java/io/ByteArrayInputStream' -> if opcode = 180 | opcode = 181 {
        true -> if (name = 'pos' | name = 'count') & desc = 'I' {
            true -> _spec('byte-stream-field', if opcode = 181 {true -> 1, _ -> 0})
            _ -> if name = 'buf' & desc = '[B' {
                true -> _spec('byte-stream-field', if opcode = 181 {true -> 1, _ -> 0})
                _ -> ?
            }
        }
        _ -> ?
    }
    // Fresh, immutable-to-the-VM Rectangle snapshots from detached Canvas
    // bounds OR the exact Rectangle(IIII) constructor. No mutation, generic
    // Shape operations, overloads, attached layout or display peers.
    'java/awt/Rectangle' -> if opcode = 180 &
        (name = 'x' | name = 'y' | name = 'width' | name = 'height') & desc = 'I' {
        true -> _spec('rectangle-coordinate', 0), _ -> ?}
    // Host-created input events and viewport dimensions are validated data,
    // not mutable AWT windows or general public-field reflection.
    'java/awt/Dimension' -> if opcode = 180 &
        (name = 'width' | name = 'height') & desc = 'I' {
        true -> _spec('dimension-coordinate', 0), _ -> ?}
    'java/awt/Event' -> if opcode = 180 &
        (name = 'id' | name = 'key' | name = 'modifiers' |
         name = 'x' | name = 'y') & desc = 'I' {
        true -> _spec('event-coordinate', 0), _ -> ?}
    _ -> ?
}
// Ordered exception handlers need a real, auditable host Throwable tree.
// This is an explicit library profile, not a rule that every java.* name is
// a Throwable. User subclasses are resolved through the compiled class map.
fn jvmThrowableParent(owner) if owner {
    'java/lang/Throwable' -> 'java/lang/Object'
    'java/lang/Exception', 'java/lang/Error' -> 'java/lang/Throwable'
    'java/lang/RuntimeException', 'java/io/IOException',
    'java/lang/ClassNotFoundException',
    'java/lang/InterruptedException' -> 'java/lang/Exception'
    'java/lang/ArithmeticException', 'java/lang/NullPointerException',
    'java/lang/NegativeArraySizeException',
    'java/lang/ClassCastException', 'java/lang/ArrayStoreException',
    'java/lang/IllegalArgumentException', 'java/lang/IllegalStateException',
    'java/lang/IllegalMonitorStateException',
    'java/lang/IndexOutOfBoundsException' -> 'java/lang/RuntimeException'
    'java/lang/NumberFormatException' -> 'java/lang/IllegalArgumentException'
    'java/lang/ArrayIndexOutOfBoundsException',
    'java/lang/StringIndexOutOfBoundsException' -> 'java/lang/IndexOutOfBoundsException'
    'java/lang/LinkageError' -> 'java/lang/Error'
    'java/lang/ExceptionInInitializerError',
    'java/lang/IncompatibleClassChangeError',
    'java/lang/NoClassDefFoundError' -> 'java/lang/LinkageError'
    _ -> ?
}
fn jvmNew(owner) if owner {
    'java/lang/Object' -> 'object'
    'java/lang/String' -> 'string-object'
    'java/lang/StringBuilder', 'java/lang/StringBuffer' -> 'text-builder'
    // In-memory only. No FileInputStream, URL, ZIP or disk/network access.
    'java/io/ByteArrayInputStream' -> 'byte-array-stream'
    'java/io/DataInputStream' -> 'data-input-stream'
    'java/io/ByteArrayOutputStream' -> 'byte-array-output'
    'java/io/DataOutputStream' -> 'data-output-stream'
    'java/net/URL' -> 'bounded-resource-url'
    'java/util/zip/ZipInputStream' -> 'bounded-zip-stream'
    'java/lang/Thread' -> 'bounded-thread'
    // CLDC/MIDP-only random island; runtime checks profile and refuses
    // sampling an unseeded constructor instead of inventing a device clock.
    'java/util/Random' -> 'bounded-midp-random'
    'java/awt/Color' -> 'awt-color'
    // A bounded logical Font value for recorded Graphics state. No platform
    // font lookup, metrics, glyph rasterization or general AWT hierarchy.
    'java/awt/Font' -> 'awt-font'
    'java/awt/Point' -> 'awt-point'
    'java/awt/Rectangle' -> 'awt-rectangle'
    // Detached, bounded component tree for the original ArcTest lifecycle.
    // No peer, geometry layout, input, font metrics or painting is implied.
    'java/awt/BorderLayout' -> 'awt-border-layout'
    'java/awt/Canvas' -> 'awt-canvas'
    'java/awt/Panel' -> 'awt-panel'
    'java/awt/TextField' -> 'awt-text-field'
    'java/awt/Button' -> 'awt-button'
    'java/awt/image/IndexColorModel' -> 'index-color-model'
    'java/awt/image/MemoryImageSource' -> 'memory-image-source'
    _ -> if jvmThrowableParent(owner) != ? {true -> 'throwable', _ -> ?}
}
// Reference types whose identity/subtyping the bounded VM can model without
// loading a JDK class. In particular, array instanceof/checkcast may use
// Object, Cloneable and Serializable; unknown JDK types fail at preflight.
fn jvmReference(owner) if owner {
    'java/lang/Object', 'java/lang/String', 'java/lang/Integer',
    'java/lang/Number', 'java/lang/StringBuilder', 'java/lang/StringBuffer',
    'java/applet/Applet', 'java/applet/AppletContext',
    'java/awt/Component', 'java/awt/Container',
    'java/awt/Panel', 'java/awt/Canvas', 'java/awt/TextComponent',
    'java/awt/TextField', 'java/awt/Button', 'java/awt/LayoutManager',
    'java/awt/LayoutManager2', 'java/awt/BorderLayout', 'java/awt/FlowLayout',
    'java/awt/Color', 'java/awt/Font', 'java/awt/Graphics',
    'java/awt/Image', 'java/awt/Point', 'java/awt/Rectangle',
    'java/awt/geom/Point2D',
    'java/awt/image/ColorModel', 'java/awt/image/IndexColorModel',
    'java/awt/image/ImageProducer', 'java/awt/image/ImageObserver',
    'java/awt/image/MemoryImageSource',
    'java/io/PrintStream', 'java/lang/Cloneable',
    'java/io/Serializable', 'java/io/InputStream',
    'java/io/ByteArrayInputStream', 'java/io/DataInputStream',
    'java/io/OutputStream', 'java/io/ByteArrayOutputStream',
    'java/io/DataOutputStream',
    'java/lang/Runnable', 'java/lang/Thread',
    'java/lang/Runtime', 'java/util/Random',
    'java/awt/Dimension', 'java/awt/Event',
    'java/net/URL', 'java/util/zip/ZipInputStream',
    'java/util/zip/ZipEntry',
    // Compile-time-only bridge for the owned MIDP Image/Graphics bytecode.
    // No new(), fields or general Java ME service follows from this identity.
    'javax/microedition/lcdui/ImageBridge' -> true
    _ -> if jvmThrowableParent(owner) != ? {true -> true, _ -> ?}
}

// The verifier and runtime must agree on the deliberately small built-in
// inheritance graph. User-class and array edges belong to their class maps;
// never infer an arbitrary java.* class from its spelling.
fn _throwableSubtype?(current, owner, depth) if depth >= 32 |
    type(current) != :string | type(owner) != :string {
    true -> false
    _ -> if current = owner {
        true -> true
        _ -> if parent := jvmThrowableParent(current) {
            ? -> false
            _ -> _throwableSubtype?(parent, owner, depth + 1)
        }
    }
}
fn jvmReferenceSubtype?(current, owner) if owner {
    'java/lang/Object' -> jvmReference(current) != ?
    'java/io/Serializable' -> current = 'java/lang/String' |
        current = 'java/lang/Integer' | current = 'java/lang/Number' |
        current = 'java/lang/StringBuilder' | current = 'java/lang/StringBuffer' |
        current = 'java/awt/Color' | current = 'java/awt/Font' |
        current = 'java/awt/Point' | current = 'java/awt/Rectangle' |
        current = 'java/applet/Applet' |
        current = 'java/awt/Component' | current = 'java/awt/Container' |
        current = 'java/awt/Panel' | current = 'java/awt/Canvas' |
        current = 'java/awt/TextComponent' | current = 'java/awt/TextField' |
        current = 'java/awt/Button' | current = 'java/awt/BorderLayout' |
        current = 'java/awt/FlowLayout' |
        jvmThrowableParent(current) != ?
    'java/lang/Cloneable' -> current = 'java/awt/Point' |
        current = 'java/awt/geom/Point2D' |
        current = 'java/awt/Rectangle'
    'java/lang/Number' -> current = 'java/lang/Integer'
    'java/io/InputStream' -> current = 'java/io/ByteArrayInputStream' |
        current = 'java/io/DataInputStream' |
        current = 'java/util/zip/ZipInputStream'
    'java/io/OutputStream' -> current = 'java/io/ByteArrayOutputStream' |
        current = 'java/io/DataOutputStream'
    // Only these concrete headless types have a modeled inheritance tree;
    // admission of a superclass method still requires an exact descriptor.
    'java/awt/Panel' -> current = 'java/applet/Applet'
    'java/awt/Container' -> current = 'java/applet/Applet' |
        current = 'java/awt/Panel'
    'java/awt/TextComponent' -> current = 'java/awt/TextField'
    'java/awt/Component' -> current = 'java/applet/Applet' |
        current = 'java/awt/Panel' | current = 'java/awt/Container' |
        current = 'java/awt/Canvas' | current = 'java/awt/TextComponent' |
        current = 'java/awt/TextField' | current = 'java/awt/Button'
    'java/awt/LayoutManager' -> current = 'java/awt/BorderLayout' |
        current = 'java/awt/FlowLayout'
    'java/awt/LayoutManager2' -> current = 'java/awt/BorderLayout'
    'java/awt/geom/Point2D' -> current = 'java/awt/Point'
    'java/awt/image/ColorModel' -> current = 'java/awt/image/IndexColorModel'
    'java/awt/image/ImageProducer' -> current = 'java/awt/image/MemoryImageSource'
    // java.awt.Component implements ImageObserver; Applet inherits that
    // interface through Panel/Container/Component, including user subclasses.
    'java/awt/image/ImageObserver' -> current = 'java/applet/Applet' |
        current = 'java/awt/Component' | current = 'java/awt/Container' |
        current = 'java/awt/Panel' | current = 'java/awt/Canvas' |
        current = 'java/awt/TextComponent' | current = 'java/awt/TextField' |
        current = 'java/awt/Button'
    _ -> _throwableSubtype?(current, owner, 0)
}

// No name-only shortcuts: a call with the wrong descriptor or opcode never
// reaches the interpreter's host functions. argc counts argument VALUES,
// excluding the receiver (a long is one value occupying two JVM slots).
fn jvmMethod(owner, name, desc, opcode) if owner {
    // Explicit MIDP virtual free-memory SNAPSHOT: not a live heap or collector.
    // The caller must opt in; link-time and runtime reject Java SE Applets.
    'java/lang/Runtime' -> if opcode = 184 & name = 'getRuntime' &
        desc = '()Ljava/lang/Runtime;' {
        true -> _spec('midp-runtime-get', 0)
        _ -> if opcode = 182 {true -> if name + desc {
            'freeMemory()J' -> _spec('midp-runtime-free', 0)
            'gc()V' -> _spec('midp-runtime-gc', 0)
            _ -> ?
        }, _ -> ?}
    }
    // A bounded Java ME Random profile. Calls on Java SE Applets are refused
    // during whole-entry preflight, and unseeded sampling is refused at run.
    'java/util/Random' -> if opcode = 183 & name = '<init>' {
        true -> if desc {
            '()V' -> _spec('midp-random-init-unseeded', 0)
            '(J)V' -> _spec('midp-random-init-seeded', 1)
            _ -> ?
        }
        _ -> if opcode = 182 {true -> if name + desc {
            'setSeed(J)V' -> _spec('midp-random-seed', 1)
            'nextInt()I' -> _spec('midp-random-next', 0)
            'nextInt(I)I' -> _spec('midp-random-bound', 1)
            _ -> ?
        }, _ -> ?}
    }
    // ONLY the javac-only bridge called by owned MIDP Image/Graphics bytecode.
    // The native host additionally checks the MIDlet profile at invocation;
    // wrong name, descriptor or invocation opcode must fail during preflight.
    'javax/microedition/lcdui/ImageBridge' -> if opcode = 184 {
        true -> if name + desc {
            'blank(II)Ljavax/microedition/lcdui/Image;' ->
                _spec('midp-image-blank', 2)
            'load(Ljava/lang/String;)Ljavax/microedition/lcdui/Image;' ->
                _spec('midp-image-load', 1)
            'graphics(Ljavax/microedition/lcdui/Image;)Ljavax/microedition/lcdui/Graphics;' ->
                _spec('midp-image-graphics', 1)
            'getRGB(Ljavax/microedition/lcdui/Image;[IIIIIII)V' ->
                _spec('midp-image-rgb', 8)
            'setColor(Ljavax/microedition/lcdui/Graphics;I)V' ->
                _spec('midp-graphics-color-set', 2)
            'getColor(Ljavax/microedition/lcdui/Graphics;)I' ->
                _spec('midp-graphics-color-get', 1)
            'clipWidth(Ljavax/microedition/lcdui/Graphics;)I' ->
                _spec('midp-graphics-clip-width', 1)
            'fillRect(Ljavax/microedition/lcdui/Graphics;IIII)V' ->
                _spec('midp-graphics-fill', 5)
            'drawImage(Ljavax/microedition/lcdui/Graphics;Ljavax/microedition/lcdui/Image;III)V' ->
                _spec('midp-graphics-blit', 5)
            _ -> ?
        }
        _ -> ?
    }
    // Static JVM arraycopy, not a name-based shortcut for other System calls.
    'java/lang/System' -> if opcode = 184 & name = 'arraycopy' &
        desc = '(Ljava/lang/Object;ILjava/lang/Object;II)V' {
        true -> _spec('arraycopy', 5)
        _ -> if opcode = 184 & name = 'gc' & desc = '()V' {
            true -> _spec('system-gc-request', 0)
            // A logical time sample, ONLY with an explicit finite host epoch.
            // Unconfigured execution still refuses; never sample the OS clock.
            _ -> if opcode = 184 & name = 'currentTimeMillis' &
                desc = '()J' {true -> _spec('virtual-current-millis', 0),
                // Do not inherit ambient process properties into a movie.
                // The only admitted key needs an explicit bounded host value.
                _ -> if opcode = 184 & name = 'getProperty' &
                    desc = '(Ljava/lang/String;)Ljava/lang/String;' {
                    true -> _spec('virtual-java-version', 1), _ -> ?}}
        }
    }
    // Raw-bit intrinsics expose pool payloads for independent JDK oracles;
    // no host float conversion may canonicalize NaN or erase negative zero.
    'java/lang/Double' -> if opcode = 184 {
        true -> if name + desc {
            'doubleToRawLongBits(D)J' -> _spec('double-raw-bits', 1)
            'doubleToLongBits(D)J' -> _spec('double-bits', 1)
            'longBitsToDouble(J)D' -> _spec('double-from-bits', 1)
            _ -> ?
        }
        _ -> ?
    }
    'java/lang/Float' -> if opcode = 184 {
        true -> if name + desc {
            'floatToRawIntBits(F)I' -> _spec('float-raw-bits', 1)
            'floatToIntBits(F)I' -> _spec('float-bits', 1)
            'intBitsToFloat(I)F' -> _spec('float-from-bits', 1)
            _ -> ?
        }
        _ -> ?
    }
    'java/lang/Math' -> if opcode = 184 {
        true -> if name + desc {
            'abs(I)I' -> _spec('iabs', 1)
            'max(II)I' -> _spec('imax', 2)
            'min(II)I' -> _spec('imin', 2)
            // Bit-exact axes and equal-magnitude diagonals only; arbitrary
            // angles are refused rather than delegated to varying host libm.
            'atan2(DD)D' -> _spec('bounded-atan2', 2)
            _ -> ?
        }
        _ -> ?
    }
    'java/lang/Integer' -> if opcode = 184 {
        true -> if name + desc {
            'parseInt(Ljava/lang/String;)I' -> _spec('parse-int', 1)
            // Original Blink.init boxes a String, then unboxes it; retaining
            // a real reference matters for the JVM identity/cache contract.
            'valueOf(Ljava/lang/String;)Ljava/lang/Integer;' -> _spec('boxed-int-string', 1)
            'valueOf(Ljava/lang/String;I)Ljava/lang/Integer;' ->
                _spec('boxed-int-radix', 2)
            'toString(I)Ljava/lang/String;' -> _spec('int-string', 1)
            'compare(II)I' -> _spec('icompare', 2)
            'sum(II)I' -> _spec('isum', 2)
            'max(II)I' -> _spec('imax', 2)
            'min(II)I' -> _spec('imin', 2)
            _ -> ?
        }
        _ -> if opcode = 182 & name = 'intValue' & desc = '()I' {
            true -> _spec('boxed-int-value', 0), _ -> ?}
    }
    'java/lang/String' -> if opcode = 183 & name = '<init>' &
        desc = '(Ljava/lang/String;)V' {
        true -> _spec('string-init-copy', 1)
        _ -> if opcode = 183 & name = '<init>' & desc = '([C)V' {
            true -> _spec('bounded-ascii-char-array-init', 1)
            _ -> if opcode = 182 {true -> if name + desc {
            'length()I' -> _spec('string-length', 0)
            // ASCII code units only until the full modified-UTF8/UTF-16
            // String model exists. Bounds are catchable at the VM boundary.
            'charAt(I)C' -> _spec('bounded-ascii-char-at', 1)
            'replace(CC)Ljava/lang/String;' -> _spec('bounded-ascii-char-replace', 2)
            'equals(Ljava/lang/Object;)Z' -> _spec('string-equals', 1)
            'equalsIgnoreCase(Ljava/lang/String;)Z' -> _spec('string-equals-ignore-case', 1)
            'indexOf(I)I' -> _spec('string-index-of', 1)
            'indexOf(Ljava/lang/String;)I' -> _spec('bounded-ascii-index-of-string', 1)
            'concat(Ljava/lang/String;)Ljava/lang/String;' -> _spec('string-concat', 1)
            'substring(II)Ljava/lang/String;' -> _spec('bounded-ascii-substring', 2)
            _ -> ?
        }
        _ -> if opcode = 184 & name = 'valueOf' {
            true -> if desc {
                '(I)Ljava/lang/String;' -> _spec('int-string', 1)
                '(D)Ljava/lang/String;' -> _spec('bounded-double-string', 1)
                // The verifier must also prove a String or null argument.
                // Arbitrary Object.toString() remains outside this VM.
                '(Ljava/lang/Object;)Ljava/lang/String;' ->
                    _spec('string-object-value-of', 1)
                _ -> ?
            }
            _ -> ?
        }
        }
        }
    }
    'java/lang/Object' -> if opcode = 183 & name = '<init>' & desc = '()V' {
        true -> _spec('object-init', 0)
        _ -> if opcode = 182 & name = 'notifyAll' & desc = '()V' {
            true -> _spec('bounded-notify-all', 0), _ -> ?}
    }
    // Sufficient for original Fliplay load_header -> read_loop. The byte
    // buffer is a bounded JVM [B; unsupported stream APIs fail at preflight.
    'java/io/ByteArrayInputStream' -> if opcode = 183 &
        name = '<init>' & desc = '([B)V' {
        true -> _spec('byte-stream-init', 1), _ -> ?}
    'java/io/DataInputStream' -> if opcode = 183 &
        name = '<init>' & desc = '(Ljava/io/InputStream;)V' {
        true -> _spec('data-stream-init', 1)
        _ -> if opcode = 182 & name = 'read' & desc = '([BII)I' {
            true -> _spec('data-stream-read', 3), _ -> ?}
    }
    // Original Sound emits seven big-endian integers into a byte-array WAV
    // header. This is strictly an in-memory pair of output streams, NOT an
    // audio backend, arbitrary OutputStream, file/socket or general writer.
    'java/io/ByteArrayOutputStream' -> if opcode = 183 & name = '<init>' &
        desc = '(I)V' {
        true -> _spec('byte-output-init', 1)
        _ -> if opcode = 182 & name = 'toByteArray' & desc = '()[B' {
            true -> _spec('byte-output-copy', 0), _ -> ?}
    }
    'java/io/DataOutputStream' -> if opcode = 183 & name = '<init>' &
        desc = '(Ljava/io/OutputStream;)V' {
        true -> _spec('data-output-init', 1)
        _ -> if opcode = 182 & name = 'writeInt' & desc = '(I)V' {
            true -> _spec('data-output-int', 1), _ -> ?}
    }
    // Explicit, pre-supplied in-memory resources ONLY; no VM disk/network.
    'java/net/URL' -> if opcode = 183 & name = '<init>' &
        desc = '(Ljava/net/URL;Ljava/lang/String;)V' {
        true -> _spec('bounded-url-init', 2)
        _ -> if opcode = 182 & name = 'openStream' &
            desc = '()Ljava/io/InputStream;' {
            true -> _spec('bounded-url-open', 0), _ -> ?}
    }
    'java/util/zip/ZipInputStream' -> if opcode = 183 & name = '<init>' &
        desc = '(Ljava/io/InputStream;)V' {
        true -> _spec('bounded-zip-init', 1)
        _ -> if opcode = 182 & name = 'getNextEntry' &
            desc = '()Ljava/util/zip/ZipEntry;' {
            true -> _spec('bounded-zip-first', 0), _ -> ?}
    }
    // Exact one-array bulk read on only a supplied local resource or
    // ByteArrayInputStream; never a network/file capability or arbitrary
    // InputStream subclass. Runtime distinguishes their JDK EOF/zero rules.
    'java/io/InputStream' -> if opcode = 182 {true -> if name + desc {
        'read([B)I' -> _spec('bounded-stream-bulk-read', 1)
        'close()V' -> _spec('bounded-stream-close', 0)
        _ -> ?
    }, _ -> ?}
    // A single deterministic cooperative task executes the original Runnable
    // under an instruction/virtual-clock cap. Contention or forced stop of a
    // live task is refused, not mapped to uncontrolled OS threads.
    'java/lang/Thread' -> if opcode = 183 & name = '<init>' &
        desc = '(Ljava/lang/Runnable;)V' {
        true -> _spec('bounded-thread-init', 1)
        _ -> if opcode = 182 {true -> if name + desc {
            'start()V' -> _spec('bounded-thread-start', 0)
            'isAlive()Z' -> _spec('bounded-thread-alive', 0)
            'stop()V' -> _spec('bounded-thread-stop', 0)
            'setPriority(I)V' -> _spec('bounded-thread-priority', 1)
            _ -> ?
        }, _ -> if opcode = 184 {true -> if name + desc {
            'currentThread()Ljava/lang/Thread;' -> _spec('bounded-current-thread', 0)
            'sleep(J)V' -> _spec('bounded-thread-sleep', 1)
            'yield()V' -> _spec('bounded-thread-yield', 0)
            _ -> ?
        }, _ -> ?}}
    }
    'java/lang/Throwable', 'java/lang/Exception', 'java/lang/RuntimeException',
    'java/lang/Error', 'java/io/IOException',
    'java/lang/ClassNotFoundException', 'java/lang/InterruptedException',
