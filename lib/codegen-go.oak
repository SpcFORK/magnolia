// codegen-go -- Oak AST to Go source code renderer
//
// Transpiles Oak/Magnolia AST nodes (as produced by the build pipeline)
// into idiomatic Go 1.18+ source code.  The generated code uses a small
// runtime preamble that provides Oak-compatible semantics:
//   - interface{} for dynamic typing
//   - __oak_eq for deep structural equality
//   - __oak_push for list append
//   - __oak_acc for safe property access
//   - map[string]interface{} for Oak objects
//   - []interface{} for Oak lists
//   - closures via func(...interface{}) interface{}
//
// Module system: Oak modules become Go init-once functions stored in a
// global registry, mirroring the JS/Lua/Java target patterns.

{
	default: default
	map: map
	each: each
	slice: slice
	filter: filter
	reduce: reduce
	clone: clone
	append: append
	len: len
	indexOf: indexOf
	keys: keys
} := import('std')
{
	replace: replace
	contains?: strContains?
	join: join
	split: split
	trim: trim
} := import('str')
{
	format: format
} := import('fmt')

mir := import('mir')

// ---------------------------------------------------------------------------
// Go reserved words — identifiers matching these are mangled
// ---------------------------------------------------------------------------

GoReserved := [
	'break', 'case', 'chan', 'const', 'continue', 'default', 'defer'
	'else', 'fallthrough', 'for', 'func', 'go', 'goto', 'if', 'import'
	'interface', 'map', 'package', 'range', 'return', 'select', 'struct'
	'switch', 'type', 'var', 'nil', 'true', 'false', 'iota'
	'append', 'cap', 'close', 'complex', 'copy', 'delete', 'imag'
	'len', 'make', 'new', 'panic', 'print', 'println', 'real', 'recover'
	'error', 'string', 'bool', 'int', 'float64', 'byte', 'rune'
	'any', 'comparable', 'rand'
]

fn goIdent(name) {
	clean := name |> clone()
	clean <- clean |> replace('?', '_qm') |> replace('!', '_bang')
	// import is special-cased to __oak_module_import before GoReserved check
	if clean = 'import' -> clean <- '__oak_module_import'
	GoReserved |> each(fn(kw) if clean = kw {
		true -> clean <- '__oak_go_' + clean
	})
	clean
}

fn goStr(s) {
	'"' + s |> map(fn(c) if c {
		'\\' -> '\\\\'
		'"' -> '\\"'
		'\n' -> '\\n'
		'\r' -> '\\r'
		'\t' -> '\\t'
		_ -> c
	}) + '"'
}

// ---------------------------------------------------------------------------
// Go runtime preamble
// ---------------------------------------------------------------------------

GoRuntimePreamble := '// oak build --go
// Magnolia/Oak to Go transpiled bundle
package main

import (
	"fmt"
	"io"
	"math"
	"sort"
	"math/rand"
	"net/http"
	"os"
	"reflect"
	"strconv"
	"strings"
	"time"
)

// Ensure imports are used
var _ = fmt.Sprint
var _ = io.ReadAll
var _ = math.Abs
var _ = http.Get
var _ = os.Args
var _ = reflect.DeepEqual
var _ = strconv.Itoa
var _ = strings.Contains
var _ = time.Now
var _ = rand.Intn

// Oak value type aliases
type OakValue = interface{}
type OakFn = func(...OakValue) OakValue
type OakList = []OakValue
type OakObject = map[string]OakValue

// Module registry
var __Oak_Modules = map[string]OakValue{}
var __Oak_Import_Aliases OakObject

func __oak_eq(a, b OakValue) bool {
	if a == nil && b == nil {
		return true
	}
	if a == nil || b == nil {
		return false
	}
	return reflect.DeepEqual(a, b)
}

func __oak_push(listVal OakValue, val OakValue) OakValue {
	if list, ok := listVal.(OakList); ok {
		return OakValue(append(list, val))
	}
	if s, ok := listVal.(string); ok {
		return s + __as_oak_string(val)
	}
	return listVal
}

func __oak_acc(obj OakValue, key OakValue) OakValue {
	if obj == nil {
		return nil
	}
	switch o := obj.(type) {
	case OakObject:
		return o[__as_oak_string(key)]
	case OakList:
		switch k := key.(type) {
		case int:
			if k >= 0 && k < len(o) {
				return o[k]
			}
		case float64:
			i := int(k)
			if i >= 0 && i < len(o) {
				return o[i]
			}
		}
		return nil
	case string:
		switch k := key.(type) {
		case int:
			if k >= 0 && k < len(o) {
				return string(o[k])
			}
		case float64:
			i := int(k)
			if i >= 0 && i < len(o) {
				return string(o[i])
			}
		}
		return nil
	}
	return nil
}

func __oak_set(obj OakValue, key string, val OakValue) OakValue {
	if o, ok := obj.(OakObject); ok {
		o[key] = val
		return val
	}
	return nil
}

func __as_oak_string(v OakValue) string {
	if v == nil {
		return ""
	}
	switch s := v.(type) {
	case string:
		return s
	case int:
		return strconv.Itoa(s)
	case float64:
		return strconv.FormatFloat(s, 102, -1, 64)
	case bool:
		if s { return "true" }
		return "false"
	default:
		return fmt.Sprint(v)
	}
}

func __oak_to_float(v OakValue) float64 {
	switch n := v.(type) {
	case int:
		return float64(n)
	case float64:
		return n
	case string:
		f, err := strconv.ParseFloat(n, 64)
		if err != nil { return 0 }
		return f
	default:
		return 0
	}
}

func __oak_to_bool(v OakValue) bool {
	if v == nil {
		return false
	}
	if b, ok := v.(bool); ok {
		return b
	}
	return true
}

func __oak_not(v OakValue) OakValue {
	return !__oak_to_bool(v)
}

func __oak_and(a, b OakValue) OakValue {
	if !__oak_to_bool(a) {
		return false
	}
	return b
}

func __oak_or(a, b OakValue) OakValue {
	if __oak_to_bool(a) {
		return true
	}
	return b
}

// Module system as OakValue so type assertions work
var __oak_modularize OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	if len(__oak_args) >= 2 {
		name := __as_oak_string(__oak_args[0])
		__Oak_Modules[name] = __oak_args[1]
	}
	return nil
})

var __oak_module_import OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	if len(__oak_args) < 1 {
		return nil
	}
	name := __as_oak_string(__oak_args[0])
	m, ok := __Oak_Modules[name]
	if !ok && __Oak_Import_Aliases != nil {
		if alias, aok := __Oak_Import_Aliases[name]; aok {
			m, ok = __Oak_Modules[__as_oak_string(alias)]
		}
	}
	if !ok {
		return nil
	}
	if factory, fok := m.(OakFn); fok {
		result := factory()
		__Oak_Modules[name] = result
		return result
	}
	return m
})

// Platform detection: nil means native (not JS)
var __Is_Oak_Node OakValue = nil

// Oak builtin: len()
var __oak_go_len OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	if len(__oak_args) < 1 || __oak_args[0] == nil {
		return int(0)
	}
	switch v := __oak_args[0].(type) {
	case string:
		return int(len(v))
	case OakList:
		return int(len(v))
	case OakObject:
		return int(len(v))
	default:
		return int(0)
	}
})

// Oak builtin: string()
var __oak_go_string OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	if len(__oak_args) < 1 {
		return ""
	}
	return __as_oak_string(__oak_args[0])
})

// Oak builtin: type()
var __oak_go_type OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	if len(__oak_args) < 1 || __oak_args[0] == nil {
		return "null"
	}
	switch __oak_args[0].(type) {
	case string:
		return "string"
	case int:
		return "int"
	case float64:
		return "float"
	case bool:
		return "bool"
	case OakList:
		return "list"
	case OakObject:
		return "object"
	case OakFn:
		return "function"
	default:
		return "unknown"
	}
})

// Oak builtin: int()
var __oak_go_int OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	if len(__oak_args) < 1 {
		return int(0)
	}
	switch v := __oak_args[0].(type) {
	case int:
		return v
	case float64:
		return int(v)
	case string:
		i, err := strconv.Atoi(v)
		if err != nil {
			f, ferr := strconv.ParseFloat(v, 64)
			if ferr != nil { return nil }
			return int(f)
		}
		return i
	case bool:
		if v { return int(1) }
		return int(0)
	default:
		return int(0)
	}
})

// Oak builtin: float()
var __oak_go_float64 OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	if len(__oak_args) < 1 {
		return float64(0)
	}
	return __oak_to_float(__oak_args[0])
})

// Oak builtin: print()
var __oak_go_print OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	for _, v := range __oak_args {
		fmt.Print(__as_oak_string(v))
	}
	return nil
})

// Oak builtin: slice()
var slice OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	if len(__oak_args) < 1 || __oak_args[0] == nil {
		return nil
	}
	start := 0
	if len(__oak_args) > 1 && __oak_args[1] != nil {
		start = int(__oak_to_float(__oak_args[1]))
	}
	switch v := __oak_args[0].(type) {
	case string:
		end := len(v)
		if len(__oak_args) > 2 && __oak_args[2] != nil {
			end = int(__oak_to_float(__oak_args[2]))
		}
		if start < 0 { start = 0 }
		if end > len(v) { end = len(v) }
		if start >= end { return "" }
		return v[start:end]
	case OakList:
		end := len(v)
		if len(__oak_args) > 2 && __oak_args[2] != nil {
			end = int(__oak_to_float(__oak_args[2]))
		}
		if start < 0 { start = 0 }
		if end > len(v) { end = len(v) }
		if start >= end { return OakList{} }
		result := make(OakList, end-start)
		copy(result, v[start:end])
		return result
	}
	return nil
})

// Oak builtin: keys()
var keys OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	if len(__oak_args) < 1 || __oak_args[0] == nil {
		return OakList{}
	}
	if obj, ok := __oak_args[0].(OakObject); ok {
		result := OakList{}
		for k := range obj {
			result = append(result, k)
		}
		return result
	}
	return OakList{}
})

// Oak builtin: values()
var values OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	if len(__oak_args) < 1 || __oak_args[0] == nil {
		return OakList{}
	}
	if obj, ok := __oak_args[0].(OakObject); ok {
		result := OakList{}
		for _, v := range obj {
			result = append(result, v)
		}
		return result
	}
	return OakList{}
})

// Oak builtin: codepoint()
var codepoint OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	if len(__oak_args) < 1 {
		return nil
	}
	s := __as_oak_string(__oak_args[0])
	if len(s) == 0 { return nil }
	return int(s[0])
})

// Oak builtin: char()
var char OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	if len(__oak_args) < 1 {
		return ""
	}
	return string(rune(int(__oak_to_float(__oak_args[0]))))
})

// Oak builtin: args()
var args OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	result := OakList{}
	for _, a := range os.Args {
		result = append(result, a)
	}
	return result
})

// Oak builtin: rand()
var __oak_go_rand OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	return rand.Float64()
})

// Oak builtin: nanotime()
var nanotime OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	return float64(time.Now().UnixNano())
})

// Oak builtin: req() — synchronous HTTP
var req OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	if len(__oak_args) < 1 {
		return nil
	}
	data, _ := __oak_args[0].(OakObject)
	if data == nil {
		return nil
	}
	method := __as_oak_string(data["method"])
	url := __as_oak_string(data["url"])
	bodyStr := __as_oak_string(data["body"])
	if method == "" { method = "GET" }
	var bodyReader io.Reader
	if bodyStr != "" {
		bodyReader = strings.NewReader(bodyStr)
	}
	httpReq, err := http.NewRequest(method, url, bodyReader)
	if err != nil {
		return OakObject{"type": "error", "error": err.Error()}
	}
	if headers, ok := data["headers"].(OakObject); ok {
		for k, v := range headers {
			httpReq.Header.Set(k, __as_oak_string(v))
		}
	}
	resp, err := http.DefaultClient.Do(httpReq)
	if err != nil {
		return OakObject{"type": "error", "error": err.Error()}
	}
	defer resp.Body.Close()
	respBody, _ := io.ReadAll(resp.Body)
	respHeaders := OakObject{}
	for k, v := range resp.Header {
		if len(v) > 0 {
			respHeaders[strings.ToLower(k)] = v[0]
		}
	}
	return OakObject{
		"type": "resp",
		"resp": OakObject{
			"status":  int(resp.StatusCode),
			"headers": respHeaders,
			"body":    string(respBody),
		},
	}
})

// Oak builtin: filter() — not a real builtin but commonly used from std
var filter OakValue = OakFn(func(__oak_args ...OakValue) OakValue {
	if len(__oak_args) < 2 {
		return OakList{}
	}
	list, ok := __oak_args[0].(OakList)
	if !ok {
		return OakList{}
	}
	pred, ok := __oak_args[1].(OakFn)
	if !ok {
		return OakList{}
	}
	result := OakList{}
	for i, v := range list {
		if __oak_to_bool(pred(v, int(i))) {
			result = append(result, v)
		}
	}
	return result
})

'

// ---------------------------------------------------------------------------
// TODO-15 v1.5: dynamic numeric ops (int-preserving) + native std stub
// ---------------------------------------------------------------------------

GoStdNatives := [
	'func __oak_num2(a, b OakValue) (int64, int64, float64, float64, bool) {'
	'\tai, ok1 := a.(int)'
	'\tbi, ok2 := b.(int)'
	'\tif ok1 && ok2 { return int64(ai), int64(bi), 0, 0, true }'
	'\treturn 0, 0, __oak_to_float(a), __oak_to_float(b), false'
	'}'
	'func __oak_add(a, b OakValue) OakValue {'
	'\tif x, y, _, _, isInt := __oak_num2(a, b); isInt { return int(x + y) }'
	'\tif sa, ok := a.(string); ok { return sa + __as_oak_string(b) }'
	'\tif sb, ok := b.(string); ok { return __as_oak_string(a) + sb }'
	'\tla, okl := a.(OakList)'
	'\tlb, okr := b.(OakList)'
	'\tif okl && okr { return append(append(OakList{}, la...), lb...) }'
	'\treturn __oak_to_float(a) + __oak_to_float(b)'
	'}'
	'func __oak_sub(a, b OakValue) OakValue {'
	'\tif x, y, _, _, isInt := __oak_num2(a, b); isInt { return int(x - y) }'
	'\treturn __oak_to_float(a) - __oak_to_float(b)'
	'}'
	'func __oak_mul(a, b OakValue) OakValue {'
	'\tif x, y, _, _, isInt := __oak_num2(a, b); isInt { return int(x * y) }'
	'\treturn __oak_to_float(a) * __oak_to_float(b)'
	'}'
	'func __oak_div(a, b OakValue) OakValue {'
	'\tif x, y, _, _, isInt := __oak_num2(a, b); isInt {'
	'\t\tif y == 0 { return int(0) }'
	'\t\treturn int(x / y)'
	'\t}'
	'\treturn __oak_to_float(a) / __oak_to_float(b)'
	'}'
	'func __oak_mod(a, b OakValue) OakValue {'
	'\tif x, y, _, _, isInt := __oak_num2(a, b); isInt {'
	'\t\tif y == 0 { return int(0) }'
	'\t\treturn int(x % y)'
	'\t}'
	'\td := __oak_to_float(b)'
	'\treturn __oak_to_float(a) - d*float64(int(__oak_to_float(a)/d))'
	'}'
	'func __oak_neg(a OakValue) OakValue {'
	'\tif x, ok := a.(int); ok { return int(-x) }'
	'\treturn -__oak_to_float(a)'
	'}'
	'var __oak_go_range = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\ta, b, c := 0, 0, 1'
	'\tif len(__oak_args) > 0 { a = int(__oak_to_float(__oak_args[0])) }'
	'\tif len(__oak_args) > 1 { b = int(__oak_to_float(__oak_args[1])) }'
	'\tif len(__oak_args) > 2 { c = int(__oak_to_float(__oak_args[2])) }'
	'\tif c == 0 { c = 1 }'
	'\tout := OakList{}'
	'\tif c > 0 { for i := a; i < b; i += c { out = append(out, int(i)) } }'
	'\tif c < 0 { for i := a; i > b; i += c { out = append(out, int(i)) } }'
	'\treturn out'
	'})'
	'var __oak_sortedKeys = func(m OakObject) []string {'
	'\tks := make([]string, 0, len(m))'
	'\tfor k := range m { ks = append(ks, k) }'
	'\tsort.Strings(ks)'
	'\treturn ks'
	'}'
	'var __oak_go_each = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 2 { return nil }'
	'\tf, _ := __oak_args[1].(OakFn)'
	'\tswitch xs := __oak_args[0].(type) {'
	'\tcase OakList:'
	'\t\tfor i, v := range xs { if f != nil { f(v, int(i)) } }'
	'\tcase OakObject:'
	'\t\tfor _, k := range __oak_sortedKeys(xs) { if f != nil { f(xs[k], k) } }'
	'\tcase string:'
	'\t\tfor i, r := range xs { if f != nil { f(string(r), int(i)) } }'
	'\t}'
	'\treturn nil'
	'})'
	'var __oak_go_map = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 2 { return OakList{} }'
	'\tf, _ := __oak_args[1].(OakFn)'
	'\tout := OakList{}'
	'\tif f == nil { return out }'
	'\tswitch xs := __oak_args[0].(type) {'
	'\tcase OakList:'
	'\t\tfor i, v := range xs { out = append(out, f(v, int(i))) }'
	'\tcase OakObject:'
	'\t\tfor _, k := range __oak_sortedKeys(xs) { out = append(out, f(xs[k], k)) }'
	'\tcase string:'
	'\t\tfor i, r := range xs { out = append(out, f(string(r), int(i))) }'
	'\t}'
	'\treturn out'
	'})'
	'var __oak_go_reduce = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 3 { return nil }'
	'\tacc := __oak_args[1]'
	'\tf, _ := __oak_args[2].(OakFn)'
	'\tif f == nil { return acc }'
	'\tswitch xs := __oak_args[0].(type) {'
	'\tcase OakList:'
	'\t\tfor i, v := range xs { acc = f(acc, v, int(i)) }'
	'\tcase OakObject:'
	'\t\tfor _, k := range __oak_sortedKeys(xs) { acc = f(acc, xs[k], k) }'
	'\tcase string:'
	'\t\tfor i, r := range xs { acc = f(acc, string(r), int(i)) }'
	'\t}'
	'\treturn acc'
	'})'
	'var __oak_go_append = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 2 { return __oak_args[0] }'
	'\tif l, ok := __oak_args[0].(OakList); ok {'
	'\t\treturn append(append(OakList{}, l...), __oak_args[1])'
	'\t}'
	'\treturn __oak_push(__oak_args[0], __oak_args[1])'
	'})'
	'var __oak_go_clone = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 1 { return nil }'
	'\tswitch v := __oak_args[0].(type) {'
	'\tcase OakList:'
	'\t\tout := make(OakList, len(v))'
	'\t\tcopy(out, v)'
	'\t\treturn out'
	'\tcase OakObject:'
	'\t\tout := OakObject{}'
	'\t\tfor k, x := range v { out[k] = x }'
	'\t\treturn out'
	'\t}'
	'\treturn __oak_args[0]'
	'})'
	'var __oak_go_default = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 1 { return nil }'
	'\tif __oak_args[0] == nil {'
	'\t\tif len(__oak_args) > 1 { return __oak_args[1] }'
	'\t\treturn nil'
	'\t}'
	'\treturn __oak_args[0]'
	'})'
	'var __oak_go_contains = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 2 { return false }'
	'\tswitch xs := __oak_args[0].(type) {'
	'\tcase OakList:'
	'\t\tfor _, v := range xs { if __oak_eq(v, __oak_args[1]) { return true } }'
	'\tcase string:'
	'\t\treturn strings.Contains(xs, __as_oak_string(__oak_args[1]))'
	'\tcase OakObject:'
	'\t\t_, ok := xs[__as_oak_string(__oak_args[1])]'
	'\t\treturn ok'
	'\t}'
	'\treturn false'
	'})'
	'var __oak_go_indexOf = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 2 { return int(-1) }'
	'\tswitch xs := __oak_args[0].(type) {'
	'\tcase OakList:'
	'\t\tfor i, v := range xs { if __oak_eq(v, __oak_args[1]) { return int(i) } }'
	'\tcase string:'
	'\t\treturn int(strings.Index(xs, __as_oak_string(__oak_args[1])))'
	'\t}'
	'\treturn int(-1)'
	'})'
	'var __oak_go_join = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 2 { return "" }'
	'\tl, _ := __oak_args[0].(OakList)'
	'\tparts := make([]string, len(l))'
	'\tfor i, v := range l { parts[i] = __as_oak_string(v) }'
	'\treturn strings.Join(parts, __as_oak_string(__oak_args[1]))'
	'})'
	'var __oak_go_first = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 1 { return nil }'
	'\tif l, ok := __oak_args[0].(OakList); ok && len(l) > 0 { return l[0] }'
	'\treturn nil'
	'})'
	'var __oak_go_last = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 1 { return nil }'
	'\tif l, ok := __oak_args[0].(OakList); ok && len(l) > 0 { return l[len(l)-1] }'
	'\treturn nil'
	'})'
	'var __oak_go_take = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 2 { return OakList{} }'
	'\tl, _ := __oak_args[0].(OakList)'
	'\tn := int(__oak_to_float(__oak_args[1]))'
	'\tif n > len(l) { n = len(l) }'
	'\tif n < 0 { n = 0 }'
	'\tout := make(OakList, n)'
	'\tcopy(out, l[:n])'
	'\treturn out'
	'})'
	'var __oak_go_reverse = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 1 { return OakList{} }'
	'\tl, _ := __oak_args[0].(OakList)'
	'\tout := make(OakList, len(l))'
	'\tfor i, v := range l { out[len(l)-1-i] = v }'
	'\treturn out'
	'})'
	'var __oak_go_identity = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 1 { return nil }'
	'\treturn __oak_args[0]'
	'})'
	'var __oak_go_error = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tmsg := ""'
	'\tif len(__oak_args) > 0 { msg = __as_oak_string(__oak_args[0]) }'
	'\treturn OakObject{"type": "error", "message": msg}'
	'})'
	'var __oak_go_println = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tparts := make([]string, len(__oak_args))'
	'\tfor i, v := range __oak_args { parts[i] = __as_oak_string(v) }'
	'\tfmt.Println(strings.Join(parts, " "))'
	'\treturn nil'
	'})'
	'var __oak_go_sin = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 1 { return float64(0) }'
	'\treturn math.Sin(__oak_to_float(__oak_args[0]))'
	'})'
	'var __oak_go_cos = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 1 { return float64(0) }'
	'\treturn math.Cos(__oak_to_float(__oak_args[0]))'
	'})'
	'var __oak_go_pow = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 2 { return float64(0) }'
	'\treturn math.Pow(__oak_to_float(__oak_args[0]), __oak_to_float(__oak_args[1]))'
	'})'
	'var __oak_go_time = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\treturn float64(time.Now().UnixNano()) / 1e9'
	'})'
	'var __oak_go_wait = OakFn(func(__oak_args ...OakValue) OakValue {'
	'\tif len(__oak_args) < 2 { return nil }'
	'\td := time.Duration(__oak_to_float(__oak_args[0]) * float64(time.Second))'
	'\tif f, ok := __oak_args[1].(OakFn); ok {'
	'\t\ttime.AfterFunc(d, func() { f() })'
	'\t} else {'
	'\t\ttime.Sleep(d)'
	'\t}'
	'\treturn nil'
	'})'
	'func __oak_setv(obj OakValue, key OakValue, val OakValue) OakValue {'
	'\tswitch o := obj.(type) {'
	'\tcase OakObject:'
	'\t\to[__as_oak_string(key)] = val'
	'\t\treturn val'
	'\tcase OakList:'
	'\t\tif i, ok := key.(int); ok {'
	'\t\t\tif i >= 0 && i < len(o) { o[i] = val; return val }'
	'\t\t}'
	'\t\tif f, ok := key.(float64); ok {'
	'\t\t\ti := int(f)'
	'\t\t\tif i >= 0 && i < len(o) { o[i] = val; return val }'
	'\t\t}'
	'\tcase string:'
	'\t\tif i, ok := key.(int); ok {'
	'\t\t\tif i >= 0 && i < len(o) {'
	'\t\t\t\tb := []byte(o)'
	'\t\t\t\tb[i] = __as_oak_string(val)[0]'
	'\t\t\t\treturn string(b)'
	'\t\t\t}'
	'\t\t}'
	'}'
	'\treturn nil'
	'}'
	'func __oak_fast_int_args(args []OakValue, k int) ([]int64, bool) {'
	'\tif len(args) < k { return nil, false }'
	'\tout := make([]int64, k)'
	'\tfor i := 0; i < k; i++ {'
	'\t\tv, ok := args[i].(int)'
	'\t\tif !ok { return nil, false }'
	'\t\tout[i] = int64(v)'
	'\t}'
	'\treturn out, true'
	'}'
	'// __oak_std_module is the native stand-in for runtime-library modules;'
	'// runtime libs are never transpiled into the bundle.'
	'var __oak_std_module = OakObject{'
	'\t"range": __oak_go_range, "map": __oak_go_map, "each": __oak_go_each,'
	'\t"filter": filter, "reduce": __oak_go_reduce, "append": __oak_go_append,'
	'\t"slice": slice, "clone": __oak_go_clone, "default": __oak_go_default,'
	'\t"keys": keys, "values": values, "contains?": __oak_go_contains,'
	'\t"indexOf": __oak_go_indexOf, "join": __oak_go_join,'
	'\t"first": __oak_go_first, "last": __oak_go_last, "take": __oak_go_take,'
	'\t"reverse": __oak_go_reverse, "identity": __oak_go_identity,'
	'\t"error": __oak_go_error, "println": __oak_go_println,'
	'\t"print": __oak_go_print, "sin": __oak_go_sin, "cos": __oak_go_cos,'
	'\t"pow": __oak_go_pow, "time": __oak_go_time, "wait": __oak_go_wait,'
	'\t"int": __oak_go_int, "float": __oak_go_float64, "string": __oak_go_string,'
	'\t"type": __oak_go_type, "len": __oak_go_len, "char": char,'
	'\t"codepoint": codepoint, "rand": __oak_go_rand,'
	'}'
]

GoRuntimePreambleFull := GoRuntimePreamble + (GoStdNatives |> join('\n')) + '\n'
// RuntimeLibs lists standard-library modules provided natively by the Go
// runtime preamble (__oak_std_module); their Oak sources are never bundled.
GoRuntimeLibs := [
	'std', 'str', 'math', 'math-base', 'math-geo', 'math-stats', 'sort'
	'random', 'fs', 'fmt', 'json', 'msgpack', 'datetime', 'path'
	'compression', 'dataprot', 'http', 'socket', 'test', 'debug', 'cli'
	'md', 'mermaid', 'crypto', 'bitwise', 'bytes', 'sample', 'hex'
	'ieee754', 'int64', 'unicode-units', 'image'
]

fn isGoRuntimeLib(name) if GoRuntimeLibs |> indexOf(name) {
	-1 -> false
	_ -> true
}

// ---------------------------------------------------------------------------
// TODO-15 v2: MIR-typed fast companions (plan §8.2)
//
// For every named function whose MIR lattice proves int-only params, locals,
// and return type, emit a monomorphized Go companion
//   func __mg_fast_<name>(p0 int64, ...) int64
// with direct scalar operators, Go-native if/else arms, self-tail-recursion
// lowered to a for loop (param rebind + continue), and direct calls between
// typed companions. The dynamic OakFn keeps its original body but tries the
// fast path first when every actual argument is an Oak int. Untyped code
// falls back to the dynamic path unchanged.
// ---------------------------------------------------------------------------

// _tvOK reports whether node fits the typed int subset. cmp?=true marks
// cond position (comparisons and bool literals allowed there only).
// tnames is the set of functions with typed companions (calls to them are
// direct); rec supplies the binding-type lattice for identifier checks.
fn _tvOK(node, rec, tnames, cmp?) if node.type {
	:int -> !cmp?
	:identifier -> if rec.bindings.(node.val) {
		? -> false
		_ -> if rec.bindings.(node.val).type = :int {
			true -> true
			_ -> rec.bindings.(node.val).kind = :param & rec.bindings.(node.val).type = :unknown
		}
	}
	:binary -> if node.op {
		:plus, :minus, :times, :divide, :modulus -> !cmp? & _tvOK(node.left, rec, tnames, false) & _tvOK(node.right, rec, tnames, false)
		:eq, :neq, :less, :greater, :leq, :geq -> cmp? & _tvOK(node.left, rec, tnames, false) & _tvOK(node.right, rec, tnames, false)
		_ -> false
	}
	:unary -> node.op = :minus & !cmp? & _tvOK(node.right, rec, tnames, false)
	:fnCall -> if node.function.type = :identifier {
		true -> if tnames.(node.function.val) {
			? -> node.function.val = rec.name // self-recursion is fine
			_ -> _tvArgsOK(node.args, rec, tnames)
		}
		_ -> false
	}
	:ifExpr -> !cmp? & _tifOK(node, rec, tnames)
	:block -> !cmp? & _tblkOK(node, rec, tnames)
	_ -> false
}

fn _tvArgsOK(args, rec, tnames) if args {
	? -> true
	_ -> {
		ok := true
		fn scan(i) if ok {
			false -> ?
			_ -> if i < len(args) {
				true -> {
					if !_tvOK(args.(i), rec, tnames, false) {
						true -> ok <- false
						_ -> ?
					}
					scan(i + 1)
				}
				_ -> ?
			}
		}
		scan(0)
		ok
	}
}

fn _tifOK(node, rec, tnames) {
	ok := _tvOK(node.cond, rec, tnames, true)
	fn arms(i) if ok {
		false -> ?
		_ -> if i < len(node.branches) {
			true -> {
				br := node.branches.(i)
				if br.target.type {
					:empty -> ?
					:int -> ?
					:bool -> ?
					_ -> ok <- false
				}
				if ok {
					true -> if !_tvOK(br.body, rec, tnames, false) {
						true -> ok <- false
						_ -> ?
					}
					_ -> ?
				}
				arms(i + 1)
			}
			_ -> ?
		}
	}
	arms(0)
	ok
}

fn _tblkOK(node, rec, tnames) {
	n := if node.exprs {
		? -> 0
		_ -> len(node.exprs)
	}
	if n = 0 {
		true -> false
		_ -> {
			ok := true
			fn scan(i) if ok {
				false -> ?
				_ -> if i < n {
					true -> {
						if i < n - 1 {
							true -> if !_tstmtOK(node.exprs.(i), rec, tnames) {
								true -> ok <- false
								_ -> ?
							}
							_ -> if !_tvOK(node.exprs.(i), rec, tnames, false) {
								true -> ok <- false
								_ -> ?
							}
						}
						scan(i + 1)
					}
					_ -> ?
				}
			}
			scan(0)
			ok
		}
	}
}

fn _tstmtOK(node, rec, tnames) if node.type {
	:assignment -> if node.left.type = :identifier & node.local? {
		true -> if rec.bindings.(node.left.val) {
			? -> false
			_ -> rec.bindings.(node.left.val).type = :int & _tvOK(node.right, rec, tnames, false)
		}
		_ -> false
	}
	_ -> false
}

// _typedFnOK decides full eligibility of a MIR fn record against the current
// typed set (fixpoint input).
fn _typedFnOK(rec, tnames) {
	ok := rec.returns = :int
	if rec.node.restArg {
		?, '' -> ?
		_ -> ok <- false
	}
	if ok {
		true -> if rec.params {
			? -> ?
			_ -> {
				fn ps(i) if ok {
					false -> ?
					_ -> if i < len(rec.params) {
						true -> {
							if rec.bindings.(rec.params.(i)) {
								? -> ok <- false
								_ -> if rec.bindings.(rec.params.(i)).type != :int {
									true -> if rec.bindings.(rec.params.(i)).kind = :param & rec.bindings.(rec.params.(i)).type = :unknown {
										true -> ?
										_ -> ok <- false
									}
									_ -> ?
								}
							}
							ps(i + 1)
						}
						_ -> ?
					}
				}
				ps(0)
			}
		}
		_ -> ?
	}
	if ok {
		true -> {
			names := rec.bindings |> keys()
			fn bs(i) if ok {
				false -> ?
				_ -> if i < len(names) {
					true -> {
						if rec.bindings.(names.(i)).type != :int {
							true -> ok <- false
							_ -> ?
						}
						bs(i + 1)
					}
					_ -> ?
				}
			}
			bs(0)
		}
		_ -> ?
	}
	if ok {
		true -> if !_tvOK(rec.node.body, rec, tnames, false) {
			true -> ok <- false
			_ -> ?
		}
		_ -> ?
	}
	ok
}

// computeTypedSet runs the fixpoint: repeatedly admit fns whose bodies only
// call already-typed fns. Returns {names: {}, recs: {}}.
fn computeTypedSet(mirOut) {
	res := {names: {}, recs: {}}
	if mirOut {
		? -> res
		_ -> {
			// 1-deep helpers with explicit state params — nested captured
			// member stores are silently dropped by the host VM
			fn admit(st, nm) if _typedFnOK(mirOut.functions.(nm), st.names) {
				true -> {
					st.names.(nm) <- true
					st.recs.(nm) <- mirOut.functions.(nm)
					true
				}
				_ -> false
			}
			fn scan(st, names, i, changed) if i < len(names) {
				true -> {
					nc := changed
					if st.names.(names.(i)) {
						? -> if admit(st, names.(i)) {
							true -> nc <- true
							_ -> ?
						}
						_ -> ?
					}
					scan(st, names, i + 1, nc)
				}
				_ -> ?
			}
			fn loop(st, i) if i < 16 {
				true -> {
					if scan(st, mirOut.functions |> keys(), 0, false) {
						true -> loop(st, i + 1)
						_ -> ?
					}
				}
				_ -> ?
			}
			loop(res, 0)
		}
	}
	res
}

// renderTVal renders a typed int64 value expression.
fn renderTVal(node, rec) if node.type {
	:int -> string(node.val)
	:identifier -> goIdent(node.val)
	:binary -> if node.op {
		:plus -> '(' + renderTVal(node.left, rec) + ' + ' + renderTVal(node.right, rec) + ')'
		:minus -> '(' + renderTVal(node.left, rec) + ' - ' + renderTVal(node.right, rec) + ')'
		:times -> '(' + renderTVal(node.left, rec) + ' * ' + renderTVal(node.right, rec) + ')'
		:divide -> if node.right.type = :int {
			true -> if node.right.val != 0 {
				true -> '(' + renderTVal(node.left, rec) + ' / ' + string(node.right.val) + ')'
				_ -> '0'
			}
			_ -> '(' + renderTVal(node.left, rec) + ' / ' + renderTVal(node.right, rec) + ')'
		}
		:modulus -> if node.right.type = :int {
			true -> if node.right.val != 0 {
				true -> '(' + renderTVal(node.left, rec) + ' % ' + string(node.right.val) + ')'
				_ -> '0'
			}
			_ -> '(' + renderTVal(node.left, rec) + ' % ' + renderTVal(node.right, rec) + ')'
		}
		_ -> '0'
	}
	:unary -> if node.op {
		:minus -> '(-' + renderTVal(node.right, rec) + ')'
		_ -> '0'
	}
	:fnCall -> '__mg_fast_' + goIdent(node.function.val) + '(' + (node.args |> map(fn(a) renderTVal(a, rec)) |> join(', ')) + ')'
	_ -> '0'
}

// renderTCond renders a typed bool (cond-position) expression.
fn renderTCond(node, rec) if node.type {
	:binary -> if node.op {
		:eq -> '(' + renderTVal(node.left, rec) + ' == ' + renderTVal(node.right, rec) + ')'
		:neq -> '(' + renderTVal(node.left, rec) + ' != ' + renderTVal(node.right, rec) + ')'
		:less -> '(' + renderTVal(node.left, rec) + ' < ' + renderTVal(node.right, rec) + ')'
		:greater -> '(' + renderTVal(node.left, rec) + ' > ' + renderTVal(node.right, rec) + ')'
		:leq -> '(' + renderTVal(node.left, rec) + ' <= ' + renderTVal(node.right, rec) + ')'
		:geq -> '(' + renderTVal(node.left, rec) + ' >= ' + renderTVal(node.right, rec) + ')'
		_ -> 'false'
	}
	:bool -> if node.val {
		true -> 'true'
		_ -> 'false'
	}
	_ -> 'false'
}

// _isSelfCall reports a bare self-call f(...).
fn _isSelfCall(node, rec) node.type = :fnCall & node.function.type = :identifier & node.function.val = rec.name

// renderTTail renders a tail-position value: self-call -> param rebind +
// continue; otherwise -> return expr. Block bodies recurse as stmt lists.
fn renderTTail(node, rec, out) if node.type {
	:block -> {
		n := if node.exprs {
			? -> 0
			_ -> len(node.exprs)
		}
		fn scan(i) if i < n {
			true -> {
				if i = n - 1 {
					true -> renderTTail(node.exprs.(i), rec, out)
					_ -> renderTStmt(node.exprs.(i), rec, out)
				}
				scan(i + 1)
			}
			_ -> ?
		}
		scan(0)
	}
	:ifExpr -> {
		// if/else-if/else chain over ordered equality arms
		fn arms(i) if i < len(node.branches) {
			true -> {
				br := node.branches.(i)
				if br.target.type {
					:empty -> out << '} else {'
					_ -> if i = 0 {
						true -> out << 'if ' + renderTCond(node.cond, rec) + ' == ' + renderTCond(br.target, rec) + ' {'
						_ -> out << '} else if ' + renderTCond(br.target, rec) + ' {'
					}
				}
				renderTTail(br.body, rec, out)
				arms(i + 1)
			}
			_ -> ?
		}
		arms(0)
		// close all opened braces: count non-empty targets
		opens := 0
		fn count(i) if i < len(node.branches) {
			true -> {
				if node.branches.(i).target.type != :empty {
					true -> opens <- opens + 1
					_ -> ?
				}
				count(i + 1)
			}
			_ -> ?
		}
		count(0)
		fn close(i) if i < opens {
			true -> {
				out << '}'
				close(i + 1)
			}
			_ -> ?
		}
		close(0)
	}
	_ -> if _isSelfCall(node, rec) {
		true -> {
			fn bind(i) if i < len(rec.params) {
				true -> {
					if i < len(node.args) {
						true -> out << goIdent(rec.params.(i)) + ' = ' + renderTVal(node.args.(i), rec)
						_ -> out << goIdent(rec.params.(i)) + ' = 0'
					}
					bind(i + 1)
				}
				_ -> ?
			}
			bind(0)
			out << 'continue'
		}
		_ -> out << 'return ' + renderTVal(node, rec)
	}
}

// renderTStmt renders a non-tail statement (int assignments only).
fn renderTStmt(node, rec, out) if node.type {
	:assignment -> out << goIdent(node.left.val) + ' = ' + renderTVal(node.right, rec)
	_ -> ?
}

// renderTypedCompanion emits the monomorphized Go function for one rec.
fn renderTypedCompanion(rec) {
	out := []
	sig := []
	if rec.params {
		? -> ?
		_ -> {
			fn ps(i) if i < len(rec.params) {
				true -> {
					sig << goIdent(rec.params.(i)) + ' int64'
					ps(i + 1)
				}
				_ -> ?
			}
			ps(0)
		}
	}
	header := 'func __mg_fast_' + goIdent(rec.name) + '(' + (sig |> join(', ')) + ') int64 {'
	out << header
	out << '\tfor {'
	// prologue: non-param int locals
	paramSet := {}
	if rec.params {
		? -> ?
		_ -> {
			fn pset(i) if i < len(rec.params) {
				true -> {
					paramSet.(rec.params.(i)) <- true
					pset(i + 1)
				}
				_ -> ?
			}
			pset(0)
		}
	}
	bnames := rec.bindings |> keys()
	fn locals(i) if i < len(bnames) {
		true -> {
			if paramSet.(bnames.(i)) {
				? -> out << '\tvar ' + goIdent(bnames.(i)) + ' int64'
				_ -> ?
			}
			locals(i + 1)
		}
		_ -> ?
	}
	locals(0)
	renderTTail(rec.node.body, rec, out)
	out << '\t}'
	out << '}'
	out |> join('\n')
}

// ---------------------------------------------------------------------------
// renderGoBundle -- main entry point called by the build system
// ---------------------------------------------------------------------------

fn renderGoBundle(bundleNode) {
	output := GoRuntimePreambleFull

	// --- TODO-15 v2: MIR-typed fast companions -----------------------------
	// Collect user-module body nodes (runtime libs are native stubs) and run
	// the MIR analysis to find int-only functions worth monomorphizing.
	mirNodes := []
	fn appendAll(dst, xs, i) if xs {
		? -> ?
		_ -> if i < len(xs) {
			true -> {
				dst.(len(dst)) <- xs.(i)
				appendAll(dst, xs, i + 1)
			}
			_ -> ?
		}
	}
	fn gatherInto(exprs, i) if exprs {
		? -> ?
		_ -> if i < len(exprs) {
			true -> {
				e := exprs.(i)
				if e.type = :fnCall & e.function.type = :identifier & e.function.val = '__oak_modularize' {
					true -> if len(e.args) > 1 & e.args.(0).type = :string & !isGoRuntimeLib(e.args.(0).val) {
						true -> if e.args.(1).type = :function & e.args.(1).body.type = :block & e.args.(1).body.exprs != ? {
							true -> appendAll(mirNodes, e.args.(1).body.exprs, 0)
						}
					}
				}
				gatherInto(exprs, i + 1)
			}
			_ -> ?
		}
	}
	if bundleNode.type = :block & bundleNode.exprs != ? {
		true -> gatherInto(bundleNode.exprs, 0)
		_ -> ?
	}
	typedSet := computeTypedSet(mir.analyze(mirNodes))
	typedNames := typedSet.names
	typedRecs := typedSet.recs
	// emit the monomorphized companions right after the preamble
	fn companion(i, ns, acc) if i < len(ns) {
		true -> companion(i + 1, ns, acc + renderTypedCompanion(typedRecs.(ns.(i))) + '\n')
		_ -> acc
	}
	if env().('MGO_NO_FAST') = ? {
		true -> output <- output + companion(0, keys(typedRecs), '')
		_ -> ?
	}

	// renderReturnExpr renders "return OakValue(expr)" but handles
	// assignments specially since Go assignments are statements, not expressions.
	fn renderReturnExpr(node) ?

	// collectBlockLocals scans direct children of a block for local variable
	// declarations and named functions, returning a list of identifier names.
	// Used to hoist var declarations to the top of Go blocks/function bodies
	// since Oak hoists all locals but Go does not.
	fn collectBlockLocals(exprs) {
		names := []
		exprs |> each(fn(expr) if {
			expr.type = :assignment & expr.local? -> if expr.left.type {
				:identifier -> names << expr.left.val
				:object -> expr.left.entries |> each(fn(entry) {
					{ key: k, val: v } := entry
					name := if v.type { :identifier -> v.val, _ -> k.val }
					names << name
				})
				:list -> expr.left.elems |> each(fn(elem) if elem.type {
					:identifier -> names << elem.val
				})
			}
			expr.type = :function & expr.name != ? & expr.name != '' ->
				names << expr.name
		})
		names
	}

	// renderHoistedBlockExprs renders a list of block expressions with
	// variable hoisting: emits var declarations at top, then renders exprs
	// with local? cleared (so := becomes =).
	fn renderHoistedBlockExprs(exprs) {
		result := ''
		locals := collectBlockLocals(exprs)
		locals |> each(fn(name) {
			result <- result + 'var ' + goIdent(name) + ' OakValue; '
		})
		lastIdx := len(exprs) - 1
		exprs |> each(fn(expr, i) {
			wasLocal := expr.local?
			if expr.type = :assignment & expr.local? -> expr.local? <- false
			if i = lastIdx {
				true -> result <- result + renderReturnExpr(expr)
				_ -> result <- result + renderStatement(expr) + '; '
			}
			if wasLocal != ? -> expr.local? <- wasLocal
		})
		result
	}

	// renderStatement renders a statement-position expression. `xs << v`
	// must rebind xs (Go append can reallocate), mirroring the C backend's
	// `l = mg_push(l, r);` emission.
	fn renderStatement(node) if node.type {
		:binary -> if node.op {
			:pushArrow -> if node.left.type = :identifier {
				true -> goIdent(node.left.val) + ' = __oak_push(' + goIdent(node.left.val) + ', ' + renderNode(node.right) + ')'
				_ -> renderNode(node)
			}
			_ -> renderNode(node)
		}
		_ -> renderNode(node)
	}

	fn renderNode(node) if node {
		? -> 'nil'
		_ -> if node.type {

			:null -> 'nil'
			:empty -> 'nil'

			:string -> goStr(node.val)

			:int -> 'int(' + string(node.val) + ')'

			:float -> {
				s := string(node.val)
				if strContains?(s, '.') {
					true -> 'float64(' + s + ')'
					_ -> 'float64(' + s + '.0)'
				}
			}

			:bool -> if node.val {
				true -> 'true'
				_ -> 'false'
			}

			:identifier -> goIdent(node.val)

			:atom -> '"' + node.val + '"'

			:list -> 'OakList{' + (node.elems |> map(renderNode) |> join(', ')) + '}'

			:object -> 'OakObject{' + (node.entries |> map(fn(entry) {
				{ key: k, val: v } := entry
				if k.type {
					:identifier -> goStr(k.val) + ': ' + renderNode(v)
					:string -> goStr(k.val) + ': ' + renderNode(v)
					:int -> goStr(string(k.val)) + ': ' + renderNode(v)
					_ -> '__as_oak_string(' + renderNode(k) + '): ' + renderNode(v)
				}
			}) |> join(', ')) + '}'

			:unary -> if node.op {
				:minus -> '__oak_neg(' + renderNode(node.right) + ')'
				:exclam -> '(!__oak_to_bool(' + renderNode(node.right) + '))'
			}

			:binary -> if node.op {
				:plus -> '__oak_add(' + renderNode(node.left) + ', ' + renderNode(node.right) + ')'
				:minus -> '__oak_sub(' + renderNode(node.left) + ', ' + renderNode(node.right) + ')'
				:times -> '__oak_mul(' + renderNode(node.left) + ', ' + renderNode(node.right) + ')'
				:divide -> '__oak_div(' + renderNode(node.left) + ', ' + renderNode(node.right) + ')'
				:modulus -> '__oak_mod(' + renderNode(node.left) + ', ' + renderNode(node.right) + ')'
				:exponent -> 'math.Pow(__oak_to_float(' + renderNode(node.left) + '), __oak_to_float(' + renderNode(node.right) + '))'
				:rshift -> '(int(__oak_to_float(' + renderNode(node.left) + ')) >> int(__oak_to_float(' + renderNode(node.right) + ')))'
				:pushArrow -> '__oak_push(' + renderNode(node.left) + ', ' + renderNode(node.right) + ')'
				:and -> '__oak_and(' + renderNode(node.left) + ', ' + renderNode(node.right) + ')'
				:or -> '__oak_or(' + renderNode(node.left) + ', ' + renderNode(node.right) + ')'
				:xor -> '(int(__oak_to_float(' + renderNode(node.left) + ')) ^ int(__oak_to_float(' + renderNode(node.right) + ')))'
				:eq -> '__oak_eq(' + renderNode(node.left) + ', ' + renderNode(node.right) + ')'
				:neq -> '!__oak_eq(' + renderNode(node.left) + ', ' + renderNode(node.right) + ')'
				:greater -> '(__oak_to_float(' + renderNode(node.left) + ') > __oak_to_float(' + renderNode(node.right) + '))'
				:less -> '(__oak_to_float(' + renderNode(node.left) + ') < __oak_to_float(' + renderNode(node.right) + '))'
				:geq -> '(__oak_to_float(' + renderNode(node.left) + ') >= __oak_to_float(' + renderNode(node.right) + '))'
				:leq -> '(__oak_to_float(' + renderNode(node.left) + ') <= __oak_to_float(' + renderNode(node.right) + '))'
				:pipe -> {
					// a |> f(b, c) → f(a, b, c)
					fnNode := node.right
					if fnNode.type = :fnCall {
						true -> renderNode(fnNode.function) + '(' + ([renderNode(node.left)] |> append(fnNode.args |> map(renderNode)) |> join(', ')) + ')'
						_ -> renderNode(node.right) + '(' + renderNode(node.left) + ')'
					}
				}
			}

			:assignment -> if node.left.type {
				:propertyAccess -> {
					container := renderNode(node.left.left)
					if node.left.right.type = :identifier {
						true -> '__oak_set(' + container + ', ' + goStr(node.left.right.val) + ', ' + renderNode(node.right) + ')'
						_ -> '__oak_setv(' + container + ', ' + renderNode(node.left.right) + ', ' + renderNode(node.right) + ')'
					}
				}
				:object -> {
					prefix := ''
					if node.local? {
						true -> node.left.entries |> each(fn(entry) {
							{ key: k, val: v } := entry
							name := if v.type {
								:identifier -> v.val
								_ -> k.val
							}
							prefix <- prefix + 'var ' + goIdent(name) + ' OakValue; '
						})
					}
					prefix + 'func() OakValue {' + {
						result := '__oak_assgn := ' + renderNode(node.right) + '; '
						node.left.entries |> each(fn(entry) {
							{ key: k, val: v } := entry
							name := if v.type {
								:identifier -> v.val
								_ -> k.val
							}
							result <- result + goIdent(name) + ' = __oak_acc(__oak_assgn, ' + goStr(k.val) + '); '
						})
						result
					} + 'return __oak_assgn}()'
				}
				:list -> {
					prefix := ''
					if node.local? {
						true -> node.left.elems |> each(fn(elem, i) if elem.type {
							:identifier -> prefix <- prefix + 'var ' + goIdent(elem.val) + ' OakValue; '
							:empty -> ?
						})
					}
					prefix + 'func() OakValue {' + {
						result := '__oak_assgn := ' + renderNode(node.right) + '; '
						node.left.elems |> each(fn(elem, i) if elem.type {
							:identifier -> result <- result + goIdent(elem.val) + ' = __oak_acc(__oak_assgn, ' + string(i) + '); '
							:empty -> ?
						})
						result
					} + 'return __oak_assgn}()'
				}
				_ -> {
					leftStr := renderNode(node.left)
					rightStr := renderNode(node.right)
					if node.local? {
						true -> leftStr + ' := ' + rightStr
						_ -> leftStr + ' = ' + rightStr
					}
				}
			}

			:propertyAccess -> if node.right.type {
				:identifier -> '__oak_acc(' + renderNode(node.left) + ', ' + goStr(node.right.val) + ')'
				_ -> '__oak_acc(' + renderNode(node.left) + ', ' + renderNode(node.right) + ')'
			}

			:ifExpr -> 'func() OakValue {' + {
				result := ''
				condExpr := renderNode(node.cond)
				// `if x := e { ... }` — assignments in cond position are not
				// valid Go expressions; hoist to a statement and use the var
				fn hoistCondAssign() if node.cond.type = :assignment & node.cond.left.type = :identifier {
					true -> {
						cname := goIdent(node.cond.left.val)
						if node.cond.local? {
							true -> result <- result + 'var ' + cname + ' OakValue; '
							_ -> ?
						}
						result <- result + cname + ' = ' + renderNode(node.cond.right) + '; '
						condExpr <- cname
					}
					_ -> ?
				}
				hoistCondAssign()
				result <- result + '__oak_cond := ' + condExpr + '; '
				hasElse := false
				node.branches |> each(fn(br, i) {
					prefix := if i { 0 -> 'if ', _ -> ' else if ' }
					if br.target.type = :empty {
						true -> {
							hasElse <- true
							result <- result + ' else { ' + renderReturnExpr(br.body) + ' }'
						}
						_ -> result <- result + prefix + '__oak_eq(__oak_cond, ' + renderNode(br.target) + ') { ' + renderReturnExpr(br.body) + ' }'
					}
				})
				if hasElse {
					true -> result
					_ -> result + '; return nil'
				}
			} + '}()'

			:block -> 'func() OakValue {' + renderHoistedBlockExprs(node.exprs) + '}()'

			:function -> {
				args := node.args
				fnExpr := 'OakFn(func(__oak_args ...OakValue) OakValue {' + {
					argBindings := args |> map(fn(a, i) {
						'var ' + goIdent(a) + ' OakValue; if len(__oak_args) > ' + string(i) + ' { ' + goIdent(a) + ' = __oak_args[' + string(i) + '] }; _ = ' + goIdent(a) + '; '
					}) |> join('')

					restBinding := if node.restArg {
						?, '' -> ''
						_ -> 'var ' + goIdent(node.restArg) + ' OakValue = OakList{}; if len(__oak_args) > ' + string(len(args)) + ' { ' + goIdent(node.restArg) + ' = OakList(__oak_args[' + string(len(args)) + ':]) }; '
					}

					bodyStr := if node.body.type = :block {
						true -> renderHoistedBlockExprs(node.body.exprs)
						_ -> renderReturnExpr(node.body)
					}
					// typed fn: try the monomorphized companion first when
					// every actual argument is an Oak int
					if node.name {
						?, '' -> ?
						_ -> if (typedNames.(node.name) != ?) & (env().('MGO_NO_FAST') = ?) {
							true -> {
								k := len(node.args)
								fn ivs(i, acc) if i < k {
									true -> ivs(i + 1, acc + 'iv[' + string(i) + ']' + if i < k - 1 {
										true -> ', '
										_ -> ''
									})
									_ -> acc
								}
								fastCall := '__mg_fast_' + goIdent(node.name) + '(' + ivs(0, '') + ')'
								bodyStr <- 'if iv, ok := __oak_fast_int_args(__oak_args, ' + string(k) + '); ok { return int(' + fastCall + ') }; ' + bodyStr
							}
							_ -> ?
						}
					}
					argBindings + restBinding + bodyStr
				} + '})'
				// Named functions: just assignment (var is hoisted by block)
				if node.name {
					?, '' -> fnExpr
					_ -> goIdent(node.name) + ' = ' + fnExpr
				}
			}

			:fnCall -> if node.function.type = :identifier & node.function.val = '__oak_modularize' & len(node.args) > 1 & node.args.(0).type = :string & isGoRuntimeLib(node.args.(0).val) {
				// runtime-library modules (std, str, ...) are provided natively
				// by __oak_std_module and never transpiled into the bundle
				true -> '__oak_modularize.(OakFn)(' + goStr(node.args.(0).val) + ', OakFn(func(__oak_args ...OakValue) OakValue { return __oak_std_module }))'
				_ -> {
					fnStr := renderNode(node.function)
					argsStr := node.args |> map(renderNode) |> join(', ')
					fnStr + '.(' + 'OakFn' + ')(' + argsStr + ')'
				}
			}

			_ -> 'nil /* unhandled: ' + string(node.type) + ' */'
		}
	}

	renderReturnExpr <- fn(node) if {
		// Named functions: declare + assign, then return the name
		node.type = :function & node.name != ? & node.name != '' ->
			renderNode(node) + '; return OakValue(' + goIdent(node.name) + ')'
		// Object destructuring: emit var decls + assignments + return
		node.type = :assignment & node.left.type = :object -> {
			prefix := ''
			if node.local? {
				true -> node.left.entries |> each(fn(entry) {
					{ key: k, val: v } := entry
					name := if v.type {
						:identifier -> v.val
						_ -> k.val
					}
					prefix <- prefix + 'var ' + goIdent(name) + ' OakValue; '
				})
			}
			body := '__oak_assgn := ' + renderNode(node.right) + '; '
			node.left.entries |> each(fn(entry) {
				{ key: k, val: v } := entry
				name := if v.type {
					:identifier -> v.val
					_ -> k.val
				}
				body <- body + goIdent(name) + ' = __oak_acc(__oak_assgn, ' + goStr(k.val) + '); '
			})
			prefix + body + 'return OakValue(__oak_assgn)'
		}
		// List destructuring: emit var decls + assignments + return
		node.type = :assignment & node.left.type = :list -> {
			prefix := ''
			if node.local? {
				true -> node.left.elems |> each(fn(elem, i) if elem.type {
					:identifier -> prefix <- prefix + 'var ' + goIdent(elem.val) + ' OakValue; '
					:empty -> ?
				})
			}
			body := '__oak_assgn := ' + renderNode(node.right) + '; '
			node.left.elems |> each(fn(elem, i) if elem.type {
				:identifier -> body <- body + goIdent(elem.val) + ' = __oak_acc(__oak_assgn, ' + string(i) + '); '
				:empty -> ?
			})
			prefix + body + 'return OakValue(__oak_assgn)'
		}
		// Regular assignments: assign then return the left-hand side
		node.type = :assignment & !(node.left.type = :propertyAccess) ->
			renderNode(node) + '; return OakValue(' + renderNode(node.left) + ')'
		// `xs << v` tail: rebind xs (append may reallocate) then return it
		node.type = :binary & node.op = :pushArrow & node.left.type = :identifier ->
			goIdent(node.left.val) + ' = __oak_push(' + goIdent(node.left.val) + ', ' + renderNode(node.right) + '); return OakValue(' + goIdent(node.left.val) + ')'
		_ -> 'return OakValue(' + renderNode(node) + ')'
	}

	output <- output + 'func main() {\n'
	output <- output + '\t_ = ' + renderNode(bundleNode) + '\n'
	output <- output + '}\n'
	output
}
