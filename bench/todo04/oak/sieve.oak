n := 100000
fn fill(i, acc) if i < n {
  true -> fill(i + 1, acc << true)
  _ -> acc
}
sieve := fill(0, [])
fn clearK(k, j) if k < n {
  true -> {
    sieve.(k) <- false
    clearK(k + j, j)
  }
  _ -> ?
}
fn outer(i, count) if i * i < n {
  true -> if sieve.(i) {
    true -> {
      clearK(i * i, i)
      outer(i + 1, count)
    }
    _ -> outer(i + 1, count)
  }
  _ -> count
}
fn countup(k, count) if k < n {
  true -> if sieve.(k) {
    true -> countup(k + 1, count + 1)
    _ -> countup(k + 1, count)
  }
  _ -> count
}
fn reps(r, count) if r = 0 {
  true -> count
  _ -> {
    fn reset(k) if k < n {
      true -> {
        sieve.(k) <- true
        reset(k + 1)
      }
      _ -> ?
    }
    reset(0)
    c1 := outer(2, 0)
    reps(r - 1, countup(2, 0))
  }
}
print('sieve=' + string(reps(50, 0)))
