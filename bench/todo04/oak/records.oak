fn make(d) if d = 0 {
  true -> ?
  _ -> { l: make(d - 1), r: make(d - 1) }
}
fn check(t) if t {
  ? -> 1
  _ -> 1 + check(t.l) + check(t.r)
}
fn dloop(d, acc) if d <= 12 {
  true -> dloop(d + 2, acc + check(make(d)) + check(make(d)))
  _ -> acc
}
fn rloop(r, acc) if r = 0 {
  true -> acc
  _ -> rloop(r - 1, acc + dloop(4, 0))
}
longLived := make(12)
total := check(longLived)
rloop(50, 0)
one := dloop(4, 0)
print('records=' + string(total + one))
