std := import('std')
c := import('compute')
xs := std.range(1, 20001, 1)
sq := { op: :mul, l: { inp: 'x' }, r: { inp: 'x' } }
sse := c.pipeline([{ op: :map, expr: sq }, { op: :reduce, expr: { op: :add, l: { acc: true }, r: { inp: 'x' } }, init: 0 }], xs, [])
fn reps(r, total) if r = 0 {
  true -> total
  _ -> reps(r - 1, total + sse % 7)
}
print('computefuse=' + string(reps(50, 0)))
