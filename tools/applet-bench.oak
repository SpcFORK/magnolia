// Reproducible A/B ablation of Magnolia's applet constant-folding pass.
// Run: magnolia tools/applet-bench.oak [iterations]  (no Java tools needed)

std := import('std')
app := import('../lib/applet.oak')
lower := import('../lib/applet-bytecode.oak')
println := std.println

n := int(std.default(args().2, '2000'))
if n = ? | n < 1 | n > 100000 -> {
    println('Expected 1..100000 iterations')
    exit(1)
}
cls := {name: 'Fold', pool: [?]}
method := {name: 'sum', desc: '()I', code: char(5)+char(6)+char(96)+char(172), catches: 0, flags: 0, locals: 1, stack: 2}

fn makeProgram(optimized?) {
    lowered := lower.lowerMethod(cls, method, {}, optimized?)
    [
        {entry: 'Fold', classes: {
            'Fold': {super: ?, fields: {}, static: {}, methods: {
                'sum()I': {code: lowered.code, locals: 1, stack: 2, static?: false}
            }}
        }}
        lowered
    ]
}

[optimized, fast] := makeProgram(true)
[baseline, plain] := makeProgram(false)

fn measure(program) {
    start := nanotime()
    steps := 0
    result := ?
    fn loop(i) if i >= n {
        true -> ?
        _ -> {
            call := app.run(program, {}, {method: 'sum', desc: '()I'})
            if call.type = :error -> {
                println(call.message)
                exit(1)
            }
            result <- call.value
            steps <- steps + call.steps
            loop(i + 1)
        }
    }
    loop(0)
    {ms: float(nanotime() - start) / 1000000, steps: steps, result: result}
}

// Warm up both programs, then alternate the measurement order to reduce
// bias from first-call costs. Report raw times; do not assume a speedup.
measure(optimized)
measure(baseline)
a := measure(baseline)
b := measure(optimized)
c := measure(optimized)
d := measure(baseline)
if a.result != b.result | c.result != d.result -> {
    println('A/B outputs differ!')
    exit(1)
}
println('Iterations per run: ' + string(n))
println('Baseline:  ' + string(plain.before) + ' instructions; ' + string(a.steps) + '/' + string(d.steps) + ' steps; ' + string(a.ms) + '/' + string(d.ms) + ' ms')
println('Optimized: ' + string(fast.after) + ' instructions; ' + string(b.steps) + '/' + string(c.steps) + ' steps; ' + string(b.ms) + '/' + string(c.ms) + ' ms')
println('Equivalent result: ' + string(a.result) + '; folds: ' + string(fast.folds))
