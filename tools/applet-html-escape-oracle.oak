// Small standalone regression for HTML script termination and source fidelity.
// Run: magnolia tools/applet-html-escape-oracle.oak
app := import('../lib/applet.oak')
str := import('str')
std := import('std')
script := 'const x="</ScRiPt>";const y="</script";const z="</SCRIPT>";console.log("<<other>");'
expected := 'const x="<\\/ScRiPt>";const y="<\\/script";const z="<\\/SCRIPT>";console.log("<<other>");'
page := app.html(script, '<&"')
sections := str.split(page, '<script>')
if len(sections) != 3 -> {
    std.println('FAIL: expected exactly two inline scripts')
    exit(1)
}
body := str.cut(sections.(2), '</script>').(0)
if body != '\n' + expected + '\n' -> {
    std.println('FAIL: mixed-case script escape corrupted inline source')
    exit(1)
}
if !str.contains?(page, '<title>&lt;&amp;&quot; · Magnolia applet</title>') -> {
    std.println('FAIL: HTML title was not escaped')
    exit(1)
}
std.println('PASS multiple mixed-case HTML terminators escaped without changing other JavaScript')
