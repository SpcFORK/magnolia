#!/usr/bin/env oak
// m0-transpile-demo -- end-to-end smoke of the JS -> Oak transpiler (M0)
//
// Builds a small JavaScript AST by hand, transpiles it to Oak with
// lib/ast-js, renders Oak source with lib/build-render-node, prepends the
// js-runtime harness bindings and writes a runnable Oak program.
//
// Usage:
//   magnolia tools/m0-transpile-demo.oak [output.oak]
//   magnolia /tmp/m0-demo-out.oak
//
// Expected output of the generated program:
//   -1 0 1
//   6
//   8
//   5 -1
//   bF

astJs := import('ast-js')
brn := import('build-render-node')
render := brn.renderOakNode
std := import('std')
join := import('str').join

args := args()
outPath := if len(args) > 1 { true -> args.(len(args) - 1), _ -> '/tmp/m0-demo-out.oak' }

fn id(n) astJs.jsIdentifier(n)
fn num(n) astJs.jsNumber(n)
fn str(s) astJs.jsString(s)
fn bin(op, l, r) astJs.jsBinary(op, l, r)
fn call(f, args) astJs.jsCall(f, args)
fn conlog(args) astJs.jsExpressionStatement(call(astJs.jsProperty(id('console'), id('log')), args))

prog := astJs.jsBlock([
	// function sign(n) { if (n < 0) { return -1; } if (n === 0) { return 0; } return 1; }
	astJs.jsFunction('sign', ['n'], astJs.jsBlock([
		astJs.jsIf(
			bin('<', id('n'), num(0))
			astJs.jsBlock([astJs.jsReturn(astJs.jsUnary('-', num(1)))])
			?
		)
		astJs.jsIf(
			bin('===', id('n'), num(0))
			astJs.jsBlock([astJs.jsReturn(num(0))])
			?
		)
		astJs.jsReturn(num(1))
	]))
	// function sumUntil(limit) { var t = 0; for (var i = 0; i < 10; i = i + 1) { if (i === limit) { break; } t = t + i; } return t; }
	astJs.jsFunction('sumUntil', ['limit'], astJs.jsBlock([
		astJs.jsVar('var', 't', num(0))
		astJs.jsFor(
			astJs.jsVar('var', 'i', num(0))
			bin('<', id('i'), num(10))
			astJs.jsAssignment(id('i'), bin('+', id('i'), num(1)))
			astJs.jsBlock([
				astJs.jsIf(
					bin('===', id('i'), id('limit'))
					astJs.jsBlock([astJs.jsBreak()])
					?
				)
				astJs.jsAssignment(id('t'), bin('+', id('t'), id('i')))
			])
		)
		astJs.jsReturn(id('t'))
	]))
	// function collatz(n) { var steps = 0; var x = n; while (x !== 1) { if (x % 2 === 0) { x = x / 2; steps = steps + 1; continue; } x = x * 3 + 1; steps = steps + 1; } return steps; }
	astJs.jsFunction('collatz', ['n'], astJs.jsBlock([
		astJs.jsVar('var', 'steps', num(0))
		astJs.jsVar('var', 'x', id('n'))
		astJs.jsWhile(
			bin('!==', id('x'), num(1))
			astJs.jsBlock([
				astJs.jsIf(
					bin('===', bin('%', id('x'), num(2)), num(0))
					astJs.jsBlock([
						astJs.jsAssignment(id('x'), bin('/', id('x'), num(2)))
						astJs.jsAssignment(id('steps'), bin('+', id('steps'), num(1)))
						astJs.jsContinue()
					])
					?
				)
				astJs.jsAssignment(id('x'), bin('+', bin('*', id('x'), num(3)), num(1)))
				astJs.jsAssignment(id('steps'), bin('+', id('steps'), num(1)))
			])
		)
		astJs.jsReturn(id('steps'))
	]))
	// function safeDiv(a, b) { try { if (b === 0) { throw 'div0'; } return a / b; } catch (e) { return -1; } }
	astJs.jsFunction('safeDiv', ['a', 'b'], astJs.jsBlock([
		astJs.jsTry(
			astJs.jsBlock([
				astJs.jsIf(
					bin('===', id('b'), num(0))
					astJs.jsBlock([astJs.jsThrow(str('div0'))])
					?
				)
				astJs.jsReturn(bin('/', id('a'), id('b')))
			])
			'e'
			astJs.jsBlock([astJs.jsReturn(astJs.jsUnary('-', num(1)))])
			?
		)
	]))
	// function latch() { var x = 'a'; try { x = 'b'; } finally { x = x + 'F'; } return x; }
	astJs.jsFunction('latch', [], astJs.jsBlock([
		astJs.jsVar('var', 'x', str('a'))
		astJs.jsTry(
			astJs.jsBlock([
				astJs.jsAssignment(id('x'), str('b'))
			])
			?
			?
			astJs.jsBlock([
				astJs.jsAssignment(id('x'), bin('+', id('x'), str('F')))
			])
		)
		astJs.jsReturn(id('x'))
	]))
	conlog([call(id('sign'), [astJs.jsUnary('-', num(5))]), call(id('sign'), [num(0)]), call(id('sign'), [num(7)])])
	conlog([call(id('sumUntil'), [num(4)])])
	conlog([call(id('collatz'), [num(6)])])
	conlog([call(id('safeDiv'), [num(10), num(2)]), call(id('safeDiv'), [num(10), num(0)])])
	conlog([call(id('latch'), [])])
])

prelude := join([
	'{'
	'\t__jsTruthy: __jsTruthy'
	'\t__jsTypeof: __jsTypeof'
	'\t__jsSignal?: __jsSignal?'
	'\t__jsIsThrow: __jsIsThrow'
	'\t__jsFunctionReturn: __jsFunctionReturn'
	'\t__jsWhile: __jsWhile'
	'\t__jsDoWhile: __jsDoWhile'
	'\t__jsFor: __jsFor'
	'\t__jsForIn: __jsForIn'
	'\t__jsForOf: __jsForOf'
	'\t__jsRegExp: __jsRegExp'
	'\t__jsDelete: __jsDelete'
	'\t__console: __console'
	'\t__Math: __Math'
	'\t__JSON: __JSON'
	'} := import(\'js-runtime\')'
], '\n') + '\n'

out := prelude + render(astJs.transpileToOak(prog)) + '\n'
import('fs').writeFile(outPath, out, ?)
print('wrote ' + outPath + '\n')
print(out)
