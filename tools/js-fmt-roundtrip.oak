#!/usr/bin/env oak
// js-fmt-roundtrip -- M4 gate: JS source -> Oak source, ready for `oak fmt`
//
// Usage:
//   magnolia tools/js-fmt-roundtrip.oak <input.js> [output.oak]
//
// Pipeline: js-parse.parse (Oak-native) -> ast-js.transpileToOak ->
// build-render-node.renderOakNode. Reports how many diagnostics the
// transpiler recorded (0 means every node type in the input was mapped).
// The rendered file can then be checked with `oak fmt <output.oak>`.

std := import('std')
fs := import('fs')
jsparse := import('js-parse')
ast := import('ast-js')
brn := import('build-render-node')
syntax := import('syntax-parse')

// args() = [magnolia-binary, script, userArgs...]
args := args()
inPath := if len(args) > 2 {
	true -> args.(2)
	_ -> {
		print('usage: magnolia tools/js-fmt-roundtrip.oak <input.js> [output.oak]\n')
		exit(1)
	}
}
outPath := if len(args) > 3 {
	true -> args.(3)
	_ -> '/tmp/js-fmt-roundtrip-out.oak'
}

src := fs.readFileSync(inPath)
r := jsparse.parse(src)
if !r.ok {
	true -> {
		print('PARSE FAILED\n')
		r.errors |> std.each(fn(e) print('  ' << string(e) << '\n'))
		exit(1)
	}
}
print('native parse: ok (' << string(len(r.warnings)) << ' warnings)\n')

ast.clearDiagnostics()
oakAst := ast.transpileToOak(r.ast)
diags := ast.takeDiagnostics()
print('transpile diagnostics: ' << string(len(diags)) << '\n')
diags |> std.each(fn(d) print('  ' << string(d) << '\n'))

out := brn.renderOakNode(oakAst)
print('rendered ' << string(len(out)) << ' bytes\n')
fs.writeFile(outPath, out, ?)
print('wrote ' << outPath << '\n')

// round-trip gate: the repo's own parser must accept the rendered source.
// syntax.parse returns a list of AST nodes on success and an
// {pos, type, error} object on failure.
rt := syntax.parse(out)
if type(rt) = :list {
	true -> print('round-trip: syntax.parse OK (' << string(len(rt)) << ' top-level nodes)\n')
	_ -> {
		print('round-trip: PARSE FAILED\n')
		print('  error: ' << string(rt.error) << ' at ' << string(rt.pos) << '\n')
		exit(1)
	}
}
